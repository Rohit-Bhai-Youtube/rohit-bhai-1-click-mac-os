@echo off
rem Removes the 'Capitaine Light W11 HiDPI' scheme registration. Generated by w11cursor.
reg delete "HKCU\Control Panel\Cursors\Schemes" /v "Capitaine Light W11 HiDPI" /f
echo.
echo Scheme removed. Opening Mouse Properties - pick another scheme and press Apply.
echo Then (as admin) delete: %WINDIR%\Cursors\Capitaine Light W11 HiDPI
rundll32.exe shell32.dll,Control_RunDLL main.cpl @1
