 Ð¿Ð¾ÑÐ»Ðµ Ñ‚Ð¾Ð³Ð¾, ÐºÐ°Ðº Ð¼Ñ‹ÑˆÑŒ ÑƒÐ¹Ð´Ñ‘Ñ‚. ÐšÐ½Ð¾Ð¿ÐºÐ°Ð¼, ÐºÐ¾Ñ‚Ð¾Ñ€Ñ‹Ðµ Ñ‡Ñ‚Ð¾-Ñ‚Ð¾ Ð´ÐµÐ»Ð°ÑŽÑ‚, Ð¿Ð¾-Ð¿Ñ€ÐµÐ¶Ð½ÐµÐ¼Ñƒ Ð½ÑƒÐ¶ÐµÐ½ Ñ‰ÐµÐ»Ñ‡Ð¾Ðº; Ñ‰ÐµÐ»Ñ‡Ð¾Ðº Ð¾ÑÑ‚Ð°Ð²Ð»ÑÐµÑ‚ Ð¿Ð°Ð½ÐµÐ»ÑŒ Ð¾Ñ‚ÐºÑ€Ñ‹Ñ‚Ð¾Ð¹\"},\n    {L\"Restore what changed\", L\"Ð’ÐµÑ€Ð½ÑƒÑ‚ÑŒ Ð¸Ð·Ð¼ÐµÐ½Ñ‘Ð½Ð½Ð¾Ðµ\"},\n    {L\"Resume\", L\"ÐŸÑ€Ð¾Ð´Ð¾Ð»Ð¶Ð¸Ñ‚ÑŒ\"},\n    {L\"Right\", L\"Ð¡Ð¿Ñ€Ð°Ð²Ð°\"},\n    {L\"Ring with the battery\u0027s charge\", L\"ÐšÐ¾Ð»ÑŒÑ†Ð¾ Ñ Ð·Ð°Ñ€ÑÐ´Ð¾Ð¼ Ð±Ð°Ñ‚Ð°Ñ€ÐµÐ¸\"},\n    {L\"Room at the pill\u0027s ends\", L\"ÐœÐµÑÑ‚Ð¾ Ð¿Ð¾ ÐºÑ€Ð°ÑÐ¼ ÐºÐ°Ð¿ÑÑƒÐ»Ñ‹\"},\n    {L\"Room between the bars\", L\"Ð Ð°ÑÑÑ‚Ð¾ÑÐ½Ð¸Ðµ Ð¼ÐµÐ¶Ð´Ñƒ Ð¿Ð¾Ð»Ð¾ÑÐ°Ð¼Ð¸\"},\n    {L\"Rounds the corners where the bar meets the screen, like a screen\u0027s own round corners\", L\"Ð¡ÐºÑ€ÑƒÐ³Ð»ÑÐµÑ‚ ÑƒÐ³Ð»Ñ‹ Ñ‚Ð°Ð¼, Ð³Ð´Ðµ Ð¿Ð°Ð½ÐµÐ»ÑŒ Ð²ÑÑ‚Ñ€ÐµÑ‡Ð°ÐµÑ‚ÑÑ Ñ ÑÐºÑ€Ð°Ð½Ð¾Ð¼, ÐºÐ°Ðº ÑÐ¾Ð±ÑÑ‚Ð²ÐµÐ½Ð½Ñ‹Ðµ ÑÐºÑ€ÑƒÐ³Ð»Ñ‘Ð½Ð½Ñ‹Ðµ ÑƒÐ³Ð»Ñ‹ ÑÐºÑ€Ð°Ð½Ð°\"},\n    {L\"Rows\", L\"Ð¡Ñ‚Ñ€Ð¾ÐºÐ¸\"},\n    {L\"Run a command line\", L\"Ð’Ñ‹Ð¿Ð¾Ð»Ð½Ð¸Ñ‚ÑŒ ÐºÐ¾Ð¼Ð°Ð½Ð´Ð½ÑƒÑŽ ÑÑ‚Ñ€Ð¾ÐºÑƒ\"},\n    {L\"Runs in cmd.exe without a window; a terminal shows only if it fails.\", L\"Ð’Ñ‹Ð¿Ð¾Ð»Ð½ÑÐµÑ‚ÑÑ Ð² cmd.exe Ð±ÐµÐ· Ð¾ÐºÐ½Ð°; Ñ‚ÐµÑ€Ð¼Ð¸Ð½Ð°Ð» Ð¿Ð¾ÑÐ²Ð»ÑÐµÑ‚ÑÑ, Ñ‚Ð¾Ð»ÑŒÐºÐ¾ ÐµÑÐ»Ð¸ Ð¾Ð½Ð° Ð·Ð°Ð²ÐµÑ€ÑˆÐ¸Ñ‚ÑÑ Ñ Ð¾ÑˆÐ¸Ð±ÐºÐ¾Ð¹.\"},\n    {L\"Safe to remove\", L\"ÐœÐ¾Ð¶Ð½Ð¾ Ð¸Ð·Ð²Ð»ÐµÐºÐ°Ñ‚ÑŒ\"},\n    {L\"Same as main: changes here apply to it too Â· + creates this monitor\u0027s profile\", L\"ÐšÐ°Ðº Ñƒ Ð³Ð»Ð°Ð²Ð½Ð¾Ð³Ð¾: Ð¸Ð·Ð¼ÐµÐ½ÐµÐ½Ð¸Ñ Ð·Ð´ÐµÑÑŒ Ð´ÐµÐ¹ÑÑ‚Ð²ÑƒÑŽÑ‚ Ð¸ Ð½Ð° Ð½ÐµÐ³Ð¾ Â· + ÑÐ¾Ð·Ð´Ð°Ñ‘Ñ‚ Ð¿Ñ€Ð¾Ñ„Ð¸Ð»ÑŒ ÑÑ‚Ð¾Ð³Ð¾ Ð¼Ð¾Ð½Ð¸Ñ‚Ð¾Ñ€Ð°\"},\n    {L\"Same as the main one\", L\"ÐšÐ°Ðº Ñƒ Ð³Ð»Ð°Ð²Ð½Ð¾Ð³Ð¾\"},\n    {L\"Save\", L\"Ð¡Ð¾Ñ…Ñ€Ð°Ð½Ð¸Ñ‚ÑŒ\"},\n    {L\"Save  (Enter)\", L\"Ð¡Ð¾Ñ…Ñ€Ð°Ð½Ð¸Ñ‚ÑŒ  (Enter)\"},\n    {L\"Save Windows\u0027 icons\", L\"Ð¡Ð¾Ñ…Ñ€Ð°Ð½Ð¸Ñ‚ÑŒ Ð·Ð½Ð°Ñ‡ÐºÐ¸ Windows\"},\n    {L\"Save Windows\u0027 icons puts a picture of every icon in the folder, named after it (wifi.png, battery-5.png...): replace the ones you want, and they show a moment later\", L\"Â«Ð¡Ð¾Ñ…Ñ€Ð°Ð½Ð¸Ñ‚ÑŒ Ð·Ð½Ð°Ñ‡ÐºÐ¸ WindowsÂ» ÐºÐ»Ð°Ð´Ñ‘Ñ‚ Ð² Ð¿Ð°Ð¿ÐºÑƒ ÐºÐ°Ñ€Ñ‚Ð¸Ð½ÐºÑƒ ÐºÐ°Ð¶Ð´Ð¾Ð³Ð¾ Ð·Ð½Ð°Ñ‡ÐºÐ°, Ð½Ð°Ð·Ð²Ð°Ð½Ð½ÑƒÑŽ Ð¿Ð¾ Ð½ÐµÐ¼Ñƒ (wifi.png, battery-5.png...): Ð·Ð°Ð¼ÐµÐ½Ð¸Ñ‚Ðµ Ð½ÑƒÐ¶Ð½Ñ‹Ðµ, Ð¸ Ð¾Ð½Ð¸ Ð¿Ð¾ÑÐ²ÑÑ‚ÑÑ Ñ‡ÐµÑ€ÐµÐ· Ð¼Ð³Ð½Ð¾Ð²ÐµÐ½Ð¸Ðµ\"},\n    {L\"Save current here\", L\"Ð¡Ð¾Ñ…Ñ€Ð°Ð½Ð¸Ñ‚ÑŒ Ñ‚ÐµÐºÑƒÑ‰Ð¸Ðµ ÑÑŽÐ´Ð°\"},\n    {L\"Save current settings\", L\"Ð¡Ð¾Ñ…Ñ€Ð°Ð½Ð¸Ñ‚ÑŒ Ñ‚ÐµÐºÑƒÑ‰Ð¸Ðµ Ð½Ð°ÑÑ‚Ñ€Ð¾Ð¹ÐºÐ¸\"},\n    {L\"Save the island\u0027s logs\", L\"Ð¡Ð¾Ñ…Ñ€Ð°Ð½Ð¸Ñ‚ÑŒ Ð¶ÑƒÑ€Ð½Ð°Ð»Ñ‹ Ð¾ÑÑ‚Ñ€Ð¾Ð²Ð°\"},\n    {L\"Save...\", L\"Ð¡Ð¾Ñ…Ñ€Ð°Ð½Ð¸Ñ‚ÑŒ...\"},\n    {L\"Saved \\u2713\", L\"Ð¡Ð¾Ñ…Ñ€Ð°Ð½ÐµÐ½Ð¾ \\u2713\"},\n    {L\"Saved.\", L\"Ð¡Ð¾Ñ…Ñ€Ð°Ð½ÐµÐ½Ð¾.\"},\n    {L\"Saves a backup file or loads one; Reset puts every setting back to its default (clicked twice)\", L\"Ð¡Ð¾Ñ…Ñ€Ð°Ð½ÑÐµÑ‚ Ñ„Ð°Ð¹Ð» Ñ€ÐµÐ·ÐµÑ€Ð²Ð½Ð¾Ð¹ ÐºÐ¾Ð¿Ð¸Ð¸ Ð¸Ð»Ð¸ Ð·Ð°Ð³Ñ€ÑƒÐ¶Ð°ÐµÑ‚ ÐµÐ³Ð¾; Â«Ð¡Ð±Ñ€Ð¾ÑÐ¸Ñ‚ÑŒÂ» Ð²Ð¾Ð·Ð²Ñ€Ð°Ñ‰Ð°ÐµÑ‚ Ð²ÑÐµ Ð½Ð°ÑÑ‚Ñ€Ð¾Ð¹ÐºÐ¸ Ð¿Ð¾ ÑƒÐ¼Ð¾Ð»Ñ‡Ð°Ð½Ð¸ÑŽ (Ð´Ð²Ð° Ð½Ð°Ð¶Ð°Ñ‚Ð¸Ñ)\"},\n    {L\"Saving Windows\u0027 iconsâ€¦\", L\"Ð¡Ð¾Ñ…Ñ€Ð°Ð½ÐµÐ½Ð¸Ðµ Ð·Ð½Ð°Ñ‡ÐºÐ¾Ð² Windowsâ€¦\"},\n    {L\"Savingâ€¦\", L\"Ð¡Ð¾Ñ…Ñ€Ð°Ð½ÐµÐ½Ð¸Ðµâ€¦\"},\n    {L\"Scales only the icons on the pill (their room too)\", L\"ÐœÐ°ÑÑˆÑ‚Ð°Ð±Ð¸Ñ€ÑƒÐµÑ‚ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Ð·Ð½Ð°Ñ‡ÐºÐ¸ Ð½Ð° ÐºÐ°Ð¿ÑÑƒÐ»Ðµ (Ð¸ Ð¼ÐµÑÑ‚Ð¾ Ð¿Ð¾Ð´ Ð½Ð¸Ñ…)\"},\n    {L\"Scales only the texts on the pill: the clock, percentages and titles\", L\"ÐœÐ°ÑÑˆÑ‚Ð°Ð±Ð¸Ñ€ÑƒÐµÑ‚ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Ñ‚ÐµÐºÑÑ‚ Ð½Ð° ÐºÐ°Ð¿ÑÑƒÐ»Ðµ: Ñ‡Ð°ÑÑ‹, Ð¿Ñ€Ð¾Ñ†ÐµÐ½Ñ‚Ñ‹ Ð¸ Ð½Ð°Ð·Ð²Ð°Ð½Ð¸Ñ\"},\n    {L\"Scales the control center, calendar and other panels\", L\"ÐœÐ°ÑÑˆÑ‚Ð°Ð±Ð¸Ñ€ÑƒÐµÑ‚ Ñ†ÐµÐ½Ñ‚Ñ€ ÑƒÐ¿Ñ€Ð°Ð²Ð»ÐµÐ½Ð¸Ñ, ÐºÐ°Ð»ÐµÐ½Ð´Ð°Ñ€ÑŒ Ð¸ Ð´Ñ€ÑƒÐ³Ð¸Ðµ Ð¿Ð°Ð½ÐµÐ»Ð¸\"},\n    {L\"Scales the pill, icons and panels together\", L\"ÐœÐ°ÑÑˆÑ‚Ð°Ð±Ð¸Ñ€ÑƒÐµÑ‚ ÐºÐ°Ð¿ÑÑƒÐ»Ñƒ, Ð·Ð½Ð°Ñ‡ÐºÐ¸ Ð¸ Ð¿Ð°Ð½ÐµÐ»Ð¸ Ð²Ð¼ÐµÑÑ‚Ðµ\"},\n    {L\"Screen\", L\"Ð­ÐºÑ€Ð°Ð½\"},\n    {L\"Screen brightness\", L\"Ð¯Ñ€ÐºÐ¾ÑÑ‚ÑŒ ÑÐºÑ€Ð°Ð½Ð°\"},\n    {L\"Screen brightness (the mouse wheel changes it)\", L\"Ð¯Ñ€ÐºÐ¾ÑÑ‚ÑŒ ÑÐºÑ€Ð°Ð½Ð° (Ð¼ÐµÐ½ÑÐµÑ‚ÑÑ ÐºÐ¾Ð»ÐµÑÐ¾Ð¼ Ð¼Ñ‹ÑˆÐ¸)\"},\n    {L\"Screens\", L\"Ð­ÐºÑ€Ð°Ð½Ñ‹\"},\n    {L\"Screenshot\", L\"Ð¡Ð½Ð¸Ð¼Ð¾Ðº ÑÐºÑ€Ð°Ð½Ð°\"},\n    {L\"Screenshot notifications open the picture (in Explorer)\", L\"Ð£Ð²ÐµÐ´Ð¾Ð¼Ð»ÐµÐ½Ð¸Ñ Ð¾ ÑÐ½Ð¸Ð¼ÐºÐ°Ñ… Ð¾Ñ‚ÐºÑ€Ñ‹Ð²Ð°ÑŽÑ‚ ÐºÐ°Ñ€Ñ‚Ð¸Ð½ÐºÑƒ (Ð² ÐŸÑ€Ð¾Ð²Ð¾Ð´Ð½Ð¸ÐºÐµ)\"},\n    {L\"Scrolling\", L\"ÐŸÑ€Ð¾ÐºÑ€ÑƒÑ‚ÐºÐ°\"},\n    {L\"Scrolling on the player skips songs instead of changing the volume\", L\"ÐŸÑ€Ð¾ÐºÑ€ÑƒÑ‚ÐºÐ° Ð½Ð° Ð¿Ð»ÐµÐµÑ€Ðµ Ð¿ÐµÑ€ÐµÐºÐ»ÑŽÑ‡Ð°ÐµÑ‚ Ð¿ÐµÑÐ½Ð¸ Ð²Ð¼ÐµÑÑ‚Ð¾ Ð¸Ð·Ð¼ÐµÐ½ÐµÐ½Ð¸Ñ Ð³Ñ€Ð¾Ð¼ÐºÐ¾ÑÑ‚Ð¸\"},\n    {L\"Search\", L\"ÐŸÐ¾Ð¸ÑÐº\"},\n    {L\"Search apps\", L\"ÐŸÐ¾Ð¸ÑÐº Ð¿Ñ€Ð¸Ð»Ð¾Ð¶ÐµÐ½Ð¸Ð¹\"},\n    {L\"Search here (a name or *.pdf)\", L\"Ð˜ÑÐºÐ°Ñ‚ÑŒ Ð·Ð´ÐµÑÑŒ (Ð¸Ð¼Ñ Ð¸Ð»Ð¸ *.pdf)\"},\n    {L\"Search results\", L\"Ð ÐµÐ·ÑƒÐ»ÑŒÑ‚Ð°Ñ‚Ñ‹ Ð¿Ð¾Ð¸ÑÐºÐ°\"},\n    {L\"Second screen only\", L\"Ð¢Ð¾Ð»ÑŒÐºÐ¾ Ð²Ñ‚Ð¾Ñ€Ð¾Ð¹ ÑÐºÑ€Ð°Ð½\"},\n    {L\"Seconds\", L\"Ð¡ÐµÐºÑƒÐ½Ð´Ñ‹\"},\n    {L\"Seconds the pill waits after the mouse leaves before it hides\", L\"Ð¡ÐºÐ¾Ð»ÑŒÐºÐ¾ ÑÐµÐºÑƒÐ½Ð´ ÐºÐ°Ð¿ÑÑƒÐ»Ð° Ð¶Ð´Ñ‘Ñ‚ Ð¿Ð¾ÑÐ»Ðµ ÑƒÑ…Ð¾Ð´Ð° Ð¼Ñ‹ÑˆÐ¸, Ð¿Ñ€ÐµÐ¶Ð´Ðµ Ñ‡ÐµÐ¼ ÑÐºÑ€Ñ‹Ñ‚ÑŒÑÑ\"},\n    {L\"See it in a terminal\", L\"Ð¡Ð¼Ð¾Ñ‚Ñ€ÐµÑ‚ÑŒ Ð² Ñ‚ÐµÑ€Ð¼Ð¸Ð½Ð°Ð»Ðµ\"},\n    {L\"See what\u0027s new in this version\", L\"ÐŸÐ¾ÑÐ¼Ð¾Ñ‚Ñ€Ð¸Ñ‚Ðµ, Ñ‡Ñ‚Ð¾ Ð½Ð¾Ð²Ð¾Ð³Ð¾ Ð² ÑÑ‚Ð¾Ð¹ Ð²ÐµÑ€ÑÐ¸Ð¸\"},\n    {L\"See-through bar\", L\"ÐŸÑ€Ð¾Ð·Ñ€Ð°Ñ‡Ð½Ð°Ñ Ð¿Ð°Ð½ÐµÐ»ÑŒ\"},\n    {L\"See-through blurred pill with a bright edge, needs Windows transparency\", L\"ÐŸÑ€Ð¾Ð·Ñ€Ð°Ñ‡Ð½Ð°Ñ Ñ€Ð°Ð·Ð¼Ñ‹Ñ‚Ð°Ñ ÐºÐ°Ð¿ÑÑƒÐ»Ð° ÑÐ¾ ÑÐ²ÐµÑ‚Ð»Ð¾Ð¹ ÐºÐ°Ð¹Ð¼Ð¾Ð¹, Ð½ÑƒÐ¶Ð½Ð° Ð¿Ñ€Ð¾Ð·Ñ€Ð°Ñ‡Ð½Ð¾ÑÑ‚ÑŒ Windows\"},\n    {L\"See-through only on the desktop\", L\"ÐŸÑ€Ð¾Ð·Ñ€Ð°Ñ‡Ð½Ð°Ñ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Ð½Ð° Ñ€Ð°Ð±Ð¾Ñ‡ÐµÐ¼ ÑÑ‚Ð¾Ð»Ðµ\"},\n    {L\"Separator line Â· drag to move Â· click to remove\", L\"Ð Ð°Ð·Ð´ÐµÐ»Ð¸Ñ‚ÐµÐ»ÑŒÐ½Ð°Ñ