                 {
                     "modId":  "invisible-borders",
                     "version":  "1.0.0",
                     "name":  "Invisible Window Borders",
                     "source":  "// ==WindhawkMod==\r\n// @id              invisible-borders\r\n// @name            Invisible Window Borders\r\n// @description     Makes window borders invisible while keeping rounded corners\r\n// @version         1.0.0\r\n// @author          Bo0ii\r\n// @github          https://github.com/Bo0ii\r\n// @homepage        https://github.com/Bo0ii/windhawk-mods\r\n// @include         *\r\n// @exclude         devenv.exe\r\n// @compilerOptions -ldwmapi -luser32\r\n// ==/WindhawkMod==\r\n\r\n// ==WindhawkModReadme==\r\n/*\r\n# Invisible Window Borders\r\n\r\nMakes window borders invisible while preserving rounded corners.\r\n\r\n![Comparison](https://raw.githubusercontent.com/Bo0ii/windhawk-mods/main/invisible-borders/onoff.png)\r\n\r\n## Features\r\n\r\n- **Invisible Borders**: Removes border color while keeping frame structure\r\n- **Preserves Rounded Corners**: Keeps window frame intact for corner rendering\r\n- **Universal**: Works with all applications\r\n- **Lightweight**: Minimal performance impact\r\n\r\n## Compatibility\r\n\r\n- Windows 10 (version 1809 and later)\r\n- Windows 11 (all versions)\r\n- Requires DWM (Desktop Window Manager) to be enabled\r\n\r\n## Support\r\n\r\nReport issues at: https://github.com/Bo0ii/windhawk-mods/issues\r\n\r\n## License\r\n\r\nMIT License - Feel free to modify and distribute\r\n*/\r\n// ==/WindhawkModReadme==\r\n\r\n// ==WindhawkModSettings==\r\n/*\r\n- SpecialWindows: false\r\n  $name: Apply to Special Windows\r\n  $description: Also apply to special windows like dialogs\r\n*/\r\n// ==/WindhawkModSettings==\r\n\r\n#include \u003cdwmapi.h\u003e\r\n#include \u003cwindhawk_api.h\u003e\r\n\r\n// Special DWM color values\r\n#ifndef DWMWA_COLOR_NONE\r\n#define DWMWA_COLOR_NONE 0xFFFFFFFE\r\n#endif\r\n\r\nconst COLORREF BorderInvisible = DWMWA_COLOR_NONE;  // No border color\r\nconst COLORREF ColorDefault = DWMWA_COLOR_DEFAULT;\r\n\r\nbool SpecialWindows = false;\r\n\r\nBOOL IsValidWindow(HWND hWnd) {\r\n    DWORD dwStyle = GetWindowLongPtr(hWnd, GWL_STYLE);\r\n    // Better exclude context menus\r\n    return (dwStyle \u0026 WS_THICKFRAME) == WS_THICKFRAME ||\r\n           (dwStyle \u0026 WS_CAPTION) == WS_CAPTION ||\r\n           (SpecialWindows \u0026\u0026 (dwStyle \u0026 WS_OVERLAPPED) == WS_OVERLAPPED \u0026\u0026 (dwStyle \u0026 WS_POPUP) != WS_POPUP);\r\n}\r\n\r\nusing DwmSetWindowAttribute_t = decltype(\u0026DwmSetWindowAttribute);\r\nDwmSetWindowAttribute_t DwmSetWindowAttribute_orig;\r\nHRESULT WINAPI DwmSetWindowAttribute_hook(HWND hwnd, DWORD dwAttribute, LPCVOID pvAttribute, DWORD cbAttribute) {\r\n    if (dwAttribute == DWMWA_BORDER_COLOR \u0026\u0026 IsValidWindow(hwnd)) {\r\n        Wh_Log(L\"Intercepted DWMWA_BORDER_COLOR - setting to invisible\");\r\n        // Override with invisible border\r\n        return DwmSetWindowAttribute_orig(hwnd, dwAttribute, \u0026BorderInvisible, sizeof(BorderInvisible));\r\n    }\r\n\r\n    return DwmSetWindowAttribute_orig(hwnd, dwAttribute, pvAttribute, cbAttribute);\r\n}\r\n\r\nvoid SetBorderInvisible(HWND hWnd)\r\n{\r\n    if (!IsValidWindow(hWnd))\r\n        return;\r\n\r\n    Wh_Log(L\"Setting invisible border\");\r\n    DwmSetWindowAttribute_orig(hWnd, DWMWA_BORDER_COLOR, \u0026BorderInvisible, sizeof(BorderInvisible));\r\n}\r\n\r\nusing DefWindowProcA_t = decltype(\u0026DefWindowProcA);\r\nDefWindowProcA_t DefWindowProcA_orig;\r\nLRESULT WINAPI DefWindowProcA_hook(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam)\r\n{\r\n    LRESULT result = DefWindowProcA_orig(hWnd, uMsg, wParam, lParam);\r\n\r\n    switch (uMsg) {\r\n        case WM_ACTIVATE:\r\n        case WM_NCACTIVATE:\r\n        case WM_DWMCOLORIZATIONCOLORCHANGED:\r\n            SetBorderInvisible(hWnd);\r\n            break;\r\n    }\r\n\r\n    return result;\r\n}\r\n\r\nusing DefWindowProcW_t = decltype(\u0026DefWindowProcW);\r\nDefWindowProcW_t DefWindowProcW_orig;\r\nLRESULT WINAPI DefWindowProcW_hook(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam)\r\n{\r\n    LRESULT result = DefWindowProcW_orig(hWnd, uMsg, wParam, lParam);\r\n\r\n    switch (uMsg) {\r\n        case WM_ACTIVATE:\r\n        case WM_NCACTIVATE:\r\n        case WM_DWMCOLORIZATIONCOLORCHANGED:\r\n            SetBorderInvisible(hWnd);\r\n            break;\r\n    }\r\n\r\n    return result;\r\n}\r\n\r\nusing DefDlgProcA_t = decltype(\u0026DefDlgProcA);\r\nDefDlgProcA_t DefDlgProcA_orig;\r\nLRESULT WINAPI DefDlgProcA_hook(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam)\r\n{\r\n    LRESULT result = DefDlgProcA_orig(hWnd, uMsg, wParam, lParam);\r\n\r\n    switch (uMsg) {\r\n        case WM_NCACTIVATE:\r\n            SetBorderInvisible(hWnd);\r\n            break;\r\n    }\r\n\r\n    return result;\r\n}\r\n\r\nusing DefDlgProcW_t = decltype(\u0026DefDlgProcW);\r\nDefDlgProcW_t DefDlgProcW_orig;\r\nLRESULT WINAPI DefDlgProcW_hook(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam)\r\n{\r\n    LRESULT result = DefDlgProcW_orig(hWnd, uMsg, wParam, lParam);\r\n\r\n    switch (uMsg) {\r\n        case WM_NCACTIVATE:\r\n            SetBorderInvisible(hWnd);\r\n            break;\r\n    }\r\n\r\n    return result;\r\n}\r\n\r\nBOOL CALLBACK EnableEnumWindowsCallback(HWND hWnd, LPARAM lParam) {\r\n    DWORD pid = lParam;\r\n\r\n    DWORD wPid = 0;\r\n    GetWindowThreadProcessId(hWnd, \u0026wPid);\r\n\r\n    if (pid == wPid) {\r\n        SetBorderInvisible(hWnd);\r\n    }\r\n\r\n    return TRUE;\r\n}\r\n\r\nBOOL CALLBACK DisableEnumWindowsCallback(HWND hWnd, LPARAM lParam) {\r\n    DWORD pid = lParam;\r\n    DWORD wPid = 0;\r\n    GetWindowThreadProcessId(hWnd, \u0026wPid);\r\n\r\n    if (pid == wPid \u0026\u0026 IsValidWindow(hWnd))\r\n        DwmSetWindowAttribute_orig(hWnd, DWMWA_BORDER_COLOR, \u0026ColorDefault, sizeof(ColorDefault));\r\n\r\n    return TRUE;\r\n}\r\n\r\nBOOL Wh_ModInit() {\r\n    Wh_Log(L\"Init - Invisible Borders\");\r\n\r\n    SpecialWindows = Wh_GetIntSetting(L\"SpecialWindows\");\r\n\r\n    Wh_SetFunctionHook(\r\n        (void *)DwmSetWindowAttribute,\r\n        (void *)DwmSetWindowAttribute_hook,\r\n        (void **)\u0026DwmSetWindowAttribute_orig);\r\n\r\n    Wh_SetFunctionHook(\r\n        (void *)DefWindowProcW,\r\n        (void *)DefWindowProcW_hook,\r\n        (void **)\u0026DefWindowProcW_orig\r\n    );\r\n\r\n    Wh_SetFunctionHook(\r\n        (void *)DefWindowProcA,\r\n        (void *)DefWindowProcA_hook,\r\n        (void **)\u0026DefWindowProcA_orig\r\n    );\r\n\r\n    Wh_SetFunctionHook(\r\n        (void *)DefDlgProcW,\r\n        (void *)DefDlgProcW_hook,\r\n        (void **)\u0026DefDlgProcW_orig\r\n    );\r\n\r\n    Wh_SetFunctionHook(\r\n        (void *)DefDlgProcA,\r\n        (void *)DefDlgProcA_hook,\r\n        (void **)\u0026DefDlgProcA_orig\r\n    );\r\n\r\n    return TRUE;\r\n}\r\n\r\nvoid Wh_ModAfterInit() {\r\n    Wh_Log(L\"AfterInit - Applying invisible borders\");\r\n    EnumWindows(EnableEnumWindowsCallback, GetCurrentProcessId());\r\n}\r\n\r\nvoid Wh_ModBeforeUninit() {\r\n    Wh_Log(L\"BeforeUninit - Restoring default borders\");\r\n    EnumWindows(DisableEnumWindowsCallback, GetCurrentProcessId());\r\n}\r\n\r\nvoid Wh_ModSettingsChanged() {\r\n    Wh_Log(L\"SettingsChanged\");\r\n    EnumWindows(DisableEnumWindowsCallback, GetCurrentProcessId());\r\n    SpecialWindows = Wh_GetIntSetting(L\"SpecialWindows\");\r\n    EnumWindows(EnableEnumWindowsCallback, GetCurrentProcessId());\r\n}\r\n",
                     "settings":  {
                                      "SpecialWindows":  0
                                  }
                 },
                 {
                     "modId":  "mac-island-dock",
                     "version":  "3.1.1",
                     "name":  "Mac Island \u0026 Dock",
                     "source":  "// ==WindhawkMod==\n// @id              mac-island-dock\n// @name            Mac Island \u0026 Dock\n// @name:pt-BR      Ilha e Dock estilo Mac\n// @name:vi-VN Mac Island \u0026 Dock\n// @description     An island at the top of the screen like the macOS menu bar and the iPhone\u0027s Dynamic Island (clock, control center, notifications, media, tray icons), and a macOS-like dock instead of the taskbar (or the Windows taskbar, transparent or as it is)\n// @description:pt-BR Uma ilha no topo da tela como a barra de menus do macOS e a Dynamic Island do iPhone (relÃ³gio, central de controle, notificaÃ§Ãµes, mÃ­dia, Ã­cones da bandeja) e uma dock como a do macOS no lugar da barra de tarefas (ou a barra do Windows, transparente ou como ela Ã©)\n// @description:vi-VN Island á»Ÿ cáº¡nh trÃªn káº¿t há»£p thanh menu macOS vÃ  Dynamic Island cá»§a iPhone, tÃ­ch há»£p Ä‘á»“ng há»“, Trung tÃ¢m Ä‘iá»u khiá»ƒn, thÃ´ng bÃ¡o, trÃ¬nh phÃ¡t ná»™i dung vÃ  khay há»‡ thá»‘ng. CÃ³ thá»ƒ dÃ¹ng Dock theo phong cÃ¡ch macOS Ä‘á»ƒ thay thanh tÃ¡c vá»¥ Windows, lÃ m trong suá»‘t thanh tÃ¡c vá»¥ hoáº·c giá»¯ nguyÃªn.\n// @version         3.1.1\n// @author          caliberda\n// @github          https://github.com/cesarkali\n// @homepage        https://island.caliberda.com.br\n// @donateUrl       https://github.com/sponsors/cesarkali\n// @include         windhawk.exe\n// @include         explorer.exe\n// @compilerOptions -DWIN32_LEAN_AND_MEAN -lole32 -loleaut32 -lruntimeobject -lshell32 -ldwmapi -lcomctl32 -lgdi32 -lmsimg32 -ld2d1 -ldwrite -lwlanapi -luuid -lversion -lbthprops -ldxva2 -lshlwapi -lwinhttp -lwinmm -liphlpapi -lshcore -lcomdlg32 -limm32 -lsetupapi -lcfgmgr32 -luserenv\n// @license         GPL-3.0\n// ==/WindhawkMod==\n\n// Mac Island \u0026 Dock\n// Copyright (C) 2026 caliberda (https://github.com/cesarkali)\n//\n// This program is free software: you can redistribute it and/or modify it\n// under the terms of the GNU General Public License as published by the Free\n// Software Foundation, version 3 of the License. It is distributed in the\n// hope that it will be useful, but WITHOUT ANY WARRANTY; without even the\n// implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.\n// See the GNU General Public License for more details:\n// https://www.gnu.org/licenses/gpl-3.0.html\n//\n// The code that reaches the taskbar\u0027s XAML tree is based on \"Taskbar tray\n// auto-hide (show on hover)\" by m417z, published under the same license; that\n// part keeps m417z\u0027s copyright.\n//\n// If you reuse this mod\u0027s code, or it inspired your work, credit to \"Mac\n// Island \u0026 Dock by caliberda\" with a link to it would be appreciated (and to\n// m417z\u0027s mod for the taskbar XAML code). This is a request, not a license\n// condition.\n\n// ==WindhawkModReadme==\n/*\n# Mac Island \u0026 Dock\n\n**English** | [PortuguÃªs](#portuguÃªs)\n\nMade in Brazil by **caliberda** Â· bugs and ideas: only [an issue on\nGitHub](https://github.com/ramensoftware/windhawk-mods/issues/new?title=%5BMac%20Island%20%26%20Dock%5D%20\u0026body=Mod%20author%3A%20%40cesarkali%0A%0A) Â· Instagram [@cesar.kali](https://www.instagram.com/cesar.kali) Â·\n[caliberda.com.br](https://caliberda.com.br) Â· every option explained:\n[island.caliberda.com.br](https://island.caliberda.com.br)\n\nThe top of macOS and the iPhone\u0027s Dynamic Island on Windows 11: an island at\nthe top of the screen with the clock, a control center, your notifications\nand what\u0027s playing, and, if you want it, a dock like the one on macOS\ninstead of the taskbar.\n\n![The island opening from its line, a timer going, the media panel and its mixer](https://i.imgur.com/xE1UHrb.gif)\n\n## What it does\n\n| | |\n| :--- | :---: |\n| **The island**: always at the top, as a pill, notches like a MacBook\u0027s, or a full bar like macOS\u0027. It minimizes to a thin line and comes back when the mouse reaches it. | ![The styles](https://i.imgur.com/pCMrBuM.gif) |\n| **Notifications**: new ones drop out of the pill (answer messages right there), apps with unread ones show on it with their count, and the bell keeps the list. | ![A notification in the pill](https://i.imgur.com/e1psOKQ.gif) |\n| **Control center**: Wi-Fi, Bluetooth, the sound of each app, brightness, \"Do not disturb\", night light and more, like on macOS; edit it like on the iPhone. | ![The control center](https://i.imgur.com/a63MaEx.gif) |\n| **Everything else on the pill**, each one optional: what\u0027s playing, a calendar with your agendas, the weather, notes, tasks, folders, wallpapers, the computer\u0027s usage, updates, virtual desktops, the keyboard\u0027s language, privacy indicators, komorebi... | ![Some of the panels](https://i.imgur.com/Q7a2g94.png) |\n| **The dock** (optional): a dock like macOS\u0027 instead of the taskbar, or the Windows taskbar made transparent with only its apps. | ![The dock](https://i.imgur.com/bKiXvzS.gif) |\n| **Make it yours**: colors (your own, or the app in front\u0027s), glass, sizes, a place and icons per app, profiles, one island on each monitor. | ![Colors](https://i.imgur.com/GJdJDI8.png) |\n\n## Getting started\n\n1. Install it: the island shows at the top of the screen.\n2. Right-click the island and click the gear under it: all its options are\n   there.\n3. **Arrange the pill**: in the settings, drag the icons in the island\u0027s\n   preview at the top of the tabs to change their order on the pill (with\n   notches, drag one to another notch). The island changes as you drag. On\n   the island itself, hold Ctrl and drag an item.\n4. This page\u0027s \"Settings\" tab chooses the taskbar: the dock (Windows 11\n   only), the transparent one, or Windows\u0027 own.\n\nEverything the mod does, in detail, is below.\n\n## What\u0027s new in 3.1.1\n\n**Fixes**\n\n* The island no longer crashes inside Windows\u0027 media controls while a\n  browser\u0027s videos (like YouTube in Chrome) or media apps keep changing, and\n  if the island ever crashes, it starts again by itself.\n* With the Fixed style\u0027s notches minimized, a notification\u0027s app icon peeks\n  out only of the notch with the bell, not out of every notch, and no longer\n  for the app you\u0027re using.\n* A click on a notification opens its app when the app\u0027s own notification\n  handler doesn\u0027t answer, instead of doing nothing.\n* An app\u0027s own counter on its taskbar button (like WhatsApp\u0027s) no longer\n  keeps its icon on the island as a waiting notification while the list is\n  empty: it counts as seen when the app comes to the front or its icon is\n  clicked, and shows again when the number grows.\n* Sleep in the power button\u0027s menu no longer hibernates PCs with Modern\n  Standby: like Start \u003e Sleep, it turns the screen off and lets the PC go to\n  sleep.\n* QQ\u0027s and WeChat\u0027s message preview shows again when hovering their icon in\n  the taskbar\u0027s tray with tray icons on the island (#7157).\n* The settings window takes much less of the processor in its first\n  seconds: the preview\u0027s hint, the \"+ Line\" glow and the other hints that\n  only fade or pulse draw at most 30 times a second instead of at the\n  monitor\u0027s rate.\n* Dock: games\u0027 icons (like Steam\u0027s) and other apps without an icon of their\n  own in the Start menu no longer go empty when Windows\u0027 icon cache is out of\n  date, nor show a small icon magnified (#7207).\n* Right after a Windows update, before Microsoft publishes the files Windhawk\n  needs to change the taskbar, the island no longer loses its tray icons: for\n  those days the taskbar just stays as Windows draws it (a notice on the\n  island says why), and the dock comes back at the next sign-in after they\u0027re\n  out.\n* The island and its settings no longer freeze for a moment every few\n  seconds when apps are chosen for the visualizer, more so with several\n  monitors or notches.\n\n## What\u0027s new in 3.1\n\n**New**\n\n* Hold Ctrl and drag an item on the island to another place or notch (an\n  idea of Thiago Silva\u0027s); the settings\u0027 preview shows how its icons are\n  dragged.\n* Panels can open when the mouse rests on their item, and files, folders or\n  links dropped on the pill become your commands (#6654).\n* Your own fonts for the island and its clock (#6648, #6609); the calendar\u0027s\n  clock and date centered, and its events area can be turned off (#6609).\n* The Bar\u0027s items at its left, middle or right (#6922), or kept on their\n  side of the clock (#6639).\n* The visualizer only for the apps you choose, with its bars\u0027 height, width\n  and spacing (#6204, #6924); seven bars, the sound going out from the\n  middle one.\n* An empty notch can disappear (#6651); a ring along the edge can show the\n  battery\u0027s charge (#6071).\n* Lyrics as one icon (#6684); what\u0027s playing can stay with nothing playing\n  (#6905); its buttons can be only play and pause (#6907).\n* Touch keyboard (#6160), Windows Settings and Win+X (#6922) buttons;\n  Hibernate in the power menu (#6886), each power action optional (#6609).\n* The network\u0027s speed opens its download and upload graphs (#6932); long\n  notifications scroll on one line (#6200); the see-through bar only on the\n  desktop (#7005).\n* Hiding: the clock pill against the screen\u0027s edge (#6997), the minimize\n  arrow keeps the island open (#6725), the edge zone as wide as the pill\n  (#6525), a shortcut lets clicks through the pill (#6718), and the island\n  can stay over borderless full-screen apps (#6740).\n* An apps launcher on the pill: all your apps (the Store\u0027s too) with a\n  search box and your favorites first (#7058).\n* The What\u0027s playing panel in other looks (Pixel, One UI, Windows 11, only\n  the cover) and bigger (#7042, #7041); the pill can show only the cover\n  (#7038), and the minimized line a thin pill with the cover and the bars\n  while music plays (#7045).\n* One switch for each status notice (#7091), a notice when you switch\n  desktops (#7014), the bell can open Windows\u0027 notification center and the\n  world clocks stay inside the clock (#7089); desktops renamed with a\n  pencil.\n* Separator lines on the pill, and an optional one in the dock between the\n  pinned apps and the others; a hex box in the color dialog; weather icons\n  from the icon pack, Meteocons or Weather Icons.\n* A keyboard shortcut for each of your commands (#6165); VLC 3 from its\n  window\u0027s title (#6164); the Fixed style and the Bar with their own icons\n  per app (#6162).\n* Long titles and artists scroll in the What\u0027s playing panel; the panels\u0027\n  scroll bars can be dragged by their thumb, and a click beside it moves a\n  page.\n* \"Light and shadow like macOS 27\": thin sliders, a white circle on the\n  buttons that are on, and a long pill\u0027s ends fading into the Liquid Glass\n  (by Thiago Silva). Vietnamese texts reviewed by caotu2k5.\n\n**Fixes**\n\n* The Bar flickering at the screen\u0027s corners with apps that round them\n  (#6954).\n* Lyrics for songs whose artist reads \"Artist - Topic\" or \"Artist â€¢ Album\"\n  (#6612).\n* External monitors\u0027 brightness (DDC/CI) turned off, with a notice, after\n  Windows stopped in the middle of a call to a monitor (#6966).\n* On Insider builds with Windows\u0027 newer taskbar, the taskbar left as Windows\n  draws it (#6888).\n* .ics events in a time zone of their own at your local time (#7020); Apple\n  Music once in the mixer (#7043).\n* The Recycle Bin counted again when Windows wasn\u0027t ready for it (#7048);\n  the charging battery between 85% and 94% (#6922).\n* The Wi-Fi\u0027s name read only when connecting, so Windows\u0027 location icon\n  doesn\u0027t stay on.\n* Sharp dock icons with \"Disable grouping on the taskbar\" (#7029); two\n  Chrome tabs in the media panel, each with its title.\n* A dock icon showing the app that closed just before (the Riot Client\n  showed FileZilla\u0027s).\n* The \"Taskbar\" setting says the dock is for Windows 11 only (#7059); panels\n  too tall for a short screen scroll (#7046).\n* The \"Do not disturb\" notice only when you switch it, not each time Windows\n  turns it on for a full-screen app (#7091).\n* Tray icons clicked again with UAC off or on the Administrator account\n  (#7092).\n* The dock\u0027s count bubble in the color of the app\u0027s own badge (#7095).\n* Apps like Medal stay in the tray: their icon has a place on the island\n  right after it\u0027s added (#7106).\n* The line being sung no longer shows twice (#7105).\n* A little more room above the dock\u0027s icons (#7103).\n* Calendar reminders no longer lost behind the list, another notice or a\n  panel, and shown once as missed after the PC slept through them (#6156).\n* A monitor\u0027s profile switched starts and stops what its island shows; a\n  paused download no longer redrawn on every frame; external monitors\u0027\n  brightness no longer turned off by mistake after a shutdown.\n\n**In pictures**\n\nThe apps launcher, with its search and favorites:\n\n![The apps launcher](https://i.imgur.com/6nUOqp0.png)\n\nThe media panel\u0027s looks: the usual one, Pixel, One UI, Windows 11 and only\nthe cover; Pixel\u0027s wavy line moves while the song plays:\n\n![The media panel\u0027s five looks](https://i.imgur.com/LDoIEUr.png)\n\n![Pixel\u0027s wavy line](https://i.imgur.com/E7Hcoch.gif)\n\nOnly the cover on the pill, and what\u0027s playing on the minimized line:\n\n![Only the cover on the pill, and the minimized line with the music](https://i.imgur.com/jbcNHUP.png)\n\nSeparator lines on the pill, added with \"+ Line\" in the settings\u0027 strip:\n\n![Separator lines on the pill and the + Line chip](https://i.imgur.com/UP0kme3.png)\n\nThe dock\u0027s line between the pinned apps and the open ones:\n\n![The dock\u0027s line between pinned and open apps](https://i.imgur.com/7a6qJnD.png)\n\nEvery version\u0027s changes are in the island\u0027s settings, on the What\u0027s new\ntab.\n\n## The island in detail\n\n### On the pill\n\n* **Styles**: a black pill at the top center; the Fixed style, which keeps\n  its room so maximized windows stop beside it; a full-width bar like the\n  macOS menu bar (or on the left or right side, its items one under the\n  other, with rounded inner corners, #6479); or notches like a MacBook\u0027s (in the middle, at the corners,\n  or three), with rounder or flatter curves, in the Fixed style or in the\n  Island style without keeping a strip (each style keeps its own choice,\n  #6485). Each item goes in the notch it\u0027s dragged to, and an empty notch\n  stays small, or can disappear, the bell\u0027s too (an option, #6651): it comes\n  back when an item or a notification comes to it, and while items are\n  dragged between the notches in the settings.\n* **Minimized** to a thin line (also at the bottom, or upright on a side), it\n  comes back when the mouse reaches it; notches hide together or each on its\n  own. It steps aside in full screen and as a screenshot\u0027s selection starts.\n  Hiding by itself, it can wait for a window instead of the mouse leaving\n  (an option, Island style): a line only while a window is maximized or over\n  it, back once it\u0027s gone. For OLED screens, the line can fade away after a\n  while (an option) and come back when the mouse reaches it. It can open\n  with a click instead (an option): the line then only grows under the\n  mouse. While a timer, Pomodoro or the stopwatch runs, the line is a small\n  pill with its ring and time (an option, on at first).\n* **Volume**: the wheel changes it, Shift+wheel picks another output device.\n  The middle button mutes the volume or the microphone, or switches \"Do not\n  disturb\" on the bell (a moon while it\u0027s on); the bell\u0027s right click opens\n  the notifications with their switches.\n* **More items**, each optional (off by default):\n  * the processor, memory and video memory use (a click shows graphs);\n  * a microphone mute button (it also turns the level to 0 for apps that\n    record a muted microphone, back when unmuted);\n  * the screen\u0027s brightness (the wheel changes it);\n  * the keyboard\u0027s language and input mode (ä¸­ or è‹±, ã‚ or A, ê°€ or A, or\n    PT...; a click switches keyboards, a bubble shows a change while the\n    pill is minimized), and a bubble when Caps Lock is turned on or off;\n  * the microphone, camera and location in use (colored icons; the apps\u0027\n    names under the mouse);\n  * USB drives (on by default: open or eject them, and a notice when one is\n    plugged in);\n  * the Recycle Bin (how many items; open it, or empty it with a second\n    click; always, or only once what\u0027s in it weighs 100 MB, 500 MB, 1 GB or\n    5 GB, coming and going by itself);\n  * a timer, a stopwatch (with hundredths) and Pomodoro, each on its own (all\n    three can run at once), like the macOS Clock app: the lengths in hours,\n    minutes and seconds on wheels (the mouse wheel, a drag, or typed), a ring\n    while it runs, Pomodoro\u0027s focus and break chosen too (25 and 5 minutes\n    at first); the pill shows the one ending first, a notice when each ends;\n    and alarms (a time on wheels, an optional name and the days it rings:\n    every day, weekdays, weekends, any days, or once, turning itself off\n    after ringing; each on or off, with or without a sound);\n  * an audio visualizer (bars pulsing with the beat of the playing app\u0027s\n    own sound, or any sound, like VLC\u0027s, only while something plays, with\n    its sensitivity and color: the icons\u0027, Windows\u0027 accent, a rainbow or\n    your own);\n  * song lyrics (an option, off by default, goes online: each song\u0027s title\n    and artist are sent to lrclib.net): the line sung now on the pill, in\n    time with the song (placed anywhere in the order, its size, color and\n    longest line chosen, the next line coming up as the one before goes; or\n    in the song title\u0027s place while a line is sung, the title back between\n    lines), and all of them in its panel (the line now lit and kept in the\n    middle, a line clicked goes there in the song); only for songs (with an\n    artist, 45 s to 20 min when the app tells the length, not videos or\n    voice messages), and not for the apps turned off under \"Apps that look\n    for lyrics\";\n  * AI usage (an option, off by default, never online): how much of Claude\n    Code\u0027s and Codex\u0027s limits is used, the one closer to its end on the pill\n    with the time until it starts over (yellow from 70%, red from 90%), and\n    both the 5-hour session and the week in its panel. It reads only what\n    the agents keep on this PC, never their logins: Codex\u0027s own logs, and\n    for Claude Code in a terminal (Pro and Max plans) what it gives its\n    [status line](https://code.claude.com/docs/en/statusline), saved by a\n    line you add to its script (the panel copies it; see Technical notes). The\n    Claude desktop app doesn\u0027t leave\n    its limits on this PC, so its use doesn\u0027t show;\n  * your commands: shortcuts you add to programs, files, folders, links or\n    command lines (a command line runs in its own hidden job; one that\n    fails shows a terminal), each with the icon of what it opens; they\u0027re\n    listed in their panel, and any of them can also be a button on the pill;\n  * the network\u0027s speed (up and down; a click shows its graphs of the last\n    minute, with a button to Task Manager, #6932), Windows\u0027 additional\n    clocks (other cities\u0027 times, shown as soon as they\u0027re added in Windows; a click opens\n    Windows\u0027 list of them) and the time until the next event, alarm, timer\n    or Pomodoro part (each can be left out; in the next 12 hours; a click\n    opens it);\n  * the pill filling like a loading bar (each an option, off by default, in\n    the Animations tab): with the progress apps show on their taskbar button\n    (downloads, copies, installs), and with the battery\u0027s charge while a\n    laptop charges; one bar across the notches (the whole bar in the Bar\n    style), with a solid line under it like the taskbar\u0027s; a color for each\n    kind (downloads and other apps, Windows\u0027 file copies, the battery): green,\n    blue, Windows\u0027 accent or your own (red for an error, yellow paused); it\n    moves simply, as a liquid wave with bubbles or as a glow with particles;\n    paused it breathes, an error shakes, done flashes with a check, canceled\n    drains back; a browser\u0027s download standing still for 30 s shows paused\n    (browsers never tell the taskbar);\n  * a ring along the edge with the battery\u0027s charge (an option, off by\n    default, in the Animations tab, #6071): on the battery\u0027s notch or the\n    pill, or on every notch; green above 40%, yellow down to 20%, red below;\n    not as the line, nor on the Bar style;\n  * the virtual desktops (a dot each; the wheel switches, a click lists them\n    with a new one and an \"x\" to close);\n  * the app in focus on that monitor (with its window\u0027s title too, if\n    chosen), light and dark mode, the profiles and a power button;\n  * notes (with topics), tasks (the last ten done kept), and keyboard\n    shortcuts to remember (recorded, or imported from komorebi\u0027s whkdrc);\n  * the weather, updates, folders and places, wallpapers and komorebi (see\n    the panels below);\n  * the control center\u0027s buttons (night light, the hotspot and airplane mode\n    switch right there; Wi-Fi, Bluetooth, projecting and accessibility open\n    their list under them; the others are shortcuts). The other way around\n    too: every pill item that opens something (the calendar, notifications,\n    what\u0027s playing, the power button, folders, the timer...) can be a\n    control center button, added with Edit.\n* Every icon shows its name under the mouse (the tips can be turned off), and\n  the item under the mouse gets a gray highlight (can be turned off too).\n\n### Notifications\n\n* **Apps with unread notifications** show on the pill with their count (from\n  Windows\u0027 notification center or the taskbar button, also with the taskbar\n  hidden), and the bell gets a red dot until the list is opened; the Widgets\n  button\u0027s news too. Ones that came while the island wasn\u0027t running show as\n  it starts.\n* A click opens the app at its latest notification (an app hidden in the\n  tray, through its tray icon); one with nothing to open shows the list.\n  Opening the app in any way, or the app clearing them in Windows, clears\n  them on the island. Apps that send under several names (Phone Link\u0027s phone\n  apps) show as one icon (an option, on by default).\n* **New ones drop out of the pill** for a few seconds (not with \"Do not\n  disturb\"), with the sender\u0027s picture when there\u0027s one. Messages can be\n  answered right there in apps that offer it (Shift+Enter for a new line);\n  a long one shows on up to three lines under the mouse; its \"x\" deletes\n  it, its arrow ignores the app for a minute. With the bar style, it drops\n  from the bar\u0027s middle. They can also come at a point of the screen you\n  choose instead (one of nine: the corners, the edges\u0027 middles or the\n  center), sliding in from its edge; their size (50% to 200%), width and\n  corners are settings too. A long text can stay on one line and scroll\n  under the mouse (an option, #6200).\n* **The list** (the bell): up to half of the screen, scrolling smoothly;\n  clear one or all (Windows\u0027 center too); its gear has \"Do not disturb\",\n  the banners in the pill and showing what they say. In \"Do not disturb\",\n  calls, alarms and reminders still ring, or stay silent too (an option).\n* Chat apps that only blink their tray icon (the Chinese WeChat, WeCom,\n  DingTalk) show on the pill with their dot when it starts blinking.\n* Status notices from the pill (an option): the charger plugged in, the\n  battery under 20% and 10%, a Bluetooth audio device connected, \"Do not\n  disturb\" turned on or off.\n* Optional: what\u0027s copied in a bubble under the pill (not password\n  managers\u0027, nothing kept); Win+N and Win+A opening the island\u0027s\n  notifications and control center, Win+J (or keys you record in the\n  settings) minimizing it to its line and back (the Bar style hides\n  altogether); the Snipping Tool\u0027s\n  notification\n  showing the screenshot in Explorer.\n\n### Panels\n\nEach one grows out from behind the pill, under the item clicked, with a\nlittle bounce.\n\n* **Control center** (its own icon), like on macOS: Wi-Fi (the networks,\n  connecting with a password, Windows\u0027 reason when it fails, forgetting one;\n  the cable\u0027s state and speed), Bluetooth (the paired devices; a click\n  connects headphones and speakers), \"Do not disturb\", night light, project,\n  cast, live captions, accessibility (the magnifier, the narrator and the\n  on-screen keyboard started from a button, color filters, sticky keys),\n  brightness (a laptop\u0027s screen and monitors with DDC/CI, a slider each; on\n  an HDR monitor, Windows\u0027 brightness of SDR content, set with an\n  undocumented Windows call, the one Twinkle Tray uses, that is checked and\n  given up on if it fails; DDC/CI can be turned\n  off for monitors or docks that flicker), the volume, the output device and each app\u0027s volume (with its\n  percentage), the battery, the mobile hotspot (its name and password\n  changed right there) and airplane mode. A page\n  opened alone from its icon on the pill has an arrow back to the whole\n  control center. \"Edit\" chooses and orders\n  its controls like on the iPhone, with shortcuts (dark mode, screenshot,\n  lock, emoji, the clipboard, Task Manager, Calculator, File Explorer, show\n  desktop, the on-screen keyboard, the touch keyboard, Windows Settings, the\n  Win+X menu).\n* **Sound**, **battery** (with the power plan and modes) and **brightness**:\n  only that, like on macOS.\n* **Calendar** (the clock): your events, with reminders in the pill; the\n  holidays of Windows\u0027 country (optional); .ics agendas (a link, like Google\n  Calendar\u0027s secret iCal address, or a file), read only, each in its color,\n  with the next events under the month; today\u0027s color; your past events\n  hidden after a day, a week or 30 days, their count (up to 200) and\n  deleting them. Or as a card (an option): the chosen day big beside the\n  month, buttons for an alarm, a timer and your agendas, that day\u0027s events,\n  and the upcoming events and holidays. An event\u0027s reminder says what it\n  does in the editor.\n* **What\u0027s playing** (the note): the cover, the song, a timeline,\n  previous/play/next, the output\u0027s volume and a mixer for every app with an\n  audio session there (including apps without media controls). Click an app\u0027s\n  icon to mute it. The player also keeps the playing app\u0027s own volume;\n  the device volume and Windows mixer button sit below it. The mixer\u0027s\n  arrow expands its app list, collapsed each time the panel opens.\n  The buttons and the cover with the title can sit on the pill (its width chosen, scrolling\n  while it plays if chosen); with several apps playing, chips with their\n  icons pick one (\"Automatic\" follows Windows), Shift+wheel on the pill too.\n  A click on the cover brings the app to the front, and the whole title and\n  the artist show under the mouse. The song and source chips need Windows\n  media controls; apps without them (like VLC 3) still appear in the mixer.\n* **Folders and places**: folders you pin and Windows\u0027 places (This PC, the\n  Recycle Bin, Settings pages...), browsed in columns like the Finder; a\n  search (a name or *.pdf), sorted as in Explorer (by name, date modified,\n  type or size, either way, the date, type or size shown), only one kind of\n  file shown (pictures, videos, documents...) or folders mixed with the\n  files, \"Open in Explorer\"; files dragged out (copied or moved, asked once)\n  or onto a folder, a file or its path copied from its row; Windows\u0027 places\n  opened with a click (their pin pins them); each pin with its own icon and\n  color (on the island only); files starred as favorites, with the pins\n  (copy the file or its path from there; one moved or deleted leaves the\n  list, one on a drive taken out comes back with it). Pictures, videos and\n  documents show thumbnails, and a bigger preview when the mouse rests on\n  one (an option, on by default).\n* **The shelf** (an option): files dropped anywhere on the pill (but on\n  the folders\u0027 item) wait there, the newest first, 5 to 30 of them (10 by\n  default, the oldest going); its item shows how many, and its panel\n  their thumbnails, to drag them into another app (copied or moved as\n  chosen for the folders panel), open them or take them off. Only their\n  places are kept, not copies.\n* **Wallpapers** from a folder you pick: thumbnails, a transition (fade,\n  circle, slide or zoom), on that monitor; the wheel on the item goes to the\n  next one.\n* **komorebi** (if installed): start, stop and reload (with whkd and masir if\n  chosen; a terminal shows what failed; nothing is installed for you, and the\n  mod never ends komorebi by itself), and its layout on the pill after a\n  dot per workspace, whose menu has the layouts (columns, rows, grid, BSP,\n  the stacks, scrolling), tiling, monocle and pause, like yasb\u0027s.\n* **Weather** (now, the next hours and the week, for a city you type, or\n  your location with \"Use my location\", asked by Windows\u0027 own permission; in\n  Â°C or Â°F, or as Windows\u0027 measurement system says; its details as cards,\n  like a phone\u0027s, if chosen) and **updates** (apps with a newer version in winget, updated in a terminal:\n  one, the ones ticked or all, an app can be ignored; and Windows updates\n  waiting; checked every 1 to 24 hours).\n* **Power**: sleep, restart, shut down (these two ask first), lock and sign\n  out, like the macOS Apple menu.\n\n### Tray icons\n\n* The other apps\u0027 tray icons: the pinned ones on the pill, the others opening\n  sideways from \"â‹¯\", or in a list under the pill (a grid like Windows\u0027, or\n  with their names). Clicks work like on the taskbar, and their names show\n  under them.\n* Pin one with a middle click, or the pin that shows after two seconds;\n  drag them to reorder, anywhere on the pill (every style and notch), or\n  between the list and the pill. Each island (or its profile) keeps its own.\n* A long list shows twelve at a time (an option) and scrolls with the wheel.\n\n### Look, place and monitors\n\n* **Colors**: black, graphite, light, Windows\u0027 accent color, glass, black or\n  light following Windows\u0027 mode (or the other way around), your own (fill,\n  texts, icons; a warning when they\u0027re hard to read), or the colors of the\n  app in front; the opacity; **glass** (Windows\u0027 blur on the island in every\n  style and on the panels; with Windows\u0027 transparency effects on, a plain\n  color otherwise or with the energy saver), translucent (a lighter tint\n  and livelier colors) or not, and blurred more than Windows\u0027 own if you\n  like; and frosted glass on the bar and the Fixed style\u0027s strip. The bar\n  can also be see-through: only its items, or only the blur with the frosted\n  glass (#6109).\n* **Sizes**: the island, its icons and its texts (each on its own: smaller\n  icons with the clock and percentages as they are), the pill\u0027s height,\n  corners and the room at its ends, and the panels (100% to 150%).\n* **Icons** (a tab of their own): every icon the island draws, about 200\n  in groups, each shown as it is now; a click gives one a picture of your\n  own (PNG, SVG, ICO, JPG...), its brush a color of its own, its \"x\" gives\n  the pack\u0027s back. The pack, from a list: Windows\u0027 (Windows 11\u0027s), Windows\n  10\u0027s, emoji (Segoe UI Emoji, in the island\u0027s colors or their own), nine\n  free online packs downloaded once when chosen (**Fluent** by Microsoft,\n  **Ionicons** like the iPhone\u0027s, **Lucide**, **Tabler**, **Phosphor**,\n  **Material** by Google, **Bootstrap**, **Iconoir** and **Heroicons**; the\n  row fills as one downloads, and a downloaded one\u0027s bin deletes it), or\n  your folder: a picture per icon named after it, like `wifi.png` or\n  `battery-5.svg` (or by its\n  code in Segoe Fluent Icons, like `E713.png`); **Save Windows\u0027 icons**\n  puts every icon in it, named, to change the ones you want, and a change\n  shows a moment later. An icon a pack hasn\u0027t stays Windows\u0027. Per profile,\n  so each monitor can have its own.\n* **Place**: anywhere on the screen (or drag the pill, which snaps to the\n  edges and corners); a place, icons and a clock of their own for some apps\n  (the pill style); on the lower half its panels open upwards, and upright\n  on the left and right edges.\n* **Monitors**: the main one, another one, the one with the mouse, or all of\n  them (each with the main island\u0027s settings or a profile of its own);\n  moving to another monitor, it glides there.\n* **Profiles** (up to 10; a pill button switches them; each can turn on by\n  itself with an app in front or a style chosen, #6166), **backup** (export\n  and import, and Reset to put the settings back as they came), and the\n  **language** (English, Portuguese, Chinese, German,\n  Spanish, Russian, Japanese, Vietnamese, or Windows\u0027; Windhawk\u0027s settings\n  too).\n* **Animations**: springs everywhere; for slower computers, only the\n  essential ones or none, their speed, and about 90, 60 or 30 frames a\n  second.\n\n### The island\u0027s settings\n\nRight-click the island and click the gear under it (with the bar, the right\nclick opens them), or the gear in the control center. They open in a window\nof their own, like Windows\u0027 Settings (resizable, in the island\u0027s colors,\nover Mica on Windows 11): a side bar with the search and a tab for each\nsubject (General, Place, Look, Icons, Animations, Pill, System, Desktop,\nApps and tools, Tray icons, What\u0027s playing, Clock and calendar, Notifications,\nMonitors with two screens or more, then Dock, About and Logs), and each\noption on a card with a line saying what it does. The island\u0027s preview\nstays at the top of the tabs that change it: its items in their order,\ndragged to move them. A dimmed option says why under its name; a click on\nthat line shows everything it needs, and \"Yes, change\" turns it all on at\nonce (\"Restore what changed\" puts it back). Logs copies or saves (to a\nfile you pick) a summary of the PC, the island\u0027s settings and its last\n300 log lines, without turning on Windhawk\u0027s logs. Windhawk\u0027s settings turn\nthe island on and set up the taskbar, the dock and its animations.\n\n| Section | What it sets |\n| :--- | :--- |\n| Profiles | Up to 10 sets of the island\u0027s settings: \"+\" saves the current ones, a click applies one, the one in use keeps every change; a pill button switches them (Shift+wheel); a profile\u0027s pencil makes it turn on by itself with some apps in front or with a style chosen (and, after its app, go back to the one before or stay). Notifications, notes and tasks aren\u0027t in them. |\n| Backup | Export or import a file with notes, tasks, shortcuts, your commands, events, the agendas\u0027 links (keep it private), pinned folders, the wallpapers\u0027 folder, profiles and settings. They\u0027re kept by Windhawk on this computer, for every account on it. Reset (a double click) puts the island\u0027s settings back as they came; notes, tasks, events and profiles stay. |\n| Language | English, Portuguese, Chinese (Simplified), German, Spanish, Russian, Japanese, Vietnamese, or Windows\u0027 display language; the dates follow it. |\n| Style | Island, Fixed or Bar, and what only that style has: the notches (none, middle, corners or three, for each style; their curves; hiding each on its own; hiding an empty one; which notch\u0027s line opens the island), dragging the pill, upright on the sides. |\n| Place | Where it sits (per monitor), a place and icons per app (pill style), the distance from the edges. |\n| Hiding | Hiding as a line after a time, or only while a window is maximized or over it, or as only the clock (also the Bar hidden with Win+J); a timer going on the line; the line\u0027s opacity, fading away after a while for OLED screens, opening it with the mouse or a click, and how long the area that brings it back is; the minimize arrow; Win+J (its keys recorded by a click). |\n| Look | The colors (your own with Windows\u0027 color dialog), the opacity, glass (translucent, its blur, light and shadow like macOS 27) and frosted glass, a see-through bar, colors following the app in front, the size, the icons\u0027 size, the texts\u0027 size, the pill\u0027s height, corners and the room at its ends, the edge around the island, its panels and bubbles (0% for none), the panels\u0027 size, panels as wide as the island; the Bar style\u0027s side (top, left or right) and inner corners, drawn, and its items at the screen\u0027s corners; the hover highlight and the tips. |\n| Icons | The pack (a list: Windows, Windows 10, emoji, nine online ones or your folder), the emojis\u0027 and your pictures\u0027 colors, your folder (choose it, open it, save Windows\u0027 icons into it), and every icon in groups, each with a picture or a color of its own if you like. |\n| Animations | On or off, all, partial or none, the speed and the frames a second (the dock\u0027s are in Windhawk\u0027s settings); the pill filling and the battery\u0027s ring. |\n| System | Its items (see above), and the pill as a loading bar: downloads (a browser\u0027s still one shown paused), file copies and the battery charging, their colors and how it moves. |\n| Control center | Its buttons on the pill: night light, Wi-Fi, Bluetooth, hotspot, airplane mode, project, cast, captions, accessibility, screenshot, lock, emoji, clipboard, Task Manager, Calculator, File Explorer, show desktop, the on-screen keyboard, the touch keyboard, Windows Settings, the Win+X menu and komorebi, each in its own place; komorebi\u0027s layout; external monitors\u0027 brightness over DDC/CI. |\n| Tray icons and media | Where the icons not pinned open (sideways, a grid or a list with names), how many show and the grid\u0027s columns; what\u0027s playing\u0027s note, buttons, cover and title on the pill, the wheel changing the song, the title\u0027s width and scrolling. |\n| Clock | The time (off: only the date), kept in the middle with the other items around it, 24 or 12 hours (a small AM/PM), seconds, the day of the week, the date and its order, the year, the month as a number, the holidays, world clocks, the time until the next event. The date follows Windows\u0027 regional format, in the island\u0027s language when one is chosen. |\n| Notifications | \"The island handles notifications and their sounds\" (see Good to know), calls, alarms and reminders silent in \"Do not disturb\", Win+N and Win+A, the apps\u0027 icons on the pill and one icon per app, the apps folded into an arrow, what\u0027s copied, and the Snipping Tool\u0027s screenshots in Explorer. |\n| Banners | Banners in the pill (also minimized) or at one of nine points of the screen (picked on a little screen), their size, width and corners (drawn), long texts scrolling under the mouse, hiding Windows\u0027 banners, pictures from the web, the Caps Lock notice and the status notices. |\n| Monitors (2+ screens) | One monitor, all of them or the one with the mouse, on a map of the real layout; the main island (tray, sounds and Windows\u0027 banners); which islands show the notifications (the main one by default; calls, alarms and reminders always on it); each other screen \"Same as the main one\" or a profile; notification options are the main island\u0027s. |\n\n### Screenshots\n\n| The calendar | What\u0027s playing | Notifications |\n| :---: | :---: | :---: |\n| ![The calendar](https://i.imgur.com/IU85vJ4.png) | ![What\u0027s playing](https://i.imgur.com/wzCKwo3.png) | ![Notifications](https://i.imgur.com/nmcC43L.png) |\n| **The weather** | **Notes** | **Tasks** |\n| ![The weather](https://i.imgur.com/5fxH29Y.png) | ![Notes](https://i.imgur.com/Qj0NbXp.png) | ![Tasks](https://i.imgur.com/29Jdwf7.png) |\n| **Updates** | **The processor\u0027s use** | **Power** |\n| ![Updates](https://i.imgur.com/sL5ksJc.png) | ![The processor\u0027s use](https://i.imgur.com/Vl5mLv0.png) | ![Power](https://i.imgur.com/lvMsIua.png) |\n\n| The island\u0027s settings | Keyboard shortcuts |\n| :---: | :---: |\n| ![The island\u0027s settings](https://i.imgur.com/5owFniD.png) | ![Keyboard shortcuts](https://i.imgur.com/q75V4Sm.png) |\n\nThe control center and the Recycle Bin, and the island\u0027s settings, tab by tab:\n\n| The control center | The Recycle Bin |\n| :---: | :---: |\n| ![The control center](https://i.imgur.com/e2VBmC6.png) | ![The Recycle Bin](https://i.imgur.com/j7dcxSC.png) |\n\n| Style | Look | Icons |\n| :---: | :---: | :---: |\n| ![Style](https://i.imgur.com/5owFniD.png) | ![Look](https://i.imgur.com/Jb3ffUf.png) | ![Icons](https://i.imgur.com/vvGbTS3.png) |\n| **Apps and tools** | **Notifications** | **What\u0027s new** |\n| ![Apps and tools](https://i.imgur.com/J6PisdP.png) | ![Notifications](https://i.imgur.com/d1NO2NF.png) | ![What\u0027s new](https://i.imgur.com/rEohAVU.png) |\n\nThe other apps\u0027 tray icons: their list open, and opening:\n\n![The tray icons\u0027 list open](https://i.imgur.com/Xt2pVE9.png)\n\n![The tray icons\u0027 list opening](https://i.imgur.com/ulHZh2A.gif)\n\nOr as a grid under the pill:\n\n![The tray icons as a grid under the pill](https://i.imgur.com/KbdLN4p.png)\n\nThe styles: the pill, the Fixed style (the pill keeping its room, so\nmaximized windows stop beside it) and the bar, at the top of the screen:\n\n![The pill](https://i.imgur.com/9eLqY38.png)\n\n![The Fixed style](https://i.imgur.com/hndh6lx.png)\n\n![The bar style](https://i.imgur.com/EkIJ4Zl.png)\n\nThe Fixed style\u0027s notches: three, three with the curves at 200%, at the\ncorners, and one in the middle; a notification coming out of the notch with\nthe bell; and the notches hiding together as one line:\n\n![Three notches](https://i.imgur.com/iJUrPeu.png)\n\n![Three notches, curves at 200%](https://i.imgur.com/YBNVGef.png)\n\n![Notches at the corners](https://i.imgur.com/oglSDoR.png)\n\n![One notch in the middle](https://i.imgur.com/NxwTVFC.png)\n\n![A notification out of the notch with the bell](https://i.imgur.com/VaSHYWf.gif)\n\n![The notches hiding together as one line](https://i.imgur.com/w5CG2rN.gif)\n\n| Colors | |\n| :--- | :---: |\n| Black | ![Black](https://i.imgur.com/AQKn4nY.png) |\n| Graphite | ![Graphite](https://i.imgur.com/J7r7GeH.png) |\n| Light | ![Light](https://i.imgur.com/B6lsL49.png) |\n| The Windows accent color | ![Accent color](https://i.imgur.com/Ilr8YHB.png) |\n| Glass | ![Glass](https://i.imgur.com/kAsBeR8.png) |\n| The glass option (Windows\u0027 blur, any color) | ![The glass option](https://i.imgur.com/fbAnalU.png) |\n| Following Windows\u0027 mode (black in dark mode) | ![Auto](https://i.imgur.com/wNJKUiA.png) |\n| The other way around (light in dark mode) | ![Auto inverted](https://i.imgur.com/tMr0Hqo.png) |\n| Your own colors | ![Your own colors](https://i.imgur.com/27jYaq7.png) |\n\n## The dock in detail\n\nThe \"Taskbar\" setting (the Windows taskbar stays as it is by default) turns\nthe Windows taskbar into a dock like the one on macOS; or keeps the Windows\ntaskbar, transparent with only its apps (a soft shadow, the magnification and\nthe bounces; it only takes clicks around its apps), or as it is (all of it,\nor only its apps).\n\n![The transparent taskbar, with only its apps](https://i.imgur.com/z0FMhlK.gif)\n\n* **Compact and floating**: the app icons on a rounded shelf a little above\n  the bottom edge; the icons\u0027 size, the space between them, the gap at the\n  bottom, the corners and the background (a see-through tint with a thin\n  edge, or none) are settings.\n* **Magnification**: the icons grow in a wave that follows the mouse and\n  pushes their neighbors aside (a click always goes to the icon under the\n  mouse), sharp from the apps\u0027 own bigger pictures; the dock makes room above\n  itself, and the windows\u0027 previews open right above it.\n* **Bounces**: an app\u0027s icon bounces while it opens and when it needs\n  attention; after a click, the dock waits for the app before hiding.\n* **Attention while hidden**: only the app\u0027s icon peeks out from the bottom\n  edge and bounces (or the whole dock, or nothing).\n* **A line between the pinned apps and the open ones** (optional, 3.1): a\n  thin line like the macOS dock\u0027s, which follows the icons as they grow.\n* Apps grow in and the others slide over; dots under the open apps.\n* **Hidden until you need it** (optional): it shows when the mouse reaches\n  the bottom edge (or a height over it you choose, the same on every\n  monitor), not over full-screen games and videos. \"When it hides\" can keep\n  it up on the desktop and hide it only while a window is maximized, or is\n  over it, like the island (#6202, #6368).\n* **A width of its own** (optional, #6152): the dock stops at a width you\n  choose, and the other apps scroll with the mouse wheel, like a box.\n* The magnification, the bounces and \"When it hides\" work on the Windows\n  taskbar kept as it is with only its apps too (an option there, #6167).\n* Without the island, the clock and the tray stay at the dock\u0027s right end, in\n  their own pill (unless hidden in the settings).\n\n## Good to know\n\n* Made for Windows 11. On Windows 10, only the island works.\n* The dock needs the taskbar at the bottom: on another edge, the taskbar\n  stays as Windows has it, and the island stays clear of it.\n* Windows\u0027 newer taskbar on some Insider builds has none of the parts the\n  dock styles (#6888): the taskbar stays as Windows has it there.\n* The Win+X button presses those keys for you, and Windows drops them while\n  an app run as administrator is in front, unless Windhawk runs as\n  administrator too.\n* **With other taskbar mods**, choose \"Windows taskbar, unchanged\"\n  (optionally without its clock and tray) or \"only the apps\". Don\u0027t combine\n  the dock with mods that restyle the taskbar or its auto-hide (Windows 11\n  Taskbar Styler themes, Taskbar Auto-Hide Instant Show) or other dock mods;\n  for a transparent taskbar, use this mod\u0027s own option.\n* **Auto-hide**: hiding the taskbar turns on Windows\u0027 auto-hide while the mod\n  is on, and back off afterwards (also after a crash). If Explorer isn\u0027t\n  running when the mod is turned off, turn it off in Windows\u0027 settings.\n* **Windows\u0027 settings**: the control center changes them itself, like\n  Windows\u0027 quick settings (dark mode, night light, the power plan and mode,\n  the microphone\u0027s mute, the output device, Wi-Fi networks, accessibility,\n  the display mode, brightness, the radios), and a virtual desktop\u0027s name\n  given with the pencil in the desktops list; they stay as set.\n* **\"The island handles notifications and their sounds\"** (off by default):\n  Windows\u0027 \"Do not disturb\" stays on while the island runs (\"alarms only\"\n  while the island\u0027s own is on), so Windows stays quiet and the island shows\n  each notification and plays its sound as it comes; calls, alarms and\n  reminders show in the pill with their buttons and ring until closed. It\u0027s\n  turned back off when the island stops or the mod is turned off (also after\n  a crash or a shutdown), and left off if turned off from Windows.\n* **Windows\u0027 banners**: while the island shows a notification, Windows\u0027\n  banner is moved off the screen (an option); calls, alarms and reminders\n  keep it, and nothing changes in full screen.\n* **Over full-screen apps** (off by default): the island is put back on top\n  of borderless full-screen apps when one comes to the front. Games in\n  exclusive full screen still draw over it. A window over a game can cost a\n  little performance, and some games\u0027 anti-cheat may not like windows over\n  them: turn it on only where you need it.\n* **Online only when turned on** (all off by default): pictures from the web\n  in notifications (over https, only for apps allowed online), the weather\n  ([Open-Meteo](https://open-meteo.com), every 30 minutes while shown; with\n  \"Use my location\", Windows\u0027 location rounded to about a kilometer goes\n  there instead of a city), the\n  holidays ([Nager.Date](https://date.nager.at), once a year), song lyrics\n  ([LRCLIB](https://lrclib.net), once a song: its title and artist, only\n  for songs), the agendas\u0027\n  links (at most every 15 minutes), updates (winget, every few hours;\n  Windows updates are read offline) and the online icon packs (once,\n  when one is chosen: about 150 small SVG files from\n  [jsDelivr](https://www.jsdelivr.com)\u0027s CDN, a plain request for each,\n  kept in the mod\u0027s storage) and the weather\u0027s icons (the same way, about\n  a dozen files, when chosen for the weather). Updates run only when asked,\n  in a terminal, accepting nothing for you.\n* **Storage**: Windhawk keeps the settings, notes and the rest for the whole\n  computer (every Windows account sees the same ones; the alarms, the\n  timer\u0027s lengths, the folders\u0027 pins, favorites and order, the shelf\u0027s\n  files, the lyrics\u0027 and the visualizer\u0027s apps and your commands are each\n  account\u0027s own); export a backup before formatting.\n* **Two processes**: the island runs in a `windhawk.exe` process of its own,\n  so a problem in it can\u0027t take the taskbar down; the dock runs in\n  `explorer.exe`. If the graphics driver resets, the island starts again by\n  itself.\n* **Similar mods**: [Dynamic Island for\n  Windows](https://windhawk.net/mods/dynamic-island-for-windows) (a pill for\n  media, downloads and the clipboard), [Island Media\n  Controls](https://windhawk.net/mods/island-media-controls) (media controls\n  on the taskbar), [TopBar for Windows](https://windhawk.net/mods/windhawk-topbar)\n  (a top bar with flyouts) and [Taskbar Dock\n  Animation](https://windhawk.net/mods/taskbar-dock-animation) (magnified\n  taskbar icons). This mod brings the island and the dock together, as one\n  macOS-like top and bottom.\n\n## Not planned, and why\n\nSome ideas won\u0027t be in the mod, at least for now:\n\n* **The Liquid Glass lens, its edges bending what\u0027s behind** (#6105,\n  #6111): Windows\u0027 blur can\u0027t bend, so it doesn\u0027t show in screenshots or\n  recordings; doing it from a screen capture weighs on the GPU and froze\n  the island.\n* **The island as the whole taskbar** (#6330): it would need a taskbar of\n  its own (the windows\u0027 list, thumbnails, jump lists).\n* **Email on the island** (#6064, #6166): it would have to sign in to your\n  mailbox; mail apps already send Windows notifications, and the island\n  shows those.\n* **Deleting Windows\u0027 notifications one by one** (#6159): it needs the\n  app\u0027s package identity; the island only reads Windows\u0027 notifications.\n* **Drawing over games in exclusive full screen** (#6740): Windows doesn\u0027t\n  show other windows over them (borderless full screen works, see Good to know).\n* **A Stage Manager like macOS\u0027** (#6071, #6166): it would move and shrink\n  every app\u0027s window all the time.\n* **A widgets panel like macOS\u0027** (#6166): a second app inside the island;\n  its items and panels already cover most widgets.\n* **Drawing with DirectComposition** (#6166): a rewrite of how the whole\n  island is drawn.\n* **AI agents that need an API key or a cookie** (#6636): the mod doesn\u0027t\n  read other apps\u0027 logins or tokens.\n* **An app apart from Windhawk**: out of a mod\u0027s scope.\n* **The Bar at the bottom, around the dock** (#6655): the dock\u0027s width\n  changes all the time, so the two would fight for the same space.\n* **Blur on the empty parts between the notches** (#6795): Windows\u0027 blur\n  works on whole windows; it would take another window following every\n  notch.\n* **Arabic** (#6809): besides the texts, the whole island would have to be\n  mirrored right to left.\n* **Players that don\u0027t use Windows\u0027 media controls, like PotPlayer**\n  (#6835): reading them another way is code for one player that breaks\n  with its updates.\n* **New dock features** (#6065, #6202, #6794): the dock is Windows\u0027 own\n  taskbar changed from the inside, the part that breaks most with Windows\u0027\n  updates, so it stays as it is (fixes only). Mods made only for a dock\n  (MacOS Style Dock, DynamicDock, Taskbar Dock Animation, Windows 11\n  Taskbar Styler) work with the island: in the mod\u0027s settings, choose\n  \"Windows taskbar, unchanged (to use other taskbar mods)\".\n\n**Want to try one of the island\u0027s yourself?** You\u0027re welcome to: start\nfrom this mod\u0027s code (Windhawk, the mod\u0027s \"Source code\" tab), click\n**Create a New Mod**, paste it and change the `// @id` line (turn the\ninstalled mod off while you test), then open an issue titled\n`[Mac Island \u0026 Dock] ...` with your `.wh.cpp` in a .zip and what you\nchanged. If it gets in (it needs to pass this repository\u0027s review and keep\nthe island light), your name goes in the changelog, the What\u0027s new tab and\nthis README.\n\n## Contact\n\nI\u0027m **caliberda**, a developer from Brazil, and I keep working on this mod:\nnew versions bring fixes and what users ask for. Write in English,\nPortuguese or your own language.\n\n* **Bugs and ideas: only an issue on GitHub**: [report a\n  bug](https://github.com/ramensoftware/windhawk-mods/issues/new?labels=mod-bug\u0026title=%5BMac%20Island%20%26%20Dock%5D%20\u0026body=Mod%20author%3A%20%40cesarkali%0A%0A) or [suggest an\n  idea](https://github.com/ramensoftware/windhawk-mods/issues/new?labels=mod-enhancement\u0026title=%5BMac%20Island%20%26%20Dock%5D%20\u0026body=Mod%20author%3A%20%40cesarkali%0A%0A).\n  It mentions me (@cesarkali), so I see it, and GitHub tells you when the\n  version with the fix or the idea comes out. Bugs and ideas sent anywhere\n  else can\u0027t be followed there.\n* **Instagram [@cesar.kali](https://www.instagram.com/cesar.kali)**: to follow\n  my projects.\n* **[island.caliberda.com.br](https://island.caliberda.com.br)**: the mod\u0027s\n  site, every option explained step by step, the roadmap and your votes.\n* **[caliberda.com.br](https://caliberda.com.br)**: my site, with my other\n  projects.\n\n## Credits\n\n* The code that reaches the taskbar\u0027s XAML is based on\n  [**Taskbar tray auto-hide (show on hover)** by m417z](https://github.com/ramensoftware/windhawk-mods/blob/main/mods/taskbar-tray-show-on-hover.wh.cpp)\n  (GPL-3.0).\n* If you reuse this mod\u0027s code, or it inspired your work, please credit\n  [**Mac Island \u0026 Dock by caliberda**](https://github.com/ramensoftware/windhawk-mods/blob/main/mods/mac-island-dock.wh.cpp)\n  with that link (and m417z\u0027s mod above, for the taskbar XAML code). This is\n  a request, not a license condition.\n* Inspired by the **macOS** menu bar, Control Center and Dock, and the\n  iPhone\u0027s **Dynamic Island** (Apple).\n* **Thiago Silva**: the Liquid Glass\u0027s light and shadow like macOS 27, its\n  thin sliders and the white circle on the buttons that are on.\n* **caotu2k5**: the review of the Vietnamese texts.\n* The online icon packs, downloaded when chosen (not part of this mod):\n  [**Fluent UI System Icons**](https://github.com/microsoft/fluentui-system-icons)\n  by Microsoft (MIT), [**Ionicons**](https://ionic.io/ionicons) by Ionic\n  (MIT), [**Lucide**](https://lucide.dev) (ISC),\n  [**Tabler Icons**](https://tabler.io/icons) (MIT),\n  [**Phosphor**](https://phosphoricons.com) (MIT),\n  [**Material Symbols**](https://fonts.google.com/icons) by Google\n  (Apache 2.0), [**Bootstrap Icons**](https://icons.getbootstrap.com)\n  (MIT), [**Iconoir**](https://iconoir.com) (MIT) and\n  [**Heroicons**](https://heroicons.com) by Tailwind Labs (MIT).\n* The weather\u0027s icon sets, downloaded when chosen (not part of this mod):\n  [**Meteocons**](https://github.com/basmilius/weather-icons) by Bas Milius\n  (MIT) and [**Weather Icons**](https://github.com/erikflowers/weather-icons)\n  by Erik Flowers (SIL OFL 1.1).\n\n## Technical notes\n\nHow some features work (Windows has no public API for them; a feature is\nleft out if Windows doesn\u0027t match):\n\n* notifications: read only from Windows\u0027 notification database, cleared\n  with Windows\u0027 notification history interface, replies through the app\u0027s\n  own handler; a call\u0027s or alarm\u0027s banner read with UI Automation;\n* night light: its state in the registry (CloudStore); the output device\n  and airplane mode: Windows\u0027 own interfaces; cast, captions, the narrator\n  and color filters: Windows\u0027 shortcuts; \"Do not disturb\": the notification\n  center\u0027s interface;\n* the glass: Windows\u0027 own blur behind a window;\n* apps using the microphone, camera and location: Windows\u0027 audio sessions,\n  Media Foundation\u0027s sensor monitor, and the record in\n  CapabilityAccessManager (newer builds may not keep it up to date);\n* USB drives: ejected like \"Safely Remove Hardware\";\n* the Recycle Bin: watched with SHChangeNotifyRegister, counted with\n  SHQueryRecycleBin and emptied with SHEmptyRecycleBin (on threads);\n* the network\u0027s speed: the adapters\u0027 counters (GetIfTable2), read once a\n  second only while it shows; the visualizer: the playing app\u0027s audio\n  session\u0027s peak meter (or the output\u0027s, IAudioMeterInformation), 30 times\n  a second only while something plays (the output\u0027s peak once a second\n  while it\u0027s on, to know some sound plays);\n* song lyrics: LRCLIB\u0027s API (lrclib.net/api/get, then /api/search, then\n  /api/search again with the bare title and the first artist; results are\n  taken only when their title, artist and length match) by the title,\n  artist and length Windows\u0027 media controls give, only for a song (not a\n  video, as the app says: its playback type), on a thread, the last few\n  songs kept in memory;\n* hiding only for a window in the way, and only the clock when hidden\n  (the island, the dock and the transparent taskbar): Windows\u0027 events\n  about the apps\u0027 windows (SetWinEventHook: made, shown, moved, cloaked,\n  brought to the front; in explorer.exe on a thread of its own), the\n  windows looked at again only after one, no polling;\n* AI usage: read only while it shows, when Windows says its files\n  changed (FindFirstChangeNotification, read on that thread, no\n  polling), from files on this PC, nothing sent anywhere. Codex: the\n  \"rate_limits\" it writes in its sessions\u0027 logs\n  (`%USERPROFILE%\\.codex\\sessions`, or under `CODEX_HOME`). Claude\n  Code: the `rate_limits` of the JSON it gives its status line\u0027s command,\n  saved in `claude-status_\u003cyour account\u0027s SID\u003e.json` in the mod\u0027s storage\n  folder, made first so only your account can read it. The island never\n  changes Claude Code\u0027s settings: the panel\u0027s \"Copy the line\" copies the\n  line to add to your status line\u0027s script (with the file\u0027s path). With\n  Git Bash, which Claude Code runs its status line in when it\u0027s\n  installed, it\u0027s `printf \u0027%s\u0027 \"$input\" \u003e \u0027\u003cthat file\u003e\u0027`, for a script\n  that read its input with `input=$(cat)`; without it,\n  `$stdin | Set-Content -Encoding utf8 -LiteralPath \u0027\u003cthat file\u003e\u0027`, for a\n  PowerShell script that read it with\n  `$stdin = [Console]::In.ReadToEnd()` (add it after that line). Without\n  a status line yet, the command `cat \u003e \u0027\u003cthat file\u003e\u0027` (Git Bash) only\n  saves it and shows nothing;\n* world clocks: Windows\u0027 additional clocks (read from the registry,\n  watched for changes);\n* the pill filling with downloads: the progress apps give their taskbar\n  button (ITaskbarList3), read from the bar the taskbar draws under the\n  button (its value and its look: normal, paused, error), two hooks in\n  Taskbar.dll saying when to look again; posted to the island;\n* thumbnails: IShellItemImageFactory (thumbnails only, no icons) on a\n  thread, a few hundred kept;\n* the shelf: the paths of files dropped on the pill (CF_HDROP), kept in\n  the mod\u0027s storage; dragged out with SHDoDragDrop;\n* commands made by dropping: the paths of what\u0027s dropped (CF_HDROP) or a\n  browser\u0027s link (only http and https), kept in your commands, nothing\n  copied;\n* panels opening with the mouse: the island\u0027s own mouse messages (no\n  hook) and a short timer; they open without taking the focus from the\n  app in front;\n* the fonts: Windows\u0027 font dialog (ChooseFont), only the family\u0027s name\n  kept; clicks through the pill: its windows made transparent to the\n  mouse (WS_EX_TRANSPARENT) while the shortcut is on;\n* hibernation: SetSuspendState, offered only when Windows allows it; the\n  touch keyboard: Windows\u0027 own toggle (ITipInvocation), or TabTip.exe;\n* virtual desktops: read from the registry (watched), switched with\n  Ctrl+Win+Left or Right; renamed (Windows 11 24H2 and later) through the\n  shell\u0027s IVirtualDesktopManagerInternal, which Windows doesn\u0027t document,\n  on a thread, the pencil hidden when it isn\u0027t there;\n* the apps launcher: the shell\u0027s Apps folder (what Start lists), read on a\n  thread when its panel opens;\n* komorebi\u0027s layout: `komorebic subscribe-pipe`;\n* the icon packs: Windows\u0027 fonts drawn by DirectWrite; pictures read on a\n  thread of their own (WIC, Direct2D for SVG), your folder watched for\n  changes (no polling), each SVG drawn there once (one that shows\n  nothing is left out), nothing read while drawing; the online packs\n  (one version each) downloaded on that thread from cdn.jsdelivr.net;\n* Win+N, Win+A and Win+J (or the keys recorded): a low-level keyboard\n  hook, only while one is on or keys are being recorded;\n* the settings\u0027 Logs page: the last 300 lines the island logs, kept in\n  memory (nothing is written until you save them);\n* wallpapers: a transition window, then Windows\u0027 IDesktopWallpaper;\n* the input mode: asked to the app\u0027s input method window;\n* tray icons: as the apps send them to the taskbar (asked again when the\n  mod starts, and kept while it reloads); with Windhawk run as\n  administrator, a click reaches only the apps that aren\u0027t;\n* power modes: the powrprof.dll functions Windows\u0027 Settings uses; the\n  GPU: performance counters and the driver\u0027s own figures.\n\n## License\n\nMac Island \u0026 Dock is free software, under the\n[GNU General Public License v3.0](https://www.gnu.org/licenses/gpl-3.0.html)\n(GPL-3.0): you can use, study, change and share it, and whoever shares a\nchanged version must keep the same license and publish its source code.\nCopyright Â© 2026 caliberda; the taskbar XAML part based on m417z\u0027s mod\nkeeps m417z\u0027s copyright, under the same license. The online icon packs\nand the weather\u0027s icon sets keep their own licenses (above).\n\n---\n\n## PortuguÃªs\n\nFeito no Brasil por **caliberda** Â· bugs e ideias: sÃ³ por [uma issue no\nGitHub](https://github.com/ramensoftware/windhawk-mods/issues/new?title=%5BMac%20Island%20%26%20Dock%5D%20\u0026body=Mod%20author%3A%20%40cesarkali%0A%0A) Â· Instagram\n[@cesar.kali](https://www.instagram.com/cesar.kali) Â· [caliberda.com.br](https://caliberda.com.br) Â·\ncada opÃ§Ã£o explicada: [island.caliberda.com.br](https://island.caliberda.com.br)\n\nO topo do macOS e a Dynamic Island do iPhone no Windows 11: uma ilha no topo\nda tela com o relÃ³gio, uma central de controle, as suas notificaÃ§Ãµes e o\nque estÃ¡ tocando; e, se quiser, uma dock como a do macOS no lugar da barra\nde tarefas.\n\n![A ilha abrindo da linha, um timer rodando, o painel de mÃ­dia e o mixer](https://i.imgur.com/xE1UHrb.gif)\n\n### O que ele faz\n\n| | |\n| :--- | :---: |\n| **A ilha**: sempre no topo, como pÃ­lula, entalhes como os do MacBook ou uma barra inteira como a do macOS. Minimiza para uma linha fina e volta quando o mouse chega nela. | ![Os estilos](https://i.imgur.com/pCMrBuM.gif) |\n| **NotificaÃ§Ãµes**: as novas saem da pÃ­lula (dÃ¡ para responder mensagens ali mesmo), os apps com notificaÃ§Ãµes nÃ£o lidas aparecem nela com o nÃºmero, e o sino guarda a lista. | ![Uma notificaÃ§Ã£o na pÃ­lula](https://i.imgur.com/e1psOKQ.gif) |\n| **Central de controle**: Wi-Fi, Bluetooth, o som de cada app, brilho, \"NÃ£o incomodar\", luz noturna e mais, como no macOS; edite como no iPhone. | ![A central de controle](https://i.imgur.com/a63MaEx.gif) |\n| **Tudo o mais na pÃ­lula**, cada um opcional: o que estÃ¡ tocando, um calendÃ¡rio com suas agendas, o clima, anotaÃ§Ãµes, tarefas, pastas, papÃ©is de parede, o uso do computador, atualizaÃ§Ãµes, Ã¡reas de trabalho virtuais, o idioma do teclado, indicadores de privacidade, komorebi... | ![Alguns painÃ©is](https://i.imgur.com/Q7a2g94.png) |\n| **A dock** (opcional): uma dock como a do macOS no lugar da barra, ou a barra do Windows transparente sÃ³ com os apps. | ![A dock](https://i.imgur.com/bKiXvzS.gif) |\n| **Do seu jeito**: cores (as suas, ou as do app da frente), vidro, tamanhos, posiÃ§Ã£o e Ã­cones por app, perfis, uma ilha em cada monitor. | ![Cores](https://i.imgur.com/GJdJDI8.png) |\n\n### ComeÃ§ando\n\n1. Instale: a ilha aparece no topo da tela.\n2. Clique com o botÃ£o direito na ilha e na engrenagem embaixo dela: todas as\n   opÃ§Ãµes dela estÃ£o lÃ¡.\n3. **Organize a pÃ­lula**: nas configuraÃ§Ãµes, arraste os Ã­cones na prÃ©via da\n   ilha, no topo das abas, para mudar a ordem deles na pÃ­lula (com\n   entalhes, arraste um para outro entalhe). A ilha muda enquanto vocÃª\n   arrasta. Na prÃ³pria ilha, segure Ctrl e arraste um item.\n4. A aba \"Settings\" desta pÃ¡gina escolhe a barra de tarefas: a dock (sÃ³ no\n   Windows 11), a transparente ou a do prÃ³prio Windows.\n\nOs detalhes de cada opÃ§Ã£o estÃ£o em inglÃªs acima e, passo a passo, no site\n[island.caliberda.com.br](https://island.caliberda.com.br).\n\n### Novidades da 3.1.1\n\n**CorreÃ§Ãµes**\n\n* A ilha nÃ£o cai mais dentro dos controles de mÃ­dia do Windows enquanto os\n  vÃ­deos de um navegador (como o YouTube no Chrome) ou apps de mÃ­dia ficam\n  mudando, e, se um dia ela cair, volta sozinha.\n* Com os entalhes do estilo Fixo minimizados, o Ã­cone do app de uma\n  notificaÃ§Ã£o aparece sÃ³ no entalhe do sino, nÃ£o em todos os entalhes, e nÃ£o\n  aparece mais para o app que vocÃª estÃ¡ usando.\n* Um clique numa notificaÃ§Ã£o abre o app dela quando o prÃ³prio app nÃ£o\n  responde ao clique da notificaÃ§Ã£o, em vez de nÃ£o fazer nada.\n* O contador do prÃ³prio app no botÃ£o dele da barra de tarefas (como o do\n  WhatsApp) nÃ£o deixa mais o Ã­cone dele na ilha como uma notificaÃ§Ã£o\n  pendente com a lista vazia: ele conta como visto quando o app vem para a\n  frente ou o Ã­cone Ã© clicado, e volta quando o nÃºmero aumenta.\n* Suspender no menu do botÃ£o de energia nÃ£o hiberna mais os PCs com Modern\n  Standby: como Iniciar \u003e Suspender, desliga a tela e deixa o PC dormir.\n* A prÃ©via de mensagens do QQ e do WeChat volta a aparecer ao passar o mouse\n  no Ã­cone deles na bandeja da barra de tarefas com Ã­cones da bandeja na\n  ilha (#7157).\n* A janela de configuraÃ§Ãµes usa bem menos o processador nos primeiros\n  segundos: a dica da prÃ©via, o brilho do \"+ Linha\" e as outras dicas que sÃ³\n  esmaecem ou pulsam sÃ£o desenhadas no mÃ¡ximo 30 vezes por segundo, em vez\n  de na taxa do monitor.\n* Dock: os Ã­cones de jogos (como os da Steam) e de outros apps sem Ã­cone\n  prÃ³prio no menu Iniciar nÃ£o ficam mais vazios quando o cache de Ã­cones do\n  Windows estÃ¡ desatualizado, nem mostram um Ã­cone pequeno ampliado (#7207).\n* Logo depois de uma atualizaÃ§Ã£o do Windows, antes de a Microsoft publicar os\n  arquivos de que o Windhawk precisa para mexer na barra, a ilha nÃ£o perde\n  mais os Ã­cones da bandeja: nesses dias a barra sÃ³ fica como o Windows a\n  desenha (um aviso na ilha explica o motivo), e a dock volta no prÃ³ximo\n  login depois que eles saem.\n* A ilha e as configuraÃ§Ãµes nÃ£o travam mais por um instante a cada poucos\n  segundos quando hÃ¡ apps escolhidos para o visualizador, ainda mais com\n  vÃ¡rios monitores ou entalhes.\n\n### Novidades da 3.1\n\n**Novidades**\n\n* Segure Ctrl e arraste um item na ilha para outro lugar ou entalhe (ideia\n  do Thiago Silva); a prÃ©via nas configuraÃ§Ãµes mostra como arrastar os\n  Ã­cones.\n* Os painÃ©is podem abrir com o mouse parado no item, e arquivos, pastas ou\n  links soltos na pÃ­lula viram os seus comandos (#6654).\n* Fontes suas para a ilha e para o relÃ³gio (#6648, #6609); o relÃ³gio e a\n  data do calendÃ¡rio centralizados, e a Ã¡rea dos eventos pode ser\n  desligada (#6609).\n* Os itens da Barra Ã  esquerda, no meio ou Ã  direita (#6922), ou cada um do\n  seu lado do relÃ³gio (#6639).\n* O visualizador sÃ³ para os apps que vocÃª escolher, com altura, largura e\n  espaÃ§o das barras (#6204, #6924); sete barras, o som saindo da do meio.\n* Um entalhe vazio pode sumir (#6651); um anel na borda pode mostrar a\n  carga da bateria (#6071).\n* A letra da mÃºsica como um Ã­cone (#6684); o que estÃ¡ tocando pode ficar\n  sem nada tocando (#6905); os botÃµes podem ser sÃ³ tocar e pausar (#6907).\n* BotÃµes de Teclado virtual (#6160), ConfiguraÃ§Ãµes do Windows e Win+X\n  (#6922); Hibernar no menu de energia (#6886), cada aÃ§Ã£o opcional (#6609).\n* A velocidade da rede abre os grÃ¡ficos de download e upload (#6932);\n  notificaÃ§Ãµes longas rolam numa linha sÃ³ (#6200); a barra transparente sÃ³\n  na Ã¡rea de trabalho (#7005).\n* Esconder: a pÃ­lula do relÃ³gio encostada na borda (#6997), a seta de\n  minimizar mantÃ©m a ilha aberta (#6725), a zona da borda da largura da\n  pÃ­lula (#6525), um atalho deixa os cliques passarem pela pÃ­lula (#6718), e\n  a ilha pode ficar sobre apps em tela cheia sem borda (#6740).\n* Um lanÃ§ador de apps na pÃ­lula: todos os seus apps (os da Store tambÃ©m)\n  com busca e os favoritos primeiro (#7058).\n* O painel do que estÃ¡ tocando em outros visuais (Pixel, One UI, Windows\n  11, sÃ³ a capa) e maior (#7042, #7041); a pÃ­lula pode mostrar sÃ³ a capa\n  (#7038), e a linha minimizada uma pÃ­lula fina com a capa e as barras\n  enquanto a mÃºsica toca (#7045).\n* Uma chave para cada aviso de status (#7091), um aviso ao trocar de Ã¡rea de\n  trabalho (#7014), o sino pode abrir a central de notificaÃ§Ãµes do Windows e\n  os relÃ³gios mundiais ficam dentro do relÃ³gio (#7089); Ã¡reas de trabalho\n  renomeadas com um lÃ¡pis.\n* Linhas separadoras na pÃ­lula, e uma opcional na dock entre os apps fixados\n  e os outros; uma caixa de hex na janela de cores; Ã­cones do clima do\n  pacote de Ã­cones, Meteocons ou Weather Icons.\n* Um atalho de teclado para cada um dos seus comandos (#6165); o VLC 3 pelo\n  tÃ­tulo da janela (#6164); o estilo Fixa e a Barra com Ã­cones por app\n  prÃ³prios (#6162).\n* TÃ­tulos e artistas longos rolam no painel O que estÃ¡ tocando; as barras\n  de rolagem dos painÃ©is podem ser arrastadas, e um clique ao lado delas\n  passa uma pÃ¡gina.\n* \"Luz e sombra como no macOS 27\": sliders finos, um cÃ­rculo branco nos\n  botÃµes ligados e as pontas de uma pÃ­lula longa esmaecendo no Liquid Glass\n  (por Thiago Silva). Textos em vietnamita revisados por caotu2k5.\n\n**CorreÃ§Ãµes**\n\n* A Barra piscando nos cantos da tela com apps que os arredondam (#6954).\n* Letras de mÃºsicas cujo artista vem como \"Artista - Topic\" ou \"Artista â€¢\n  Ãlbum\" (#6612).\n* O brilho dos monitores externos (DDC/CI) desligado, com um aviso, quando o\n  Windows parou no meio de uma chamada a um monitor (#6966).\n* Em builds Insider com a barra nova do Windows, a barra fica como o Windows\n  a desenha (#6888).\n* Eventos de calendÃ¡rios .ics com fuso prÃ³prio na sua hora local (#7020); o\n  Apple Music uma vez sÃ³ no mixer (#7043).\n* A Lixeira contada de novo quando o Windows ainda nÃ£o estava pronto\n  (#7048); a bateria carregando entre 85% e 94% (#6922).\n* O nome do Wi-Fi lido sÃ³ ao conectar, para o Ã­cone de localizaÃ§Ã£o do\n  Windows nÃ£o ficar aceso.\n* Ãcones da dock nÃ­tidos com \"Disable grouping on the taskbar\" (#7029); duas\n  abas do Chrome no painel de mÃ­dia, cada uma com o seu tÃ­tulo.\n* Um Ã­cone da dock que mostrava o app fechado logo antes (o Riot Client\n  mostrava o do FileZilla).\n* A opÃ§Ã£o \"Barra de tarefas\" diz que a dock Ã© sÃ³ para o Windows 11 (#7059);\n  painÃ©is altos demais para a tela agora rolam (#7046).\n* O aviso de \"NÃ£o incomodar\" sÃ³ quando vocÃª o troca, nÃ£o a cada vez que o\n  Windows o liga para um app em tela cheia (#7091).\n* Ãcones da bandeja clicÃ¡veis de novo com o UAC desligado ou na conta\n  Administrador (#7092).\n* A bolha de contagem da dock na cor do selo do prÃ³prio app (#7095).\n* Apps como o Medal ficam na bandeja: o Ã­cone tem lugar na ilha logo depois\n  de criado (#7106).\n* A linha cantada nÃ£o aparece mais duas vezes (#7105).\n* Um pouco mais de espaÃ§o acima dos Ã­cones da dock (#7103).\n* Lembretes do calendÃ¡rio nÃ£o se perdem mais atrÃ¡s da lista, de outro aviso\n  ou de um painel, e aparecem uma vez como perdidos depois que o PC dormiu\n  (#6156).\n* Trocar o perfil de um monitor liga e desliga o que a ilha dele mostra; um\n  download pausado nÃ£o Ã© mais redesenhado a cada quadro; o brilho dos\n  monitores externos nÃ£o Ã© mais desligado por engano depois de desligar o\n  PC.\n\n**Em imagens**\n\nO lanÃ§ador de apps, com busca e favoritos:\n\n![O lanÃ§ador de apps](https://i.imgur.com/6nUOqp0.png)\n\nOs visuais do painel de mÃ­dia: o de sempre, Pixel, One UI, Windows 11 e sÃ³\na capa; a linha ondulada do Pixel se mexe enquanto a mÃºsica toca:\n\n![Os cinco visuais do painel de mÃ­dia](https://i.imgur.com/LDoIEUr.png)\n\n![A linha ondulada do Pixel](https://i.imgur.com/E7Hcoch.gif)\n\nSÃ³ a capa na pÃ­lula, e o que estÃ¡ tocando na linha minimizada:\n\n![SÃ³ a capa na pÃ­lula, e a linha minimizada com a mÃºsica](https://i.imgur.com/jbcNHUP.png)\n\nLinhas separadoras na pÃ­lula, adicionadas com \"+ Linha\" na faixa das\nconfiguraÃ§Ãµes:\n\n![Linhas separadoras na pÃ­lula e o botÃ£o + Linha](https://i.imgur.com/UP0kme3.png)\n\nA linha da dock entre os apps fixados e os abertos:\n\n![A linha da dock entre os apps fixados e os abertos](https://i.imgur.com/7a6qJnD.png)\n\nAs mudanÃ§as de cada versÃ£o ficam nas configuraÃ§Ãµes da ilha, na aba\nNovidades.\n\n### Bom saber\n\n* Feito para o Windows 11. No Windows 10, sÃ³ a ilha funciona.\n* **Com outros mods da barra de tarefas**, escolha \"Windows taskbar,\n  unchanged\" ou \"only the apps\", e nÃ£o combine a dock com outros mods de\n  dock ou que mudam o visual da barra.\n* **Internet sÃ³ quando vocÃª liga** (tudo desligado de inÃ­cio): clima,\n  feriados, letras de mÃºsicas, agendas, atualizaÃ§Ãµes, imagens nas\n  notificaÃ§Ãµes, os pacotes de Ã­cones online e os Ã­cones do clima.\n* **Backup**: as configuraÃ§Ãµes ficam no Windhawk; exporte um backup nas\n  configuraÃ§Ãµes da ilha antes de formatar.\n\n### Contato\n\nSou o **caliberda**, desenvolvedor brasileiro, e continuo melhorando este\nmod: as novas versÃµes trazem correÃ§Ãµes e o que os usuÃ¡rios pedem. Pode\nescrever em portuguÃªs.\n\n* **Bugs e ideias: sÃ³ por uma issue no GitHub** (pode ser em portuguÃªs): [relatar um\n  bug](https://github.com/ramensoftware/windhawk-mods/issues/new?labels=mod-bug\u0026title=%5BMac%20Island%20%26%20Dock%5D%20\u0026body=Mod%20author%3A%20%40cesarkali%0A%0A) ou [sugerir uma\n  ideia](https://github.com/ramensoftware/windhawk-mods/issues/new?labels=mod-enhancement\u0026title=%5BMac%20Island%20%26%20Dock%5D%20\u0026body=Mod%20author%3A%20%40cesarkali%0A%0A).\n  Ela jÃ¡ me marca (@cesarkali), entÃ£o eu vejo, e o GitHub avisa vocÃª quando\n  sair a versÃ£o com a correÃ§Ã£o ou a ideia. Bugs e ideias mandados em outro\n  lugar nÃ£o tÃªm como ser acompanhados lÃ¡.\n* **Instagram [@cesar.kali](https://www.instagram.com/cesar.kali)**: para\n  acompanhar meus projetos.\n* **[island.caliberda.com.br](https://island.caliberda.com.br)**: o site do\n  mod, cada opÃ§Ã£o explicada passo a passo, o roadmap e os seus votos.\n* **[caliberda.com.br](https://caliberda.com.br)**: meu site, com meus outros\n  projetos.\n\n### CrÃ©ditos\n\n* O cÃ³digo que chega no XAML da barra de tarefas Ã© baseado no\n  [**Taskbar tray auto-hide (show on hover)**, do m417z](https://github.com/ramensoftware/windhawk-mods/blob/main/mods/taskbar-tray-show-on-hover.wh.cpp)\n  (GPL-3.0).\n* Se vocÃª reutilizar cÃ³digo deste mod, ou ele inspirou o seu trabalho, dÃª\n  crÃ©dito a\n  [**Mac Island \u0026 Dock by caliberda**](https://github.com/ramensoftware/windhawk-mods/blob/main/mods/mac-island-dock.wh.cpp)\n  com esse link (e ao mod do m417z acima, pelo cÃ³digo do XAML da barra). Ã‰ um\n  pedido, nÃ£o uma condiÃ§Ã£o da licenÃ§a.\n* Inspirado na barra de menus, na central de controle e na Dock do\n  **macOS**, e na **Dynamic Island** do iPhone (Apple).\n* **Thiago Silva**: a luz e sombra do Liquid Glass como no macOS 27, os\n  sliders finos e o cÃ­rculo branco nos botÃµes ligados.\n* **caotu2k5**: a revisÃ£o dos textos em vietnamita.\n* Os pacotes de Ã­cones online, baixados quando escolhidos (nÃ£o fazem parte\n  deste mod):\n  [**Fluent UI System Icons**](https://github.com/microsoft/fluentui-system-icons),\n  da Microsoft (MIT), [**Ionicons**](https://ionic.io/ionicons), da Ionic\n  (MIT), [**Lucide**](https://lucide.dev) (ISC),\n  [**Tabler Icons**](https://tabler.io/icons) (MIT),\n  [**Phosphor**](https://phosphoricons.com) (MIT),\n  [**Material Symbols**](https://fonts.google.com/icons), do Google\n  (Apache 2.0), [**Bootstrap Icons**](https://icons.getbootstrap.com)\n  (MIT), [**Iconoir**](https://iconoir.com) (MIT) e\n  [**Heroicons**](https://heroicons.com), da Tailwind Labs (MIT).\n* Os conjuntos de Ã­cones do clima, baixados quando escolhidos (nÃ£o fazem\n  parte deste mod): [**Meteocons**](https://github.com/basmilius/weather-icons),\n  de Bas Milius (MIT), e\n  [**Weather Icons**](https://github.com/erikflowers/weather-icons), de Erik\n  Flowers (SIL OFL 1.1).\n\n### LicenÃ§a\n\nO Mac Island \u0026 Dock Ã© software livre, sob a\n[GNU General Public License v3.0](https://www.gnu.org/licenses/gpl-3.0.html)\n(GPL-3.0): vocÃª pode usar, estudar, mudar e compartilhar, e quem\ncompartilhar uma versÃ£o modificada precisa manter a mesma licenÃ§a e publicar\no cÃ³digo-fonte. Copyright Â© 2026 caliberda; a parte do XAML da barra,\nbaseada no mod do m417z, continua com o copyright do m417z, sob a mesma\nlicenÃ§a. Os pacotes de Ã­cones online e os conjuntos do clima tÃªm as\nprÃ³prias licenÃ§as (acima).\n*/\n// ==/WindhawkModReadme==\n\n// ==WindhawkModSettings==\n/*\n- taskbarMode: windows\n  $name: Taskbar\n  $name:pt-BR: Barra de tarefas\n  $name:zh-CN: ä»»åŠ¡æ \n  $name:de-DE: Taskleiste\n  $name:es: Barra de tareas\n  $name:ru-RU: ÐŸÐ°Ð½ÐµÐ»ÑŒ Ð·Ð°Ð´Ð°Ñ‡\n  $name:ja-JP: ã‚¿ã‚¹ã‚¯ãƒãƒ¼\n  $name:vi-VN: \"Thanh tÃ¡c vá»¥\"\n  $description: What happens to the Windows taskbar. The dock is for Windows 11 only (on Windows 10 the taskbar stays as it is and only the island works). Each group below says which of these it applies to\n  $description:pt-BR: O que acontece com a barra de tarefas do Windows. A dock 