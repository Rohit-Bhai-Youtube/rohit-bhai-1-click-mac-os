lptr},\r\n    {0xE950, L\"component\", IconGroup::Other, L\"cube-outline\", L\"component\",\r\n     L\"puzzle_piece\", L\"cube\", L\"puzzle-piece\", L\"box\", L\"box\", L\"component\",\r\n     L\"puzzle-piece\", L\"\\U0001F9F1\"},\r\n    {0xE964, L\"smartcard\", IconGroup::Other, L\"card-outline\", L\"credit-card\",\r\n     L\"payment\", L\"credit-card\", L\"credit-card\", L\"credit_card\", L\"credit-card\",\r\n     L\"credit-card\", L\"credit-card\", L\"\\U0001F4B3\"},\r\n    {0xE9A6, L\"fit-page\", IconGroup::Other, L\"expand-outline\", L\"scan\", L\"scan\",\r\n     L\"scan\", L\"scan\", L\"scan\", L\"aspect-ratio\", L\"maximize\",\r\n     L\"arrows-pointing-out\", nullptr},\r\n    {0xE9F9, L\"report-document\", IconGroup::Other, L\"document-text-outline\",\r\n     L\"file-chart-column\", L\"document_data\", L\"file-chart\", L\"chart-bar\",\r\n     L\"report\", L\"file-earmark-bar-graph\", L\"stats-report\", L\"chart-bar\",\r\n     L\"\\U0001F4CA\"},\r\n    {0xEA3A, L\"circle-ring\", IconGroup::Other, L\"ellipse-outline\", L\"circle\",\r\n     L\"circle\", L\"circle\", L\"circle\", L\"circle\", L\"circle\", L\"circle\", nullptr,\r\n     L\"\\u2B55\"},\r\n    {0xEC7A, L\"developer-tools\", IconGroup::Other, L\"hammer-outline\", L\"hammer\",\r\n     L\"toolbox\", L\"hammer\", L\"hammer\", L\"construction\", L\"hammer\", L\"hammer\",\r\n     L\"wrench\", L\"\\U0001F6E0\"},\r\n    {0xECA5, L\"tiles\", IconGroup::Other, L\"apps-outline\", L\"layout-grid\",\r\n     L\"apps\", L\"layout-grid\", L\"grid-four\", L\"apps\", L\"grid\", L\"view-grid\",\r\n     L\"squares-2x2\", nullptr},\r\n    {0xEDA8, L\"brush-size\", IconGroup::Other, L\"brush-outline\", L\"brush\",\r\n     L\"paint_brush\", L\"brush\", L\"paint-brush\", L\"brush\", L\"brush\", nullptr,\r\n     L\"paint-brush\", L\"\\U0001F58C\"},\r\n    {0xF000, L\"knowledge-article\", IconGroup::Other, L\"book-outline\",\r\n     L\"book-open\", L\"book_open\", L\"book\", L\"book-open\", L\"book\", L\"book\",\r\n     L\"book\", L\"book-open\", L\"\\U0001F4D6\"},\r\n    {0xF0E2, L\"grid-view\", IconGroup::Pill, L\"grid-outline\", L\"grid-3x3\",\r\n     L\"grid\", L\"grid-3x3\", L\"grid-nine\", L\"grid_3x3\", L\"grid-3x3\",\r\n     L\"dots-grid-3x3\", L\"squares-2x2\", nullptr},\r\n    {0xF4A5, L\"effect-size\", IconGroup::Other, L\"sparkles-outline\", L\"sparkles\",\r\n     L\"sparkle\", L\"sparkles\", L\"sparkle\", L\"stars\", L\"stars\", L\"magic-wand\",\r\n     L\"sparkles\", L\"\\u2728\"},\r\n};\r\n\r\nconst IconInfo* FindIcon(WCHAR glyph) {\r\n    for (const auto& icon : kIcons) {\r\n        if (icon.glyph == glyph) {\r\n            return &icon;\r\n        }\r\n    }\r\n    return nullptr;\r\n}\r\n\r\n// The weather's icons (the entries of kIcons from kWeatherGlyphFirst, one\r\n// for each kind of sky, in this order): what the weather draws in the pill\r\n// and its panel when islandWeatherIcons asks for pictures (see WeatherSky).\r\nenum WeatherConcept {\r\n    kSkyClearDay,\r\n    kSkyClearNight,\r\n    kSkyPartlyDay,\r\n    kSkyPartlyNight,\r\n    kSkyCloud,\r\n    kSkyRain,\r\n    kSkyDrizzle,\r\n    kSkySnow,\r\n    kSkySleet,\r\n    kSkyThunder,\r\n    kSkyFog,\r\n    kSkyConcepts\r\n};\r\nconstexpr WCHAR kWeatherGlyphFirst = 0xF8E0;\r\n\r\nbool IsWeatherIconGlyph(WCHAR glyph) {\r\n    return glyph >= kWeatherGlyphFirst &&\r\n           glyph < kWeatherGlyphFirst + kSkyConcepts;\r\n}\r\n\r\n// The kind of sky a weather code (WMO) is, by day or by night: the same\r\n// grouping as the emoji (WeatherEmoji), with freezing rain as sleet.\r\nint WeatherConceptOf(int code, bool day) {\r\n    switch (code) {\r\n        case 0:\r\n            return day ? kSkyClearDay : kSkyClearNight;\r\n        case 1:\r\n            return day ? kSkyPartlyDay : kSkyClearNight;\r\n        case 2:\r\n            return day ? kSkyPartlyDay : kSkyPartlyNight;\r\n        case 3:\r\n            return kSkyCloud;\r\n        case 45:\r\n        case 48:\r\n            return kSkyFog;\r\n        case 51:\r\n        case 53:\r\n        case 55:\r\n            return kSkyDrizzle;\r\n        case 56:\r\n        case 57:\r\n        case 66:\r\n        case 67:\r\n            return kSkySleet;\r\n        case 71:\r\n        case 73:\r\n        case 75:\r\n        case 77:\r\n        case 85:\r\n        case 86:\r\n            return kSkySnow;\r\n        case 95:\r\n        case 96:\r\n        case 99:\r\n            return kSkyThunder;\r\n        default:\r\n            // (Rain, showers, and any code not known.)\r\n            return kSkyRain;\r\n    }\r\n}\r\n\r\nWCHAR WeatherGlyphOf(int code, bool day) {\r\n    return (WCHAR)(kWeatherGlyphFirst + WeatherConceptOf(code, day));\r\n}\r\n\r\n// A sky as the pill and the weather panel keep it: an emoji, or, when\r\n// pictures are asked for, this mark, the icon's glyph and the emoji drawn if\r\n// there's no picture of it.\r\nconstexpr WCHAR kWeatherMark = 1;\r\n\r\nbool IsWeatherSky(const std::wstring& sky) {\r\n    return sky.size() >= 2 && sky[0] == kWeatherMark;\r\n}\r\n\r\nstd::wstring WeatherSkyEmoji(const std::wstring& sky) {\r\n    return IsWeatherSky(sky) ? sky.substr(2) : sky;\r\n}\r\n\r\n// Whether the weather's pictures are asked of the icon packs (the one\r\n// chosen, in the Icons tab): their downloads then include them, not before.\r\nstd::atomic<bool> g_weatherFromPacks{false};\r\n\r\n// The battery's glyph at `percent`: Segoe's ten steps, with the bolt while\r\n// charging. (Charging at 90% is out of the row, E83E: E863, right after\r\n// E862, is the energy saver's battery, #6922.)\r\nWCHAR BatteryGlyphFor(int percent, bool charging) {\r\n    const int tenth = std::clamp((percent + 5) / 10, 0, 10);\r\n    if (tenth >= 10) {\r\n        return charging ? (WCHAR)0xEA93 : (WCHAR)0xE83F;\r\n    }\r\n    if (charging && tenth == 9) {\r\n        return (WCHAR)0xE83E;\r\n    }\r\n    return (WCHAR)((charging ? 0xE85A : 0xE850) + tenth);\r\n}\r\n\r\n// The icon packs (islandIconPack), in the order the settings list them: the\r\n// font's (Windows 11's; Windows 10's where it has the icon), Segoe UI\r\n// Emoji's, the online ones (downloaded once, see kOnlineIconPacks), or a\r\n// folder of the user's (g_iconFolder). Pictures chosen for single icons\r\n// (g_iconFiles) go over any of them; an icon a pack hasn't is the font's.\r\nenum IconPackId {\r\n    kIconPackWindows,\r\n    kIconPackWindows10,\r\n    kIconPackEmoji,\r\n    kIconPackFluent,\r\n    kIconPackIonicons,\r\n    kIconPackLucide,\r\n    kIconPackTabler,\r\n    kIconPackPhosphor,\r\n    kIconPackMaterial,\r\n    kIconPackBootstrap,\r\n    kIconPackIconoir,\r\n    kIconPackHeroicons,\r\n    kIconPackFolder,\r\n    kIconPacks\r\n};\r\n// The online packs (all free to use: MIT, or Apache 2.0 for Google's): where\r\n// their pictures are (one version, on jsDelivr's CDN; each file its name in\r\n// the pack then `ending`), the folder they're kept in (in the mod's\r\n// storage), their name for each icon, and who makes them and their license\r\n// (as the settings say). Their pictures are only shapes: drawn in the\r\n// icons' colors.\r\nstruct OnlineIconPack {\r\n    int pack;\r\n    PCWSTR folder;\r\n    PCWSTR url;\r\n    PCWSTR ending;\r\n    PCWSTR IconInfo::*name;\r\n    PCWSTR by;\r\n    PCWSTR license;\r\n};\r\n// The weather's own icon sets (islandWeatherIcons 2 and 3): online packs too,\r\n// downloaded into the same folder when chosen, but not in the list of icon\r\n// packs (their numbers are past it).\r\nconstexpr int kWeatherSetMeteocons = kIconPacks;\r\nconstexpr int kWeatherSetIcons = kIconPacks + 1;\r\n\r\n// The set a choice of weather icons is (-1: none).\r\nint WeatherSetOf(int choice) {\r\n    return choice == 2   ? kWeatherSetMeteocons\r\n           : choice == 3 ? kWeatherSetIcons\r\n                         : -1;\r\n}\r\n\r\nconstexpr OnlineIconPack kOnlineIconPacks[] = {\r\n    {kIconPackFluent, L\"fluent-1.1.343\",\r\n     L\"https://cdn.jsdelivr.net/npm/@fluentui/svg-icons@1.1.343/icons/\",\r\n     L\"_24_regular.svg\", &IconInfo::fluent, L\"Microsoft\", L\"MIT\"},\r\n    {kIconPackIonicons, L\"ionicons-7.4.0\",\r\n     L\"https://cdn.jsdelivr.net/npm/ionicons@7.4.0/dist/svg/\", L\".svg\",\r\n     &IconInfo::ionicon, L\"Ionic\", L\"MIT\"},\r\n    {kIconPackLucide, L\"lucide-1.40.0\",\r\n     L\"https://cdn.jsdelivr.net/npm/lucide-static@1.40.0/icons/\", L\".svg\",\r\n     &IconInfo::lucide, L\"Lucide\", L\"ISC\"},\r\n    {kIconPackTabler, L\"tabler-3.48.0\",\r\n     L\"https://cdn.jsdelivr.net/npm/@tabler/icons@3.48.0/icons/outline/\",\r\n     L\".svg\", &IconInfo::tabler, L\"Tabler\", L\"MIT\"},\r\n    {kIconPackPhosphor, L\"phosphor-2.1.1\",\r\n     L\"https://cdn.jsdelivr.net/npm/@phosphor-icons/core@2.1.1/assets/\"\r\n     L\"regular/\",\r\n     L\".svg\", &IconInfo::phosphor, L\"Phosphor\", L\"MIT\"},\r\n    {kIconPackMaterial, L\"material-symbols-0.47.6\",\r\n     L\"https://cdn.jsdelivr.net/npm/@material-symbols/svg-400@0.47.6/\"\r\n     L\"outlined/\",\r\n     L\".svg\", &IconInfo::material, L\"Google\", L\"Apache 2.0\"},\r\n    {kIconPackBootstrap, L\"bootstrap-icons-1.13.1\",\r\n     L\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/icons/\", L\".svg\",\r\n     &IconInfo::bootstrap, L\"Bootstrap\", L\"MIT\"},\r\n    {kIconPackIconoir, L\"iconoir-7.12.1\",\r\n     L\"https://cdn.jsdelivr.net/npm/iconoir@7.12.1/icons/regular/\", L\".svg\",\r\n     &IconInfo::iconoir, L\"Iconoir\", L\"MIT\"},\r\n    {kIconPackHeroicons, L\"heroicons-2.2.0\",\r\n     L\"https://cdn.jsdelivr.net/npm/heroicons@2.2.0/24/outline/\", L\".svg\",\r\n     &IconInfo::heroicon, L\"Tailwind Labs\", L\"MIT\"},\r\n    // Only the weather's (see kWeatherSetMeteocons): Meteocons' static \"fill\"\r\n    // icons in color, and Weather Icons' (SIL OFL 1.1) in one color.\r\n    {kWeatherSetMeteocons, L\"meteocons-svg-static-0.1.0\",\r\n     L\"https://cdn.jsdelivr.net/npm/@meteocons/svg-static@0.1.0/fill/\",\r\n     L\".svg\", &IconInfo::meteocon, L\"Bas Milius\", L\"MIT\"},\r\n    {kWeatherSetIcons, L\"weather-icons-2.0.12\",\r\n     L\"https://cdn.jsdelivr.net/gh/erikflowers/weather-icons@2.0.12/svg/\",\r\n     L\".svg\", &IconInfo::weathericon, L\"Erik Flowers\", L\"SIL OFL 1.1\"},\r\n};\r\n\r\nconst OnlineIconPack* FindOnlineIconPack(int pack) {\r\n    for (const auto& online : kOnlineIconPacks) {\r\n        if (online.pack == pack) {\r\n            return &online;\r\n        }\r\n    }\r\n    return nullptr;\r\n}\r\n\r\n// The icon pack's folder (empty: none chosen yet), and the pictures and\r\n// colors chosen for single icons (as stored, \"E701|path\" and \"E701|#RRGGBB\"\r\n// lines, and read), per profile.\r\nstd::wstring g_iconFolder;\r\nstruct IconFiles {\r\n    std::wstring text;\r\n    std::vector<std::pair<WCHAR, std::wstring>> files;\r\n    // 0xRRGGBB.\r\n    std::vector<std::pair<WCHAR, int>> colors;\r\n};\r\nIconFiles g_iconFiles;\r\nconstexpr size_t kIconFilesRoom = 16 * 1024;\r\n\r\n// The stored list read: an icon's code (one of kIcons) and a path on this\r\n// computer's drives or a color each line; anything else, a second picture\r\n// or color for an icon, or more than there are icons, left out.\r\nIconFiles DecodeIconFiles(const std::wstring& text) {\r\n    IconFiles read{text};\r\n    size_t start = 0;\r\n    while (start < text.size() &&\r\n           read.files.size() + read.colors.size() < 2 * std::size(kIcons)) {\r\n        size_t end = text.find(L'\\n', start);\r\n        if (end == std::wstring::npos) {\r\n            end = text.size();\r\n        }\r\n        const std::wstring_view line(text.data() + start, end - start);\r\n        start = end + 1;\r\n        if (line.size() < 6 || line[4] != L'|' ||\r\n            !std::all_of(line.begin(), line.begin() + 4,\r\n                         [](WCHAR c) { return iswxdigit(c) != 0; })) {\r\n            continue;\r\n        }\r\n        const WCHAR glyph = (WCHAR)wcstoul(\r\n            std::wstring(line.substr(0, 4)).c_str(), nullptr, 16);\r\n        std::wstring path(line.substr(5));\r\n        if (path.size() == 7 && path[0] == L'#' &&\r\n            std::all_of(path.begin() + 1, path.end(),\r\n                        [](WCHAR c) { return iswxdigit(c) != 0; })) {\r\n            if (FindIcon(glyph) &&\r\n                std::none_of(read.colors.begin(), read.colors.end(),\r\n                             [&](const auto& color) {\r\n                                 return color.first == glyph;\r\n                             })) {\r\n                read.colors.push_back(\r\n                    {glyph, (int)wcstoul(path.c_str() + 1, nullptr, 16)});\r\n            }\r\n            continue;\r\n        }\r\n        if (FindIcon(glyph) && IsLocalDrivePath(path) &&\r\n            std::none_of(read.files.begin(), read.files.end(),\r\n                         [&](const auto& file) {\r\n                             return file.first == glyph;\r\n                         })) {\r\n            read.files.push_back({glyph, std::move(path)});\r\n        }\r\n    }\r\n    return read;\r\n}\r\n\r\nstd::wstring EncodeIconFiles(\r\n    const std::vector<std::pair<WCHAR, std::wstring>>& files,\r\n    const std::vector<std::pair<WCHAR, int>>& colors) {\r\n    std::wstring text;\r\n    for (const auto& [glyph, path] : files) {\r\n        WCHAR code[8];\r\n        swprintf_s(code, L\"%04X|\", glyph);\r\n        text += code + path + L\"\\n\";\r\n    }\r\n    for (const auto& [glyph, color] : colors) {\r\n        WCHAR line[16];\r\n        swprintf_s(line, L\"%04X|#%06X\\n\", glyph, color & 0xFFFFFF);\r\n        text += line;\r\n    }\r\n    return text;\r\n}\r\n\r\n// The color chosen for an icon (0xRRGGBB; -1: none, the island's). On the\r\n// islands' thread only (the dock's icons in explorer stay as they are).\r\nint IconColorOf(WCHAR glyph) {\r\n    if (g_iconFiles.colors.empty() ||\r\n        GetCurrentThreadId() != g_islandThreadId) {\r\n        return -1;\r\n    }\r\n    for (const auto& [own, color] : g_iconFiles.colors) {\r\n        if (own == glyph) {\r\n            return color;\r\n        }\r\n    }\r\n    return -1;\r\n}\r\n\r\n// The icon a picture's file name stands for in the user's folder: an icon's\r\n// name (any case) or its code (0: none).\r\nWCHAR IconGlyphFromName(std::wstring_view stem) {\r\n    if (stem.size() == 4 &&\r\n        std::all_of(stem.begin(), stem.end(),\r\n                    [](WCHAR c) { return iswxdigit(c) != 0; })) {\r\n        const WCHAR glyph =\r\n            (WCHAR)wcstoul(std::wstring(stem).c_str(), nullptr, 16);\r\n        return FindIcon(glyph) ? glyph : 0;\r\n    }\r\n    for (const auto& icon : kIcons) {\r\n        if (stem.size() == wcslen(icon.name) &&\r\n            _wcsnicmp(stem.data(), icon.name, stem.size()) == 0) {\r\n            return icon.glyph;\r\n        }\r\n    }\r\n    return 0;\r\n}\r\n\r\n// The pictures of a pack, read on the icons' own thread (see\r\n// IconThreadProc): a folder's (the user's, read again when it changes; an\r\n// online pack's, downloaded into the mod's storage first), or the pictures\r\n// chosen for single icons. The islands' thread draws them (see\r\n// DrawIconPicture), and only asks: no file is read while drawing.\r\nenum class IconSourceKind { Folder, Online, Files };\r\nstruct IconPicture {\r\n    WCHAR glyph;\r\n    // Premultiplied BGRA, kIconPictureMost square at most (an SVG drawn\r\n    // that big).\r\n    UINT width = 0;\r\n    UINT height = 0;\r\n    std::vector<BYTE> pixels;\r\n};\r\nenum class IconSourceState { Reading, Downloading, Ready, Failed, NotLocal };\r\nstruct IconSource {\r\n    IconSourceKind kind;\r\n    // The folder, the online pack's folder name, or the files' list.\r\n    std::wstring what;\r\n    IconSourceState state = IconSourceState::Reading;\r\n    // Told apart from the pictures before (see IconBitmap).\r\n    UINT serial = 0;\r\n    std::vector<IconPicture> pictures;\r\n    // Downloading: how many are there of how many.\r\n    int done = 0;\r\n    int total = 0;\r\n    // To be read (again): asked, its folder changed, or tried again.\r\n    bool again = true;\r\n};\r\nconstexpr size_t kIconSourcesMost = 8;\r\nconstexpr size_t kIconEntriesMost = 4096;\r\nconstexpr ULONGLONG kIconFileMost = 4 * 1024 * 1024;\r\nconstexpr size_t kIconSvgMost = 64 * 1024;\r\nconstexpr UINT kIconPictureMost = 128;\r\n// (A folder changing: read once the changes stop for this long.)\r\nconstexpr DWORD kIconChangeSettleMs = 400;\r\n// (At most this many waits, about a minute, for a folder written all the\r\n// time: saving Windows' icons there takes several seconds.)\r\nconstexpr int kIconChangeSettleTimes = 150;\r\n// Told to the islands' thread: pictures read (see OnIconsRead).\r\nconstexpr UINT WM_APP_ICONS = WM_APP + 100;\r\n// Every island drawn again with them (defined further down).\r\nvoid OnIconsRead();\r\n// Pictures read, told to the main island's window: a message to its thread\r\n// is lost while a modal loop runs it (a menu, a move, a drag); to the\r\n// thread before it has a window.\r\nvoid TellIconsRead() {\r\n    if (const HWND island = g_islandWnd;\r\n        island && PostMessage(island, WM_APP_ICONS, 0, 0)) {\r\n        return;\r\n    }\r\n    PostThreadMessage(g_islandThreadId, WM_APP_ICONS, 0, 0);\r\n}\r\n\r\nSRWLOCK g_iconLock = SRWLOCK_INIT;\r\nstd::vector<IconSource> g_iconSources;\r\n// Counts every new picture read, and every change of what the icons look\r\n// like (see IconsGeneration): pictures drawn of them (the control center's\r\n// tiles) are drawn again.\r\nstd::atomic<UINT> g_iconSerial{0};\r\n// Counts every change of the online packs' files (downloaded, deleted): the\r\n// settings look at which are there again (see IconPackOnDisk).\r\nstd::atomic<UINT> g_iconDiskChanges{0};\r\nUINT g_iconLook = 0;\r\n// The icons' thread (started by the islands' thread with a first pack, and\r\n// ended with it, see ReleaseIconPictures): what stops it, a request under\r\n// way closed at once, and what tells it to look at the sources.\r\nHANDLE g_iconThread = nullptr;\r\nHANDLE g_iconStopEvent = nullptr;\r\nHANDLE g_iconKick = nullptr;\r\nstd::atomic<bool> g_iconStop{false};\r\nHttpsCancel g_iconCancel;\r\n\r\nUINT IconsGeneration() {\r\n    return g_iconLook + g_iconSerial;\r\n}\r\n\r\n// An SVG picture's text (of the size kept), not a web page or anything\r\n// else.\r\nbool LooksLikeSvg(const std::string& text) {\r\n    const size_t svg = text.find(\"<svg\");\r\n    return text.size() <= kIconSvgMost && svg != std::string::npos &&\r\n           svg < 1024 && text.find(\"</svg>\", svg) != std::string::npos;\r\n}\r\n\r\n// An SVG's own width and height taken out of its text (Lucide's say 24,\r\n// which would draw it that big, cut or small): it then fills the size it's\r\n// drawn at, its viewBox kept (one made of them when it has none). In the\r\n// text, as Direct2D's SVG elements' attributes can't be set safely with\r\n// this compiler's headers (their order differs from Windows').\r\nvoid FillSvgSize(std::string* svg) {\r\n    const size_t start = svg->find(\"<svg\");\r\n    const size_t end = start == std::string::npos ? start\r\n                                                  : svg->find('>', start);\r\n    if (end == std::string::npos) {\r\n        return;\r\n    }\r\n    std::string tag = svg->substr(start, end - start);\r\n    double sizes[2] = {0, 0};\r\n    const char* names[2] = {\"width=\", \"height=\"};\r\n    for (int i = 0; i < 2; i++) {\r\n        for (size_t at = tag.find(names[i]); at != std::string::npos;\r\n             at = tag.find(names[i], at + 1)) {\r\n            const size_t quote = at + strlen(names[i]);\r\n            // (Not stroke-width or another name ending the same.)\r\n            if (at == 0 || !isspace((unsigned char)tag[at - 1]) ||\r\n                quote >= tag.size() ||\r\n                (tag[quote] != '\"' && tag[quote] != '\\'')) {\r\n                continue;\r\n            }\r\n            const size_t closing = tag.find(tag[quote], quote + 1);\r\n            if (closing == std::string::npos) {\r\n                return;\r\n            }\r\n            const std::string value =\r\n                tag.substr(quote + 1, closing - quote - 1);\r\n            char* rest = nullptr;\r\n            const double number = strtod(value.c_str(), &rest);\r\n            if (rest && (*rest == 0 || strcmp(rest, \"px\") == 0)) {\r\n                sizes[i] = number;\r\n            }\r\n            tag.erase(at - 1, closing + 1 - (at - 1));\r\n            break;\r\n        }\r\n    }\r\n    if (tag.find(\"viewBox\") == std::string::npos && sizes[0] > 0 &&\r\n        sizes[1] > 0) {\r\n        tag.insert(4, \" viewBox=\\\"0 0 \" + std::to_string(sizes[0]) + \" \" +\r\n                          std::to_string(sizes[1]) + \"\\\"\");\r\n    }\r\n    svg->replace(start, end - start, tag);\r\n}\r\n\r\n// Whether a picture's pixels show anything (one all see-through would leave\r\n// its icon empty: the font's is drawn instead).\r\nbool IconPictureShows(const IconPicture& picture) {\r\n    for (size_t i = 3; i < picture.pixels.size(); i += 4) {\r\n        if (picture.pixels[i]) {\r\n            return true;\r\n        }\r\n    }\r\n    return false;\r\n}\r\n\r\n// An SVG's text drawn kIconPictureMost square (see FillSvgSize), here on\r\n// the icons' thread rather than as it's drawn.\r\nbool DrawSvgPicture(IWICImagingFactory* wic,\r\n                    ID2D1Factory* d2d,\r\n                    std::string svg,\r\n                    IconPicture* picture) {\r\n    FillSvgSize(&svg);\r\n    constexpr UINT kPixels = kIconPictureMost;\r\n    winrt::com_ptr<IWICBitmap> bitmap;\r\n    winrt::com_ptr<ID2D1RenderTarget> target;\r\n    winrt::com_ptr<ID2D1DeviceContext5> context;\r\n    winrt::com_ptr<IStream> stream;\r\n    winrt::com_ptr<ID2D1SvgDocument> document;\r\n    stream.attach(\r\n        SHCreateMemStream((const BYTE*)svg.data(), (UINT)svg.size()));\r\n    if (!stream || !d2d ||\r\n        FAILED(wic->CreateBitmap(kPixels, kPixels,\r\n                                 GUID_WICPixelFormat32bppPBGRA,\r\n                                 WICBitmapCacheOnLoad, bitmap.put())) ||\r\n        FAILED(d2d->CreateWicBitmapRenderTarget(\r\n            bitmap.get(),\r\n            D2D1::RenderTargetProperties(\r\n                D2D1_RENDER_TARGET_TYPE_DEFAULT,\r\n                D2D1::PixelFormat(DXGI_FORMAT_B8G8R8A8_UNORM,\r\n                                  D2D1_ALPHA_MODE_PREMULTIPLIED),\r\n                96, 96),\r\n            target.put())) ||\r\n        FAILED(target->QueryInterface(IID_PPV_ARGS(context.put()))) ||\r\n        FAILED(context->CreateSvgDocument(\r\n            stream.get(), D2D1::SizeF((float)kPixels, (float)kPixels),\r\n            document.put()))) {\r\n        return false;\r\n    }\r\n    target->BeginDraw();\r\n    target->Clear(D2D1::ColorF(0, 0, 0, 0));\r\n    context->DrawSvgDocument(document.get());\r\n    if (FAILED(target->EndDraw())) {\r\n        return false;\r\n    }\r\n    picture->width = kPixels;\r\n    picture->height = kPixels;\r\n    picture->pixels.resize((size_t)kPixels * kPixels * 4);\r\n    return SUCCEEDED(bitmap->CopyPixels(nullptr, kPixels * 4,\r\n                                        (UINT)picture->pixels.size(),\r\n                                        picture->pixels.data()));\r\n}\r\n\r\n// A picture read: an SVG drawn, or the biggest of a picture's frames (an ICO\r\n// file has several sizes), made kIconPictureMost square at most; false\r\n// without one, or with one that shows nothing.\r\nbool ReadIconPicture(IWICImagingFactory* wic,\r\n                     ID2D1Factory* d2d,\r\n                     const std::wstring& path,\r\n                     IconPicture* picture) {\r\n    if (_wcsicmp(PathFindExtension(path.c_str()), L\".svg\") == 0) {\r\n        std::string svg;\r\n        const HANDLE file = CreateFile(\r\n            path.c_str(), GENERIC_READ,\r\n            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr,\r\n            OPEN_EXISTING, 0, nullptr);\r\n        if (file == INVALID_HANDLE_VALUE) {\r\n            return false;\r\n        }\r\n        LARGE_INTEGER size{};\r\n        DWORD read = 0;\r\n        bool done = GetFileSizeEx(file, &size) && size.QuadPart > 0 &&\r\n                    (ULONGLONG)size.QuadPart <= kIconSvgMost;\r\n        if (done) {\r\n            svg.resize((size_t)size.QuadPart);\r\n            done = ReadFile(file, svg.data(), (DWORD)svg.size(), &read,\r\n                            nullptr) &&\r\n                   read == svg.size();\r\n        }\r\n        CloseHandle(file);\r\n        return done && LooksLikeSvg(svg) &&\r\n               DrawSvgPicture(wic, d2d, std::move(svg), picture) &&\r\n               IconPictureShows(*picture);\r\n    }\r\n    winrt::com_ptr<IWICBitmapDecoder> decoder;\r\n    UINT frames = 0;\r\n    if (FAILED(wic->CreateDecoderFromFilename(\r\n            path.c_str(), nullptr, GENERIC_READ,\r\n            WICDecodeMetadataCacheOnDemand, decoder.put())) ||\r\n        FAILED(decoder->GetFrameCount(&frames))) {\r\n        return false;\r\n    }\r\n    winrt::com_ptr<IWICBitmapFrameDecode> biggest;\r\n    UINT width = 0;\r\n    UINT height = 0;\r\n    for (UINT i = 0; i < frames && i < 16; i++) {\r\n        winrt::com_ptr<IWICBitmapFrameDecode> frame;\r\n        UINT frameWidth = 0;\r\n        UINT frameHeight = 0;\r\n        if (SUCCEEDED(decoder->GetFrame(i, frame.put())) &&\r\n            SUCCEEDED(frame->GetSize(&frameWidth, &frameHeight)) &&\r\n            frameWidth > width && frameHeight > 0) {\r\n            biggest = frame;\r\n            width = frameWidth;\r\n            height = frameHeight;\r\n        }\r\n    }\r\n    winrt::com_ptr<IWICFormatConverter> converter;\r\n    if (!biggest || FAILED(wic->CreateFormatConverter(converter.put())) ||\r\n        FAILED(converter->Initialize(\r\n            biggest.get(), GUID_WICPixelFormat32bppPBGRA,\r\n            WICBitmapDitherTypeNone, nullptr, 0,\r\n            WICBitmapPaletteTypeMedianCut))) {\r\n        return false;\r\n    }\r\n    winrt::com_ptr<IWICBitmapSource> source;\r\n    source.copy_from(converter.get());\r\n    const float fit = std::min(\r\n        1.0f, (float)kIconPictureMost / (float)std::max(width, height));\r\n    if (fit < 1) {\r\n        winrt::com_ptr<IWICBitmapScaler> scaler;\r\n        const UINT fitWidth = std::max(1u, (UINT)std::lround(width * fit));\r\n        const UINT fitHeight = std::max(1u, (UINT)std::lround(height * fit));\r\n        if (FAILED(wic->CreateBitmapScaler(scaler.put())) ||\r\n            FAILED(scaler->Initialize(converter.get(), fitWidth, fitHeight,\r\n                                      WICBitmapInterpolationModeFant))) {\r\n            return false;\r\n        }\r\n        source.copy_from(scaler.get());\r\n        width = fitWidth;\r\n        height = fitHeight;\r\n    }\r\n    picture->width = width;\r\n    picture->height = height;\r\n    picture->pixels.resize((size_t)width * height * 4);\r\n    return SUCCEEDED(source->CopyPixels(nullptr, width * 4,\r\n                                        (UINT)picture->pixels.size(),\r\n                                        picture->pixels.data())) &&\r\n           IconPictureShows(*picture);\r\n}\r\n\r\n// A folder's pictures for icons (its first entries only; one per icon):\r\n// named after an icon or by its code (the user's), or by the online pack's\r\n// names (each of its pictures may stand for several icons).\r\nstd::vector<IconPicture> ReadIconFolder(IWICImagingFactory* wic,\r\n                                        ID2D1Factory* d2d,\r\n                                        const std::wstring& folder,\r\n                                        const OnlineIconPack* online) {\r\n    std::vector<IconPicture> pictures;\r\n    WIN32_FIND_DATA data;\r\n    const HANDLE find = FindFirstFile((folder + L\"\\\\*\").c_str(), &data);\r\n    if (find == INVALID_HANDLE_VALUE) {\r\n        return pictures;\r\n    }\r\n    size_t entries = 0;\r\n    do {\r\n        const PCWSTR dot = wcsrchr(data.cFileName, L'.');\r\n        // (Not an online pack's mark of a picture it doesn't have.)\r\n        if ((data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || !dot ||\r\n            _wcsicmp(dot, L\".none\") == 0 ||\r\n            (((ULONGLONG)data.nFileSizeHigh << 32) | data.nFileSizeLow) >\r\n                kIconFileMost) {\r\n            continue;\r\n        }\r\n        const std::wstring_view stem(data.cFileName,\r\n                                     (size_t)(dot - data.cFileName));\r\n        std::vector<WCHAR> glyphs;\r\n        if (online) {\r\n            for (const auto& icon : kIcons) {\r\n                if (icon.*online->name && stem == icon.*online->name) {\r\n                    glyphs.push_back(icon.glyph);\r\n                }\r\n            }\r\n        } else if (const WCHAR glyph = IconGlyphFromName(stem)) {\r\n            glyphs.push_back(glyph);\r\n        }\r\n        std::erase_if(glyphs, [&](WCHAR glyph) {\r\n            return std::any_of(pictures.begin(), pictures.end(),\r\n                               [&](const IconPicture& picture) {\r\n                                   return picture.glyph == glyph;\r\n                               });\r\n        });\r\n        IconPicture picture{};\r\n        if (glyphs.empty() ||\r\n            !ReadIconPicture(wic, d2d, folder + L\"\\\\\" + data.cFileName,\r\n                             &picture)) {\r\n            continue;\r\n        }\r\n        for (WCHAR glyph : glyphs) {\r\n            picture.glyph = glyph;\r\n            pictures.push_back(picture);\r\n        }\r\n    } while (!g_iconStop && ++entries < kIconEntriesMost &&\r\n             FindNextFile(find, &data));\r\n    FindClose(find);\r\n    return pictures;\r\n}\r\n\r\n// The online pack's pictures not downloaded yet (its picture for each\r\n// icon, once each), into its folder, the source's count told as it goes;\r\n// false if one couldn't be (the ones before are kept: the next time, only\r\n// the rest). One the pack doesn't have (the server says 404) is skipped,\r\n// and remembered (an empty <name>.none beside them) so it's never asked for\r\n// again: that icon keeps the island's own. Only the pictures' addresses are\r\n// asked for: nothing about the user is sent.\r\nbool DownloadIconPack(const OnlineIconPack& pack, const std::wstring& folder) {\r\n    std::vector<std::wstring> names;\r\n    for (const auto& icon : kIcons) {\r\n        // (A pack's weather pictures only once the weather asks for them.)\r\n        if (!(icon.*pack.name) ||\r\n            (IsWeatherIconGlyph(icon.glyph) && pack.pack < kIconPacks &&\r\n             !g_weatherFromPacks)) {\r\n            continue;\r\n        }\r\n        const std::wstring name = icon.*pack.name;\r\n        auto missing = [&](PCWSTR ending) {\r\n            const std::wstring path = folder + L\"\\\\\" + name + ending;\r\n            return GetFileAttributes(path.c_str()) == INVALID_FILE_ATTRIBUTES;\r\n        };\r\n        if (std::find(names.begin(), names.end(), name) == names.end() &&\r\n            missing(L\".svg\") && missing(L\".none\")) {\r\n            names.push_back(name);\r\n        }\r\n    }\r\n    auto tell = [&](int done, IconSourceState state) {\r\n        AcquireSRWLockExclusive(&g_iconLock);\r\n        for (auto& source : g_iconSources) {\r\n            if (source.kind == IconSourceKind::Online &&\r\n                source.what == pack.folder) {\r\n                source.state = state;\r\n                source.done = done;\r\n                source.total = (int)names.size();\r\n            }\r\n        }\r\n        ReleaseSRWLockExclusive(&g_iconLock);\r\n        g_iconDiskChanges++;\r\n        TellIconsRead();\r\n    };\r\n    if (names.empty()) {\r\n        return true;\r\n    }\r\n    tell(0, IconSourceState::Downloading);\r\n    for (size_t i = 0; i < names.size(); i++) {\r\n        std::vector<BYTE> data;\r\n        DWORD answer = 0;\r\n        if (!HttpsGet(pack.url + names[i] + pack.ending, &data, kIconSvgMost,\r\n                      5000, &g_iconStop, &g_iconCancel, &answer)) {\r\n            if (answer != 404 || g_iconStop) {\r\n                return false;\r\n            }\r\n            IslandLog(L\"Icon pack %s: no %s\", pack.folder, names[i].c_str());\r\n            const HANDLE none = CreateFile(\r\n                (folder + L\"\\\\\" + names[i] + L\".none\").c_str(), GENERIC_WRITE,\r\n                0, nullptr, CREATE_ALWAYS, 0, nullptr);\r\n            if (none != INVALID_HANDLE_VALUE) {\r\n                CloseHandle(none);\r\n            }\r\n            continue;\r\n        }\r\n        if (!LooksLikeSvg(std::string(data.begin(), data.end()))) {\r\n            return false;\r\n        }\r\n        // (Whole, or not there: written beside it, then put in its place.)\r\n        const std::wstring path = folder + L\"\\\\\" + names[i] + L\".svg\";\r\n        const std::wstring part = path + L\".part\";\r\n        const HANDLE file = CreateFile(part.c_str(), GENERIC_WRITE, 0,\r\n                                       nullptr, CREATE_ALWAYS, 0, nullptr);\r\n        DWORD written = 0;\r\n        const bool done =\r\n            file != INVALID_HANDLE_VALUE &&\r\n            WriteFile(file, data.data(), (DWORD)data.size(), &written,\r\n                      nullptr) &&\r\n            written == data.size();\r\n        if (file != INVALID_HANDLE_VALUE) {\r\n            CloseHandle(file);\r\n        }\r\n        if (!done ||\r\n            !MoveFileEx(part.c_str(), path.c_str(),\r\n                        MOVEFILE_REPLACE_EXISTING)) {\r\n            DeleteFile(part.c_str());\r\n            return false;\r\n        }\r\n        // (The settings say how far it is, now and then.)\r\n        if (i % 8 == 7) {\r\n            tell((int)i + 1, IconSourceState::Downloading);\r\n        }\r\n    }\r\n    return true;\r\n}\r\n\r\n// The folder in the mod's storage an online pack is kept in (empty if\r\n// there's no storage).\r\nstd::wstring OnlineIconPackPath(const OnlineIconPack& pack) {\r\n    WCHAR storage[MAX_PATH];\r\n    if (!Wh_GetModStoragePath(storage, ARRAYSIZE(storage))) {\r\n        return {};\r\n    }\r\n    return std::wstring(storage) + L\"\\\\icon-packs\\\\\" + pack.folder;\r\n}\r\n\r\n// That folder, made if it isn't there (empty if it can't be).\r\nstd::wstring OnlineIconPackFolder(const OnlineIconPack& pack) {\r\n    const std::wstring folder = OnlineIconPackPath(pack);\r\n    if (folder.empty()) {\r\n        return {};\r\n    }\r\n    const std::wstring packs = folder.substr(0, folder.rfind(L'\\\\'));\r\n    CreateDirectory(packs.substr(0, packs.rfind(L'\\\\')).c_str(), nullptr);\r\n    CreateDirectory(packs.c_str(), nullptr);\r\n    CreateDirectory(folder.c_str(), nullptr);\r\n    const DWORD attributes = GetFileAttributes(folder.c_str());\r\n    return attributes != INVALID_FILE_ATTRIBUTES &&\r\n                   (attributes & FILE_ATTRIBUTE_DIRECTORY)\r\n               ? folder\r\n               : std::wstring();\r\n}\r\n\r\n// Whether an online pack has pictures in the mod's storage (downloaded, or\r\n// partly): a look at its folder, not done while drawing.\r\nbool IconPackOnDisk(int pack) {\r\n    const OnlineIconPack* online = FindOnlineIconPack(pack);\r\n    const std::wstring folder =\r\n        online ? OnlineIconPackPath(*online) : std::wstring();\r\n    if (folder.empty()) {\r\n        return false;\r\n    }\r\n    WIN32_FIND_DATA data;\r\n    const HANDLE find = FindFirstFile((folder + L\"\\\\*.svg\").c_str(), &data);\r\n    if (find == INVALID_HANDLE_VALUE) {\r\n        return false;\r\n    }\r\n    FindClose(find);\r\n    return true;\r\n}\r\n\r\n// The online packs' folders to delete, taken by the icons' thread (with\r\n// g_iconLock).\r\nstd::vector<std::wstring> g_iconDeletes;\r\n\r\n// A pack's folder deleted: its pictures (and any half-written one), then\r\n// it.\r\nvoid DeleteIconPackFolder(const std::wstring& folder) {\r\n    WIN32_FIND_DATA data;\r\n    const HANDLE find = FindFirstFile((folder + L\"\\\\*\").c_str(), &data);\r\n    if (find != INVALID_HANDLE_VALUE) {\r\n        do {\r\n            if (!(data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) {\r\n                DeleteFile((folder + L\"\\\\\" + data.cFileName).c_str());\r\n            }\r\n        } while (FindNextFile(find, &data));\r\n        FindClose(find);\r\n    }\r\n    RemoveDirectory(folder.c_str());\r\n}\r\n\r\n// Reads the sources the islands ask for (see RequestIconSource), each one\r\n// once, and the user's folders again when they change (watched), until the\r\n// islands' thread ends (see ReleaseIconPictures).\r\nDWORD WINAPI IconThreadProc(LPVOID) {\r\n    const HRESULT com = CoInitializeEx(nullptr, COINIT_MULTITHREADED);\r\n    winrt::com_ptr<IWICImagingFactory> wic;\r\n    CoCreateInstance(CLSID_WICImagingFactory, nullptr, CLSCTX_INPROC_SERVER,\r\n                     IID_PPV_ARGS(wic.put()));\r\n    // (The SVGs drawn with it, see DrawSvgPicture.)\r\n    winrt::com_ptr<ID2D1Factory> d2d;\r\n    D2D1CreateFactory(D2D1_FACTORY_TYPE_SINGLE_THREADED, d2d.put());\r\n    // The user's folders watched (only the ones asked for).\r\n    std::vector<std::pair<std::wstring, HANDLE>> watches;\r\n    while (!g_iconStop) {\r\n        struct Job {\r\n            IconSourceKind kind;\r\n            std::wstring what;\r\n        };\r\n        std::vector<Job> jobs;\r\n        std::vector<std::wstring> watched;\r\n        AcquireSRWLockExclusive(&g_iconLock);\r\n        // (A pack deleted: its pictures gone, downloaded again if chosen.)\r\n        std::vector<std::wstring> deletes;\r\n        deletes.swap(g_iconDeletes);\r\n        std::erase_if(g_iconSources, [&](const IconSource& source) {\r\n            return source.kind == IconSourceKind::Online &&\r\n                   std::any_of(deletes.begin(), deletes.end(),\r\n                               [&](const std::wstring& folder) {\r\n                                   return folder.ends_with(L\"\\\\\" +\r\n                                                           source.what);\r\n                               });\r\n        });\r\n        for (auto& source : g_iconSources) {\r\n            if (source.kind == IconSourceKind::Folder &&\r\n                IsLocalDrivePath(source.what)) {\r\n                watched.push_back(source.what);\r\n            }\r\n            if (source.again) {\r\n                source.again = false;\r\n                jobs.push_back({source.kind, source.what});\r\n            }\r\n        }\r\n        ReleaseSRWLockExclusive(&g_iconLock);\r\n        for (const auto& folder : deletes) {\r\n            DeleteIconPackFolder(folder);\r\n        }\r\n        if (!deletes.empty()) {\r\n            g_iconDiskChanges++;\r\n            TellIconsRead();\r\n        }\r\n        std::erase_if(watches, [&](const auto& watch) {\r\n            if (std::find(watched.begin(), watched.end(), watch.first) !=\r\n                watched.end()) {\r\n                return false;\r\n            }\r\n            FindCloseChangeNotification(watch.second);\r\n            return true;\r\n        });\r\n        for (const auto& folder : watched) {\r\n            if (std::none_of(watches.begin(), watches.end(),\r\n                             [&](const auto& watch) {\r\n                                 return watch.first == folder;\r\n                             })) {\r\n                const HANDLE change = FindFirstChangeNotification(\r\n                    folder.c_str(), FALSE,\r\n                    FILE_NOTIFY_CHANGE_FILE_NAME |\r\n                        FILE_NOTIFY_CHANGE_LAST_WRITE |\r\n                        FILE_NOTIFY_CHANGE_SIZE);\r\n                if (change != INVALID_HANDLE_VALUE) {\r\n                    watches.push_back({folder, change});\r\n                }\r\n            }\r\n        }\r\n        for (const Job& job : jobs) {\r\n            if (g_iconStop) {\r\n                break;\r\n            }\r\n            IconSourceState state = IconSourceState::Ready;\r\n            std::vector<IconPicture> pictures;\r\n            if (!wic) {\r\n                state = IconSourceState::Failed;\r\n            } else if (job.kind == IconSourceKind::Folder) {\r\n                if (IsLocalDrivePath(job.what)) {\r\n                    pictures = ReadIconFolder(wic.get(), d2d.get(), job.what,\r\n                                              nullptr);\r\n                } else {\r\n                    state = IconSourceState::NotLocal;\r\n                }\r\n            } else if (job.kind == IconSourceKind::Online) {\r\n                const OnlineIconPack* pack = nullptr;\r\n                for (const auto& online : kOnlineIconPacks) {\r\n                    if (job.what == online.folder) {\r\n                        pack = &online;\r\n                    }\r\n                }\r\n                const std::wstring folder =\r\n                    pack ? OnlineIconPackFolder(*pack) : std::wstring();\r\n                if (folder.empty() || !DownloadIconPack(*pack, folder)) {\r\n                    state = IconSourceState::Failed;\r\n                }\r\n                g_iconDiskChanges++;\r\n                if (!folder.empty()) {\r\n                    pictures =\r\n                        ReadIconFolder(wic.get(), d2d.get(), folder, pack);\r\n                }\r\n            } else {\r\n                for (const auto& [glyph, path] :\r\n                     DecodeIconFiles(job.what).files) {\r\n                    IconPicture picture{glyph};\r\n                    if (g_iconStop) {\r\n                        break;\r\n                    }\r\n                    if (ReadIconPicture(wic.get(), d2d.get(), path,\r\n                                        &picture)) {\r\n                        pictures.push_back(std::move(picture));\r\n                    }\r\n                }\r\n            }\r\n            if (g_iconStop) {\r\n                break;\r\n            }\r\n            AcquireSRWLockExclusive(&g_iconLock);\r\n            for (auto& source : g_iconSources) {\r\n                if (source.kind == job.kind && source.what == job.what) {\r\n                    source.state = state;\r\n                    source.pictures = std::move(pictures);\r\n                    source.serial = ++g_iconSerial;\r\n                    break;\r\n                }\r\n            }\r\n            ReleaseSRWLockExclusive(&g_iconLock);\r\n            TellIconsRead();\r\n        }\r\n        // Then a request, a change in a watched folder, or the end.\r\n        std::vector<HANDLE> handles{g_iconStopEvent, g_iconKick};\r\n        for (const auto& watch : watches) {\r\n            handles.push_back(watch.second);\r\n        }\r\n        const DWORD woken = WaitForMultipleObjects(\r\n            (DWORD)handles.size(), handles.data(), FALSE, INFINITE);\r\n        if (woken == WAIT_OBJECT_0 || woken == WAIT_FAILED) {\r\n            break;\r\n        }\r\n        if (woken >= WAIT_OBJECT_0 + 2 &&\r\n            woken < WAIT_OBJECT_0 + handles.size()) {\r\n            // (Read once the files are written: the changes settled. A\r\n            // watch that can't go on, its folder gone, is dropped: made\r\n            // again above once the folder is back.)\r\n            const size_t index = woken - WAIT_OBJECT_0 - 2;\r\n            const std::wstring folder = watches[index].first;\r\n            const HANDLE change = watches[index].second;\r\n            bool watching = FindNextChangeNotification(change);\r\n            for (int times = 0;\r\n                 watching && times < kIconChangeSettleTimes &&\r\n                 WaitForSingleObject(g_iconStopEvent, 0) == WAIT_TIMEOUT &&\r\n                 WaitForSingleObject(change, kIconChangeSettleMs) ==\r\n                     WAIT_OBJECT_0;\r\n                 times++) {\r\n                watching = FindNextChangeNotification(change);\r\n            }\r\n            if (!watching) {\r\n                FindCloseChangeNotification(change);\r\n                watches.erase(watches.begin() + index);\r\n            }\r\n            AcquireSRWLockExclusive(&g_iconLock);\r\n            for (auto& source : g_iconSources) {\r\n                if (source.kind == IconSourceKind::Folder &&\r\n                    source.what == folder) {\r\n                    source.again = true;\r\n                }\r\n            }\r\n            ReleaseSRWLockExclusive(&g_iconLock);\r\n        }\r\n    }\r\n    for (const auto& watch : watches) {\r\n        FindCloseChangeNotification(watch.second);\r\n    }\r\n    wic = nullptr;\r\n    d2d = nullptr;\r\n    if (SUCCEEDED(com)) {\r\n        CoUninitialize();\r\n    }\r\n    return 0;\r\n}\r\n\r\nvoid KickIconThread();\r\n\r\n// A source the islands draw from, asked for (read on the icons' thread,\r\n// started now if it isn't running); `again`: read it again (an online pack\r\n// that couldn't be downloaded, tried again). The islands' thread only.\r\nvoid RequestIconSource(IconSourceKind kind,\r\n                       std::wstring_view what,\r\n                       bool again = false) {\r\n    AcquireSRWLockExclusive(&g_iconLock);\r\n    auto it = std::find_if(g_iconSources.begin(), g_iconSources.end(),\r\n                           [&](const IconSource& source) {\r\n                               return source.kind == kind &&\r\n                                      source.what == what;\r\n                           });\r\n    const bool asked = it == g_iconSources.end() || again;\r\n    if (it == g_iconSources.end()) {\r\n        if (g_iconSources.size() >= kIconSourcesMost) {\r\n            g_iconSources.erase(g_iconSources.begin());\r\n        }\r\n        g_iconSources.push_back({kind, std::wstring(what)});\r\n    } else if (again) {\r\n        it->again = true;\r\n        it->state = IconSourceState::Reading;\r\n    }\r\n    ReleaseSRWLockExclusive(&g_iconLock);\r\n    if (asked) {\r\n        KickIconThread();\r\n    }\r\n}\r\n\r\n// The icons' thread told to look at what's asked (started first if it\r\n// isn't running).\r\nvoid KickIconThread() {\r\n    if (!g_iconThread) {\r\n        g_iconStop = false;\r\n        AcquireSRWLockExclusive(&g_iconCancel.lock);\r\n        g_iconCancel.canceled = false;\r\n        ReleaseSRWLockExclusive(&g_iconCancel.lock);\r\n        if (!g_iconStopEvent) {\r\n            g_iconStopEvent = CreateEvent(nullptr, TRUE, FALSE, nullptr);\r\n        }\r\n        if (!g_iconKick) {\r\n            g_iconKick = CreateEvent(nullptr, FALSE, FALSE, nullptr);\r\n        }\r\n        if (g_iconStopEvent && g_iconKick) {\r\n            g_iconThread =\r\n                CreateThread(nullptr, 0, IconThreadProc, nullptr, 0, nullptr);\r\n        }\r\n        if (!g_iconThread) {\r\n            IslandLog(L\"The icons' thread couldn't start: %u\",\r\n                      GetLastError());\r\n            return;\r\n        }\r\n    }\r\n    SetEvent(g_iconKick);\r\n}\r\n\r\n// An online pack's pictures deleted from the mod's storage (on the icons'\r\n// thread; chosen again, it's downloaded again).\r\nvoid DeleteIconPack(int pack) {\r\n    const OnlineIconPack* online = FindOnlineIconPack(pack);\r\n    const std::wstring folder =\r\n        online ? OnlineIconPackPath(*online) : std::wstring();\r\n    if (folder.empty()) {\r\n        return;\r\n    }\r\n    AcquireSRWLockExclusive(&g_iconLock);\r\n    g_iconDeletes.push_back(folder);\r\n    ReleaseSRWLockExclusive(&g_iconLock);\r\n    KickIconThread();\r\n}\r\n\r\n// An online pack's download under way: how far (0 to 1), or -1 when it\r\n// isn't downloading.\r\nfloat IconPackProgress(int pack) {\r\n    const OnlineIconPack* online = FindOnlineIconPack(pack);\r\n    if (!online) {\r\n        return -1;\r\n    }\r\n    float progress = -1;\r\n    AcquireSRWLockShared(&g_iconLock);\r\n    for (const auto& source : g_iconSources) {\r\n        if (source.kind == IconSourceKind::Online &&\r\n            source.what == online->folder &&\r\n            source.state == IconSourceState::Downloading) {\r\n            progress = source.total > 0\r\n                           ? std::clamp((float)source.done / source.total,\r\n                                        0.0f, 1.0f)\r\n                           : 0.0f;\r\n        }\r\n    }\r\n    ReleaseSRWLockShared(&g_iconLock);\r\n    return progress;\r\n}\r\n\r\n// Whether any online pack is downloading (the settings' list moving).\r\nbool IconPacksDownloading() {\r\n    return std::any_of(std::begin(kOnlineIconPacks), std::end(kOnlineIconPacks),\r\n                       [](const OnlineIconPack& online) {\r\n                           return IconPackProgress(online.pack) >= 0;\r\n                       });\r\n}\r\n\r\n// The source the current island's pack draws from (none: the font's, or\r\n// the emoji's): its kind and what it is.\r\nbool CurrentIconSource(IconSourceKind* kind, std::wstring* what) {\r\n    if (g_settings.islandIconPack == kIconPackFolder &&\r\n        !g_iconFolder.empty()) {\r\n        *kind = IconSourceKind::Folder;\r\n        *what = g_iconFolder;\r\n        return true;\r\n    }\r\n    if (const OnlineIconPack* online =\r\n            FindOnlineIconPack(g_settings.islandIconPack)) {\r\n        *kind = IconSourceKind::Online;\r\n        *what = online->folder;\r\n        return true;\r\n    }\r\n    return false;\r\n}\r\n\r\n// What the icon pack's row says about it (empty: nothing): an online one\r\n// downloading (how far) or not downloaded, a folder not on this computer or\r\n// without any icon's picture.\r\nstd::wstring IconSourceStatus(IconSourceKind kind, const std::wstring& what) {\r\n    std::wstring status;\r\n    AcquireSRWLockShared(&g_iconLock);\r\n    for (const auto& source : g_iconSources) {\r\n        if (source.kind != kind || source.what != what) {\r\n            continue;\r\n        }\r\n        if (source.state == IconSourceState::Downloading) {\r\n            status = std::wstring(Tr(L\"Downloading the icons\",\r\n                                     L\"Baixando os ícones\")) +\r\n                     L\" · \" + std::to_wstring(source.done) + L\"/\" +\r\n                     std::to_wstring(source.total);\r\n        } else if (source.state == IconSourceState::Failed) {\r\n            status = Tr(L\"Couldn't download them: click it again to try\",\r\n                        L\"Não deu para baixar: clique de novo para tentar\");\r\n        } else if (source.state == IconSourceState::NotLocal) {\r\n            status = Tr(L\"Only a folder on this computer\",\r\n                        L\"Só uma pasta deste computador\");\r\n        } else if (source.state == IconSourceState::Ready &&\r\n                   source.pictures.empty()) {\r\n            status = Tr(L\"No icon's picture in that folder\",\r\n                        L\"Nenhuma imagem de ícone nessa pasta\");\r\n        }\r\n    }\r\n    ReleaseSRWLockShared(&g_iconLock);\r\n    return status;\r\n}\r\n\r\nstd::wstring IconPackStatus() {\r\n    IconSourceKind kind;\r\n    std::wstring what;\r\n    return CurrentIconSource(&kind, &what) ? IconSourceStatus(kind, what)\r\n                                           : std::wstring();\r\n}\r\n\r\n// The same for the weather's set (none: nothing to say).\r\nstd::wstring WeatherIconsStatus() {\r\n    const OnlineIconPack* set =\r\n        FindOnlineIconPack(WeatherSetOf(g_settings.islandWeatherIcons));\r\n    return set ? IconSourceStatus(IconSourceKind::Online, set->folder)\r\n               : std::wstring();\r\n}\r\n\r\n// Drawn by the islands' thread: for each drawing target (one only kept\r\n// here is let go), the bitmaps made of the sources' pictures (by size\r\n// steps: an icon growing in an animation doesn't make one each frame); the\r\n// fonts' formats (Windows 10's icons, the emojis), and which icons Windows\r\n// 10's font has.\r\nstruct IconTargetBitmap {\r\n    UINT serial;\r\n    WCHAR glyph;\r\n    int pixels;\r\n    winrt::com_ptr<ID2D1Bitmap> bitmap;\r\n};\r\nstruct IconTargetBitmaps {\r\n    winrt::com_ptr<ID2D1RenderTarget> target;\r\n    UINT64 used = 0;\r\n    std::vector<IconTargetBitmap> bitmaps;\r\n};\r\nstd::vector<IconTargetBitmaps> g_iconTargets;\r\nUINT64 g_iconUses = 0;\r\nwinrt::com_ptr<IWICImagingFactory> g_iconWic;\r\nwinrt::com_ptr<IDWriteFactory> g_iconDwrite;\r\nstruct IconFontFormat {\r\n    PCWSTR family;\r\n    float size;\r\n    DWRITE_TEXT_ALIGNMENT across;\r\n    DWRITE_PARAGRAPH_ALIGNMENT down;\r\n    winrt::com_ptr<IDWriteTextFormat> format;\r\n};\r\nstd::vector<IconFontFormat> g_iconFormats;\r\nstd::vector<std::pair<WCHAR, bool>> g_windows10Glyphs;\r\nconstexpr size_t kIconTargetsMost = 32;\r\nconstexpr size_t kIconBitmapsMost = 256;\r\nconstexpr size_t kIconFormatsMost = 64;\r\nconstexpr int kIconPixelSizes[] = {16, 20, 24, 32, 40, 48, 64, 96, 128};\r\nconstexpr WCHAR kWindows10IconFont[] = L\"Segoe MDL2 Assets\";\r\nconstexpr WCHAR kEmojiFont[] = L\"Segoe UI Emoji\";\r\n// The emojis fill their whole box, the icons not quite.\r\nconstexpr float kEmojiScale = 0.86f;\r\n\r\n// The bitmaps' size step for an icon drawn `wanted` pixels big.\r\nint IconPixels(float wanted) {\r\n    for (int size : kIconPixelSizes) {\r\n        if (size >= wanted) {\r\n            return size;\r\n        }\r\n    }\r\n    return kIconPixelSizes[std::size(kIconPixelSizes) - 1];\r\n}\r\n\r\n// The bitmaps made for `target` (see IconTargetBitmaps).\r\nIconTargetBitmaps& IconTargetOf(ID2D1RenderTarget* target) {\r\n    auto kept = std::find_if(g_iconTargets.begin(), g_iconTargets.end(),\r\n                             [&](const IconTargetBitmaps& entry) {\r\n                                 return entry.target.get() == target;\r\n                             });\r\n    if (kept == g_iconTargets.end()) {\r\n        // The targets only kept here (their windows gone) go first, then the\r\n        // least used one when there are too many.\r\n        std::erase_if(g_iconTargets, [](const IconTargetBitmaps& entry) {\r\n            entry.target->AddRef();\r\n            return entry.target->Release() == 1;\r\n        });\r\n        if (g_iconTargets.size() >= kIconTargetsMost) {\r\n            g_iconTargets.erase(std::min_element(\r\n                g_iconTargets.begin(), g_iconTargets.end(),\r\n                [](const IconTargetBitmaps& a, const IconTargetBitmaps& b) {\r\n                    return a.used < b.used;\r\n                }));\r\n        }\r\n        g_iconTargets.push_back({});\r\n        kept = std::prev(g_iconTargets.end());\r\n        kept->target.copy_from(target);\r\n    }\r\n    kept->used = ++g_iconUses;\r\n    return *kept;\r\n}\r\n\r\n// A bitmap `pixels` big to draw on (at 96 DPI: its DIPs are its pixels);\r\n// nullptr if it can't be.\r\nwinrt::com_ptr<ID2D1BitmapRenderTarget> IconCanvas(ID2D1RenderTarget* target,\r\n                                                   int pixels) {\r\n    const D2D1_SIZE_F size{(float)pixels, (float)pixels};\r\n    const D2D1_SIZE_U pixelSize{(UINT32)pixels, (UINT32)pixels};\r\n    winrt::com_ptr<ID2D1BitmapRenderTarget> canvas;\r\n    if (FAILED(target->CreateCompatibleRenderTarget(\r\n            &size, &pixelSize, nullptr,\r\n            D2D1_COMPATIBLE_RENDER_TARGET_OPTIONS_NONE, canvas.put()))) {\r\n        return nullptr;\r\n    }\r\n    return canvas;\r\n}\r\n\r\n// A source's picture as a bitmap of `target`'s, at least `wanted` pixels\r\n// big (or as big as it is); nullptr if it can't be.\r\nID2D1Bitmap* IconBitmap(ID2D1RenderTarget* target,\r\n                        UINT serial,\r\n                        const IconPicture& picture,\r\n                        float wanted) {\r\n    const int pixels = IconPixels(wanted);\r\n    IconTargetBitmaps* kept = &IconTargetOf(target);\r\n    for (const auto& made : kept->bitmaps) {\r\n        if (made.serial == serial && made.glyph == picture.glyph &&\r\n            made.pixels == pixels) {\r\n            return made.bitmap.get();\r\n        }\r\n    }\r\n    // (The ones of pictures read before go.)\r\n    std::erase_if(kept->bitmaps, [&](const IconTargetBitmap& made) {\r\n        return made.glyph == picture.glyph && made.serial != serial;\r\n    });\r\n    if (kept->bitmaps.size() >= kIconBitmapsMost) {\r\n        kept->bitmaps.clear();\r\n    }\r\n    winrt::com_ptr<ID2D1Bitmap> bitmap;\r\n    if (!picture.pixels.empty()) {\r\n        // Made smaller to fit, its proportions kept (one already smaller,\r\n        // as it is).\r\n        const float fit =\r\n            std::min(1.0f, (float)pixels / (float)std::max(picture.width,\r\n                                                           picture.height));\r\n        winrt::com_ptr<IWICBitmap> memory;\r\n        winrt::com_ptr<IWICBitmapScaler> scaler;\r\n        if (fit >= 1) {\r\n            target->CreateBitmap(\r\n                D2D1::SizeU(picture.width, picture.height),\r\n                picture.pixels.data(), picture.width * 4,\r\n                D2D1::BitmapProperties(D2D1::PixelFormat(\r\n                    DXGI_FORMAT_B8G8R8A8_UNORM,\r\n                    D2D1_ALPHA_MODE_PREMULTIPLIED)),\r\n                bitmap.put());\r\n        } else if ((g_iconWic ||\r\n                    SUCCEEDED(CoCreateInstance(\r\n                        CLSID_WICImagingFactory, nullptr,\r\n                        CLSCTX_INPROC_SERVER,\r\n                        IID_PPV_ARGS(g_iconWic.put())))) &&\r\n                   SUCCEEDED(g_iconWic->CreateBitmapFromMemory(\r\n                       picture.width, picture.height,\r\n                       GUID_WICPixelFormat32bppPBGRA, picture.width * 4,\r\n                       (UINT)picture.pixels.size(),\r\n                       const_cast<BYTE*>(picture.pixels.data()),\r\n                       memory.put())) &&\r\n                   SUCCEEDED(g_iconWic->CreateBitmapScaler(scaler.put())) &&\r\n                   SUCCEEDED(scaler->Initialize(\r\n                       memory.get(),\r\n                       std::max(1u, (UINT)std::lround(picture.width * fit)),\r\n                       std::max(1u, (UINT)std::lround(picture.height * fit)),\r\n                       WICBitmapInterpolationModeFant))) {\r\n            target->CreateBitmapFromWicBitmap(scaler.get(), nullptr,\r\n                                              bitmap.put());\r\n        }\r\n    }\r\n    kept->bitmaps.push_back({serial, picture.glyph, pixels, bitmap});\r\n    return kept->bitmaps.back().bitmap.get();\r\n}\r\n\r\n// Where the font would draw an icon of `size` in `rect` (by `format`'s\r\n// alignments): its square's top left corner.\r\nD2D1_POINT_2F IconCorner(IDWriteTextFormat* format,\r\n                         const D2D1_RECT_F& rect,\r\n                         float size) {\r\n    const DWRITE_TEXT_ALIGNMENT across = format->GetTextAlignment();\r\n    const DWRITE_PARAGRAPH_ALIGNMENT down = format->GetParagraphAlignment();\r\n    return {across == DWRITE_TEXT_ALIGNMENT_LEADING ? rect.left\r\n            : across == DWRITE_TEXT_ALIGNMENT_TRAILING\r\n                ? rect.right - size\r\n                : (rect.left + rect.right - size) / 2,\r\n            down == DWRITE_PARAGRAPH_ALIGNMENT_NEAR ? rect.top\r\n            : down == DWRITE_PARAGRAPH_ALIGNMENT_FAR\r\n                ? rect.bottom - size\r\n                : (rect.top + rect.bottom - size) / 2};\r\n}\r\n\r\n// How much `target` draws bigger (an icon's pixels as big as it's drawn).\r\nfloat TargetZoom(ID2D1RenderTarget* target) {\r\n    D2D1_MATRIX_3X2_F transform;\r\n    target->GetTransform(&transform);\r\n    return std::sqrt(std::fabs(transform._11 * transform._22 -\r\n                               transform._12 * transform._21));\r\n}\r\n\r\n// A picture in its own colors drawn as see-through as `brush` would draw.\r\nvoid DrawIconOwnColors(ID2D1RenderTarget* target,\r\n                       ID2D1Bitmap* bitmap,\r\n                       const D2D1_RECT_F& box,\r\n                       ID2D1Brush* brush) {\r\n    float opacity = brush->GetOpacity();\r\n    winrt::com_ptr<ID2D1SolidColorBrush> solid;\r\n    if (SUCCEEDED(brush->QueryInterface(IID_PPV_ARGS(solid.put())))) {\r\n        opacity *= solid->GetColor().a;\r\n    }\r\n    DrawBitmapSmooth(target, bitmap, box, opacity);\r\n}\r\n\r\n// A source's picture for `glyph` drawn where the font would draw it: only\r\n// its shape, in the brush's color like the font's (`tint`), or with its own\r\n// colors. False without one (the source asked for if it isn't yet).\r\nbool DrawIconPicture(ID2D1RenderTarget* target,\r\n                     IconSourceKind kind,\r\n                     std::wstring_view what,\r\n                     WCHAR glyph,\r\n                     IDWriteTextFormat* format,\r\n                     const D2D1_RECT_F& rect,\r\n                     ID2D1Brush* brush,\r\n                     bool tint) {\r\n    AcquireSRWLockShared(&g_iconLock);\r\n    const auto source = std::find_if(\r\n        g_iconSources.begin(), g_iconSources.end(),\r\n        [&](const IconSource& own) {\r\n            return own.kind == kind && own.what == what;\r\n        });\r\n    if (source == g_iconSources.end()) {\r\n        ReleaseSRWLockShared(&g_iconLock);\r\n        RequestIconSource(kind, what);\r\n        return false;\r\n    }\r\n    const auto picture = std::find_if(\r\n        source->pictures.begin(), source->pictures.end(),\r\n        [&](const IconPicture& own) { return own.glyph == glyph; });\r\n    bool drawn = false;\r\n    if (picture != source->pictures.end()) {\r\n        const float size = format->GetFontSize();\r\n        if (ID2D1Bitmap* bitmap = IconBitmap(target, source->serial, *picture,\r\n                                             size * TargetZoom(target))) {\r\n            const D2D1_POINT_2F corner = IconCorner(format, rect, size);\r\n            const D2D1_SIZE_U pixels = bitmap->GetPixelSize();\r\n            const float fit =\r\n                size / (float)std::max(pixels.width, pixels.height);\r\n            const float width = pixels.width * fit;\r\n            const float height = pixels.height * fit;\r\n            const D2D1_RECT_F box{corner.x + (size - width) / 2,\r\n                                  corner.y + (size - height) / 2,\r\n                                  corner.x + (size + width) / 2,\r\n                                  corner.y + (size + height) / 2};\r\n            if (tint) {\r\n                // (Its opacity as the mask, which Direct2D only draws\r\n                // aliased.)\r\n                const D2D1_ANTIALIAS_MODE mode = target->GetAntialiasMode();\r\n                target->SetAntialiasMode(D2D1_ANTIALIAS_MODE_ALIASED);\r\n                target->FillOpacityMask(bitmap, brush,\r\n                                        D2D1_OPACITY_MASK_CONTENT_GRAPHICS,\r\n                                        &box);\r\n                target->SetAntialiasMode(mode);\r\n            } else {\r\n                DrawIconOwnColors(target, bitmap, box, brush);\r\n            }\r\n            drawn = true;\r\n        }\r\n    }\r\n    ReleaseSRWLockShared(&g_iconLock);\r\n    return drawn;\r\n}\r\n\r\n// Another font's format (kept, see g_iconFormats); nullptr if it can't be.\r\nIDWriteTextFormat* IconFontFormatFor(PCWSTR family,\r\n                                     float size,\r\n                                     DWRITE_TEXT_ALIGNMENT across,\r\n                                     DWRITE_PARAGRAPH_ALIGNMENT down) {\r\n    if (!g_iconDwrite &&\r\n        FAILED(DWriteCreateFactory(DWRITE_FACTORY_TYPE_SHARED,\r\n                                   __uuidof(IDWriteFactory),\r\n                                   (IUnknown**)g_iconDwrite.put()))) {\r\n        return nullptr;\r\n    }\r\n    auto made = std::find_if(\r\n        g_iconFormats.begin(), g_iconFormats.end(),\r\n        [&](const IconFontFormat& kept) {\r\n            return kept.family == family && kept.size == size &&\r\n                   kept.across == across && kept.down == down;\r\n        });\r\n    if (made == g_iconFormats.end()) {\r\n        if (g_iconFormats.size() >= kIconFormatsMost) {\r\n            g_iconFormats.clear();\r\n        }\r\n        winrt::com_ptr<IDWriteTextFormat> own;\r\n        if (FAILED(g_iconDwrite->CreateTextFormat(\r\n                family, nullptr, DWRITE_FONT_WEIGHT_NORMAL,\r\n                DWRITE_FONT_STYLE_NORMAL, DWRITE_FONT_STRETCH_NORMAL, size,\r\n                L\"\", own.put()))) {\r\n            return nullptr;\r\n        }\r\n        own->SetTextAlignment(across);\r\n        own->SetParagraphAlignment(down);\r\n        own->SetWordWrapping(DWRITE_WORD_WRAPPING_NO_WRAP);\r\n        g_iconFormats.push_back({family, size, across, down, own});\r\n        made = std::prev(g_iconFormats.end());\r\n    }\r\n    return made->format.get();\r\n}\r\n\r\n// `text` drawn with another font, in `format`'s place and size (times\r\n// `scale`): Windows 10's icons, an emoji in the brush's color.\r\nvoid DrawIconWithFont(ID2D1RenderTarget* target,\r\n                      PCWSTR family,\r\n                      PCWSTR text,\r\n                      IDWriteTextFormat* format,\r\n                      float scale,\r\n                      const D2D1_RECT_F& rect,\r\n                      ID2D1Brush* brush) {\r\n    if (IDWriteTextFormat* own = IconFontFormatFor(\r\n            family, format->GetFontSize() * scale, format->GetTextAlignment(),\r\n            format->GetParagraphAlignment())) {\r\n        target->DrawText(text, (UINT32)wcslen(text), own, rect, brush);\r\n    }\r\n}\r\n\r\n// An emoji in its own colors drawn where the font would draw `glyph`'s\r\n// icon. Drawn once in a bitmap (each size step, see IconBitmap): a color\r\n// emoji is many layers, too slow to draw with every frame.\r\nvoid DrawColorEmoji(ID2D1RenderTarget* target,\r\n                    WCHAR glyph,\r\n                    PCWSTR emoji,\r\n                    IDWriteTextFormat* format,\r\n                    const D2D1_RECT_F& rect,\r\n                    ID2D1Brush* brush) {\r\n    // (Kept as the pictures of source 0, which no source is.)\r\n    constexpr UINT kEmojiSerial = 0;\r\n    const float size = format->GetFontSize();\r\n    const int pixels = IconPixels(size * TargetZoom(target));\r\n    IconTargetBitmaps& kept = IconTargetOf(target);\r\n    auto made = std::find_if(kept.bitmaps.begin(), kept.bitmaps.end(),\r\n                             [&](const IconTargetBitmap& own) {\r\n                                 return own.serial == kEmojiSerial &&\r\n                                        own.glyph == glyph &&\r\n                                        own.pixels == pixels;\r\n                             });\r\n    if (made == kept.bitmaps.end()) {\r\n        if (kept.bitmaps.size() >= kIconBitmapsMost) {\r\n            kept.bitmaps.clear();\r\n        }\r\n        winrt::com_ptr<ID2D1Bitmap> bitmap;\r\n        IDWriteTextFormat* own = IconFontFormatFor(\r\n            kEmojiFont, pixels * kEmojiScale, DWRITE_TEXT_ALIGNMENT_CENTER,\r\n            DWRITE_PARAGRAPH_ALIGNMENT_CENTER);\r\n        winrt::com_ptr<ID2D1BitmapRenderTarget> canvas;\r\n        winrt::com_ptr<ID2D1SolidColorBrush> ink;\r\n        if (own) {\r\n            canvas = IconCanvas(target, pixels);\r\n        }\r\n        if (canvas && SUCCEEDED(canvas->CreateSolidColorBrush(\r\n                          D2D1::ColorF(D2D1::ColorF::White), ink.put()))) {\r\n            // (Gray edges: ClearType's colored ones need a background.)\r\n            canvas->SetTextAntialiasMode(D2D1_TEXT_ANTIALIAS_MODE_GRAYSCALE);\r\n            canvas->BeginDraw();\r\n            canvas->Clear(D2D1::ColorF(0, 0, 0, 0));\r\n            canvas->DrawText(emoji, (UINT32)wcslen(emoji), own,\r\n                             {0, 0, (float)pixels, (float)pixels}, ink.get(),\r\n                             D2D1_DRAW_TEXT_OPTIONS_ENABLE_COLOR_FONT);\r\n            if (SUCCEEDED(canvas->EndDraw())) {\r\n                canvas->GetBitmap(bitmap.put());\r\n            }\r\n        }\r\n        kept.bitmaps.push_back({kEmojiSerial, glyph, pixels, bitmap});\r\n        made = std::prev(kept.bitmaps.end());\r\n    }\r\n    if (made->bitmap) {\r\n        const D2D1_POINT_2F corner = IconCorner(format, rect, size);\r\n        DrawIconOwnColors(target, made->bitmap.get(),\r\n                          {corner.x, corner.y, corner.x + size,\r\n                           corner.y + size},\r\n                          brush);\r\n    } else {\r\n        // (No bitmap: in the brush's color.)\r\n        DrawIconWithFont(target, kEmojiFont, emoji, format, kEmojiScale, rect,\r\n                         brush);\r\n    }\r\n}\r\n\r\n// Whether Windows 10's icon font has `glyph` (its newer icons are only in\r\n// Windows 11's), asked once each.\r\nbool Windows10FontHas(WCHAR glyph) {\r\n    for (const auto& [kept, has] : g_windows10Glyphs) {\r\n        if (kept == glyph) {\r\n            return has;\r\n        }\r\n    }\r\n    bool has = false;\r\n    winrt::com_ptr<IDWriteFontCollection> fonts;\r\n    UINT32 index = 0;\r\n    BOOL exists = FALSE;\r\n    winrt::com_ptr<IDWriteFontFamily> family;\r\n    winrt::com_ptr<IDWriteFont> font;\r\n    if ((g_iconDwrite ||\r\n         SUCCEEDED(DWriteCreateFactory(DWRITE_FACTORY_TYPE_SHARED,\r\n                                       __uuidof(IDWriteFactory),\r\n                                       (IUnknown**)g_iconDwrite.put()))) &&\r\n        SUCCEEDED(g_iconDwrite->GetSystemFontCollection(fonts.put())) &&\r\n        SUCCEEDED(fonts->FindFamilyName(kWindows10IconFont, &index,\r\n                                        &exists)) &&\r\n        exists && SUCCEEDED(fonts->GetFontFamily(index, family.put())) &&\r\n        SUCCEEDED(family->GetFirstMatchingFont(\r\n            DWRITE_FONT_WEIGHT_NORMAL, DWRITE_FONT_STRETCH_NORMAL,\r\n            DWRITE_FONT_STYLE_NORMAL, font.put()))) {\r\n        font->HasCharacter(glyph, &exists);\r\n        has = exists;\r\n    }\r\n    g_windows10Glyphs.push_back({glyph, has});\r\n    return has;\r\n}\r\n\r\n// The icon drawn by the user's choice (see IconPackId): a picture chosen\r\n// for it, the pack's picture or emoji, or Windows 10's; false for the\r\n// font's (Windows 11's), as before. On the islands' thread only (the dock's\r\n// icons in explorer stay the font's).\r\nbool DrawChosenIcon(ID2D1RenderTarget* target,\r\n                    WCHAR glyph,\r\n                    IDWriteTextFormat* format,\r\n                    const D2D1_RECT_F& rect,\r\n                    ID2D1Brush* brush) {\r\n    const int pack = g_settings.islandIconPack;\r\n    if ((pack == kIconPackWindows && g_iconFiles.files.empty()) ||\r\n        GetCurrentThreadId() != g_islandThreadId) {\r\n        return false;\r\n    }\r\n    // (Only the mod's icons: not a letter or a figure drawn alone.)\r\n    const IconInfo* icon = FindIcon(glyph);\r\n    if (!icon) {\r\n        return false;\r\n    }\r\n    const bool ownColors = g_settings.islandIconColors == 1;\r\n    if (std::any_of(g_iconFiles.files.begin(), g_iconFiles.files.end(),\r\n                    [&](const auto& file) { return file.first == glyph; }) &&\r\n        DrawIconPicture(target, IconSourceKind::Files, g_iconFiles.text,\r\n                        glyph, format, rect, brush, !ownColors)) {\r\n        return true;\r\n    }\r\n    switch (pack) {\r\n        case kIconPackWindows10: {\r\n            if (wcscmp(IconFont(), kWindows10IconFont) == 0 ||\r\n                !Windows10FontHas(glyph)) {\r\n                return false;\r\n            }\r\n            const WCHAR text[] = {glyph, 0};\r\n            DrawIconWithFont(target, kWindows10IconFont, text, format, 1,\r\n                             rect, brush);\r\n            return true;\r\n        }\r\n        case kIconPackEmoji:\r\n            if (!icon->emoji) {\r\n                return false;\r\n            }\r\n            if (ownColors) {\r\n                DrawColorEmoji(target, glyph, icon->emoji, format, rect,\r\n                               brush);\r\n            } else {\r\n                DrawIconWithFont(target, kEmojiFont, icon->emoji, format,\r\n                                 kEmojiScale, rect, brush);\r\n            }\r\n            return true;\r\n        case kIconPackFolder:\r\n            return !g_iconFolder.empty() &&\r\n                   DrawIconPicture(target, IconSourceKind::Folder,\r\n                                   g_iconFolder, glyph, format, rect, brush,\r\n                                   !ownColors);\r\n        default:\r\n            if (const OnlineIconPack* online = FindOnlineIconPack(pack)) {\r\n                return DrawIconPicture(target, IconSourceKind::Online,\r\n                                       online->folder, glyph, format, rect,\r\n                                       brush, true);\r\n            }\r\n            return false;\r\n    }\r\n}\r\n\r\n// An icon of the font drawn (like DrawText), as the user chose (see\r\n// DrawChosenIcon).\r\nvoid DrawGlyph(ID2D1RenderTarget* target,\r\n               const WCHAR* text,\r\n               UINT32 length,\r\n               IDWriteTextFormat* format,\r\n               const D2D1_RECT_F& rect,\r\n               ID2D1Brush* brush,\r\n               D2D1_DRAW_TEXT_OPTIONS options = D2D1_DRAW_TEXT_OPTIONS_NONE) {\r\n    // (In its own color, if one was chosen for it, as see-through as the\r\n    // brush would draw it.)\r\n    winrt::com_ptr<ID2D1SolidColorBrush> solid;\r\n    D2D1_COLOR_F before{};\r\n    if (const int color = length == 1 ? IconColorOf(text[0]) : -1;\r\n        color >= 0 &&\r\n        SUCCEEDED(brush->QueryInterface(IID_PPV_ARGS(solid.put())))) {\r\n        before = solid->GetColor();\r\n        solid->SetColor(D2D1::ColorF(((color >> 16) & 0xFF) / 255.0f,\r\n                                     ((color >> 8) & 0xFF) / 255.0f,\r\n                                     (color & 0xFF) / 255.0f, before.a));\r\n    }\r\n    if (length != 1 || !DrawChosenIcon(target, text[0], format, rect, brush)) {\r\n        // (A weather icon the pack hasn't has no glyph in the font: its\r\n        // emoji, in its colors.)\r\n        const IconInfo* weather =\r\n            length == 1 && IsWeatherIconGlyph(text[0]) ? FindIcon(text[0])\r\n                                                       : nullptr;\r\n        if (!weather) {\r\n            target->DrawText(text, length, format, rect, brush, options);\r\n        } else if (weather->emoji &&\r\n                   GetCurrentThreadId() == g_islandThreadId) {\r\n            DrawColorEmoji(target, text[0], weather->emoji, format, rect,\r\n                           brush);\r\n        }\r\n    }\r\n    if (solid) {\r\n        solid->SetColor(before);\r\n    }\r\n}\r\n\r\n// The picture a weather sky asks for (see WeatherSky), by the icons chosen\r\n// (islandWeatherIcons): the icon pack's, or one of the sets' (in color for\r\n// Meteocons, in the brush's color for Weather Icons), as big as `format`'s\r\n// font and by its alignments. False without one (not a mark, no picture in\r\n// that pack or set, or it isn't read yet: the emoji is drawn instead).\r\nbool DrawWeatherPicture(ID2D1RenderTarget* target,\r\n                        ID2D1Brush* brush,\r\n                        const std::wstring& sky,\r\n                        IDWriteTextFormat* format,\r\n                        const D2D1_RECT_F& rect) {\r\n    if (!IsWeatherSky(sky) || !format) {\r\n        return false;\r\n    }\r\n    const WCHAR glyph = sky[1];\r\n    const int choice = g_settings.islandWeatherIcons;\r\n    if (choice == 1) {\r\n        // (The first time: the pack's pictures asked for again, with the\r\n        // weather's.)\r\n        if (!g_weatherFromPacks.exchange(true)) {\r\n            IconSourceKind kind;\r\n            std::wstring what;\r\n            if (CurrentIconSource(&kind, &what)) {\r\n                RequestIconSource(kind, what, true);\r\n            }\r\n        }\r\n        return DrawChosenIcon(target, glyph, format, rect, brush);\r\n    }\r\n    if (const OnlineIconPack* set = FindOnlineIconPack(WeatherSetOf(choice))) {\r\n        return DrawIconPicture(target, IconSourceKind::Online, set->folder,\r\n                               glyph, format, rect, brush, choice != 2);\r\n    }\r\n    return false;\r\n}\r\n\r\n// The weather's pictures asked for now, after the choice: the icon pack's\r\n// (read again, for the weather's), or the set's (downloaded once; again if\r\n// it failed).\r\nvoid RequestWeatherPictures() {\r\n    const int choice = g_settings.islandWeatherIcons;\r\n    if (choice == 1) {\r\n        g_weatherFromPacks = true;\r\n        IconSourceKind kind;\r\n        std::wstring what;\r\n        if (CurrentIconSource(&kind, &what)) {\r\n            RequestIconSource(kind, what, true);\r\n        }\r\n    } else if (const OnlineIconPack* set =\r\n                   FindOnlineIconPack(WeatherSetOf(choice))) {\r\n        RequestIconSource(IconSourceKind::Online, set->folder, true);\r\n    }\r\n}\r\n\r\n// Instagram's logo in lines (a rounded square, a lens, a dot), the size of an\r\n// icon of the font, around its middle.\r\nvoid DrawInstagramLogo(ID2D1RenderTarget* target,\r\n                       ID2D1Brush* brush,\r\n                       D2D1_POINT_2F middle,\r\n                       float size) {\r\n    const float half = size / 2;\r\n    const float stroke = std::max(1.0f, size / 12);\r\n    const float inset = stroke / 2;\r\n    target->DrawRoundedRectangle(\r\n        {{middle.x - half + inset, middle.y - half + inset,\r\n          middle.x + half - inset, middle.y + half - inset},\r\n         size * 0.28f,\r\n         size * 0.28f},\r\n        brush, stroke);\r\n    target->DrawEllipse({middle, size * 0.22f, size * 0.22f}, brush, stroke);\r\n    const float dot = stroke * 0.8f;\r\n    target->FillEllipse(\r\n        {{middle.x + size * 0.25f, middle.y - size * 0.25f}, dot, dot}, brush);\r\n}\r\n\r\n// The islands' thread ending: the icons' thread stopped (a download under\r\n// way closed at once) and waited for, then the pictures and what was made\r\n// of them let go.\r\nvoid ReleaseIconPictures() {\r\n    if (g_iconThread) {\r\n        g_iconStop = true;\r\n        SetEvent(g_iconStopEvent);\r\n        CancelHttps(&g_iconCancel);\r\n        WaitForSingleObject(g_iconThread, INFINITE);\r\n        CloseHandle(g_iconThread);\r\n        g_iconThread = nullptr;\r\n    }\r\n    for (HANDLE* event : {&g_iconStopEvent, &g_iconKick}) {\r\n        if (*event) {\r\n            CloseHandle(*event);\r\n            *event = nullptr;\r\n        }\r\n    }\r\n    AcquireSRWLockExclusive(&g_iconLock);\r\n    g_iconSources.clear();\r\n    ReleaseSRWLockExclusive(&g_iconLock);\r\n    g_iconTargets.clear();\r\n    g_iconFormats.clear();\r\n    g_windows10Glyphs.clear();\r\n    g_iconWic = nullptr;\r\n    g_iconDwrite = nullptr;\r\n}\r\n\r\n// The font's icons saved in `folder` as PNG pictures named after them\r\n// (kIcons), black on transparent: a start for a pack of one's own (the\r\n// files already there are left as they are). How many were saved, or -1\r\n// when the folder couldn't be written.\r\nint SaveWindowsIcons(const std::wstring& folder) {\r\n    constexpr UINT kPixels = 64;\r\n    winrt::com_ptr<IWICImagingFactory> wic;\r\n    winrt::com_ptr<ID2D1Factory> d2d;\r\n    winrt::com_ptr<IDWriteFactory> dwrite;\r\n    winrt::com_ptr<IWICBitmap> bitmap;\r\n    winrt::com_ptr<ID2D1RenderTarget> target;\r\n    winrt::com_ptr<ID2D1SolidColorBrush> brush;\r\n    winrt::com_ptr<IDWriteTextFormat> format;\r\n    if (FAILED(CoCreateInstance(CLSID_WICImagingFactory, nullptr,\r\n                                CLSCTX_INPROC_SERVER,\r\n                                IID_PPV_ARGS(wic.put()))) ||\r\n        FAILED(D2D1CreateFactory(D2D1_FACTORY_TYPE_SINGLE_THREADED,\r\n                                 d2d.put())) ||\r\n        FAILED(DWriteCreateFactory(DWRITE_FACTORY_TYPE_SHARED,\r\n                                   __uuidof(IDWriteFactory),\r\n                                   (IUnknown**)dwrite.put())) ||\r\n        FAILED(wic->CreateBitmap(kPixels, kPixels,\r\n                                 GUID_WICPixelFormat32bppPBGRA,\r\n                                 WICBitmapCacheOnLoad, bitmap.put())) ||\r\n        FAILED(d2d->CreateWicBitmapRenderTarget(\r\n            bitmap.get(),\r\n            D2D1::RenderTargetProperties(\r\n                D2D1_RENDER_TARGET_TYPE_DEFAULT,\r\n                D2D1::PixelFormat(DXGI_FORMAT_B8G8R8A8_UNORM,\r\n                                  D2D1_ALPHA_MODE_PREMULTIPLIED),\r\n                96, 96),\r\n            target.put())) ||\r\n        FAILED(target->CreateSolidColorBrush(D2D1::ColorF(0, 0, 0),\r\n                                             brush.put())) ||\r\n        FAILED(dwrite->CreateTextFormat(\r\n            IconFont(), nullptr, DWRITE_FONT_WEIGHT_NORMAL,\r\n            DWRITE_FONT_STYLE_NORMAL, DWRITE_FONT_STRETCH_NORMAL,\r\n            (float)kPixels, L\"\", format.put()))) {\r\n        return -1;\r\n    }\r\n    format->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_CENTER);\r\n    format->SetParagraphAlignment(DWRITE_PARAGRAPH_ALIGNMENT_CENTER);\r\n    target->SetTextAntialiasMode(D2D1_TEXT_ANTIALIAS_MODE_GRAYSCALE);\r\n    int saved = 0;\r\n    bool failed = false;\r\n    for (const auto& icon : kIcons) {\r\n        // (The weather's have no glyph in the font to save.)\r\n        if (IsWeatherIconGlyph(icon.glyph)) {\r\n            continue;\r\n        }\r\n        const std::wstring path = folder + L\"\\\\\" + icon.name + L\".png\";\r\n        if (GetFileAttributes(path.c_str()) != INVALID_FILE_ATTRIBUTES) {\r\n            continue;\r\n        }\r\n        target->BeginDraw();\r\n        target->Clear(D2D1::ColorF(0, 0, 0, 0));\r\n        target->DrawText(&icon.glyph, 1, format.get(),\r\n                         D2D1::RectF(0, 0, kPixels, kPixels), brush.get());\r\n        winrt::com_ptr<IWICFormatConverter> converter;\r\n        winrt::com_ptr<IWICStream> stream;\r\n        winrt::com_ptr<IWICBitmapEncoder> encoder;\r\n        winrt::com_ptr<IWICBitmapFrameEncode> frame;\r\n        WICPixelFormatGUID pixelFormat = GUID_WICPixelFormat32bppBGRA;\r\n        if (FAILED(target->EndDraw()) ||\r\n            FAILED(wic->CreateFormatConverter(converter.put())) ||\r\n            FAILED(converter->Initialize(\r\n                bitmap.get(), GUID_WICPixelFormat32bppBGRA,\r\n                WICBitmapDitherTypeNone, nullptr, 0,\r\n                WICBitmapPaletteTypeMedianCut)) ||\r\n            FAILED(wic->CreateStream(stream.put())) ||\r\n            FAILED(stream->InitializeFromFilename(path.c_str(),\r\n                                                  GENERIC_WRITE)) ||\r\n            FAILED(wic->CreateEncoder(GUID_ContainerFormatPng, nullptr,\r\n                                      encoder.put())) ||\r\n            FAILED(encoder->Initialize(stream.get(),\r\n                                       WICBitmapEncoderNoCache)) ||\r\n            FAILED(encoder->CreateNewFrame(frame.put(), nullptr)) ||\r\n            FAILED(frame->Initialize(nullptr)) ||\r\n            FAILED(frame->SetSize(kPixels, kPixels)) ||\r\n            FAILED(frame->SetPixelFormat(&pixelFormat)) ||\r\n            FAILED(frame->WriteSource(converter.get(), nullptr)) ||\r\n            FAILED(frame->Commit()) || FAILED(encoder->Commit())) {\r\n            failed = true;\r\n            continue;\r\n        }\r\n        saved++;\r\n    }\r\n    return failed && !saved ? -1 : saved;\r\n}\r\n\r\nstruct HolidayRequest {\r\n    HWND notify;\r\n    int year;\r\n    std::wstring country;\r\n};\r\n\r\nDWORD WINAPI HolidayThreadProc(LPVOID parameter) {\r\n    std::unique_ptr<HolidayRequest> request((HolidayRequest*)parameter);\r\n    std::vector<BYTE> data;\r\n    const std::wstring url = L\"https://date.nager.at/api/v3/PublicHolidays/\" +\r\n                             std::to_wstring(request->year) + L\"/\" +\r\n                             request->country;\r\n    if (!HttpsGet(url, &data, 256 * 1024)) {\r\n        PostMessage(request->notify, WM_APP_HOLIDAYS, request->year, 1);\r\n        return 0;\r\n    }\r\n    std::wstring json;\r\n    const int length = MultiByteToWideChar(CP_UTF8, 0, (const char*)data.data(),\r\n                                           (int)data.size(), nullptr, 0);\r\n    if (length > 0) {\r\n        json.resize(length);\r\n        MultiByteToWideChar(CP_UTF8, 0, (const char*)data.data(),\r\n                            (int)data.size(), json.data(), length);\r\n    }\r\n    std::vector<Holiday> holidays = ParseHolidays(json);\r\n    AcquireSRWLockExclusive(&g_holidaysLock);\r\n    if (g_holidaysCountry == request->country &&\r\n        std::find(g_holidayYears.begin(), g_holidayYears.end(),\r\n                  request->year) == g_holidayYears.end()) {\r\n        g_holidayYears.push_back(request->year);\r\n        for (auto& holiday : holidays) {\r\n            if (holiday.year == request->year) {\r\n                g_holidays.push_back(std::move(holiday));\r\n            }\r\n        }\r\n    }\r\n    ReleaseSRWLockExclusive(&g_holidaysLock);\r\n    PostMessage(request->notify, WM_APP_HOLIDAYS, request->year, 0);\r\n    return 0;\r\n}\r\n\r\n// Agendas: .ics calendars (iCalendar, like Google Calendar's \"Secret address\r\n// in iCal format\"), added in the calendar (value \"agendas\") or in the mod's\r\n// settings (calendarIcs). Their events show on their days in each agenda's\r\n// color, read only (no reminders: their own apps remind). They're read on a\r\n// thread of their own as the calendar opens (again after 15 minutes, or 10\r\n// after failing) and kept in memory only; repeating events are expanded\r\n// from the start of last year to the end of the next one. Times in UTC or in\r\n// a time zone of their own (TZID, see FindIcsZone) turn into local ones.\r\nstruct AgendaEvent {\r\n    int year = 0;\r\n    int month = 0;\r\n    int day = 0;\r\n    // Minutes into the day, or -1 for the whole day.\r\n    int minute = -1;\r\n    std::wstring title;\r\n};\r\n\r\nstruct Agenda {\r\n    // An https link (webcal:// read as https://) or a file's path on a drive.\r\n    std::wstring source;\r\n    // 0xRRGGBB.\r\n    int color = 0;\r\n    // In the mod's settings: removed there, not in the calendar.\r\n    bool fromSettings = false;\r\n    // Its own name (X-WR-CALNAME), once read.\r\n    std::wstring name;\r\n    std::vector<AgendaEvent> events;\r\n    bool read = false;\r\n    bool failed = false;\r\n    // Read, but not an .ics (a web page's link).\r\n    bool notIcs = false;\r\n    bool reading = false;\r\n    ULONGLONG readAt = 0;\r\n};\r\n\r\n// An agenda's event, with the agenda's color.\r\nstruct AgendaItem {\r\n    AgendaEvent event;\r\n    int color = 0;\r\n};\r\n\r\n// Touched under the lock (read on a thread of their own).\r\nSRWLOCK g_agendasLock = SRWLOCK_INIT;\r\nstd::vector<Agenda> g_agendas;\r\n// The days with events (year * 10000 + month * 100 + day) and their color:\r\n// the first agenda's with an event that day.\r\nstd::unordered_map<int, int> g_agendaDays;\r\n// The links and paths in the mod's settings (read with them).\r\nstd::vector<std::wstring> g_calendarIcs;\r\n// Reading them (one thread at a time), and told to stop (the calendar\r\n// going away).\r\nHANDLE g_agendaThread;\r\nstd::atomic<bool> g_agendaBusy{false};\r\nstd::atomic<bool> g_agendaStop{false};\r\nconstexpr size_t kMaxAgendas = 12;\r\nconstexpr size_t kMaxAgendaSource = 1024;\r\nconstexpr size_t kMaxAgendaEvents = 20000;\r\nconstexpr size_t kMaxAgendaBytes = 16 * 1024 * 1024;\r\n// New agendas' colors, in turn (macOS's calendar colors, without the\r\n// holidays' green).\r\nconstexpr int kAgendaColors[] = {0x0A84FF, 0xFF9F0A, 0xBF5AF2, 0xFF375F,\r\n                                 0x64D2FF, 0xFFD60A, 0xAC8E68};\r\n// Today's circle (value calendarToday): red like on macOS (0), Windows'\r\n// accent color (1), or one chosen (2, calendarTodayColor).\r\nconstexpr int kTodayRed = 0xFF453A;\r\n// An agenda was read (wParam 1: the last one asked for).\r\nconstexpr UINT WM_APP_AGENDAS = WM_APP + 87;\r\n// The color dialog closed (see ColorThreadProc).\r\nconstexpr UINT WM_APP_COLOR_DONE = WM_APP + 72;\r\n// The font dialog closed (see FontThreadProc).\r\nconstexpr UINT WM_APP_FONT_DONE = WM_APP + 109;\r\n\r\nD2D1_COLOR_F RgbColor(int rgb, float alpha) {\r\n    float parts[3];\r\n    CustomColorParts(rgb, parts);\r\n    return {parts[0], parts[1], parts[2], alpha};\r\n}\r\n\r\n// Windows' accent color (Settings, Personalization, Colors), 0xRRGGBB.\r\nint ReadWindowsAccentColor() {\r\n    DWORD value = 0;\r\n    DWORD size = sizeof(value);\r\n    if (RegGetValue(HKEY_CURRENT_USER,\r\n                    L\"Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Explorer\\\\\"\r\n                    L\"Accent\",\r\n                    L\"AccentColorMenu\", RRF_RT_REG_DWORD, nullptr, &value,\r\n                    &size) == ERROR_SUCCESS) {\r\n        // 0xAABBGGRR.\r\n        return (int)(((value & 0xFF) << 16) | (value & 0xFF00) |\r\n                     ((value >> 16) & 0xFF));\r\n    }\r\n    DWORD color = 0;\r\n    BOOL opaque = FALSE;\r\n    return SUCCEEDED(DwmGetColorizationColor(&color, &opaque))\r\n               ? (int)(color & 0xFFFFFF)\r\n               : 0x0078D4;\r\n}\r\n\r\n// Filled before any island is created, refreshed on Windows' color events.\r\nint g_windowsAccentColor = 0x0078D4;\r\nint WindowsAccentColor() { return g_windowsAccentColor; }\r\n\r\n// What the pill fills with (see Island::UpdateFill), each with its colors:\r\n// downloads and other apps, file copies, the battery charging.\r\nconstexpr int kFillDownloads = 0;\r\nconstexpr int kFillCopies = 1;\r\nconstexpr int kFillCharge = 2;\r\n\r\n// A kind's colors (islandFillColor and the others): green, blue, Windows'\r\n// accent or its own, 0xRRGGBB; and the one chosen.\r\nint FillChoiceRgb(int kind, int choice) {\r\n    switch (choice) {\r\n        case 1:\r\n            return 0x0A84FF;\r\n        case 2:\r\n            return WindowsAccentColor();\r\n        case 3:\r\n            return kind == kFillCopies   ? g_settings.islandFillCopyOwnColor\r\n                   : kind == kFillCharge ? g_settings.islandFillChargeOwnColor\r\n                                         : g_settings.islandFillOwnColor;\r\n        default:\r\n            return 0x30D158;\r\n    }\r\n}\r\n\r\nint FillColorRgb(int kind) {\r\n    return FillChoiceRgb(kind, kind == kFillCopies ? g_settings.islandFillCopyColor\r\n                               : kind == kFillCharge\r\n                                   ? g_settings.islandFillChargeColor\r\n                                   : g_settings.islandFillColor);\r\n}\r\n\r\n// The audio visualizer's colors (islandVisualizerColor): the icons',\r\n// Windows' accent, a rainbow (each bar its own hue, going around slowly),\r\n// its own, or the playing song's cover's (like the iPhone's).\r\nconstexpr int kVisualizerRainbow = 2;\r\nconstexpr int kVisualizerCover = 4;\r\n// (How fast the rainbow goes around: turns a second.)\r\nconstexpr double kRainbowTurns = 0.12;\r\n\r\n// The longest a song's line gets on the pill (DIPs, islandLyricsWidth):\r\n// longer, it ends with \"…\" (all of it in the panel), so the pill doesn't\r\n// overflow. The first follows each line (as wide as its words, up to the\r\n// longest); the others keep the widest line's width while lines go on.\r\nconstexpr int kLyricsMaxWidths[] = {360, 180, 260, 360};\r\nconstexpr int kLyricsWidthFollows = 0;\r\n\r\n// From how much in it (MB) the Recycle Bin's item shows\r\n// (islandRecycleMinSize): always, or only once it weighs that much (it comes\r\n// and goes by itself, see RecycleBinShown).\r\nconstexpr int kRecycleMinMegabytes[] = {0, 100, 500, 1024, 5120};\r\n\r\n// A hue (0 to 1 around the color wheel, any number: it wraps) at full\r\n// color, 0xRRGGBB.\r\nint RainbowRgb(double hue) {\r\n    const double h = (hue - std::floor(hue)) * 6;\r\n    const int sector = std::min((int)h, 5);\r\n    const double f = h - sector;\r\n    const double rise = f;\r\n    const double fall = 1 - f;\r\n    double r = 1, g = 0, b = 0;\r\n    switch (sector) {\r\n        case 0:\r\n            r = 1, g = rise, b = 0;\r\n            break;\r\n        case 1:\r\n            r = fall, g = 1, b = 0;\r\n            break;\r\n        case 2:\r\n            r = 0, g = 1, b = rise;\r\n            break;\r\n        case 3:\r\n            r = 0, g = fall, b = 1;\r\n            break;\r\n        case 4:\r\n            r = rise, g = 0, b = 1;\r\n            break;\r\n        default:\r\n            r = 1, g = 0, b = fall;\r\n            break;\r\n    }\r\n    auto byte = [](double v) { return (int)std::lround(v * 255); };\r\n    return byte(r) << 16 | byte(g) << 8 | byte(b);\r\n}\r\n\r\n// Where a language button's flag goes: at `left` (its text's start), in the\r\n// button's middle, on whole pixels so its edges stay sharp (at 150% a\r\n// button starts half a pixel in).\r\nD2D1_RECT_F ChoiceFlagRect(float left, const D2D1_RECT_F& button,\r\n                           float scale) {\r\n    const float width = std::round(18 * scale);\r\n    const float height = std::round(12 * scale);\r\n    const float x = std::round(left);\r\n    const float y = std::round((button.top + button.bottom - height) / 2);\r\n    return {x, y, x + width, y + height};\r\n}\r\n\r\n// A language's flag in `rect` (about 3:2), drawn in shapes (Windows has no\r\n// emoji flags): simplified, like an icon, its corners rounded and a thin\r\n// edge so a white one shows on a light background. English: the United\r\n// States'.\r\nvoid DrawFlag(ID2D1RenderTarget* target,\r\n              ID2D1SolidColorBrush* brush,\r\n              const D2D1_RECT_F& rect,\r\n              TextLanguage language,\r\n              float opacity) {\r\n    winrt::com_ptr<ID2D1Factory> factory;\r\n    target->GetFactory(factory.put());\r\n    const float w = rect.right - rect.left;\r\n    const float h = rect.bottom - rect.top;\r\n    const float radius = std::max(1.0f, std::round(h / 6));\r\n    winrt::com_ptr<ID2D1RoundedRectangleGeometry> shape;\r\n    if (!factory || w < 2 || h < 2 ||\r\n        FAILED(factory->CreateRoundedRectangleGeometry({rect, radius, radius},\r\n                                                       shape.put()))) {\r\n        return;\r\n    }\r\n    auto color = [&](int rgb) {\r\n        brush->SetColor(RgbColor(rgb, opacity));\r\n        return brush;\r\n    };\r\n    auto band = [&](float from, float to, int rgb, bool across = true) {\r\n        const D2D1_RECT_F part =\r\n            across ? D2D1_RECT_F{rect.left, rect.top + h * from, rect.right,\r\n                                 rect.top + h * to}\r\n                   : D2D1_RECT_F{rect.left + w * from, rect.top,\r\n                                 rect.left + w * to, rect.bottom};\r\n        target->FillRectangle(part, color(rgb));\r\n    };\r\n    // A five-pointed star around (x, y), r its points' reach.\r\n    auto star = [&](float x, float y, float r, int rgb) {\r\n        winrt::com_ptr<ID2D1PathGeometry> path;\r\n        winrt::com_ptr<ID2D1GeometrySink> sink;\r\n        if (FAILED(factory->CreatePathGeometry(path.put())) ||\r\n            FAILED(path->Open(sink.put()))) {\r\n            return;\r\n        }\r\n        for (int k = 0; k < 10; k++) {\r\n            const float reach = k % 2 ? r * 0.4f : r;\r\n            const float angle = -1.5708f + k * 0.62832f;\r\n            const D2D1_POINT_2F point{x + reach * std::cos(angle),\r\n                                      y + reach * std::sin(angle)};\r\n            if (k == 0) {\r\n                sink->BeginFigure(point, D2D1_FIGURE_BEGIN_FILLED);\r\n            } else {\r\n                sink->AddLine(point);\r\n            }\r\n        }\r\n        sink->EndFigure(D2D1_FIGURE_END_CLOSED);\r\n        if (SUCCEEDED(sink->Close())) {\r\n            target->FillGeometry(path.get(), color(rgb));\r\n        }\r\n    };\r\n    winrt::com_ptr<ID2D1Layer> layer;\r\n    target->CreateLayer(nullptr, layer.put());\r\n    target->PushLayer(D2D1::LayerParameters(D2D1::InfiniteRect(), shape.get()),\r\n                      layer.get());\r\n    const float cx = (rect.left + rect.right) / 2;\r\n    const float cy = (rect.top + rect.bottom) / 2;\r\n    switch (language) {\r\n        case TextLanguage::English:\r\n            band(0, 1, 0xFFFFFF);\r\n            for (int k = 0; k < 13; k += 2) {\r\n                band(k / 13.0f, (k + 1) / 13.0f, 0xB22234);\r\n            }\r\n            target->FillRectangle(\r\n                {rect.left, rect.top, rect.left + w * 0.42f,\r\n                 rect.top + h * 7 / 13},\r\n                color(0x3C3B6E));\r\n            break;\r\n        case TextLanguage::Portuguese: {\r\n            band(0, 1, 0x009C3B);\r\n            winrt::com_ptr<ID2D1PathGeometry> path;\r\n            winrt::com_ptr<ID2D1GeometrySink> sink;\r\n            if (SUCCEEDED(factory->CreatePathGeometry(path.put())) &&\r\n                SUCCEEDED(path->Open(sink.put()))) {\r\n                sink->BeginFigure({rect.left + w * 0.1f, cy},\r\n                                  D2D1_FIGURE_BEGIN_FILLED);\r\n                sink->AddLine({cx, rect.top + h * 0.14f});\r\n                sink->AddLine({rect.right - w * 0.1f, cy});\r\n                sink->AddLine({cx, rect.bottom - h * 0.14f});\r\n                sink->EndFigure(D2D1_FIGURE_END_CLOSED);\r\n                if (SUCCEEDED(sink->Close())) {\r\n                    target->FillGeometry(path.get(), color(0xFFDF00));\r\n                }\r\n            }\r\n            target->FillEllipse({{cx, cy}, h * 0.23f, h * 0.23f},\r\n                                color(0x002776));\r\n            break;\r\n        }\r\n        case TextLanguage::Chinese:\r\n            band(0, 1, 0xEE1C25);\r\n            star(rect.left + w * 0.18f, rect.top + h * 0.28f, h * 0.17f,\r\n                 0xFFDE00);\r\n            for (const auto& [x, y] : {std::pair{0.34f, 0.12f},\r\n                                       std::pair{0.41f, 0.24f},\r\n                                       std::pair{0.41f, 0.4f},\r\n                                       std::pair{0.34f, 0.52f}}) {\r\n                star(rect.left + w * x, rect.top + h * y, h * 0.06f, 0xFFDE00);\r\n            }\r\n            break;\r\n        case TextLanguage::German:\r\n            band(0, 1 / 3.0f, 0x000000);\r\n            band(1 / 3.0f, 2 / 3.0f, 0xDD0000);\r\n            band(2 / 3.0f, 1, 0xFFCE00);\r\n            break;\r\n        case TextLanguage::Spanish:\r\n            band(0, 0.25f, 0xAA151B);\r\n            band(0.25f, 0.75f, 0xF1BF00);\r\n            band(0.75f, 1, 0xAA151B);\r\n            break;\r\n        case TextLanguage::Russian:\r\n            band(0, 1 / 3.0f, 0xFFFFFF);\r\n            band(1 / 3.0f, 2 / 3.0f, 0x0039A6);\r\n            band(2 / 3.0f, 1, 0xD52B1E);\r\n            break;\r\n        case TextLanguage::Japanese:\r\n            band(0, 1, 0xFFFFFF);\r\n            target->FillEllipse({{cx, cy}, h * 0.3f, h * 0.3f},\r\n                                color(0xBC002D));\r\n            break;\r\n        case TextLanguage::Vietnamese:\r\n            band(0, 1, 0xDA251D);\r\n            star(cx, cy, h * 0.3f, 0xFFFF00);\r\n            break;\r\n    }\r\n    target->PopLayer();\r\n    brush->SetColor(D2D1::ColorF(0, 0, 0, 0.18f * opacity));\r\n    target->DrawRoundedRectangle(\r\n        {{rect.left + 0.5f, rect.top + 0.5f, rect.right - 0.5f,\r\n          rect.bottom - 0.5f},\r\n         radius,\r\n         radius},\r\n        brush, 1);\r\n}\r\n\r\nint MediaCoverRgb();\r\n\r\n// A visualizer color's 0xRRGGBB (the rainbow: its first bar's; the cover's:\r\n// the icons' without one).\r\nint VisualizerChoiceRgb(int choice) {\r\n    if (choice == kVisualizerCover) {\r\n        if (const int cover = MediaCoverRgb(); cover >= 0) {\r\n            return cover;\r\n        }\r\n        choice = 0;\r\n    }\r\n    switch (choice) {\r\n        case 1:\r\n            return WindowsAccentColor();\r\n        case kVisualizerRainbow:\r\n            return RainbowRgb(0);\r\n        case 3:\r\n            return g_settings.islandVisualizerOwnColor;\r\n        default: {\r\n            const D2D1_COLOR_F icon = FgIcon(1);\r\n            return (int)std::lround(icon.r * 255) << 16 |\r\n                   (int)std::lround(icon.g * 255) << 8 |\r\n                   (int)std::lround(icon.b * 255);\r\n        }\r\n    }\r\n}\r\n\r\n// How the fill moves (islandFillStyle).\r\nconstexpr int kFillStyleSimple = 0;\r\nconstexpr int kFillStyleLiquid = 1;\r\nconstexpr int kFillStyleGlow = 2;\r\n// How a download's fill ended: not (going on, or none), done (it got to its\r\n// end), canceled; and how long each shows.\r\nconstexpr int kFillEndNone = 0;\r\nconstexpr int kFillEndDone = 1;\r\nconstexpr int kFillEndCanceled = 2;\r\nconstexpr double kFillDoneSeconds = 1.3;\r\nconstexpr double kFillCanceledSeconds = 0.9;\r\n\r\n// A base64 text's bytes (the URL-safe kind too; it ends at its padding).\r\nstd::string DecodeBase64(const std::wstring& text) {\r\n    std::string bytes;\r\n    int value = 0;\r\n    int bits = 0;\r\n    for (const WCHAR c : text) {\r\n        int digit;\r\n        if (c >= L'A' && c <= L'Z') {\r\n            digit = c - L'A';\r\n        } else if (c >= L'a' && c <= L'z') {\r\n            digit = c - L'a' + 26;\r\n        } else if (c >= L'0' && c <= L'9') {\r\n            digit = c - L'0' + 52;\r\n        } else if (c == L'+' || c == L'-') {\r\n            digit = 62;\r\n        } else if (c == L'/' || c == L'_') {\r\n            digit = 63;\r\n        } else {\r\n            break;\r\n        }\r\n        value = ((value << 6) | digit) & 0xFFFFFF;\r\n        bits += 6;\r\n        if (bits >= 8) {\r\n            bits -= 8;\r\n            bytes += (char)((value >> bits) & 0xFF);\r\n        }\r\n    }\r\n    return bytes;\r\n}\r\n\r\n// A Google Calendar page's link (sharing a calendar, \"?cid=\" its ID in\r\n// base64, or showing it, \"embed?src=\" its ID) as the calendar's public iCal\r\n// address (which works only while it's public; any calendar has a secret\r\n// one, in its settings); nothing for other links.\r\nstd::wstring GooglePublicIcs(const std::wstring& link) {\r\n    if (!link.starts_with(L\"https://calendar.google.com/\") ||\r\n        link.find(L\"/ical/\") != std::wstring::npos) {\r\n        return {};\r\n    }\r\n    auto parameter = [&](PCWSTR name) {\r\n        for (const WCHAR before : {L'?', L'&'}) {\r\n            const std::wstring key = std::wstring(1, before) + name + L\"=\";\r\n            const size_t at = link.find(key);\r\n            if (at != std::wstring::npos) {\r\n                const size_t start = at + key.size();\r\n                return link.substr(start,\r\n                                   link.find_first_of(L\"&#\", start) - start);\r\n            }\r\n        }\r\n        return std::wstring();\r\n    };\r\n    std::wstring id;\r\n    if (const std::wstring cid = parameter(L\"cid\"); !cid.empty()) {\r\n        const std::string bytes = DecodeBase64(cid);\r\n        id.assign(bytes.begin(), bytes.end());\r\n    } else {\r\n        id = parameter(L\"src\");\r\n    }\r\n    std::wstring escaped;\r\n    for (const WCHAR c : id) {\r\n        if (c == L'@') {\r\n            escaped += L\"%40\";\r\n        } else if (iswalnum(c) || c == L'.' || c == L'-' || c == L'_' ||\r\n                   c == L'%') {\r\n            escaped += c;\r\n        } else {\r\n            return {};\r\n        }\r\n    }\r\n    return escaped.empty() ? std::wstring()\r\n                           : L\"https://calendar.google.com/calendar/ical/\" +\r\n                                 escaped + L\"/public/basic.ics\";\r\n}\r\n\r\n// A link or a path as typed or pasted (quotes and spaces around it gone,\r\n// webcal:// read as https://, a Google Calendar page's link as its iCal\r\n// address); nothing when it's neither an https link nor a file's path on a\r\n// drive.\r\nstd::wstring AgendaSource(std::wstring text) {\r\n    const size_t start = text.find_first_not_of(L\" \\t\\\"'\");\r\n    if (start == std::wstring::npos) {\r\n        return {};\r\n    }\r\n    text = text.substr(start, text.find_last_not_of(L\" \\t\\\"'\") - start + 1);\r\n    if (_wcsnicmp(text.c_str(), L\"webcal://\", 9) == 0) {\r\n        text = L\"https://\" + text.substr(9);\r\n    }\r\n    const bool link =\r\n        _wcsnicmp(text.c_str(), L\"https://\", 8) == 0 && text.size() > 8;\r\n    if (link) {\r\n        text = L\"https://\" + text.substr(8);\r\n        if (const std::wstring google = GooglePublicIcs(text);\r\n            !google.empty()) {\r\n            text = google;\r\n        }\r\n    }\r\n    // (A drive's path: not a network share's, which would connect to the\r\n    // computer named with the user's sign-in, nor a device's.)\r\n    const bool path = text.size() > 3 && iswalpha(text[0]) && text[1] == L':' &&\r\n                      (text[2] == L'\\\\' || text[2] == L'/');\r\n    return (link || path) && text.size() <= kMaxAgendaSource ? text\r\n                                                             : std::wstring();\r\n}\r\n\r\n// What an agenda is called before it's read: its link's host, or its\r\n// file's name.\r\nstd::wstring AgendaShortName(const std::wstring& source) {\r\n    if (source.starts_with(L\"https://\")) {\r\n        const size_t end = source.find(L'/', 8);\r\n        return source.substr(8, end == std::wstring::npos ? end : end - 8);\r\n    }\r\n    const size_t slash = source.find_last_of(L\"\\\\/\");\r\n    return slash == std::wstring::npos ? source : source.substr(slash + 1);\r\n}\r\n\r\n// A color for a new agenda: the first one none has.\r\nint NextAgendaColor(const std::vector<Agenda>& agendas) {\r\n    for (const int color : kAgendaColors) {\r\n        if (std::none_of(\r\n                agendas.begin(), agendas.end(),\r\n                [&](const Agenda& agenda) { return agenda.color == color; })) {\r\n            return color;\r\n        }\r\n    }\r\n    return kAgendaColors[agendas.size() % std::size(kAgendaColors)];\r\n}\r\n\r\n// (Under the lock, exclusive.)\r\nvoid IndexAgendaDays() {\r\n    g_agendaDays.clear();\r\n    for (const auto& agenda : g_agendas) {\r\n        for (const auto& event : agenda.events) {\r\n            g_agendaDays.try_emplace(\r\n                event.year * 10000 + event.month * 100 + event.day,\r\n                agenda.color);\r\n        }\r\n    }\r\n}\r\n\r\n// The calendar's agendas: the ones added in it (value \"agendas\": a line\r\n// each, \"u\", its color and its source, tab-separated), then the settings'\r\n// ones (whose colors \"s\" lines keep). Read as the calendar opens: what's\r\n// already read stays.\r\nvoid LoadAgendas() {\r\n    const std::wstring value = GetWholeStringValue(L\"agendas\", 32 * 1024);\r\n    std::vector<Agenda> wanted;\r\n    std::vector<std::pair<std::wstring, int>> settingsColors;\r\n    auto known = [&](const std::wstring& source) {\r\n        return std::any_of(\r\n            wanted.begin(), wanted.end(),\r\n            [&](const Agenda& agenda) { return agenda.source == source; });\r\n    };\r\n    for (PCWSTR line = value.data(); *line;) {\r\n        PCWSTR end = wcschr(line, L'\\n');\r\n        const std::wstring text =\r\n            end ? std::wstring(line, end) : std::wstring(line);\r\n        line = end ? end + 1 : line + wcslen(line);\r\n        const size_t tab = text.find(L'\\t');\r\n        const size_t second =\r\n            tab == std::wstring::npos ? tab : text.find(L'\\t', tab + 1);\r\n        if (second == std::wstring::npos) {\r\n            continue;\r\n        }\r\n        const int color =\r\n            (int)wcstoul(text.substr(tab + 1, second - tab - 1).c_str(),\r\n                         nullptr, 16) &\r\n            0xFFFFFF;\r\n        const std::wstring source = AgendaSource(text.substr(second + 1));\r\n        if (source.empty()) {\r\n            continue;\r\n        }\r\n        if (text[0] == L's') {\r\n            settingsColors.push_back({source, color});\r\n        } else if (!known(source) && wanted.size() < kMaxAgendas) {\r\n            Agenda agenda;\r\n            agenda.source = source;\r\n            agenda.color = color;\r\n            wanted.push_back(std::move(agenda));\r\n        }\r\n    }\r\n    for (const auto& source : g_calendarIcs) {\r\n        if (known(source) || wanted.size() >= kMaxAgendas) {\r\n            continue;\r\n        }\r\n        Agenda agenda;\r\n        agenda.source = source;\r\n        agenda.fromSettings = true;\r\n        agenda.color = -1;\r\n        for (const auto& [kept, color] : settingsColors) {\r\n            if (kept == source) {\r\n                agenda.color = color;\r\n            }\r\n        }\r\n        if (agenda.color < 0) {\r\n            agenda.color = NextAgendaColor(wanted);\r\n        }\r\n        wanted.push_back(std::move(agenda));\r\n    }\r\n    AcquireSRWLockExclusive(&g_agendasLock);\r\n    for (auto& agenda : wanted) {\r\n        for (auto& old : g_agendas) {\r\n            if (old.source == agenda.source) {\r\n                agenda.name = std::move(old.name);\r\n                agenda.events = std::move(old.events);\r\n                agenda.read = old.read;\r\n                agenda.failed = old.failed;\r\n                agenda.notIcs = old.notIcs;\r\n                agenda.reading = old.reading;\r\n                agenda.readAt = old.readAt;\r\n                break;\r\n            }\r\n        }\r\n    }\r\n    g_agendas = std::move(wanted);\r\n    IndexAgendaDays();\r\n    ReleaseSRWLockExclusive(&g_agendasLock);\r\n}\r\n\r\nvoid SaveAgendas() {\r\n    std::wstring value;\r\n    AcquireSRWLockShared(&g_agendasLock);\r\n    for (const auto& agenda : g_agendas) {\r\n        WCHAR color[8];\r\n        swprintf_s(color, L\"%06X\", agenda.color & 0xFFFFFF);\r\n        value += std::wstring(agenda.fromSettings ? L\"s\\t\" : L\"u\\t\") + color +\r\n                 L\"\\t\" + agenda.source + L\"\\n\";\r\n    }\r\n    ReleaseSRWLockShared(&g_agendasLock);\r\n    SetStoredString(L\"agendas\", value.c_str());\r\n}\r\n\r\n// The color of a day with agenda events, if it has some.\r\nbool AgendaDayColor(int year, int month, int day, int* color) {\r\n    AcquireSRWLockShared(&g_agendasLock);\r\n    const auto it = g_agendaDays.find(year * 10000 + month * 100 + day);\r\n    const bool found = it != g_agendaDays.end();\r\n    if (found) {\r\n        *color = it->second;\r\n    }\r\n    ReleaseSRWLockShared(&g_agendasLock);\r\n    return found;\r\n}\r\n\r\n// A day's agenda events: the whole-day ones, then by time.\r\nstd::vector<AgendaItem> AgendaEventsOn(int year, int month, int day) {\r\n    std::vector<AgendaItem> items;\r\n    AcquireSRWLockShared(&g_agendasLock);\r\n    for (const auto& agenda : g_agendas) {\r\n        for (const auto& event : agenda.events) {\r\n            if (event.year == year && event.month == month &&\r\n                event.day == day) {\r\n                items.push_back({event, agenda.color});\r\n            }\r\n        }\r\n    }\r\n    ReleaseSRWLockShared(&g_agendasLock);\r\n    std::stable_sort(items.begin(), items.end(),\r\n                     [](const AgendaItem& a, const AgendaItem& b) {\r\n                         return a.event.minute < b.event.minute;\r\n                     });\r\n    return items;\r\n}\r\n\r\n// The next `count` agenda events from now (today's whole-day ones too); the\r\n// same one in two agendas counts once.\r\nstd::vector<AgendaItem> UpcomingAgendaEvents(size_t count) {\r\n    SYSTEMTIME now;\r\n    GetLocalTime(&now);\r\n    const int today = now.wYear * 10000 + now.wMonth * 100 + now.wDay;\r\n    const int minute = now.wHour * 60 + now.wMinute;\r\n    auto day = [](const AgendaEvent& event) {\r\n        return event.year * 10000 + event.month * 100 + event.day;\r\n    };\r\n    struct Candidate {\r\n        const AgendaEvent* event;\r\n        int color;\r\n    };\r\n    auto earlier = [&](const Candidate& a, const Candidate& b) {\r\n        const int dayA = day(*a.event);\r\n        const int dayB = day(*b.event);\r\n        if (dayA != dayB) {\r\n            return dayA < dayB;\r\n        }\r\n        if (a.event->minute != b.event->minute) {\r\n            return a.event->minute < b.event->minute;\r\n        }\r\n        return a.event->title < b.event->title;\r\n    };\r\n    std::vector<AgendaItem> upcoming;\r\n    AcquireSRWLockShared(&g_agendasLock);\r\n    std::vector<Candidate> candidates;\r\n    for (const auto& agenda : g_agendas) {\r\n        for (const auto& event : agenda.events) {\r\n            const int on = day(event);\r\n            if (on > today ||\r\n                (on == today && (event.minute < 0 || event.minute >= minute))) {\r\n                candidates.push_back({&event, agenda.color});\r\n            }\r\n        }\r\n    }\r\n    const size_t kept = std::min(candidates.size(), count * 3);\r\n    std::partial_sort(candidates.begin(), candidates.begin() + kept,\r\n                      candidates.end(), earlier);\r\n    for (size_t i = 0; i < kept && upcoming.size() < count; i++) {\r\n        if (i && !earlier(candidates[i - 1], candidates[i])) {\r\n            continue;\r\n        }\r\n        upcoming.push_back({*candidates[i].event, candidates[i].color});\r\n    }\r\n    ReleaseSRWLockShared(&g_agendasLock);\r\n    return upcoming;\r\n}\r\n\r\n// A day as a number, to count days with (days since 1601; 0 for none).\r\nint DayNumber(int year, int month, int day) {\r\n    SYSTEMTIME time{(WORD)year, (WORD)month, 0, (WORD)day};\r\n    FILETIME file;\r\n    if (year < 1601 || year > 30000 || !SystemTimeToFileTime(&time, &file)) {\r\n        return 0;\r\n    }\r\n    return (int)((((ULONGLONG)file.dwHighDateTime << 32) | file.dwLowDateTime) /\r\n                 (24ULL * 60 * 60 * 10000000));\r\n}\r\n\r\nvoid DayFromNumber(int number, int* year, int* month, int* day) {\r\n    const ULONGLONG ticks = (ULONGLONG)number * 24 * 60 * 60 * 10000000;\r\n    const FILETIME file{(DWORD)ticks, (DWORD)(ticks >> 32)};\r\n    SYSTEMTIME time{};\r\n    FileTimeToSystemTime(&file, &time);\r\n    *year = time.wYear;\r\n    *month = time.wMonth;\r\n    *day = time.wDay;\r\n}\r\n\r\n// 0 is Sunday (1601 started on a Monday).\r\nint NumberWeekday(int number) {\r\n    return (number + 1) % 7;\r\n}\r\n\r\n// A day number and a minute in UTC as local ones.\r\nvoid UtcToLocal(int* number, int* minute) {\r\n    int year;\r\n    int month;\r\n    int day;\r\n    DayFromNumber(*number, &year, &month, &day);\r\n    SYSTEMTIME utc{(WORD)year, (WORD)month,          0,\r\n                   (WORD)day,  (WORD)(*minute / 60), (WORD)(*minute % 60)};\r\n    SYSTEMTIME local;\r\n    if (SystemTimeToTzSpecificLocalTime(nullptr, &utc, &local)) {\r\n        *number = DayNumber(local.wYear, local.wMonth, local.wDay);\r\n        *minute = local.wHour * 60 + local.wMinute;\r\n    }\r\n}\r\n\r\n// An iCalendar date (\"20261012\") or time (\"20261012T143000\", in UTC with a\r\n// \"Z\" at its end), as a day number and minute (-1 for a date): a time in\r\n// UTC turned into a local one, or kept in UTC when `utc` is given (and set:\r\n// a rule's days are counted in UTC then).\r\nbool ParseIcsTime(const std::wstring& value,\r\n                  int* number,\r\n                  int* minute,\r\n                  bool* utc = nullptr) {\r\n    int year = 0;\r\n    int month = 0;\r\n    int day = 0;\r\n    if (value.size() < 8 ||\r\n        swscanf_s(value.c_str(), L\"%4d%2d%2d\", &year, &month, &day) != 3) {\r\n        return false;\r\n    }\r\n    *minute = -1;\r\n    if (value.size() >= 13 && value[8] == L'T') {\r\n        int hour = 0;\r\n        int minutes = 0;\r\n        if (swscanf_s(value.c_str() + 9, L\"%2d%2d\", &hour, &minutes) != 2 ||\r\n            hour < 0 || hour > 23 || minutes < 0 || minutes > 59) {\r\n            return false;\r\n        }\r\n        *minute = hour * 60 + minutes;\r\n    }\r\n    *number = DayNumber(year, month, day);\r\n    if (!*number) {\r\n        return false;\r\n    }\r\n    if (*minute >= 0 && value.size() >= 16 && towupper(value[15]) == L'Z') {\r\n        if (utc) {\r\n            *utc = true;\r\n        } else {\r\n            UtcToLocal(number, minute);\r\n        }\r\n    }\r\n    return true;\r\n}\r\n\r\n// A text with its escapes (\"\\,\" \"\\;\" \"\\n\"), on one line.\r\nstd::wstring UnescapeIcsText(const std::wstring& text) {\r\n    std::wstring result;\r\n    for (size_t i = 0; i < text.size() && result.size() < 200; i++) {\r\n        if (text[i] == L'\\\\' && i + 1 < text.size()) {\r\n            const WCHAR next = text[++i];\r\n            result += next == L'n' || next == L'N' ? L' ' : next;\r\n        } else if (text[i] >= 0x20) {\r\n            result += text[i];\r\n        }\r\n    }\r\n    return result;\r\n}\r\n\r\n// A repeating event's rule (RRULE): what the island understands of it.\r\nstruct IcsRule {\r\n    // 1 daily, 2 weekly, 3 monthly, 4 yearly.\r\n    int frequency = 0;\r\n    int interval = 1;\r\n    int count = 0;\r\n    // The last day (a day number), or 0; its minute (-1 with only a date),\r\n    // and whether they're still in UTC.\r\n    int until = 0;\r\n    int untilMinute = -1;\r\n    bool untilUtc = false;\r\n    // BYDAY: which one in the month (0 for each one, from the end when\r\n    // negative) and the weekday (0 for Sunday).\r\n    std::vector<std::pair<int, int>> days;\r\n    std::vector<int> monthDays;\r\n    std::vector<int> months;\r\n    int position = 0;\r\n};\r\n\r\n// (`utc`: the event's days aren't local ones, so its last day stays in UTC, see\r\n// ParseIcsTime. Its lists are bounded and without repeats: a file from the web\r\n// can say anything.)\r\nbool ParseIcsRule(const std::wstring& text, IcsRule* rule, bool utc = false) {\r\n    for (size_t at = 0; at < text.size();) {\r\n        size_t end = text.find(L';', at);\r\n        if (end == std::wstring::npos) {\r\n            end = text.size();\r\n        }\r\n        const std::wstring part = text.substr(at, end - at);\r\n        at = end + 1;\r\n        const size_t equals = part.find(L'=');\r\n        if (equals == std::wstring::npos) {\r\n            continue;\r\n        }\r\n        std::wstring key = part.substr(0, equals);\r\n        for (auto& c : key) {\r\n            c = towupper(c);\r\n        }\r\n        const std::wstring value = part.substr(equals + 1);\r\n        std::vector<std::wstring> items;\r\n        constexpr size_t kMaxRuleItems = 400;\r\n        for (size_t from = 0;\r\n             from <= value.size() && items.size() < kMaxRuleItems;) {\r\n            size_t comma = value.find(L',', from);\r\n            if (comma == std::wstring::npos) {\r\n                comma = value.size();\r\n            }\r\n            items.push_back(value.substr(from, comma - from));\r\n            from = comma + 1;\r\n        }\r\n        if (key == L\"FREQ\") {\r\n            static constexpr PCWSTR kFrequencies[] = {L\"DAILY\", L\"WEEKLY\",\r\n                                                      L\"MONTHLY\", L\"YEARLY\"};\r\n            for (int i = 0; i < 4; i++) {\r\n                if (_wcsicmp(value.c_str(), kFrequencies[i]) == 0) {\r\n                    rule->frequency = i + 1;\r\n                }\r\n            }\r\n        } else if (key == L\"INTERVAL\") {\r\n            rule->interval = std::clamp(_wtoi(value.c_str()), 1, 1000);\r\n        } else if (key == L\"COUNT\") {\r\n            rule->count = std::clamp(_wtoi(value.c_str()), 0, 100000);\r\n        } else if (key == L\"UNTIL\") {\r\n            bool inUtc = false;\r\n            if (!ParseIcsTime(value, &rule->until, &rule->untilMinute,\r\n                              utc ? &inUtc : nullptr)) {\r\n                rule->until = 0;\r\n            }\r\n            rule->untilUtc = inUtc;\r\n        } else if (key == L\"BYDAY\") {\r\n            static constexpr PCWSTR kWeekdays[] = {L\"SU\", L\"MO\", L\"TU\", L\"WE\",\r\n                                                   L\"TH\", L\"FR\", L\"SA\"};\r\n            for (const auto& item : items) {\r\n                if (item.size() < 2) {\r\n                    continue;\r\n                }\r\n                const std::wstring name = item.substr(item.size() - 2);\r\n                // (Which one in a month or a year: at most the 53rd.)\r\n                const int nth =\r\n                    item.size() > 2\r\n                        ? _wtoi(item.substr(0, item.size() - 2).c_str())\r\n                        : 0;\r\n                if (nth < -53 || nth > 53) {\r\n                    continue;\r\n                }\r\n                for (int weekday = 0; weekday < 7; weekday++) {\r\n                    const std::pair<int, int> entry{nth, weekday};\r\n                    if (_wcsicmp(name.c_str(), kWeekdays[weekday]) == 0 &&\r\n                        rule->days.size() < 35 &&\r\n                        std::find(rule->days.begin(), rule->days.end(),\r\n                                  entry) == rule->days.end()) {\r\n                        rule->days.push_back(entry);\r\n                    }\r\n                }\r\n            }\r\n        } else if (key == L\"BYMONTHDAY\") {\r\n            for (const auto& item : items) {\r\n                const int day = _wtoi(item.c_str());\r\n                if (day && day >= -31 && day <= 31 &&\r\n                    std::find(rule->monthDays.begin(), rule->monthDays.end(),\r\n                              day) == rule->monthDays.end()) {\r\n                    rule->monthDays.push_back(day);\r\n                }\r\n            }\r\n        } else if (key == L\"BYMONTH\") {\r\n            for (const auto& item : items) {\r\n                const int month = _wtoi(item.c_str());\r\n                if (month >= 1 && month <= 12 &&\r\n                    std::find(rule->months.begin(), rule->months.end(),\r\n                              month) == rule->months.end()) {\r\n                    rule->months.push_back(month);\r\n                }\r\n            }\r\n        } else if (key == L\"BYSETPOS\") {\r\n            rule->position = std::clamp(_wtoi(value.c_str()), -366, 366);\r\n        }\r\n    }\r\n    return rule->frequency != 0;\r\n}\r\n\r\n// The days a monthly or yearly rule picks in a month (day numbers, sorted):\r\n// its days of the month, its weekdays (each one, or the nth one), or the\r\n// event's own day.\r\nstd::vector<int> IcsMonthDays(const IcsRule& rule,\r\n                              int year,\r\n                              int month,\r\n                              int ownDay) {\r\n    std::vector<int> days;\r\n    const int first = DayNumber(year, month, 1);\r\n    if (!first) {\r\n        return days;\r\n    }\r\n    const int count = DaysInMonth(year, month);\r\n    if (!rule.monthDays.empty()) {\r\n        for (const int day : rule.monthDays) {\r\n            const int one = day > 0 ? day : count + day + 1;\r\n            if (one >= 1 && one <= count) {\r\n                days.push_back(first + one - 1);\r\n            }\r\n        }\r\n    } else if (!rule.days.empty()) {\r\n        for (const auto& [nth, weekday] : rule.days) {\r\n            std::vector<int> all;\r\n            for (int day = first + (weekday - NumberWeekday(first) + 7) % 7;\r\n                 day < first + count; day += 7) {\r\n                all.push_back(day);\r\n            }\r\n            if (nth == 0) {\r\n                days.insert(days.end(), all.begin(), all.end());\r\n            } else if (nth > 0 && nth <= (int)all.size()) {\r\n                days.push_back(all[nth - 1]);\r\n            } else if (nth < 0 && -nth <= (int)all.size()) {\r\n                days.push_back(all[(int)all.size() + nth]);\r\n            }\r\n        }\r\n    } else if (ownDay <= count) {\r\n        days.push_back(first + ownDay - 1);\r\n    }\r\n    std::sort(days.begin(), days.end());\r\n    days.erase(std::unique(days.begin(), days.end()), days.end());\r\n    if (rule.position && !days.empty()) {\r\n        const int index = rule.position > 0 ? rule.position - 1\r\n                                            : (int)days.size() + rule.position;\r\n        const int one =\r\n            index >= 0 && index < (int)days.size() ? days[index] : 0;\r\n        days.clear();\r\n        if (one) {\r\n            days.push_back(one);\r\n        }\r\n    }\r\n    return days;\r\n}\r\n\r\n// A time zone an event's times are in (its TZID): one of Windows', or the\r\n// rules its file gives for it.\r\nstruct IcsZone {\r\n    bool windows = false;\r\n    DYNAMIC_TIME_ZONE_INFORMATION dynamic{};\r\n    TIME_ZONE_INFORMATION rules{};\r\n};\r\n\r\nSYSTEMTIME IcsSystemTime(int number, int minute) {\r\n    int year;\r\n    int month;\r\n    int day;\r\n    DayFromNumber(number, &year, &month, &day);\r\n    return SYSTEMTIME{(WORD)year, (WORD)month,         0,\r\n                      (WORD)day,  (WORD)(minute / 60), (WORD)(minute % 60)};\r\n}\r\n\r\n// A day number and a minute in a zone as UTC ones (as they were if it can't).\r\nvoid IcsZoneToUtc(const IcsZone& zone, int* number, int* minute) {\r\n    const SYSTEMTIME local = IcsSystemTime(*number, *minute);\r\n    SYSTEMTIME utc;\r\n    if (zone.windows\r\n            ? TzSpecificLocalTimeToSystemTimeEx(&zone.dynamic, &local, &utc)\r\n            : TzSpecificLocalTimeToSystemTime(&zone.rules, &local, &utc)) {\r\n        *number = DayNumber(utc.wYear, utc.wMonth, utc.wDay);\r\n        *minute = utc.wHour * 60 + utc.wMinute;\r\n    }\r\n}\r\n\r\n// The other way round.\r\nvoid UtcToIcsZone(const IcsZone& zone, int* number, int* minute) {\r\n    const SYSTEMTIME utc = IcsSystemTime(*number, *minute);\r\n    SYSTEMTIME local;\r\n    if (zone.windows\r\n            ? SystemTimeToTzSpecificLocalTimeEx(&zone.dynamic, &utc, &local)\r\n            : SystemTimeToTzSpecificLocalTime(&zone.rules, &utc, &local)) {\r\n        *number = DayNumber(local.wYear, local.wMonth, local.wDay);\r\n        *minute = local.wHour * 60 + local.wMinute;\r\n    }\r\n}\r\n\r\n// A change of offset in a file's VTIMEZONE (a STANDARD or a DAYLIGHT part).\r\nstruct IcsZoneChange {\r\n    bool valid = false;\r\n    // Its offset from UTC, in minutes.\r\n    int offset = 0;\r\n    // When it first happened (a day number and a minute).\r\n    int start = 0;\r\n    int minute = -1;\r\n    std::wstring rule;\r\n};\r\n\r\n// An offset as written (\"+0100\", \"-0330\"), in minutes.\r\nbool ParseIcsOffset(const std::wstring& value, int* minutes) {\r\n    if (value.size() < 5 || (value[0] != L'+' && value[0] != L'-')) {\r\n        return false;\r\n    }\r\n    int hours = 0;\r\n    int rest = 0;\r\n    if (swscanf_s(value.c_str() + 1, L\"%2d%2d\", &hours, &rest) != 2 ||\r\n        hours < 0 || hours > 14 || rest < 0 || rest > 59) {\r\n        return false;\r\n    }\r\n    *minutes = (value[0] == L'-' ? -1 : 1) * (hours * 60 + rest);\r\n    return true;\r\n}\r\n\r\n// A change that happens every year, on the nth weekday of a month, as Windows\r\n// keeps those (wDay 5 for the last one). Others can't be kept that way.\r\nbool IcsYearlyChange(const IcsZoneChange& change, SYSTEMTIME* date) {\r\n    IcsRule rule;\r\n    if (change.minute < 0 || !ParseIcsRule(change.rule, &rule) ||\r\n        rule.frequency != 4 || rule.months.size() != 1 ||\r\n        rule.days.size() != 1) {\r\n        return false;\r\n    }\r\n    const auto [nth, weekday] = rule.days[0];\r\n    if (nth == 0 || nth < -1) {\r\n        return false;\r\n    }\r\n    *date = {};\r\n    date->wMonth = (WORD)rule.months[0];\r\n    date->wDayOfWeek = (WORD)weekday;\r\n    date->wDay = (WORD)(nth < 0 ? 5 : std::min(nth, 5));\r\n    date->wHour = (WORD)(change.minute / 60);\r\n    date->wMinute = (WORD)(change.minute % 60);\r\n    return true;\r\n}\r\n\r\n// A VTIMEZONE as Windows keeps a zone: with its two yearly changes, or at its\r\n// newest offset when it doesn't have them.\r\nbool IcsZoneRules(const IcsZoneChange& standard,\r\n                  const IcsZoneChange& daylight,\r\n                  TIME_ZONE_INFORMATION* zone) {\r\n    *zone = {};\r\n    if (standard.valid && daylight.valid &&\r\n        IcsYearlyChange(standard, &zone->StandardDate) &&\r\n        IcsYearlyChange(daylight, &zone->DaylightDate)) {\r\n        zone->Bias = -standard.offset;\r\n        zone->DaylightBias = standard.offset - daylight.offset;\r\n        return true;\r\n    }\r\n    zone->StandardDate = {};\r\n    zone->DaylightDate = {};\r\n    const IcsZoneChange& newest =\r\n        !standard.valid || (daylight.valid && daylight.start > standard.start)\r\n            ? daylight\r\n            : standard;\r\n    zone->Bias = -newest.offset;\r\n    return newest.valid;\r\n}\r\n\r\n// Where a line's value starts (\"NAME;PARAMETERS:VALUE\"; a colon in quotes is a\r\n// parameter's), or npos.\r\nsize_t IcsLineColon(const std::wstring& line) {\r\n    bool quoted = false;\r\n    for (size_t i = 0; i < line.size(); i++) {\r\n        if (line[i] == L'\"') {\r\n            quoted = !quoted;\r\n        } else if (line[i] == L':' && !quoted) {\r\n            return i;\r\n        }\r\n    }\r\n    return std::wstring::npos;\r\n}\r\n\r\n// The most time zones a calendar's times are looked up in, and the longest\r\n// name: a file from the web can say anything.\r\nconstexpr size_t kMaxIcsZones = 64;\r\nconstexpr size_t kMaxIcsZoneName = 128;\r\n\r\n// The zones a file describes (VTIMEZONE), by their TZID. A zone can have many\r\n// changes over the years: its newest of each kind counts.\r\nstd::unordered_map<std::wstring, TIME_ZONE_INFORMATION> ReadIcsZones(\r\n    const std::vector<std::wstring>& lines) {\r\n    std::unordered_map<std::wstring, TIME_ZONE_INFORMATION> zones;\r\n    std::wstring id;\r\n    IcsZoneChange changes[2];\r\n    IcsZoneChange change;\r\n    bool inZone = false;\r\n    // The part being read: 0 STANDARD, 1 DAYLIGHT, -1 none.\r\n    int kind = -1;\r\n    size_t read = 0;\r\n    for (const auto& line : lines) {\r\n        if (++read % 4096 == 0 && g_agendaStop) {\r\n            return {};\r\n        }\r\n        const size_t colon = IcsLineColon(line);\r\n        if (colon == std::wstring::npos) {\r\n            continue;\r\n        }\r\n        std::wstring key = line.substr(0, std::min(colon, line.find(L';')));\r\n        for (auto& c : key) {\r\n            c = towupper(c);\r\n        }\r\n        const std::wstring value = line.substr(colon + 1);\r\n        const bool opens = key == L\"BEGIN\";\r\n        const bool closes = key == L\"END\";\r\n        if (!inZone) {\r\n            if (opens && _wcsicmp(value.c_str(), L\"VTIMEZONE\") == 0) {\r\n                inZone = true;\r\n                kind = -1;\r\n                id.clear();\r\n                changes[0] = {};\r\n                changes[1] = {};\r\n            }\r\n            continue;\r\n        }\r\n        if (opens) {\r\n            kind = _wcsicmp(value.c_str(), L\"STANDARD\") == 0   ? 0\r\n                   : _wcsicmp(value.c_str(), L\"DAYLIGHT\") == 0 ? 1\r\n                                                               : -1;\r\n            change = {};\r\n        } else if (closes && _wcsicmp(value.c_str(), L\"VTIMEZONE\") == 0) {\r\n            inZone = false;\r\n            TIME_ZONE_INFORMATION zone;\r\n            if (!id.empty() && zones.size() < kMaxIcsZones &&\r\n                IcsZoneRules(changes[0], changes[1], &zone)) {\r\n                zones.emplace(id, zone);\r\n            }\r\n        } else if (closes) {\r\n            if (kind >= 0 && change.valid &&\r\n                change.start >= changes[kind].start) {\r\n                changes[kind] = change;\r\n            }\r\n            kind = -1;\r\n        } else if (kind < 0) {\r\n            if (key == L\"TZID\") {\r\n                id = value.substr(0, kMaxIcsZoneName);\r\n            }\r\n        } else if (key == L\"TZOFFSETTO\") {\r\n            change.valid = ParseIcsOffset(value, &change.offset);\r\n        } else if (key == L\"DTSTART\") {\r\n            // (Outlook's \"16010101T030000\" is before any day number: only its\r\n            // hour counts, kept by ParseIcsTime.)\r\n            if (!ParseIcsTime(value, &change.start, &change.minute)) {\r\n                change.start = 0;\r\n            }\r\n        } else if (key == L\"RRULE\") {\r\n            change.rule = value;\r\n        }\r\n    }\r\n    return zones;\r\n}\r\n\r\n// One of Windows' time zones by its name (\"W. Europe Standard Time\").\r\nbool FindWindowsZone(const std::wstring& name,\r\n                     DYNAMIC_TIME_ZONE_INFORMATION* zone) {\r\n    for (DWORD i = 0; EnumDynamicTimeZoneInformation(i, zone) == ERROR_SUCCESS;\r\n         i++) {\r\n        if (_wcsicmp(zone->TimeZoneKeyName, name.c_str()) == 0) {\r\n            return true;\r\n        }\r\n    }\r\n    return false;\r\n}\r\n\r\n// Windows' name for an IANA one (\"America/New_York\"), by Windows' own ICU\r\n// (from Windows 10 1903 on; without it, none).\r\nstd::wstring WindowsZoneOfIana(const std::wstring& name) {\r\n    HMODULE icu =\r\n        LoadLibraryExW(L\"icu.dll\", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);\r\n    if (!icu) {\r\n        return {};\r\n    }\r\n    using GetWindowsId_t = int(__cdecl*)(const WCHAR*, int, WCHAR*, int, int*);\r\n    const auto getWindowsId =\r\n        (GetWindowsId_t)GetProcAddress(icu, \"ucal_getWindowsTimeZoneID\");\r\n    std::wstring result;\r\n    if (getWindowsId) {\r\n        WCHAR windows[128];\r\n        // (ICU's status: above 0 is a failure.)\r\n        int status = 0;\r\n        const int length =\r\n            getWindowsId(name.c_str(), (int)name.size(), windows,\r\n                         ARRAYSIZE(windows), &status);\r\n        if (status <= 0 && length > 0 && length < (int)ARRAYSIZE(windows)) {\r\n            result.assign(windows, length);\r\n        }\r\n    }\r\n    FreeLibrary(icu);\r\n    return result;\r\n}\r\n\r\n// The zone of a TZID: Windows' name (Outlook's), an IANA one (Apple's and most\r\n// others'), or what the file itself says of it (a zone Outlook made its own,\r\n// \"(UTC+01:00) Amsterdam, Berlin...\"). Without any, its times stay as they are\r\n// written, as local ones: one zone never fails the whole file.\r\nstd::optional<IcsZone> FindIcsZone(\r\n    const std::wstring& id,\r\n    const std::unordered_map<std::wstring, TIME_ZONE_INFORMATION>& described) {\r\n    IcsZone zone;\r\n    // (Outlook's name for UTC, \"tzone://Microsoft/Utc\".)\r\n    constexpr std::wstring_view kMicrosoft = L\"tzone://Microsoft/\";\r\n    const std::wstring name =\r\n        _wcsnicmp(id.c_str(), kMicrosoft.data(), kMicrosoft.size()) == 0\r\n            ? id.substr(kMicrosoft.size())\r\n            : id;\r\n    if (FindWindowsZone(name, &zone.dynamic)) {\r\n        zone.windows = true;\r\n        return zone;\r\n    }\r\n    if (const std::wstring windows = WindowsZoneOfIana(name);\r\n        !windows.empty() && FindWindowsZone(windows, &zone.dynamic)) {\r\n        zone.windows = true;\r\n        return zone;\r\n    }\r\n    if (const auto it = described.find(id); it != described.end()) {\r\n        zone.rules = it->second;\r\n        return zone;\r\n    }\r\n    IslandLog(L\"Agenda: time zone '%s' not known, taken as local\", id.c_str());\r\n    return std::nullopt;\r\n}\r\n\r\n// A property's TZID (\"DTSTART;TZID=...;VALUE=...:\", `colon` being where its\r\n// value starts), without its quotes; empty without one.\r\nstd::wstring IcsZoneParameter(const std::wstring& line, size_t colon) {\r\n    for (size_t at = line.find(L';'); at < colon;) {\r\n        const size_t from = at + 1;\r\n        size_t end = from;\r\n        bool quoted = false;\r\n        for (; end < colon && (quoted || line[end] != L';'); end++) {\r\n            quoted = line[end] == L'\"' ? !quoted : quoted;\r\n        }\r\n        if (_wcsnicmp(line.c_str() + from, L\"TZID=\", 5) == 0) {\r\n            std::wstring value = line.substr(from + 5, end - from - 5);\r\n            std::erase(value, L'\"');\r\n            return value.substr(0, kMaxIcsZoneName);\r\n        }\r\n        at = end;\r\n    }\r\n    return {};\r\n}\r\n\r\n// A time as written (in UTC, in `zone`, or local) on an event's own days:\r\n// UTC ones when its start is in UTC, its zone's when it has one, otherwise\r\n// local ones.\r\nbool IcsEventTime(bool eventUtc,\r\n                  const IcsZone* eventZone,\r\n                  const std::wstring& text,\r\n                  const IcsZone* zone,\r\n                  int* number,\r\n                  int* minute) {\r\n    bool utc = false;\r\n    if (!ParseIcsTime(text, number, minute, &utc)) {\r\n        return false;\r\n    }\r\n    if (*minute < 0 || (!utc && (!zone || zone == eventZone))) {\r\n        return true;\r\n    }\r\n    if (!utc) {\r\n        IcsZoneToUtc(*zone, number, minute);\r\n    }\r\n    if (eventZone) {\r\n        UtcToIcsZone(*eventZone, number, minute);\r\n    } else if (!eventUtc) {\r\n        UtcToLocal(number, minute);\r\n    }\r\n    return true;\r\n}\r\n\r\n// An event as read from the file.\r\nstruct IcsEvent {\r\n    std::wstring uid;\r\n    std::wstring title;\r\n    std::wstring rule;\r\n    // Its first day (a day number), its minute (-1 for the whole day), and\r\n    // how many days it lasts.\r\n    int start = 0;\r\n    int minute = -1;\r\n    int span = 1;\r\n    int end = 0;\r\n    int endMinute = -1;\r\n    int durationDays = 0;\r\n    // Days taken out of its rule (EXDATE, or moved).\r\n    std::vector<int> excluded;\r\n    // An occurrence of another event, moved (RECURRENCE-ID): the day it\r\n    // was on.\r\n    int moved = 0;\r\n    bool cancelled = false;\r\n    // Its start is in UTC: its days are UTC ones (its rule's days fall on\r\n    // them), turned into local ones only as they're shown.\r\n    bool utc = false;\r\n    // Or in a time zone of its own, the same way.\r\n    const IcsZone* zone = nullptr;\r\n    // Its times as written with their zones' names (TZID), read once the\r\n    // whole event is (its start says on which days the others are).\r\n    std::wstring startText;\r\n    std::wstring startZone;\r\n    std::wstring endText;\r\n    std::wstring endZone;\r\n    std::wstring movedText;\r\n    std::wstring movedZone;\r\n    std::vector<std::pair<std::wstring, std::wstring>> excludedTexts;\r\n};\r\n\r\n// The days an event starts on (day numbers), up to `last` (from `first`,\r\n// counting the days it lasts): its own, or its rule's, without the ones\r\n// taken out.\r\nstd::vector<int> IcsEventDays(const IcsEvent& event, int first, int last) {\r\n    std::vector<int> days;\r\n    const int from = first - event.span + 1;\r\n    IcsRule rule;\r\n    if (event.moved || event.rule.empty() ||\r\n        !ParseIcsRule(event.rule, &rule, event.utc || event.zone)) {\r\n        if (event.start >= from && event.start <= last) {\r\n            days.push_back(event.start);\r\n        }\r\n        return days;\r\n    }\r\n    // (Its last day comes in UTC: counted in the event's zone.)\r\n    if (event.zone && rule.until && rule.untilUtc && rule.untilMinute >= 0) {\r\n        UtcToIcsZone(*event.zone, &rule.until, &rule.untilMinute);\r\n    }\r\n    int taken = 0;\r\n    // False once past its end (its last day, its count, or `last`).\r\n    auto take = [&](int day) {\r\n        if (day < event.start) {\r\n            return true;\r\n        }\r\n        if ((rule.until && day > rule.until) || day > last) {\r\n            return false;\r\n        }\r\n        taken++;\r\n        if (day >= from &&\r\n            std::find(event.excluded.begin(), event.excluded.end(), day) ==\r\n                event.excluded.end()) {\r\n            days.push_back(day);\r\n        }\r\n        return !rule.count || taken < rule.count;\r\n    };\r\n    auto past = [&](int day) {\r\n        return day > last || (rule.until && day > rule.until);\r\n    };\r\n    auto inMonths = [&](int day) {\r\n        int year;\r\n        int month;\r\n        int date;\r\n        DayFromNumber(day, &year, &month, &date);\r\n        return rule.months.empty() ||\r\n               std::find(rule.months.begin(), rule.months.end(), month) !=\r\n                   rule.months.end();\r\n    };\r\n    int year;\r\n    int month;\r\n    int day;\r\n    DayFromNumber(event.start, &year, &month, &day);\r\n    int fromYear;\r\n    int fromMonth;\r\n    int fromDay;\r\n    DayFromNumber(std::max(from, event.start), &fromYear, &fromMonth, &fromDay);\r\n    const int step = rule.interval;\r\n    // Without a count, the periods long before `first` are skipped.\r\n    const bool skip = !rule.count;\r\n    constexpr int kMaxPeriods = 5000;\r\n    if (rule.frequency == 1) {\r\n        int k = skip ? std::max(0, (from - event.start) / step - 1) : 0;\r\n        for (int n = 0; n < kMaxPeriods; n++, k++) {\r\n            const int one = event.start + k * step;\r\n            if (past(one)) {\r\n                break;\r\n            }\r\n            const bool weekday =\r\n                rule.days.empty() ||\r\n                std::any_of(rule.days.begin(), rule.days.end(),\r\n                            [&](const std::pair<int, int>& entry) {\r\n                                return entry.second == NumberWeekday(one);\r\n                            });\r\n            if (weekday && inMonths(one) && !take(one)) {\r\n                break;\r\n            }\r\n        }\r\n    } else if (rule.frequency == 2) {\r\n        // Weeks from Monday.\r\n        const int base = event.start - (NumberWeekday(event.start) + 6) % 7;\r\n        std::vector<int> offsets;\r\n        for (const auto& entry : rule.days) {\r\n            offsets.push_back((entry.second + 6) % 7);\r\n        }\r\n        if (offsets.empty()) {\r\n            offsets.push_back((NumberWeekday(event.start) + 6) % 7);\r\n        }\r\n        std::sort(offsets.begin(), offsets.end());\r\n        offsets.erase(std::unique(offsets.begin(), offsets.end()),\r\n                      offsets.end());\r\n        int k = skip ? std::max(0, (from - base) / (7 * step) - 1) : 0;\r\n        bool going = true;\r\n        for (int n = 0; n < kMaxPeriods && going; n++, k++) {\r\n            const int week = base + k * 7 * step;\r\n            if (past(week)) {\r\n                break;\r\n            }\r\n            for (const int offset : offsets) {\r\n                if (inMonths(week + offset) && !take(week + offset)) {\r\n                    going = false;\r\n                    break;\r\n                }\r\n            }\r\n        }\r\n    } else if (rule.frequency == 3) {\r\n        const int startIndex = year * 12 + month - 1;\r\n        int k =\r\n            skip ? std::max(\r\n                       0,\r\n                       (fromYear * 12 + fromMonth - 1 - startIndex) / step - 1)\r\n                 : 0;\r\n        bool going = true;\r\n        for (int n = 0; n < kMaxPeriods && going; n++, k++) {\r\n            const int index = startIndex + k * step;\r\n            const int y = index / 12;\r\n            const int m = index % 12 + 1;\r\n            const int firstDay = DayNumber(y, m, 1);\r\n            if (!firstDay || past(firstDay)) {\r\n                break;\r\n            }\r\n            if (!rule.months.empty() &&\r\n                std::find(rule.months.begin(), rule.months.end(), m) ==\r\n                    rule.months.end()) {\r\n                continue;\r\n            }\r\n            for (const int one : IcsMonthDays(rule, y, m, day)) {\r\n                if (!take(one)) {\r\n                    going = false;\r\n                    break;\r\n                }\r\n            }\r\n        }\r\n    } else if (rule.frequency == 4) {\r\n        std::vector<int> months = rule.months;\r\n        if (months.empty()) {\r\n            months.push_back(month);\r\n        }\r\n        std::sort(months.begin(), months.end());\r\n        int k = skip ? std::max(0, (fromYear - year) / step - 1) : 0;\r\n        bool going = true;\r\n        for (int n = 0; n < kMaxPeriods && going; n++, k++) {\r\n            const int y = year + k * step;\r\n            const int firstDay = DayNumber(y, 1, 1);\r\n            if (!firstDay || past(firstDay)) {\r\n                break;\r\n            }\r\n            for (const int m : months) {\r\n                for (const int one : IcsMonthDays(rule, y, m, day)) {\r\n                    if (!take(one)) {\r\n                        going = false;\r\n                        break;\r\n                    }\r\n                }\r\n                if (!going) {\r\n                    break;\r\n                }\r\n            }\r\n        }\r\n    }\r\n    return days;\r\n}\r\n\r\n// The events of an .ics file's text between `first` and `last` (day\r\n// numbers; up to kMaxAgendaEvents, the nearest to today), and the\r\n// calendar's name. Nothing once g_agendaStop is set (the calendar going\r\n// away). Its lines, lists and occurrences are bounded: a file from the web\r\n// can say anything.\r\nstd::vector<AgendaEvent> ParseIcs(const std::wstring& text,\r\n                                  int first,\r\n                                  int last,\r\n                                  std::wstring* name) {\r\n    // A long line goes on in the next ones, after a space or a tab (up to a\r\n    // length no calendar needs).\r\n    constexpr size_t kMaxIcsLine = 16 * 1024;\r\n    std::vector<std::wstring> lines;\r\n    for (size_t at = 0; at < text.size();) {\r\n        size_t end = text.find(L'\\n', at);\r\n        if (end == std::wstring::npos) {\r\n            end = text.size();\r\n        }\r\n        std::wstring line = text.substr(at, std::min(end - at, kMaxIcsLine));\r\n        at = end + 1;\r\n        if (!line.empty() && line.back() == L'\\r') {\r\n            line.pop_back();\r\n        }\r\n        if (!line.empty() && (line[0] == L' ' || line[0] == L'\\t') &&\r\n            !lines.empty()) {\r\n            if (lines.back().size() < kMaxIcsLine) {\r\n                lines.back() +=\r\n                    line.substr(1, kMaxIcsLine - lines.back().size());\r\n            }\r\n        } else {\r\n            lines.push_back(std::move(line));\r\n        }\r\n    }\r\n    const auto described = ReadIcsZones(lines);\r\n    // The zones its events' times are in, each looked up once (see\r\n    // FindIcsZone; none for a zone not known).\r\n    std::unordered_map<std::wstring, std::optional<IcsZone>> zones;\r\n    auto zoneOf = [&](const std::wstring& id) -> const IcsZone* {\r\n        if (id.empty()) {\r\n            return nullptr;\r\n        }\r\n        auto it = zones.find(id);\r\n        if (it == zones.end()) {\r\n            if (zones.size() >= kMaxIcsZones) {\r\n                return nullptr;\r\n            }\r\n            it = zones.emplace(id, FindIcsZone(id, described)).first;\r\n        }\r\n        return it->second ? &*it->second : nullptr;\r\n    };\r\n    constexpr size_t kMaxIcsExcluded = 366;\r\n    std::vector<IcsEvent> events;\r\n    IcsEvent event;\r\n    bool inEvent = false;\r\n    // Inside an event's own parts (its alarms).\r\n    int nested = 0;\r\n    size_t read = 0;\r\n    for (const auto& line : lines) {\r\n        if (++read % 4096 == 0 && g_agendaStop) {\r\n            return {};\r\n        }\r\n        const size_t colon = IcsLineColon(line);\r\n        if (colon == std::wstring::npos) {\r\n            continue;\r\n        }\r\n        std::wstring key = line.substr(0, std::min(colon, line.find(L';')));\r\n        for (auto& c : key) {\r\n            c = towupper(c);\r\n        }\r\n        const std::wstring value = line.substr(colon + 1);\r\n        if (key == L\"BEGIN\") {\r\n            if (inEvent) {\r\n                nested++;\r\n            } else if (_wcsicmp(value.c_str(), L\"VEVENT\") == 0) {\r\n                inEvent = true;\r\n                event = {};\r\n            }\r\n            continue;\r\n        }\r\n        if (key == L\"END\") {\r\n            if (nested) {\r\n                nested--;\r\n            } else if (inEvent && _wcsicmp(value.c_str(), L\"VEVENT\") == 0) {\r\n                inEvent = false;\r\n                // Its times: on its start's days (in UTC, in its zone, or\r\n                // local).\r\n                bool utc = false;\r\n                if (!ParseIcsTime(event.startText, &event.start, &event.minute,\r\n                                  &utc)) {\r\n                    event.start = 0;\r\n                }\r\n                event.utc = utc;\r\n                event.zone = !utc && event.minute >= 0\r\n                                 ? zoneOf(event.startZone)\r\n                                 : nullptr;\r\n                if (!IcsEventTime(event.utc, event.zone, event.endText,\r\n                                  zoneOf(event.endZone), &event.end,\r\n                                  &event.endMinute)) {\r\n                    event.end = 0;\r\n                }\r\n                int minute;\r\n                if (!IcsEventTime(event.utc, event.zone, event.movedText,\r\n                                  zoneOf(event.movedZone), &event.moved,\r\n                                  &minute)) {\r\n                    event.moved = 0;\r\n                }\r\n                for (const auto& [one, zone] : event.excludedTexts) {\r\n                    int day;\r\n                    if (IcsEventTime(event.utc, event.zone, one, zoneOf(zone),\r\n                                     &day, &minute)) {\r\n                        event.excluded.push_back(day);\r\n                    }\r\n                }\r\n                event.excludedTexts.clear();\r\n                if (event.minute < 0) {\r\n                    event.span = event.end > event.start\r\n                                     ? event.end - event.start\r\n                                 : event.durationDays > 0 ? event.durationDays\r\n                                                          : 1;\r\n                } else if (event.end > event.start) {\r\n                    // On its next days too only when it lasts a day or more.\r\n                    const int days = event.end - event.start;\r\n                    const bool lasting =\r\n                        days >= 2 || event.endMinute >= event.minute;\r\n                    event.span =\r\n                        lasting ? days + (event.endMinute > 0 ? 1 : 0) : 1;\r\n                }\r\n                event.span = std::clamp(event.span, 1, 60);\r\n                if (event.start) {\r\n                    events.push_back(std::move(event));\r\n                }\r\n            }\r\n            continue;\r\n        }\r\n        if (!inEvent) {\r\n            if (key == L\"X-WR-CALNAME\" && name->empty()) {\r\n                *name = UnescapeIcsText(value).substr(0, 60);\r\n            }\r\n            continue;\r\n        }\r\n        if (nested) {\r\n            continue;\r\n        }\r\n        if (key == L\"SUMMARY\") {\r\n            event.title = UnescapeIcsText(value);\r\n        } else if (key == L\"UID\") {\r\n            event.uid = value;\r\n        } else if (key == L\"DTSTART\") {\r\n            event.startText = value;\r\n            event.startZone = IcsZoneParameter(line, colon);\r\n        } else if (key == L\"DTEND\") {\r\n            event.endText = value;\r\n            event.endZone = IcsZoneParameter(line, colon);\r\n        } else if (key == L\"DURATION\") {\r\n            // \"P2D\" or \"P1W\" (whole days).\r\n            const size_t p = value.find(L'P');\r\n            if (p != std::wstring::npos) {\r\n                wchar_t* after = nullptr;\r\n                const long number = wcstol(value.c_str() + p + 1, &after, 10);\r\n                if (after && (*after == L'D' || *after == L'W')) {\r\n                    event.durationDays = (int)std::clamp(number, 0L, 60L) *\r\n                                         (*after == L'W' ? 7 : 1);\r\n                }\r\n            }\r\n        } else if (key == L\"RRULE\") {\r\n            event.rule = value;\r\n        } else if (key == L\"EXDATE\") {\r\n            const std::wstring zone = IcsZoneParameter(line, colon);\r\n            for (size_t from = 0;\r\n                 from < value.size() &&\r\n                 event.excludedTexts.size() < kMaxIcsExcluded;) {\r\n                size_t comma = value.find(L',', from);\r\n                if (comma == std::wstring::npos) {\r\n                    comma = value.size();\r\n                }\r\n                event.excludedTexts.push_back(\r\n                    {value.substr(from, comma - from), zone});\r\n                from = comma + 1;\r\n            }\r\n        } else if (key == L\"RECURRENCE-ID\") {\r\n            event.movedText = value;\r\n            event.movedZone = IcsZoneParameter(line, colon);\r\n        } else if (key == L\"STATUS\") {\r\n            event.cancelled = _wcsicmp(value.c_str(), L\"CANCELLED\") == 0;\r\n        }\r\n    }\r\n    // A moved occurrence (or a cancelled one) takes its event's place on\r\n    // the day it was on.\r\n    std::unordered_map<std::wstring, std::vector<size_t>> byUid;\r\n    for (size_t i = 0; i < events.size(); i++) {\r\n        if (!events[i].moved && !events[i].uid.empty()) {\r\n            byUid[events[i].uid].push_back(i);\r\n        }\r\n    }\r\n    for (const auto& moved : events) {\r\n        if (!moved.moved) {\r\n            continue;\r\n        }\r\n        if (const auto it = byUid.find(moved.uid); it != byUid.end()) {\r\n            for (const size_t i : it->second) {\r\n                // (On that event's own days.)\r\n                int day;\r\n                int minute;\r\n                if (IcsEventTime(events[i].utc, events[i].zone, moved.movedText,\r\n                                 zoneOf(moved.movedZone), &day, &minute)) {\r\n                    events[i].excluded.push_back(day);\r\n                }\r\n            }\r\n        }\r\n    }\r\n    // Every occurrence (up to many more than are kept), on its local day,\r\n    // then the ones nearest to today kept.\r\n    struct Occurrence {\r\n        int day;\r\n        int minute;\r\n        size_t event;\r\n    };\r\n    constexpr size_t kMaxOccurrences = 10 * kMaxAgendaEvents;\r\n    std::vector<Occurrence> occurrences;\r\n    for (size_t e = 0;\r\n         e < events.size() && occurrences.size() < kMaxOccurrences; e++) {\r\n        if (g_agendaStop) {\r\n            return {};\r\n        }\r\n        const IcsEvent& one = events[e];\r\n        if (one.cancelled) {\r\n            continue;\r\n        }\r\n        // (In UTC or in its zone: a day more on each side, its local days may\r\n        // be those. Each occurrence turned on its own: the zones' clock\r\n        // changes fall between them.)\r\n        const bool notLocal = one.utc || one.zone;\r\n        for (const int start : IcsEventDays(one, notLocal ? first - 1 : first,\r\n                                            notLocal ? last + 1 : last)) {\r\n            int day = start;\r\n            int minute = one.minute;\r\n            if (one.zone) {\r\n                IcsZoneToUtc(*one.zone, &day, &minute);\r\n            }\r\n            if (notLocal) {\r\n                UtcToLocal(&day, &minute);\r\n            }\r\n            for (int i = 0;\r\n                 i < one.span && occurrences.size() < kMaxOccurrences; i++) {\r\n                if (day + i >= first && day + i <= last) {\r\n                    occurrences.push_back({day + i, i == 0 ? minute : -1, e});\r\n                }\r\n            }\r\n        }\r\n    }\r\n    if (occurrences.size() > kMaxAgendaEvents) {\r\n        SYSTEMTIME now;\r\n        GetLocalTime(&now);\r\n        const int today = DayNumber(now.wYear, now.wMonth, now.wDay);\r\n        std::nth_element(\r\n            occurrences.begin(), occurrences.begin() + kMaxAgendaEvents,\r\n            occurrences.end(), [&](const Occurrence& a, const Occurrence& b) {\r\n                return std::abs(a.day - today) < std::abs(b.day - today);\r\n            });\r\n        occurrences.resize(kMaxAgendaEvents);\r\n    }\r\n    std::vector<AgendaEvent> found;\r\n    found.reserve(occurrences.size());\r\n    for (const auto& one : occurrences) {\r\n        AgendaEvent item;\r\n        DayFromNumber(one.day, &item.year, &item.month, &item.day);\r\n        item.minute = one.minute;\r\n        item.title = events[one.event].title;\r\n        found.push_back(std::move(item));\r\n    }\r\n    return found;\r\n}\r\n\r\nstruct AgendaRequest {\r\n    HWND notify = nullptr;\r\n    std::vector<std::wstring> sources;\r\n};\r\n\r\n// Reads the agendas asked for, one at a time: the calendar is told as each\r\n// comes.\r\nDWORD WINAPI AgendaThreadProc(LPVOID parameter) {\r\n    std::unique_ptr<AgendaRequest> request((AgendaRequest*)parameter);\r\n    SYSTEMTIME today;\r\n    GetLocalTime(&today);\r\n    const int first = DayNumber(today.wYear - 1, 1, 1);\r\n    const int last = DayNumber(today.wYear + 1, 12, 31);\r\n    for (const auto& source : request->sources) {\r\n        if (g_agendaStop) {\r\n            break;\r\n        }\r\n        std::wstring text;\r\n        bool ok;\r\n        // (Why it failed, for the log.)\r\n        DWORD answer = 0;\r\n        const ULONGLONG askedAt = GetTickCount64();\r\n        if (source.starts_with(L\"https://\")) {\r\n            std::vector<BYTE> data;\r\n            ok = HttpsGet(source, &data, kMaxAgendaBytes, 10000, &g_agendaStop,\r\n                          nullptr, &answer);\r\n            const int length =\r\n                ok ? MultiByteToWideChar(CP_UTF8, 0, (const char*)data.data(),\r\n                                         (int)data.size(), nullptr, 0)\r\n                   : 0;\r\n            if (length > 0) {\r\n                text.resize(length);\r\n                MultiByteToWideChar(CP_UTF8, 0, (const char*)data.data(),\r\n                                    (int)data.size(), text.data(), length);\r\n            }\r\n        } else {\r\n            ok = ReadTextFile(source.c_str(), kMaxAgendaBytes, &text);\r\n        }\r\n        const bool fetched = ok;\r\n        ok = ok && text.find(L\"BEGIN:VCALENDAR\") != std::wstring::npos;\r\n        if (!ok && !g_agendaStop) {\r\n            // Only its host: the address can be a secret one.\r\n            std::wstring where = L\"a file\";\r\n            if (source.starts_with(L\"https://\")) {\r\n                where = source.substr(8, source.find(L'/', 8) - 8);\r\n            }\r\n            std::wstring start = text.substr(0, 40);\r\n            std::replace_if(\r\n                start.begin(), start.end(), [](WCHAR c) { return c < 0x20; },\r\n                L' ');\r\n            if (fetched) {\r\n                IslandLog(L\"Agenda from %s isn't a calendar: %u characters, \"\r\n                          L\"it starts with \\\"%s\\\"\",\r\n                          where.c_str(), (unsigned)text.size(), start.c_str());\r\n            } else if (source.starts_with(L\"https://\")) {\r\n                // (No answer within the wait, an error, or a whole answer\r\n                // cut off or over kMaxAgendaBytes.)\r\n                IslandLog(L\"Agenda from %s not read: %s %u after %.1f s\",\r\n                          where.c_str(),\r\n                          !answer         ? L\"no answer, status\"\r\n                          : answer == 200 ? L\"cut off or too big, HTTP\"\r\n                                          : L\"HTTP\",\r\n                          (unsigned)answer,\r\n                          (GetTickCount64() - askedAt) / 1000.0);\r\n            } else {\r\n                IslandLog(L\"Agenda from a file not read\");\r\n            }\r\n        }\r\n        std::wstring name;\r\n        std::vector<AgendaEvent> events;\r\n        if (ok) {\r\n            events = ParseIcs(text, first, last, &name);\r\n        }\r\n        // (Stopped: nothing kept, nobody told.)\r\n        if (g_agendaStop) {\r\n            break;\r\n        }\r\n        AcquireSRWLockExclusive(&g_agendasLock);\r\n        for (auto& agenda : g_agendas) {\r\n            if (agenda.source != source) {\r\n                continue;\r\n            }\r\n            agenda.reading = false;\r\n            agenda.readAt = GetTickCount64();\r\n            agenda.failed = !ok;\r\n            agenda.notIcs = fetched && !ok;\r\n            if (ok) {\r\n                agenda.read = true;\r\n                agenda.name = std::move(name);\r\n                agenda.events = std::move(events);\r\n            }\r\n            break;\r\n        }\r\n        IndexAgendaDays();\r\n        ReleaseSRWLockExclusive(&g_agendasLock);\r\n        if (&source != &request->sources.back()) {\r\n            PostMessage(request->notify, WM_APP_AGENDAS, 0, 0);\r\n        }\r\n    }\r\n    g_agendaBusy = false;\r\n    if (!g_agendaStop) {\r\n        PostMessage(request->notify, WM_APP_AGENDAS, 1, 0);\r\n    }\r\n    return 0;\r\n}\r\n\r\n// Reads the agendas not read yet, or read 15 minutes ago (10, after\r\n// failing), on a thread (one at a time); `notify` is told as each comes.\r\nvoid RequestAgendas(HWND notify) {\r\n    if (g_agendaBusy) {\r\n        return;\r\n    }\r\n    if (g_agendaThread) {\r\n        CloseHandle(g_agendaThread);\r\n        g_agendaThread = nullptr;\r\n    }\r\n    const ULONGLONG now = GetTickCount64();\r\n    auto request = std::make_unique<AgendaRequest>();\r\n    request->notify = notify;\r\n    AcquireSRWLockExclusive(&g_agendasLock);\r\n    for (auto& agenda : g_agendas) {\r\n        const ULONGLONG wait = (agenda.failed ? 10 : 15) * 60 * 1000;\r\n        if (!agenda.readAt || now - agenda.readAt >= wait) {\r\n            agenda.reading = true;\r\n            request->sources.push_back(agenda.source);\r\n        }\r\n    }\r\n    ReleaseSRWLockExclusive(&g_agendasLock);\r\n    if (request->sources.empty()) {\r\n        return;\r\n    }\r\n    g_agendaBusy = true;\r\n    g_agendaStop = false;\r\n    g_agendaThread =\r\n        CreateThread(nullptr, 0, AgendaThreadProc, request.get(), 0, nullptr);\r\n    if (g_agendaThread) {\r\n        request.release();\r\n        return;\r\n    }\r\n    g_agendaBusy = false;\r\n    AcquireSRWLockExclusive(&g_agendasLock);\r\n    for (auto& agenda : g_agendas) {\r\n        agenda.reading = false;\r\n    }\r\n    ReleaseSRWLockExclusive(&g_agendasLock);\r\n}\r\n\r\nbool HasEvents(int year, int month, int day) {\r\n    return std::any_of(g_events.begin(), g_events.end(),\r\n                       [&](const CalendarEvent& event) {\r\n                           return event.year == year && event.month == month &&\r\n                                  event.day == day;\r\n                       });\r\n}\r\n\r\n// A local time as minutes since 1601, to compare.\r\nlong long LocalMinutes(int year, int month, int day, int minute) {\r\n    SYSTEMTIME time{(WORD)year, (WORD)month, 0, (WORD)day,\r\n                    (WORD)(minute / 60), (WORD)(minute % 60)};\r\n    FILETIME file;\r\n    if (!SystemTimeToFileTime(&time, &file)) {\r\n        return 0;\r\n    }\r\n    return (((long long)file.dwHighDateTime << 32) | file.dwLowDateTime) /\r\n           (60LL * 10000000);\r\n}\r\n\r\n// What a reminder due `late` minutes ago does (negative: not due yet). A few\r\n// minutes late is still on time (a slow PC). One the PC slept through, or the\r\n// island wasn't running or was hidden for, shows once as missed, up to 12\r\n// hours late (an all-day event's, until its day ends); older ones are only\r\n// marked done (#6156).\r\nenum class ReminderDue { Wait, OnTime, Missed, TooOld };\r\nconstexpr long long kReminderOnTimeMinutes = 2;\r\nconstexpr long long kReminderMissedMinutes = 12 * 60;\r\n\r\nReminderDue ClassifyReminder(long long late, bool allDay) {\r\n    if (late < 0) {\r\n        return ReminderDue::Wait;\r\n    }\r\n    if (late <= kReminderOnTimeMinutes) {\r\n        return ReminderDue::OnTime;\r\n    }\r\n    const long long most =\r\n        allDay ? 24 * 60 - kAllDayReminderMinute : kReminderMissedMinutes;\r\n    return late <= most ? ReminderDue::Missed : ReminderDue::TooOld;\r\n}\r\n\r\n// When an event's reminder is due, in LocalMinutes.\r\nlong long ReminderMinutes(const CalendarEvent& event) {\r\n    return LocalMinutes(\r\n        event.year, event.month, event.day,\r\n        event.minute >= 0 ? event.minute : kAllDayReminderMinute);\r\n}\r\n\r\nstruct DueReminder {\r\n    CalendarEvent event;\r\n    bool missed;\r\n};\r\n\r\n// The reminders due now (marked as done), each with whether it is a missed\r\n// one. Ones too old are marked done without reminding.\r\nstd::vector<DueReminder> TakeDueReminders() {\r\n    LoadEvents();\r\n    SYSTEMTIME now;\r\n    GetLocalTime(&now);\r\n    const long long current = LocalMinutes(now.wYear, now.wMonth, now.wDay,\r\n                                           now.wHour * 60 + now.wMinute);\r\n    std::vector<DueReminder> due;\r\n    bool changed = false;\r\n    for (auto& event : g_events) {\r\n        if (!event.remind || event.fired) {\r\n            continue;\r\n        }\r\n        const long long late = current - ReminderMinutes(event);\r\n        const ReminderDue verdict = ClassifyReminder(late, event.minute < 0);\r\n        if (verdict == ReminderDue::Wait) {\r\n            continue;\r\n        }\r\n        event.fired = true;\r\n        changed = true;\r\n        // (Logged without its title, to see why one wasn't seen: #6156.)\r\n        if (verdict == ReminderDue::TooOld) {\r\n            IslandLog(L\"Reminder missed by %lld min: too old, not shown\",\r\n                      late);\r\n            continue;\r\n        }\r\n        due.push_back({event, verdict == ReminderDue::Missed});\r\n        IslandLog(L\"Reminder due %lld min ago%s\", late,\r\n                  verdict == ReminderDue::Missed ? L\" (shown as missed)\" : L\"\");\r\n    }\r\n    if (changed) {\r\n        SaveEvents();\r\n    }\r\n    return due;\r\n}\r\n\r\n// Past events hidden from their day's list a while after their day\r\n// (calendarHidePastAfter: 0 never, 1 after a day, 2 a week, 3 thirty days),\r\n// one choice for every island (the events are the same for all), made in the\r\n// main island's calendar. Still marked on their day, and shown when asked\r\n// for (see CalendarPanel::DayEvents).\r\nint g_hidePastAfter = 0;\r\n\r\n// The days a calendarHidePastAfter choice waits (0: never hidden).\r\nint HidePastDays(int choice) {\r\n    return choice == 1 ? 1 : choice == 2 ? 7 : choice == 3 ? 30 : 0;\r\n}\r\n\r\n// Whether an event's day is at least `days` days before `today` (in\r\n// LocalMinutes, at midnight).\r\nbool EventIsPast(const CalendarEvent& event, long long today, int days) {\r\n    const long long day = LocalMinutes(event.year, event.month, event.day, 0);\r\n    return days > 0 && day && today - day >= days * 24LL * 60;\r\n}\r\n\r\n// Today in LocalMinutes, at midnight.\r\nlong long TodayMinutes() {\r\n    SYSTEMTIME now;\r\n    GetLocalTime(&now);\r\n    return LocalMinutes(now.wYear, now.wMonth, now.wDay, 0);\r\n}\r\n\r\n// The events before today (see DeletePastEvents).\r\nsize_t PastEventCount() {\r\n    const long long today = TodayMinutes();\r\n    return std::count_if(g_events.begin(), g_events.end(),\r\n                         [&](const CalendarEvent& event) {\r\n                             return EventIsPast(event, today, 1);\r\n                         });\r\n}\r\n\r\n// Changed when the events or their hiding change elsewhere (see\r\n// SetHidePastAfter, DeletePastEvents): an open calendar lays itself out\r\n// again.\r\nint g_eventsDropped = 0;\r\n\r\nvoid SetHidePastAfter(int choice) {\r\n    g_hidePastAfter = std::clamp(choice, 0, 3);\r\n    Wh_SetIntValue(L\"calendarHidePastAfter\", g_hidePastAfter);\r\n    g_eventsDropped++;\r\n}\r\n\r\n// Every event before today deleted (the calendar's \"Delete past events\").\r\nvoid DeletePastEvents() {\r\n    const long long today = TodayMinutes();\r\n    if (std::erase_if(g_events, [&](const CalendarEvent& event) {\r\n            return EventIsPast(event, today, 1);\r\n        })) {\r\n        SaveEvents();\r\n        g_eventsDropped++;\r\n    }\r\n}\r\n\r\n// Whether the island shows the main island's settings (see\r\n// Island::HasMainSettings); defined further down.\r\nbool IslandHasMainSettings(const Island* island);\r\n\r\n// A time as the clock's format says (see clockFormat), everywhere the island\r\n// shows one. With 12 hours, AM or PM (the regional format's words, or these)\r\n// goes in `marker` when it's drawn apart (smaller, on the pill), otherwise\r\n// after the time.\r\nstd::wstring FormatClockTime(const SYSTEMTIME& time,\r\n                             bool seconds,\r\n                             std::wstring* marker = nullptr) {\r\n    WCHAR text[64] = L\"\";\r\n    const int format = g_settings.clockFormat;\r\n    if (format == 0) {\r\n        GetTimeFormatEx(LOCALE_NAME_USER_DEFAULT, seconds ? 0 : TIME_NOSECONDS,\r\n                        &time, nullptr, text, ARRAYSIZE(text));\r\n        return text;\r\n    }\r\n    PCWSTR picture = format == 1 ? (seconds ? L\"HH:mm:ss\" : L\"HH:mm\")\r\n                                 : (seconds ? L\"h:mm:ss\" : L\"h:mm\");\r\n    GetTimeFormatEx(LOCALE_NAME_USER_DEFAULT, 0, &time, picture, text,\r\n                    ARRAYSIZE(text));\r\n    std::wstring result = text;\r\n    if (format == 2) {\r\n        WCHAR designator[16] = L\"\";\r\n        GetTimeFormatEx(DateLocale(), 0, &time, L\"tt\", designator,\r\n                        ARRAYSIZE(designator));\r\n        const std::wstring words =\r\n            designator[0] ? designator : time.wHour < 12 ? L\"AM\" : L\"PM\";\r\n        if (marker) {\r\n            *marker = words;\r\n        } else {\r\n            result += L\" \" + words;\r\n        }\r\n    }\r\n    return result;\r\n}\r\n\r\n// With 12 hours, the clock's AM or PM (its last word) smaller, like the\r\n// iPhone's.\r\nvoid SmallClockMarker(IDWriteTextLayout* layout, const std::wstring& text) {\r\n    const size_t space = text.rfind(L' ');\r\n    if (g_settings.clockFormat != 2 || space == std::wstring::npos ||\r\n        space + 1 >= text.size()) {\r\n        return;\r\n    }\r\n    const DWRITE_TEXT_RANGE range{(UINT32)space + 1,\r\n                                  (UINT32)(text.size() - space - 1)};\r\n    FLOAT size = 0;\r\n    layout->GetFontSize(0, &size);\r\n    layout->SetFontSize(size * 0.68f, range);\r\n}\r\n\r\n// \"14:30\", or \"All day\".\r\nstd::wstring EventTimeText(int minute) {\r\n    if (minute < 0) {\r\n        return Tr(L\"All day\", L\"Dia todo\");\r\n    }\r\n    SYSTEMTIME time{2000, 1, 0, 1, (WORD)(minute / 60), (WORD)(minute % 60)};\r\n    return FormatClockTime(time, false);\r\n}\r\n\r\n// What's on the clipboard added to a text being typed (on one line, up to\r\n// `limit` characters).\r\nvoid PasteText(HWND hwnd, std::wstring* text, size_t limit) {\r\n    if (!OpenClipboard(hwnd)) {\r\n        return;\r\n    }\r\n    if (HANDLE data = GetClipboardData(CF_UNICODETEXT)) {\r\n        if (auto pasted = (PCWSTR)GlobalLock(data)) {\r\n            const PCWSTR end = pasted + GlobalSize(data) / sizeof(WCHAR);\r\n            for (PCWSTR p = pasted; p < end && *p && text->size() < limit;\r\n                 p++) {\r\n                if (*p >= 0x20 && *p != L'\\t') {\r\n                    *text += *p;\r\n                }\r\n            }\r\n            GlobalUnlock(data);\r\n        }\r\n    }\r\n    CloseClipboard();\r\n}\r\n\r\nclass CalendarPanel : public Panel {\r\n   protected:\r\n    void Prepare(float scale) override;\r\n    void OnOpen() override;\r\n    void Draw(ID2D1RenderTarget* target, ID2D1SolidColorBrush* brush) override;\r\n    bool OnMouseMove(POINT pt) override;\r\n    bool OnMouseLeave() override;\r\n    bool OnMouseUp(POINT pt) override;\r\n    bool OnWheel(int delta) override;\r\n    bool OnKey(WPARAM key) override;\r\n    bool OnChar(WCHAR c) override;\r\n\r\n   public:\r\n    // Called every second while open, for the clock.\r\n    void Refresh() {\r\n        // Events gone elsewhere, or hidden otherwise (see g_eventsDropped):\r\n        // the one being changed no longer, the rows laid out again.\r\n        if (m_eventsDropped != g_eventsDropped) {\r\n            m_eventsDropped = g_eventsDropped;\r\n            if (m_adding && m_editingId &&\r\n                std::none_of(g_events.begin(), g_events.end(),\r\n                             [&](const CalendarEvent& event) {\r\n                                 return event.id == m_editingId;\r\n                             })) {\r\n                StopEditing();\r\n            }\r\n            if (IsOpen()) {\r\n                Layout();\r\n            }\r\n        }\r\n        if (IsOpen()) {\r\n            Render();\r\n        }\r\n    }\r\n    // Opens on a day (a reminder's).\r\n    void SelectDay(int year, int month, int day) {\r\n        m_openOn = {year, month, day};\r\n    }\r\n\r\n   protected:\r\n    bool AnimateContents(double dt) override;\r\n\r\n   private:\r\n    enum class Part {\r\n        None,\r\n        Previous,\r\n        Next,\r\n        Title,\r\n        Day,          // A day of the month (value).\r\n        DeleteEvent,  // An event's \"x\" (id).\r\n        EventRow,     // An event, to edit it (id).\r\n        Add,\r\n        TitleField,\r\n        // The value: 0 in the box (to type), +1/-1 on its arrows.\r\n        Hour,\r\n        Minute,\r\n        AllDay,\r\n        Remind,\r\n        Save,\r\n        Cancel,\r\n        // The agendas' view: its button, an agenda's color and its \"x\" (the\r\n        // agenda's index), the link's field and \"Add\", and today's colors\r\n        // (0 to 2).\r\n        Agendas,\r\n        AgendaColor,\r\n        AgendaRemove,\r\n        LinkField,\r\n        LinkAdd,\r\n        TodayChoice,\r\n        // When past events are hidden (the choice's index).\r\n        DeleteChoice,\r\n        DeletePast,\r\n        // \"Show N hidden\" under the day's events.\r\n        ShowHidden,\r\n        // An upcoming event's or holiday's row (its day, yyyymmdd).\r\n        Upcoming,\r\n        // Today big at the left (islandCalendarBigDay): its alarms' and\r\n        // timer's buttons, and its gear (the agendas' view).\r\n        BigAlarms,\r\n        BigTimer,\r\n        BigGear,\r\n    };\r\n    struct Hit {\r\n        Part part = Part::None;\r\n        long long value = 0;\r\n        bool operator==(const Hit& other) const {\r\n            return part == other.part && value == other.value;\r\n        }\r\n    };\r\n    struct DayOpen {\r\n        int year = 0;\r\n        int month = 0;\r\n        int day = 0;\r\n    };\r\n\r\n    void ChangeMonth(int delta);\r\n    void Layout();\r\n    Hit HitTest(POINT pt) const;\r\n    // Today big (islandCalendarBigDay, #6165, see LayoutBigDay): its left\r\n    // column's width (0 without it), its buttons, the line before them, its\r\n    // number's format.\r\n    float m_side = 0;\r\n    // A short screen (#7046): the month stays whole, its rows as tall as fit\r\n    // (the big clock goes before they get too short), and the events scroll\r\n    // with the wheel in their view (nothing when they fit). See FitMonth and\r\n    // FitEvents. The panel as a whole scrolls only if that's not enough.\r\n    float m_rowHeight = 0;\r\n    float m_clockHeight = 0;\r\n    D2D1_RECT_F m_eventsView{};\r\n    SmoothScroll m_eventsScroll;\r\n    void FitMonth(float above, float below);\r\n    float FitEvents(float left, float right, float top, float bottom);\r\n    void BeginEventsView(ID2D1RenderTarget* target);\r\n    void EndEventsView(ID2D1RenderTarget* target, ID2D1SolidColorBrush* brush);\r\n    void DrawEvents(ID2D1RenderTarget* target,\r\n                    ID2D1SolidColorBrush* brush,\r\n                    float width);\r\n    D2D1_RECT_F m_bigAlarms{}, m_bigTimer{}, m_bigGear{};\r\n    float m_bigDivider = 0;\r\n    // The chosen day's events on it (the agendas' and the user's own, by\r\n    // their time; see LayoutBigDay), up to kBigDayEvents, how many more,\r\n    // and their title's row.\r\n    struct BigDayEvent {\r\n        int minute;\r\n        // The agenda's color, or -1 for the user's own (red, as in the\r\n        // month).\r\n        int color;\r\n        std::wstring title;\r\n    };\r\n    std::vector<BigDayEvent> m_bigEvents;\r\n    size_t m_bigEventsMore = 0;\r\n    D2D1_RECT_F m_bigEventsHeader{};\r\n    // (The upcoming events' and holidays' rows, as both views have them.)\r\n    Hit UpcomingHit(POINT pt) const;\r\n    void LayoutBigDay();\r\n    winrt::com_ptr<IDWriteTextFormat> m_bigDayFormat;\r\n    void DrawCalendar(ID2D1RenderTarget* target, ID2D1SolidColorBrush* brush);\r\n    void DrawBigDay(ID2D1RenderTarget* target, ID2D1SolidColorBrush* brush);\r\n    // The holidays of the year shown, downloaded if chosen and not known\r\n    // yet (once a session; on a thread, see HolidayThreadProc).\r\n    void RequestHolidays();\r\n    bool OnAppMessage(UINT msg, WPARAM wParam, LPARAM lParam) override;\r\n    void OnDestroy() override;\r\n    HANDLE m_holidayThread = nullptr;\r\n    std::vector<int> m_holidaysAsked;\r\n    // A download failed (offline): not asked again before then.\r\n    ULONGLONG m_holidaysRetryAt = 0;\r\n    // The chosen day's holidays' rows, over its events.\r\n    std::vector<D2D1_RECT_F> m_holidayRows;\r\n    // The next holidays, under it all.\r\n    std::vector<Holiday> m_upcoming;\r\n    D2D1_RECT_F m_upcomingHeader{};\r\n    // A month's title and days, moved sideways by `offset` pixels.\r\n    void DrawMonth(ID2D1RenderTarget* target,\r\n                   ID2D1SolidColorBrush* brush,\r\n                   int year,\r\n                   int month,\r\n                   float offset,\r\n                   float opacity);\r\n    void DrawUpcoming(ID2D1RenderTarget* target, ID2D1SolidColorBrush* brush);\r\n    void DrawField(ID2D1RenderTarget* target,\r\n                   ID2D1SolidColorBrush* brush,\r\n                   const D2D1_RECT_F& rect,\r\n                   const std::wstring& text,\r\n                   PCWSTR placeholder,\r\n                   bool focused);\r\n    std::vector<const CalendarEvent*> DayEvents(size_t* hidden = nullptr) const;\r\n    void SaveNewEvent();\r\n    void StartEditing(const CalendarEvent* event);\r\n    void StopEditing();\r\n    void TypeDigit(int digit);\r\n\r\n    winrt::com_ptr<IDWriteTextFormat> m_titleFormat;\r\n    winrt::com_ptr<IDWriteTextFormat> m_dayFormat;\r\n    winrt::com_ptr<IDWriteTextFormat> m_iconFormat;\r\n    winrt::com_ptr<IDWriteTextFormat> m_clockFormat;\r\n    winrt::com_ptr<IDWriteTextFormat> m_dateFormat;\r\n    winrt::com_ptr<IDWriteTextFormat> m_textFormat;\r\n    winrt::com_ptr<IDWriteTextFormat> m_smallFormat;\r\n    winrt::com_ptr<IDWriteTypography> m_tabular;\r\n    // Changing months: the one before slides out, the new one in (m_slide\r\n    // from 1 to 0), in the direction of m_slideDirection.\r\n    int m_fromYear = 0;\r\n    int m_fromMonth = 0;\r\n    double m_slide = 0;\r\n    double m_slideVelocity = 0;\r\n    int m_slideDirection = 0;\r\n    float m_preparedScale = 0;\r\n    D2D1_RECT_F m_previous{}, m_next{}, m_title{};\r\n    Hit m_hover;\r\n    int m_year = 0;\r\n    int m_month = 0;\r\n    // The day chosen (its events below the month).\r\n    int m_selectedYear = 0;\r\n    int m_selectedMonth = 0;\r\n    int m_selectedDay = 0;\r\n    DayOpen m_openOn;\r\n    // Where things are.\r\n    std::vector<std::pair<int, D2D1_RECT_F>> m_dayRects;\r\n    std::vector<std::pair<long long, D2D1_RECT_F>> m_eventRows;\r\n    D2D1_RECT_F m_eventsHeader{}, m_addButton{}, m_titleField{}, m_hourBox{},\r\n        m_minuteBox{}, m_allDayButton{}, m_remindButton{}, m_saveButton{},\r\n        m_cancelButton{}, m_status{};\r\n    // A new event being written (or one being changed, m_editingId): its\r\n    // title, its time (or the whole day), and the reminder.\r\n    bool m_adding = false;\r\n    long long m_editingId = 0;\r\n    // g_eventsDropped when last seen (see Refresh).\r\n    int m_eventsDropped = 0;\r\n    // The chosen day's events hidden as past (see g_hidePastAfter): how\r\n    // many, their \"Show N hidden\" row, and the day they're shown for once\r\n    // that's clicked (year * 10000 + month * 100 + day).\r\n    size_t m_hiddenCount = 0;\r\n    D2D1_RECT_F m_hiddenRow{};\r\n    int m_showHiddenFor = 0;\r\n    int SelectedDayKey() const {\r\n        return m_selectedYear * 10000 + m_selectedMonth * 100 + m_selectedDay;\r\n    }\r\n    // Where typing goes; in the hour and the minute, how many figures were\r\n    // typed (two move on).\r\n    enum class Field { Title, Hour, Minute } m_focus = Field::Title;\r\n    int m_digits = 0;\r\n    // The fields fading and sliding in (0 to 1).\r\n    double m_form = 0;\r\n    double m_formVelocity = 0;\r\n    std::wstring m_newTitle;\r\n    int m_newHour = 9;\r\n    int m_newMinute = 0;\r\n    bool m_newAllDay = false;\r\n    bool m_newRemind = true;\r\n    void StepTime(Part part, int steps);\r\n    std::wstring m_statusText;\r\n\r\n    // The agendas' view (instead of the month): the agendas, a link or a\r\n    // path to add, and today's color.\r\n    bool m_agendasView = false;\r\n    D2D1_RECT_F m_agendasButton{}, m_agendaHint{}, m_linkField{}, m_linkAdd{},\r\n        m_agendaStatus{}, m_todayHeader{};\r\n    std::vector<D2D1_RECT_F> m_agendaRows;\r\n    // The ones added in the calendar (the settings' ones are removed there).\r\n    std::vector<bool> m_agendaRemovable;\r\n    std::array<D2D1_RECT_F, 3> m_todayChips{};\r\n    // Past events hidden after (see g_hidePastAfter): its header and its\r\n    // choices, and the events' count with \"Delete past events\" (pressed\r\n    // twice) next to it. The main island's calendar only.\r\n    D2D1_RECT_F m_deleteHeader{};\r\n    std::array<D2D1_RECT_F, 4> m_deleteChips{};\r\n    D2D1_RECT_F m_countLine{};\r\n    D2D1_RECT_F m_deletePastButton{};\r\n    double m_deletePastArmedAt = -100;\r\n    std::wstring m_newLink;\r\n    std::wstring m_agendaStatusText;\r\n    // The chosen day's agenda events (up to kEventsShown, and how many\r\n    // more), and the next ones from now.\r\n    std::vector<AgendaItem> m_dayAgenda;\r\n    std::vector<D2D1_RECT_F> m_agendaEventRows;\r\n    size_t m_agendaMore = 0;\r\n    D2D1_RECT_F m_agendaMoreRow{};\r\n    std::vector<AgendaItem> m_upcomingAgenda;\r\n    D2D1_RECT_F m_upcomingAgendaHeader{};\r\n    // Today's circle (see kTodayRed), and Windows' accent color (read as the\r\n    // calendar opens).\r\n    int m_todayMode = 0;\r\n    int m_todayColor = kTodayRed;\r\n    int m_windowsAccent = 0x0078D4;\r\n    D2D1_COLOR_F TodayColor() const;\r\n    void SetTodayMode(int mode);\r\n    void LayoutAgendas(float y);\r\n    void DrawAgendas(ID2D1RenderTarget* target, ID2D1SolidColorBrush* brush);\r\n    void AddAgenda();\r\n    void RemoveAgenda(size_t index);\r\n    // Windows' color dialog (see ColorThreadProc), for an agenda (its\r\n    // source) or for today (empty).\r\n    HANDLE m_colorThread = nullptr;\r\n    std::wstring m_colorSource;\r\n    void StartColorDialog(const std::wstring& source, int color);\r\n    bool OnColorDone(LPARAM lParam);\r\n    void EndColorDialog();\r\n};\r\n\r\n// The clock on top of the calendar; the events' rows under it.\r\nconstexpr float kCalendarClockHeight = 74;\r\n// Today big at the calendar's left (islandCalendarBigDay), and its buttons\r\n// opening the timer's panel on a tab (see Island::OpenTimerTab).\r\nconstexpr float kCalendarSideWidth = 160;\r\n// Its right column (the buttons and the upcoming holidays).\r\nconstexpr float kBigDayRight = 190;\r\nvoid OpenTimerTabOf(Island* island, int tab);\r\nconstexpr float kEventRowHeight = 30;\r\nconstexpr int kEventsShown = 4;\r\nconstexpr WCHAR kGlyphEventDelete = 0xE711;\r\nconstexpr WCHAR kGlyphChevronDownCalendar = 0xE70D;\r\nconstexpr WCHAR kGlyphCalendarBack = 0xE72B;\r\n\r\nvoid CalendarPanel::Prepare(float scale) {\r\n    if (scale != m_preparedScale || m_preparedFonts != FontsKey()) {\r\n        m_preparedScale = scale;\r\n        m_preparedFonts = FontsKey();\r\n        m_clockFormat = MakeFormat(ClockFont(L\"Segoe UI Variable Display\"),\r\n                                   DWRITE_FONT_WEIGHT_SEMI_BOLD, 34 * scale,\r\n                                   DWRITE_TEXT_ALIGNMENT_LEADING);\r\n        m_dateFormat = MakeFormat(L\"Segoe UI Variable Text\",\r\n                                  DWRITE_FONT_WEIGHT_NORMAL, 13 * scale,\r\n                                  DWRITE_TEXT_ALIGNMENT_LEADING);\r\n        if (!m_tabular &&\r\n            SUCCEEDED(m_dwrite->CreateTypography(m_tabular.put()))) {\r\n            m_tabular->AddFontFeature(\r\n                {DWRITE_FONT_FEATURE_TAG_TABULAR_FIGURES, 1});\r\n        }\r\n        m_titleFormat = MakeFormat(L\"Segoe UI Variable Display\",\r\n                                   DWRITE_FONT_WEIGHT_BOLD, 15 * scale,\r\n                                   DWRITE_TEXT_ALIGNMENT_LEADING);\r\n        m_dayFormat = MakeFormat(L\"Segoe UI Variable Text\",\r\n                                 DWRITE_FONT_WEIGHT_SEMI_BOLD, 13 * scale);\r\n        m_iconFormat = MakeFormat(IconFont(),\r\n                                  DWRITE_FONT_WEIGHT_NORMAL, 12 * scale);\r\n        m_textFormat =\r\n            MakeFormat(L\"Segoe UI Variable Text\", DWRITE_FONT_WEIGHT_NORMAL,\r\n                       12.5f * scale, DWRITE_TEXT_ALIGNMENT_LEADING);\r\n        m_smallFormat =\r\n            MakeFormat(L\"Segoe UI Variable Text\", DWRITE_FONT_WEIGHT_NORMAL,\r\n                       11.5f * scale, DWRITE_TEXT_ALIGNMENT_LEADING);\r\n        m_bigDayFormat = MakeFormat(L\"Segoe UI Variable Display\",\r\n                                    DWRITE_FONT_WEIGHT_SEMI_BOLD, 64 * scale,\r\n                                    DWRITE_TEXT_ALIGNMENT_CENTER);\r\n    }\r\n    LoadEvents();\r\n    Layout();\r\n}\r\n\r\nvoid CalendarPanel::OnOpen() {\r\n    SYSTEMTIME today;\r\n    GetLocalTime(&today);\r\n    m_selectedYear = m_year = today.wYear;\r\n    m_selectedMonth = m_month = today.wMonth;\r\n    m_selectedDay = today.wDay;\r\n    // A reminder's day.\r\n    if (m_openOn.year) {\r\n        m_selectedYear = m_year = m_openOn.year;\r\n        m_selectedMonth = m_month = m_openOn.month;\r\n        m_selectedDay = m_openOn.day;\r\n        m_openOn = {};\r\n    }\r\n    RequestHolidays();\r\n    m_hover = {};\r\n    m_slide = 0;\r\n    m_slideVelocity = 0;\r\n    m_adding = false;\r\n    m_editingId = 0;\r\n    m_form = 0;\r\n    m_formVelocity = 0;\r\n    m_statusText.clear();\r\n    // The agendas (read again when due) and today's color.\r\n    m_agendasView = false;\r\n    m_newLink.clear();\r\n    m_agendaStatusText.clear();\r\n    m_todayMode = std::clamp(Wh_GetIntValue(L\"calendarToday\", 0), 0, 2);\r\n    m_todayColor = Wh_GetIntValue(L\"calendarTodayColor\", kTodayRed) & 0xFFFFFF;\r\n    m_windowsAccent = WindowsAccentColor();\r\n    LoadAgendas();\r\n    RequestAgendas(m_hwnd);\r\n    Layout();\r\n}\r\n\r\nbool CalendarPanel::AnimateContents(double dt) {\r\n    const bool slide =\r\n        SpringTowards(m_slide, m_slideVelocity, 0, 0.45, dt, 0.85);\r\n    const bool form = SpringTowards(m_form, m_formVelocity, m_adding ? 1 : 0,\r\n                                    m_adding ? 0.4 : 0.25, dt,\r\n                                    m_adding ? kBounceDamping : 1.0);\r\n    const bool events = m_eventsScroll.Animate(dt);\r\n    // Writing an event or a link: the caret blinks a moment (at the lower\r\n    // frame rate).\r\n    const bool typing = (m_adding || m_agendasView) && CaretBlinking();\r\n    m_idleMotion = typing && !slide && !form && !events;\r\n    return slide || form || events || typing;\r\n}\r\n\r\n// Writing an event: a new one (nullptr) for the chosen day, or one to change.\r\nvoid CalendarPanel::StartEditing(const CalendarEvent* event) {\r\n    m_adding = true;\r\n    m_statusText.clear();\r\n    m_focus = Field::Title;\r\n    m_digits = 0;\r\n    if (event) {\r\n        m_editingId = event->id;\r\n        m_newTitle = event->title;\r\n        m_newRemind = event->remind;\r\n        m_newAllDay = event->minute < 0;\r\n        const int minute = event->minute < 0 ? 9 * 60 : event->minute;\r\n        m_newHour = minute / 60;\r\n        m_newMinute = minute % 60;\r\n    } else {\r\n        m_editingId = 0;\r\n        m_newTitle.clear();\r\n        m_newRemind = true;\r\n        m_newAllDay = false;\r\n        // The next full hour.\r\n        SYSTEMTIME now;\r\n        GetLocalTime(&now);\r\n        m_newHour = (now.wHour + 1) % 24;\r\n        m_newMinute = 0;\r\n    }\r\n    m_form = 0;\r\n    m_formVelocity = 0;\r\n    StartIslandAnimation();\r\n    Layout();\r\n    // (Among events that scroll: brought into view.)\r\n    if (m_eventsView.bottom > m_eventsView.top) {\r\n        m_eventsScroll.ShowRange(m_titleField.top - m_eventsView.top,\r\n                                 m_saveButton.bottom - m_eventsView.top);\r\n    }\r\n}\r\n\r\nvoid CalendarPanel::StopEditing() {\r\n    m_adding = false;\r\n    m_editingId = 0;\r\n    m_statusText.clear();\r\n    StartIslandAnimation();\r\n    Layout();\r\n}\r\n\r\n// A figure typed in the hour or the minute: two make the value (the hour\r\n// then moves on to the minute), like typing a time on a phone.\r\nvoid CalendarPanel::TypeDigit(int digit) {\r\n    m_newAllDay = false;\r\n    if (m_focus == Field::Hour) {\r\n        if (m_digits == 0) {\r\n            m_newHour = digit;\r\n            m_digits = 1;\r\n            // No hour starts with 3 or more and has a second figure.\r\n            if (digit > 2) {\r\n                m_focus = Field::Minute;\r\n                m_digits = 0;\r\n            }\r\n        } else {\r\n            const int value = m_newHour * 10 + digit;\r\n            m_newHour = value <= 23 ? value : digit;\r\n            m_focus = Field::Minute;\r\n            m_digits = 0;\r\n        }\r\n    } else if (m_focus == Field::Minute) {\r\n        if (m_digits == 0) {\r\n            m_newMinute = digit;\r\n            m_digits = digit > 5 ? 0 : 1;\r\n        } else {\r\n            m_newMinute = std::min(m_newMinute * 10 + digit, 59);\r\n            m_digits = 0;\r\n        }\r\n    }\r\n}\r\n\r\nvoid CalendarPanel::RequestHolidays() {\r\n    if (!g_settings.calendarHolidays || !m_year) {\r\n        return;\r\n    }\r\n    LoadHolidays();\r\n    AcquireSRWLockShared(&g_holidaysLock);\r\n    const std::wstring country = g_holidaysCountry;\r\n    const bool known = std::find(g_holidayYears.begin(), g_holidayYears.end(),\r\n                                 m_year) != g_holidayYears.end();\r\n    ReleaseSRWLockShared(&g_holidaysLock);\r\n    if (country.empty() || known || GetTickCount64() < m_holidaysRetryAt ||\r\n        std::find(m_holidaysAsked.begin(), m_holidaysAsked.end(), m_year) !=\r\n            m_holidaysAsked.end()) {\r\n        return;\r\n    }\r\n    // One at a time.\r\n    if (m_holidayThread) {\r\n        if (WaitForSingleObject(m_holidayThread, 0) != WAIT_OBJECT_0) {\r\n            return;\r\n        }\r\n        CloseHandle(m_holidayThread);\r\n        m_holidayThread = nullptr;\r\n    }\r\n    m_holidaysAsked.push_back(m_year);\r\n    auto* request = new HolidayRequest{m_hwnd, m_year, country};\r\n    m_holidayThread =\r\n        CreateThread(nullptr, 0, HolidayThreadProc, request, 0, nullptr);\r\n    if (!m_holidayThread) {\r\n        delete request;\r\n    }\r\n}\r\n\r\nbool CalendarPanel::OnAppMessage(UINT msg, WPARAM wParam, LPARAM lParam) {\r\n    if (msg == WM_APP_COLOR_DONE) {\r\n        return OnColorDone(lParam);\r\n    }\r\n    // An agenda read; the last one: the ones added meanwhile are read too.\r\n    if (msg == WM_APP_AGENDAS) {\r\n        if (wParam) {\r\n            RequestAgendas(m_hwnd);\r\n        }\r\n        Layout();\r\n        StartIslandAnimation();\r\n        return true;\r\n    }\r\n    if (msg != WM_APP_HOLIDAYS) {\r\n        return false;\r\n    }\r\n    // Not downloaded (offline): asked again when it's shown, after 10\r\n    // minutes.\r\n    if (lParam) {\r\n        std::erase(m_holidaysAsked, (int)wParam);\r\n        m_holidaysRetryAt = GetTickCount64() + 10 * 60 * 1000;\r\n        return true;\r\n    }\r\n    SaveHolidays();\r\n    Layout();\r\n    // The next year shown, maybe.\r\n    RequestHolidays();\r\n    return true;\r\n}\r\n\r\nvoid CalendarPanel::OnDestroy() {\r\n    EndColorDialog();\r\n    // The agendas being read (any calendar's): stopped at the next step (a\r\n    // request gives up after a few seconds), and read again as the calendar\r\n    // opens next time.\r\n    if (g_agendaThread) {\r\n        g_agendaStop = true;\r\n        WaitForSingleObject(g_agendaThread, 20000);\r\n        CloseHandle(g_agendaThread);\r\n        g_agendaThread = nullptr;\r\n        AcquireSRWLockExclusive(&g_agendasLock);\r\n        for (auto& agenda : g_agendas) {\r\n            agenda.reading = false;\r\n        }\r\n        ReleaseSRWLockExclusive(&g_agendasLock);\r\n    }\r\n    if (m_holidayThread) {\r\n        // The download gives up after a few seconds.\r\n        WaitForSingleObject(m_holidayThread, 15000);\r\n        CloseHandle(m_holidayThread);\r\n        m_holidayThread = nullptr;\r\n    }\r\n}\r\n\r\nvoid CalendarPanel::ChangeMonth(int delta) {\r\n    // The month shown slides out (from where it is, if still sliding).\r\n    if (m_slide < 0.5) {\r\n        m_fromYear = m_year;\r\n        m_fromMonth = m_month;\r\n    }\r\n    m_slideDirection = delta > 0 ? 1 : -1;\r\n    m_slide = 1;\r\n    m_slideVelocity = 0;\r\n    StartIslandAnimation();\r\n    m_month += delta;\r\n    while (m_month < 1) {\r\n        m_month += 12;\r\n        m_year--;\r\n    }\r\n    while (m_month > 12) {\r\n        m_month -= 12;\r\n        m_year++;\r\n    }\r\n    RequestHolidays();\r\n    Layout();\r\n}\r\n\r\nstd::vector<const CalendarEvent*> CalendarPanel::DayEvents(\r\n    size_t* hidden) const {\r\n    std::vector<const CalendarEvent*> events;\r\n    // Past the chosen wait (see g_hidePastAfter): only once asked for;\r\n    // `hidden` gets how many.\r\n    const int days =\r\n        m_showHiddenFor == SelectedDayKey() ? 0 : HidePastDays(g_hidePastAfter);\r\n    const long long today = TodayMinutes();\r\n    if (hidden) {\r\n        *hidden = 0;\r\n    }\r\n    for (const auto& event : g_events) {\r\n        if (event.year == m_selectedYear && event.month == m_selectedMonth &&\r\n            event.day == m_selectedDay) {\r\n            if (EventIsPast(event, today, days)) {\r\n                if (hidden) {\r\n                    (*hidden)++;\r\n                }\r\n                continue;\r\n            }\r\n            events.push_back(&event);\r\n        }\r\n    }\r\n    std::stable_sort(events.begin(), events.end(),\r\n                     [](const CalendarEvent* a, const CalendarEvent* b) {\r\n                         return a->minute < b->minute;\r\n                     });\r\n    return events;\r\n}\r\n\r\n// Today big (islandCalendarBigDay, #6165), as one card: the chosen day at\r\n// the left (its weekday, month, number, week and holiday), the month's\r\n// grid in the middle (its title over it, its neighbors' days dimmed), and at\r\n// the right the alarm's and timer's buttons and the agendas' gear, over the\r\n// chosen day's events, the upcoming events and holidays. A day clicked is\r\n// shown at the left; the wheel changes the month.\r\nvoid CalendarPanel::LayoutBigDay() {\r\n    const float scale = m_scale;\r\n    const float padding = std::round(kPanelPadding * scale);\r\n    const float cell = std::round(kCalendarCell * scale);\r\n    const float gridLeft = m_side;\r\n    // The month shown (\"Novembro de 2026\", DrawBigDay) over the weekdays;\r\n    // clicking it goes back to today, as in the month without the card.\r\n    const float titleHeight = std::round(24 * scale);\r\n    m_title = {gridLeft + cell * 0.2f, padding, gridLeft + cell * 7,\r\n               padding + titleHeight};\r\n    const float gridTop = m_title.bottom + std::round(26 * scale);\r\n    FitMonth(gridTop, padding);\r\n    const float divider = gridLeft + cell * 7 + padding;\r\n    const float right = divider + padding + std::round(kBigDayRight * scale);\r\n    m_dayRects.clear();\r\n    WCHAR firstDayText[4] = L\"6\";\r\n    GetLocaleInfoEx(LOCALE_NAME_USER_DEFAULT, LOCALE_IFIRSTDAYOFWEEK,\r\n                    firstDayText, ARRAYSIZE(firstDayText));\r\n    const int firstDay = (_wtoi(firstDayText) + 1) % 7;\r\n    const int lead =\r\n        m_year ? (DayOfWeek(m_year, m_month, 1) - firstDay + 7) % 7 : 0;\r\n    const int days = m_year ? DaysInMonth(m_year, m_month) : 0;\r\n    for (int day = 1; day <= days; day++) {\r\n        const int index = day - 1 + lead;\r\n        m_dayRects.push_back(\r\n            {day,\r\n             {gridLeft + (index % 7) * cell,\r\n              gridTop + (index / 7) * m_rowHeight,\r\n              gridLeft + (index % 7 + 1) * cell,\r\n              gridTop + (index / 7 + 1) * m_rowHeight}});\r\n    }\r\n    const float button = std::round(32 * scale);\r\n    const float gap = std::round(8 * scale);\r\n    const float left = divider + padding;\r\n    m_bigAlarms = {left, padding, right, padding + button};\r\n    m_bigTimer = {left, padding + button + gap, right,\r\n                  padding + button * 2 + gap};\r\n    m_bigGear = {left, m_bigTimer.bottom + gap, right,\r\n                 m_bigTimer.bottom + gap + button};\r\n    // The chosen day's events, the agendas' and the user's own, by their\r\n    // time (whole-day ones first).\r\n    constexpr size_t kBigDayEvents = 3;\r\n    const float row = std::round(kEventRowHeight * scale);\r\n    const float line = std::round(22 * scale);\r\n    const float listTop = m_bigGear.bottom + gap * 1.5f;\r\n    float y = listTop;\r\n    const float gridBottom = gridTop + m_rowHeight * 6;\r\n    SYSTEMTIME today;\r\n    GetLocalTime(&today);\r\n    const int year = m_selectedYear ? m_selectedYear : today.wYear;\r\n    const int month = m_selectedYear ? m_selectedMonth : today.wMonth;\r\n    const int dayOf = m_selectedYear ? m_selectedDay : today.wDay;\r\n    m_bigEvents.clear();\r\n    m_bigEventsMore = 0;\r\n    m_bigEventsHeader = m_upcomingAgendaHeader = m_upcomingHeader = {};\r\n    m_upcomingAgenda.clear();\r\n    m_upcoming.clear();\r\n    // (Only the buttons with the events area off, islandCalendarEvents.)\r\n    if (!g_settings.islandCalendarEvents) {\r\n        m_bigDivider = divider;\r\n        m_eventsScroll.SetSizes(0, 0);\r\n        m_size = {(LONG)std::ceil(right + padding),\r\n                  (LONG)std::ceil(std::max(gridBottom, y) + padding)};\r\n        return;\r\n    }\r\n    for (const auto& item : AgendaEventsOn(year, month, dayOf)) {\r\n        m_bigEvents.push_back(\r\n            {item.event.minute, item.color, item.event.title});\r\n    }\r\n    for (const CalendarEvent* event : DayEvents()) {\r\n        m_bigEvents.push_back({event->minute, -1, event->title});\r\n    }\r\n    std::stable_sort(m_bigEvents.begin(), m_bigEvents.end(),\r\n                     [](const BigDayEvent& a, const BigDayEvent& b) {\r\n                         return a.minute < b.minute;\r\n                     });\r\n    m_bigEventsMore = m_bigEvents.size() > kBigDayEvents\r\n                          ? m_bigEvents.size() - kBigDayEvents\r\n                          : 0;\r\n    if (m_bigEventsMore) {\r\n        m_bigEvents.resize(kBigDayEvents);\r\n    }\r\n    m_bigEventsHeader = {};\r\n    if (!m_bigEvents.empty()) {\r\n        m_bigEventsHeader = {left, y, right, y + row};\r\n        y += row + line * (float)(m_bigEvents.size() + (m_bigEventsMore ? 1 : 0));\r\n        y += gap;\r\n    }\r\n    // Then the upcoming events and holidays (DrawUpcoming draws them,\r\n    // UpcomingHit finds their rows).\r\n    m_upcomingAgenda = UpcomingAgendaEvents(3);\r\n    m_upcomingAgendaHeader = {};\r\n    if (!m_upcomingAgenda.empty()) {\r\n        m_upcomingAgendaHeader = {left, y, right, y + row};\r\n        y += row + line * (float)m_upcomingAgenda.size() + gap;\r\n    }\r\n    m_upcoming = UpcomingHolidays(3);\r\n    m_upcomingHeader = {};\r\n    if (!m_upcoming.empty()) {\r\n        m_upcomingHeader = {left, y, right, y + row};\r\n        y += row + line * (float)m_upcoming.size();\r\n    }\r\n    m_bigDivider = divider;\r\n    // (Taller than the month with a lot on the right.)\r\n    const float bottom = FitEvents(left, right + padding, listTop, y);\r\n    m_size = {(LONG)std::ceil(right + padding),\r\n              (LONG)std::ceil(std::max(gridBottom + padding, bottom))};\r\n}\r\n\r\nvoid CalendarPanel::Layout() {\r\n    const float scale = m_scale;\r\n    const float padding = std::round(kPanelPadding * scale);\r\n    const float cell = std::round(kCalendarCell * scale);\r\n    const float width = padding * 2 + cell * 7;\r\n    const float titleHeight = cell * 1.2f;\r\n    m_eventsView = {};\r\n    // Today big (not in the agendas' view): a card of its own.\r\n    m_side = g_settings.islandCalendarBigDay && !m_agendasView\r\n                 ? std::round(kCalendarSideWidth * scale)\r\n                 : 0;\r\n    m_bigAlarms = m_bigTimer = m_bigGear = {};\r\n    if (m_side > 0) {\r\n        LayoutBigDay();\r\n        return;\r\n    }\r\n    // (Under the month, at least the events' title and a row of them.)\r\n    FitMonth(padding + titleHeight + cell * 0.8f,\r\n             std::round(6 * scale) + padding +\r\n                 (g_settings.islandCalendarEvents\r\n                      ? std::round(kEventRowHeight * scale) * 2\r\n                      : 0));\r\n    const float top = padding + m_clockHeight;\r\n    const float gridTop = top + titleHeight + cell * 0.8f;\r\n\r\n    if (m_agendasView) {\r\n        m_eventsScroll.SetSizes(0, 0);\r\n        m_dayRects.clear();\r\n        m_holidayRows.clear();\r\n        m_eventRows.clear();\r\n        m_dayAgenda.clear();\r\n        m_agendaEventRows.clear();\r\n        m_hiddenRow = {};\r\n        m_upcoming.clear();\r\n        m_upcomingAgenda.clear();\r\n        m_agendaMore = 0;\r\n        m_eventsHeader = m_addButton = m_titleField = m_hourBox = m_minuteBox =\r\n            m_allDayButton = m_remindButton = m_saveButton = m_cancelButton =\r\n                m_status = m_upcomingHeader = m_upcomingAgendaHeader =\r\n                    m_agendaMoreRow = {};\r\n        LayoutAgendas(top + titleHeight);\r\n        return;\r\n    }\r\n    m_agendaRows.clear();\r\n    m_agendaRemovable.clear();\r\n    m_agendaHint = m_linkField = m_linkAdd = m_agendaStatus =\r\n        m_todayHeader = m_deleteHeader = {};\r\n    m_todayChips = {};\r\n    m_deleteChips = {};\r\n\r\n    // The days of the month shown, where they are.\r\n    m_dayRects.clear();\r\n    WCHAR firstDayText[4] = L\"6\";\r\n    GetLocaleInfoEx(LOCALE_NAME_USER_DEFAULT, LOCALE_IFIRSTDAYOFWEEK,\r\n                    firstDayText, ARRAYSIZE(firstDayText));\r\n    const int firstDay = (_wtoi(firstDayText) + 1) % 7;\r\n    const int lead = m_year ? (DayOfWeek(m_year, m_month, 1) - firstDay + 7) % 7\r\n                            : 0;\r\n    const int days = m_year ? DaysInMonth(m_year, m_month) : 0;\r\n    for (int day = 1; day <= days; day++) {\r\n        const int index = day - 1 + lead;\r\n        m_dayRects.push_back(\r\n            {day,\r\n             {padding + (index % 7) * cell, gridTop + (index / 7) * m_rowHeight,\r\n              padding + (index % 7 + 1) * cell,\r\n              gridTop + (index / 7 + 1) * m_rowHeight}});\r\n    }\r\n\r\n    // The chosen day's holidays, agenda events and events, then adding one.\r\n    float y = gridTop + m_rowHeight * 6 + std::round(6 * scale);\r\n    // (None of it with the events area off, islandCalendarEvents: the month\r\n    // ends the panel.)\r\n    if (!g_settings.islandCalendarEvents) {\r\n        m_eventsScroll.SetSizes(0, 0);\r\n        m_adding = false;\r\n        m_editingId = 0;\r\n        m_statusText.clear();\r\n        m_holidayRows.clear();\r\n        m_eventRows.clear();\r\n        m_dayAgenda.clear();\r\n        m_agendaEventRows.clear();\r\n        m_upcoming.clear();\r\n        m_upcomingAgenda.clear();\r\n        m_agendaMore = 0;\r\n        m_hiddenCount = 0;\r\n        m_hiddenRow = {};\r\n        m_addButton = m_titleField = m_hourBox = m_minuteBox =\r\n            m_allDayButton = m_remindButton = m_saveButton = m_cancelButton =\r\n                m_status = m_upcomingHeader = m_upcomingAgendaHeader =\r\n                    m_agendaMoreRow = {};\r\n        // (The month's clip ends here, see DrawCalendar.)\r\n        m_eventsHeader = {padding, y, width - padding, y};\r\n        m_size = {(LONG)width, (LONG)std::ceil(y + padding)};\r\n        return;\r\n    }\r\n    const float row = std::round(kEventRowHeight * scale);\r\n    m_eventsHeader = {padding, y, width - padding, y + row};\r\n    y += row;\r\n    m_holidayRows.clear();\r\n    for (size_t i = 0;\r\n         i < HolidaysOn(m_selectedYear, m_selectedMonth, m_selectedDay).size() &&\r\n         i < 2;\r\n         i++) {\r\n        m_holidayRows.push_back({padding, y, width - padding, y + row});\r\n        y += row;\r\n    }\r\n    // (Up to kEventsShown agenda events; how many more under them.)\r\n    m_dayAgenda =\r\n        AgendaEventsOn(m_selectedYear, m_selectedMonth, m_selectedDay);\r\n    m_agendaMore = m_dayAgenda.size() > (size_t)kEventsShown\r\n                       ? m_dayAgenda.size() - kEventsShown\r\n                       : 0;\r\n    if (m_agendaMore) {\r\n        m_dayAgenda.resize(kEventsShown);\r\n    }\r\n    m_agendaEventRows.clear();\r\n    for (size_t i = 0; i < m_dayAgenda.size(); i++) {\r\n        m_agendaEventRows.push_back({padding, y, width - padding, y + row});\r\n        y += row;\r\n    }\r\n    m_agendaMoreRow = {};\r\n    if (m_agendaMore) {\r\n        m_agendaMoreRow = {padding, y, width - padding, y + row * 0.7f};\r\n        y += row * 0.7f;\r\n    }\r\n    m_eventRows.clear();\r\n    const auto events = DayEvents(&m_hiddenCount);\r\n    for (size_t i = 0; i < events.size() && (int)i < kEventsShown; i++) {\r\n        m_eventRows.push_back(\r\n            {events[i]->id, {padding, y, width - padding, y + row}});\r\n        y += row;\r\n    }\r\n    m_hiddenRow = {};\r\n    if (m_hiddenCount) {\r\n        m_hiddenRow = {padding, y, width - padding, y + row * 0.7f};\r\n        y += row * 0.7f;\r\n    }\r\n    if (events.empty() && m_hiddenCount == 0 && m_holidayRows.empty() &&\r\n        m_dayAgenda.empty()) {\r\n        // \"No events\".\r\n        y += row;\r\n    }\r\n    y += std::round(4 * scale);\r\n    const float field = std::round(32 * scale);\r\n    if (!m_adding) {\r\n        m_addButton = {padding, y, width - padding, y + field};\r\n        m_titleField = m_hourBox = m_minuteBox = m_allDayButton =\r\n            m_remindButton = m_saveButton = m_cancelButton = m_status = {};\r\n        y += field;\r\n    } else {\r\n        // The title; under it, the time and the reminder; then \"Cancel\" and\r\n        // \"Add\" (or \"Save\").\r\n        m_addButton = {};\r\n        const float gap = std::round(6 * scale);\r\n        m_titleField = {padding, y, width - padding, y + field};\r\n        y += field + gap;\r\n        // From the right: the bell, the minute, \":\", the hour; \"All day\"\r\n        // takes what's left.\r\n        const float box = std::round(50 * scale);\r\n        const float time = std::round(40 * scale);\r\n        const float colon = std::round(12 * scale);\r\n        m_remindButton = {width - padding - time, y, width - padding,\r\n                          y + time};\r\n        m_minuteBox = {m_remindButton.left - gap * 2 - box, y,\r\n                       m_remindButton.left - gap * 2, y + time};\r\n        m_hourBox = {m_minuteBox.left - colon - box, y,\r\n                     m_minuteBox.left - colon, y + time};\r\n        m_allDayButton = {padding, y, m_hourBox.left - gap * 2, y + time};\r\n        y += time;\r\n        // (A problem in red, or what the bell does: #6156.)\r\n        m_status = {padding, y, width - padding, y + row * 0.8f};\r\n        y += row * 0.8f;\r\n        y += gap * 1.5f;\r\n        const float buttonWidth =\r\n            std::floor((width - padding * 2 - gap) / 2);\r\n        m_cancelButton = {padding, y, padding + buttonWidth, y + field};\r\n        m_saveButton = {width - padding - buttonWidth, y, width - padding,\r\n                        y + field};\r\n        y += field;\r\n    }\r\n    // The next agenda events and holidays, from today.\r\n    m_upcomingAgenda = UpcomingAgendaEvents(4);\r\n    m_upcomingAgendaHeader = {};\r\n    if (!m_upcomingAgenda.empty()) {\r\n        y += std::round(8 * scale);\r\n        m_upcomingAgendaHeader = {padding, y, width - padding, y + row};\r\n        y += row + m_upcomingAgenda.size() * std::round(22 * scale);\r\n    }\r\n    m_upcoming = UpcomingHolidays(4);\r\n    m_upcomingHeader = {};\r\n    if (!m_upcoming.empty()) {\r\n        y += std::round(8 * scale);\r\n        m_upcomingHeader = {padding, y, width - padding, y + row};\r\n        y += row + m_upcoming.size() * std::round(22 * scale);\r\n    }\r\n    m_size = {(LONG)width,\r\n              (LONG)std::ceil(FitEvents(0, width, m_eventsHeader.top, y))};\r\n}\r\n\r\n// How tall the month's rows and the big clock are for the room there is, with\r\n// `above` and `below` taken by what's around them and always there.\r\nvoid CalendarPanel::FitMonth(float above, float below) {\r\n    const float full = std::round(kCalendarCell * m_scale);\r\n    const float least = std::round(kCalendarRowLeast * m_scale);\r\n    m_clockHeight =\r\n        m_side > 0 ? 0 : std::round(kCalendarClockHeight * m_scale);\r\n    m_rowHeight = full;\r\n    if (m_agendasView) {\r\n        return;\r\n    }\r\n    const float room = MaxHeight() - above - below;\r\n    if ((room - m_clockHeight) / 6 < least) {\r\n        m_clockHeight = 0;\r\n    }\r\n    m_rowHeight =\r\n        std::clamp(std::floor((room - m_clockHeight) / 6), least, full);\r\n}\r\n\r\n// The events' place (from `top`, their rows ending at `bottom`), scrolling\r\n// when they don't fit, and where the panel ends then.\r\nfloat CalendarPanel::FitEvents(float left,\r\n                               float right,\r\n                               float top,\r\n                               float bottom) {\r\n    const float padding = std::round(kPanelPadding * m_scale);\r\n    if (bottom + padding <= MaxHeight()) {\r\n        m_eventsView = {};\r\n        m_eventsScroll.SetSizes(0, 0);\r\n        return bottom + padding;\r\n    }\r\n    const float margin = std::round(6 * m_scale);\r\n    const float end =\r\n        std::max(MaxHeight() - margin,\r\n                 top + std::round(kEventRowHeight * m_scale) * 2);\r\n    m_eventsView = {left, top, right, end};\r\n    m_eventsScroll.SetSizes(end - top, bottom - top);\r\n    return end + margin;\r\n}\r\n\r\n// The upcoming events' and holidays' rows (see DrawUpcoming).\r\nCalendarPanel::Hit CalendarPanel::UpcomingHit(POINT pt) const {\r\n    const float line = std::round(22 * m_scale);\r\n    for (const bool agenda : {true, false}) {\r\n        const D2D1_RECT_F& header =\r\n            agenda ? m_upcomingAgendaHeader : m_upcomingHeader;\r\n        const size_t count =\r\n            agenda ? m_upcomingAgenda.size() : m_upcoming.size();\r\n        if (header.bottom <= header.top || pt.x < header.left ||\r\n            pt.x >= header.right || pt.y < header.bottom) {\r\n            continue;\r\n        }\r\n        const size_t i = (size_t)((pt.y - header.bottom) / line);\r\n        if (i >= count) {\r\n            continue;\r\n        }\r\n        if (agenda) {\r\n            const AgendaEvent& event = m_upcomingAgenda[i].event;\r\n            return {Part::Upcoming,\r\n                    event.year * 10000LL + event.month * 100 + event.day};\r\n        }\r\n        const Holiday& holiday = m_upcoming[i];\r\n        return {Part::Upcoming,\r\n                holiday.year * 10000LL + holiday.month * 100 + holiday.day};\r\n    }\r\n    return {};\r\n}\r\n\r\nCalendarPanel::Hit CalendarPanel::HitTest(POINT pt) const {\r\n    // (The events scrolled: their rows are further down than they show.)\r\n    if (m_eventsView.bottom > m_eventsView.top) {\r\n        if (PointInRect(pt, m_eventsView)) {\r\n            pt.y += (LONG)std::round(m_eventsScroll.Offset());\r\n        } else if (pt.x >= m_eventsView.left && pt.y >= m_eventsView.top) {\r\n            return {};\r\n        }\r\n    }\r\n    // Today big: its buttons, the upcoming holidays and the days.\r\n    if (m_side > 0) {\r\n        if (PointInRect(pt, m_bigAlarms)) {\r\n            return {Part::BigAlarms};\r\n        }\r\n        if (PointInRect(pt, m_bigTimer)) {\r\n            return {Part::BigTimer};\r\n        }\r\n        if (PointInRect(pt, m_bigGear)) {\r\n            return {Part::BigGear};\r\n        }\r\n        if (const Hit upcoming = UpcomingHit(pt);\r\n            upcoming.part != Part::None) {\r\n            return upcoming;\r\n        }\r\n        if (PointInRect(pt, m_title)) {\r\n            return {Part::Title};\r\n        }\r\n        for (const auto& [day, rect] : m_dayRects) {\r\n            if (PointInRect(pt, rect)) {\r\n                return {Part::Day, day};\r\n            }\r\n        }\r\n        return {};\r\n    }\r\n    if (PointInRect(pt, m_agendasButton)) {\r\n        return {Part::Agendas};\r\n    }\r\n    if (m_agendasView) {\r\n        // An agenda's color at its start, its \"x\" at its end.\r\n        for (size_t i = 0; i < m_agendaRows.size(); i++) {\r\n            const D2D1_RECT_F& row = m_agendaRows[i];\r\n            if (!PointInRect(pt, row)) {\r\n                continue;\r\n            }\r\n            if (pt.x < row.left + std::round(28 * m_scale)) {\r\n                return {Part::AgendaColor, (long long)i};\r\n            }\r\n            if (pt.x >= row.right - std::round(28 * m_scale) &&\r\n                i < m_agendaRemovable.size() && m_agendaRemovable[i]) {\r\n                return {Part::AgendaRemove, (long long)i};\r\n            }\r\n            return {};\r\n        }\r\n        if (PointInRect(pt, m_linkField)) {\r\n            return {Part::LinkField};\r\n        }\r\n        if (PointInRect(pt, m_linkAdd)) {\r\n            return {Part::LinkAdd};\r\n        }\r\n        for (size_t i = 0; i < m_todayChips.size(); i++) {\r\n            if (PointInRect(pt, m_todayChips[i])) {\r\n                return {Part::TodayChoice, (long long)i};\r\n            }\r\n        }\r\n        for (size_t i = 0; i < m_deleteChips.size(); i++) {\r\n            if (PointInRect(pt, m_deleteChips[i])) {\r\n                return {Part::DeleteChoice, (long long)i};\r\n            }\r\n        }\r\n        if (PointInRect(pt, m_deletePastButton)) {\r\n            return {Part::DeletePast};\r\n        }\r\n        return {};\r\n    }\r\n    if (PointInRect(pt, m_hiddenRow)) {\r\n        return {Part::ShowHidden};\r\n    }\r\n    if (const Hit upcoming = UpcomingHit(pt); upcoming.part != Part::None) {\r\n        return upcoming;\r\n    }\r\n    if (PointInRect(pt, m_previous)) {\r\n        return {Part::Previous};\r\n    }\r\n    if (PointInRect(pt, m_next)) {\r\n        return {Part::Next};\r\n    }\r\n    if (PointInRect(pt, m_title)) {\r\n        return {Part::Title};\r\n    }\r\n    for (const auto& [day, rect] : m_dayRects) {\r\n        if (PointInRect(pt, rect)) {\r\n            return {Part::Day, day};\r\n        }\r\n    }\r\n    for (const auto& [id, rect] : m_eventRows) {\r\n        // The \"x\" at the end of the row; the rest of it edits the event.\r\n        if (PointInRect(pt, rect)) {\r\n            if (pt.x >= rect.right - std::round(28 * m_scale)) {\r\n                return {Part::DeleteEvent, id};\r\n            }\r\n            return {Part::EventRow, id};\r\n        }\r\n    }\r\n    if (PointInRect(pt, m_addButton)) {\r\n        return {Part::Add};\r\n    }\r\n    if (PointInRect(pt, m_titleField)) {\r\n        return {Part::TitleField};\r\n    }\r\n    // The hour and the minute: their arrows (at the right end, up adds,\r\n    // down takes away), or the box itself, to type.\r\n    for (Part part : {Part::Hour, Part::Minute}) {\r\n        const D2D1_RECT_F& box = part == Part::Hour ? m_hourBox : m_minuteBox;\r\n        if (!PointInRect(pt, box)) {\r\n            continue;\r\n        }\r\n        if (pt.x >= box.right - std::round(16 * m_scale)) {\r\n            return {part, pt.y < (box.top + box.bottom) / 2 ? 1 : -1};\r\n        }\r\n        return {part, 0};\r\n    }\r\n    if (PointInRect(pt, m_allDayButton)) {\r\n        return {Part::AllDay};\r\n    }\r\n    if (PointInRect(pt, m_remindButton)) {\r\n        return {Part::Remind};\r\n    }\r\n    if (PointInRect(pt, m_saveButton)) {\r\n        return {Part::Save};\r\n    }\r\n    if (PointInRect(pt, m_cancelButton)) {\r\n        return {Part::Cancel};\r\n    }\r\n    return {};\r\n}\r\n\r\nvoid CalendarPanel::DrawField(ID2D1RenderTarget* target,\r\n                              ID2D1SolidColorBrush* brush,\r\n                              const D2D1_RECT_F& rect,\r\n                              const std::wstring& text,\r\n                              PCWSTR placeholder,\r\n                              bool focused) {\r\n    const float s = m_scale;\r\n    const float radius = std::round(8 * s);\r\n    brush->SetColor(Fg(focused ? 0.14f : 0.09f));\r\n    GlassFill(target, {rect, radius, radius}, brush);\r\n    if (focused) {\r\n        brush->SetColor(Accent(1));\r\n        target->DrawRoundedRectangle(\r\n            {{rect.left + 0.75f, rect.top + 0.75f, rect.right - 0.75f,\r\n              rect.bottom - 0.75f},\r\n             radius,\r\n             radius},\r\n            brush, 1.5f);\r\n    }\r\n    const D2D1_RECT_F textRect{rect.left + std::round(10 * s), rect.top,\r\n                               rect.right - std::round(8 * s), rect.bottom};\r\n    const bool empty = text.empty();\r\n    const std::wstring shown = empty ? std::wstring(placeholder) : text;\r\n    float caretX = textRect.left;\r\n    winrt::com_ptr<IDWriteTextLayout> layout;\r\n    if (SUCCEEDED(m_dwrite->CreateTextLayout(\r\n            shown.c_str(), (UINT32)shown.size(), m_textFormat.get(), 10000,\r\n            textRect.bottom - textRect.top, layout.put()))) {\r\n        DWRITE_TEXT_METRICS metrics;\r\n        layout->GetMetrics(&metrics);\r\n        const float overflow =\r\n            empty ? 0\r\n                  : std::max(0.0f, metrics.widthIncludingTrailingWhitespace -\r\n                                       (textRect.right - textRect.left));\r\n        target->PushAxisAlignedClip(textRect, D2D1_ANTIALIAS_MODE_ALIASED);\r\n        brush->SetColor(Fg(empty ? 0.4f : 0.95f));\r\n        target->DrawTextLayout({textRect.left - overflow, textRect.top},\r\n                               layout.get(), brush);\r\n        target->PopAxisAlignedClip();\r\n        if (!empty) {\r\n            caretX = textRect.left + metrics.widthIncludingTrailingWhitespace -\r\n                     overflow;\r\n        }\r\n    }\r\n    if (focused) {\r\n        const float middle = (rect.top + rect.bottom) / 2;\r\n        brush->SetColor(CaretColor());\r\n        target->FillRectangle({caretX + 1, middle - std::round(8 * s),\r\n                               caretX + 2.5f, middle + std::round(8 * s)},\r\n                              brush);\r\n    }\r\n}\r\n\r\n// With today big at the left (islandCalendarBigDay): that column, and the\r\n// calendar beside it as it's drawn without it.\r\nvoid CalendarPanel::Draw(ID2D1RenderTarget* target,\r\n                         ID2D1SolidColorBrush* brush) {\r\n    if (m_side <= 0) {\r\n        DrawCalendar(target, brush);\r\n        return;\r\n    }\r\n    DrawBigDay(target, brush);\r\n}\r\n\r\n// A day's ISO 8601 week (weeks start on Monday; the first has the year's\r\n// first Thursday), as calendars number them.\r\nint IsoWeek(int year, int month, int day) {\r\n    int ordinal = day;\r\n    for (int m = 1; m < month; m++) {\r\n        ordinal += DaysInMonth(year, m);\r\n    }\r\n    // Monday 1 to Sunday 7.\r\n    const int weekday = (DayOfWeek(year, month, day) + 6) % 7 + 1;\r\n    const int week = (ordinal - weekday + 10) / 7;\r\n    auto weeks = [](int y) {\r\n        auto p = [](int x) { return (x + x / 4 - x / 100 + x / 400) % 7; };\r\n        return p(y) == 4 || p(y - 1) == 3 ? 53 : 52;\r\n    };\r\n    if (week < 1) {\r\n        return weeks(year - 1);\r\n    }\r\n    return week > weeks(year) ? 1 : week;\r\n}\r\n\r\n// A month's title in the dates' language (\"Novembro de 2026\").\r\nstd::wstring YearMonthTitle(int year, int month) {\r\n    SYSTEMTIME first{(WORD)year, (WORD)month, 0, 1};\r\n    WCHAR title[64] = L\"\";\r\n    GetDateFormatEx(DateLocale(), DATE_YEARMONTH, &first, nullptr, title,\r\n                    ARRAYSIZE(title), nullptr);\r\n    if (title[0]) {\r\n        title[0] = towupper(title[0]);\r\n    }\r\n    return title;\r\n}\r\n\r\n// The card (see LayoutBigDay): the chosen day at the left, the month in the\r\n// middle, a line, then the buttons and the upcoming holidays.\r\nvoid CalendarPanel::DrawBigDay(ID2D1RenderTarget* target,\r\n                               ID2D1SolidColorBrush* brush) {\r\n    if (!m_bigDayFormat || !m_dateFormat || !m_textFormat || !m_dayFormat ||\r\n        !m_titleFormat || !m_smallFormat) {\r\n        return;\r\n    }\r\n    const float scale = m_scale;\r\n    const float padding = std::round(kPanelPadding * scale);\r\n    const float cell = std::round(kCalendarCell * scale);\r\n    const float height = (float)m_size.cy;\r\n    SYSTEMTIME today;\r\n    GetLocalTime(&today);\r\n    SYSTEMTIME chosen{(WORD)m_selectedYear, (WORD)m_selectedMonth, 0,\r\n                      (WORD)m_selectedDay};\r\n    if (!m_selectedYear) {\r\n        chosen = today;\r\n    }\r\n    // The left column: its weekday (bold), its month, its number, its week\r\n    // and its holiday.\r\n    {\r\n        const float left = padding;\r\n        const float right = m_side - padding;\r\n        auto line = [&](const std::wstring& text, IDWriteTextFormat* format,\r\n                        float top, float bottom, D2D1_COLOR_F color) {\r\n            format->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_CENTER);\r\n            brush->SetColor(color);\r\n            target->DrawText(text.c_str(), (UINT32)text.size(), format,\r\n                             {left, top, right, bottom}, brush,\r\n                             D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n            format->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_LEADING);\r\n        };\r\n        auto date = [&](PCWSTR picture) {\r\n            WCHAR text[64] = L\"\";\r\n            GetDateFormatEx(DateLocale(), 0, &chosen, picture, text,\r\n                            ARRAYSIZE(text), nullptr);\r\n            std::wstring result = text;\r\n            if (!result.empty()) {\r\n                result[0] = towupper(result[0]);\r\n            }\r\n            return result;\r\n        };\r\n        float y = padding + std::round(14 * scale);\r\n        line(date(L\"dddd\"), m_titleFormat.get(), y, y + std::round(22 * scale),\r\n             Fg(0.95f));\r\n        y += std::round(22 * scale);\r\n        line(date(L\"MMMM\"), m_dateFormat.get(), y, y + std::round(20 * scale),\r\n             Fg(0.75f));\r\n        y += std::round(24 * scale);\r\n        brush->SetColor(Fg(0.97f));\r\n        const std::wstring number = std::to_wstring(chosen.wDay);\r\n        target->DrawText(number.c_str(), (UINT32)number.size(),\r\n                         m_bigDayFormat.get(),\r\n                         {left, y, right, y + std::round(84 * scale)}, brush,\r\n                         D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n        const auto holidays =\r\n            HolidaysOn(chosen.wYear, chosen.wMonth, chosen.wDay);\r\n        const float bottom = height - padding - std::round(8 * scale);\r\n        const float weekTop =\r\n            bottom - std::round((holidays.empty() ? 18 : 36) * scale);\r\n        line(std::wstring(Tr(L\"Week\", L\"Semana\")) + L\" \" +\r\n                 std::to_wstring(\r\n                     IsoWeek(chosen.wYear, chosen.wMonth, chosen.wDay)),\r\n             m_smallFormat.get(), weekTop, weekTop + std::round(18 * scale),\r\n             Fg(0.6f));\r\n        if (!holidays.empty()) {\r\n            line(holidays.front(), m_smallFormat.get(),\r\n                 weekTop + std::round(18 * scale), bottom, Fg(0.8f));\r\n        }\r\n    }\r\n    // The month: its title (so a month paged to is told), the weekdays'\r\n    // short names, then six weeks (the neighbors' days dimmed), today in its\r\n    // circle, the chosen day in a ring, holidays and agenda days in their\r\n    // colors, a dot under days with events.\r\n    WCHAR firstDayText[4] = L\"6\";\r\n    GetLocaleInfoEx(LOCALE_NAME_USER_DEFAULT, LOCALE_IFIRSTDAYOFWEEK,\r\n                    firstDayText, ARRAYSIZE(firstDayText));\r\n    const int firstDay = (_wtoi(firstDayText) + 1) % 7;\r\n    const float gridLeft = m_side;\r\n    const float headerTop = m_title.bottom;\r\n    const float gridTop = headerTop + std::round(26 * scale);\r\n    if (m_year) {\r\n        const std::wstring monthTitle = YearMonthTitle(m_year, m_month);\r\n        brush->SetColor(Fg(0.95f));\r\n        target->DrawText(monthTitle.c_str(), (UINT32)monthTitle.size(),\r\n                         m_titleFormat.get(), m_title, brush,\r\n                         D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n    }\r\n    for (int column = 0; column < 7; column++) {\r\n        const int weekday = (firstDay + column) % 7;\r\n        WCHAR name[16] = L\"\";\r\n        GetLocaleInfoEx(DateLocale(),\r\n                        LOCALE_SABBREVDAYNAME1 + (weekday + 6) % 7, name,\r\n                        ARRAYSIZE(name));\r\n        brush->SetColor(Fg(0.55f));\r\n        target->DrawText(name, (UINT32)wcslen(name), m_dayFormat.get(),\r\n                         {gridLeft + column * cell, headerTop,\r\n                          gridLeft + (column + 1) * cell, gridTop},\r\n                         brush, D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n    }\r\n    const int year = m_year;\r\n    const int month = m_month;\r\n    if (year) {\r\n        D2D1_COLOR_F todayFill = TodayColor();\r\n        const float todayInk =\r\n            Luminance(todayFill.r, todayFill.g, todayFill.b) > 0.62f ? 0.08f\r\n                                                                       : 1.0f;\r\n        const int lead = (DayOfWeek(year, month, 1) - firstDay + 7) % 7;\r\n        const int days = DaysInMonth(year, month);\r\n        const int previousDays = DaysInMonth(month == 1 ? year - 1 : year,\r\n                                             month == 1 ? 12 : month - 1);\r\n        for (int index = 0; index < 42; index++) {\r\n            int day = index - lead + 1;\r\n            bool inMonth = true;\r\n            if (day < 1) {\r\n                day += previousDays;\r\n                inMonth = false;\r\n            } else if (day > days) {\r\n                day -= days;\r\n                inMonth = false;\r\n            }\r\n            const D2D1_RECT_F rect{gridLeft + (index % 7) * cell,\r\n                                   gridTop + (index / 7) * m_rowHeight,\r\n                                   gridLeft + (index % 7 + 1) * cell,\r\n                                   gridTop + (index / 7 + 1) * m_rowHeight};\r\n            const D2D1_POINT_2F center{(rect.left + rect.right) / 2,\r\n                                       (rect.top + rect.bottom) / 2};\r\n            const float circle = std::min(cell, m_rowHeight) * 0.4f;\r\n            const bool isToday = inMonth && day == today.wDay &&\r\n                                 month == today.wMonth && year == today.wYear;\r\n            const bool selected = inMonth && day == chosen.wDay &&\r\n                                  month == chosen.wMonth &&\r\n                                  year == chosen.wYear;\r\n            const bool hover = inMonth && m_hover.part == Part::Day &&\r\n                               m_hover.value == day;\r\n            if (isToday) {\r\n                brush->SetColor(todayFill);\r\n                target->FillEllipse({center, circle, circle}, brush);\r\n            } else if (selected) {\r\n                brush->SetColor(Accent(0.85f));\r\n                target->FillEllipse({center, circle, circle}, brush);\r\n            } else if (const float lit =\r\n                           Hover(HoverKey(5002, year * 10000 + month * 100 +\r\n                                                    index),\r\n                                 hover);\r\n                       lit > 0.01f) {\r\n                brush->SetColor(Fg(0.1f * lit));\r\n                GlassFillEllipse(target, {center, circle, circle}, brush);\r\n            }\r\n            if (selected && isToday) {\r\n                brush->SetColor(Fg(0.6f));\r\n                target->DrawEllipse({center, circle + 2 * scale,\r\n                                     circle + 2 * scale},\r\n                                    brush, 1.5f);\r\n            }\r\n            int agendaColor = 0;\r\n            const bool agendaDay =\r\n                inMonth && !isToday && !selected &&\r\n                AgendaDayColor(year, month, day, &agendaColor);\r\n            const bool holiday = inMonth && !isToday && !selected &&\r\n                                 !agendaDay &&\r\n                                 !HolidaysOn(year, month, day).empty();\r\n            brush->SetColor(\r\n                isToday     ? D2D1::ColorF(todayInk, todayInk, todayInk, 1)\r\n                : selected  ? AccentInk(1)\r\n                : agendaDay ? RgbColor(agendaColor, 1)\r\n                : holiday   ? D2D1::ColorF(1.0f, 0.36f, 0.36f, 1)\r\n                            : Fg(inMonth ? 0.9f : 0.3f));\r\n            const std::wstring text = std::to_wstring(day);\r\n            target->DrawText(text.c_str(), (UINT32)text.size(),\r\n                             m_dayFormat.get(), rect, brush);\r\n            if (inMonth && HasEvents(year, month, day)) {\r\n                const float dot = 1.8f * scale;\r\n                brush->SetColor(D2D1::ColorF(1.0f, 0.27f, 0.23f, 1));\r\n                target->FillEllipse(\r\n                    {{center.x, center.y + circle - 3 * scale}, dot, dot},\r\n                    brush);\r\n            }\r\n        }\r\n    }\r\n    // The line between the month and the buttons.\r\n    brush->SetColor(Fg(0.12f));\r\n    target->FillRectangle({m_bigDivider, padding, m_bigDivider + 1,\r\n                           height - padding},\r\n                          brush);\r\n    // The buttons (the gear's glyph before its name).\r\n    for (const auto& [rect, part, name, glyph] :\r\n         {std::tuple{m_bigAlarms, Part::BigAlarms,\r\n                     Tr(L\"Set an alarm\", L\"Criar alarme\"), WCHAR(0)},\r\n          std::tuple{m_bigTimer, Part::BigTimer,\r\n                     Tr(L\"Set a timer\", L\"Criar timer\"), WCHAR(0)},\r\n          std::tuple{m_bigGear, Part::BigGear, Tr(L\"Agendas\", L\"Agendas\"),\r\n                     kGlyphSettings}}) {\r\n        const float lit = Hover(rect, m_hover.part == part);\r\n        const float radius = std::round(8 * scale);\r\n        brush->SetColor(Fg(0.1f + 0.08f * lit));\r\n        GlassFill(target, {rect, radius, radius}, brush);\r\n        brush->SetColor(Fg(0.9f));\r\n        D2D1_RECT_F label = rect;\r\n        if (glyph && m_iconFormat) {\r\n            const float inset = std::round(4 * scale);\r\n            const D2D1_RECT_F icon{rect.left + inset, rect.top,\r\n                                   rect.left + inset + std::round(28 * scale),\r\n                                   rect.bottom};\r\n            DrawGlyph(target, &glyph, 1, m_iconFormat.get(), icon, brush);\r\n            label.left = icon.right;\r\n            label.right -= inset;\r\n        }\r\n        m_textFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_CENTER);\r\n        target->DrawText(name, (UINT32)wcslen(name), m_textFormat.get(), label,\r\n                         brush, D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n        m_textFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_LEADING);\r\n    }\r\n    BeginEventsView(target);\r\n    // The chosen day's events: a line over them, their title (\"Events,\r\n    // October 27\"), then each one's color bar, time and title, and how many\r\n    // more.\r\n    if (const D2D1_RECT_F& header = m_bigEventsHeader;\r\n        header.bottom > header.top) {\r\n        brush->SetColor(Fg(0.1f));\r\n        target->FillRectangle(\r\n            {header.left, header.top, header.right, header.top + 1}, brush);\r\n        WCHAR day[64] = L\"\";\r\n        GetDateFormatEx(DateLocale(), 0, &chosen,\r\n                        MonthDayPicture(false).c_str(), day, ARRAYSIZE(day),\r\n                        nullptr);\r\n        const std::wstring title =\r\n            std::wstring(Tr(L\"Events, \", L\"Eventos, \")) + day;\r\n        brush->SetColor(Fg(0.6f));\r\n        target->DrawText(title.c_str(), (UINT32)title.size(),\r\n                         m_smallFormat.get(), header, brush,\r\n                         D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n        const float line = std::round(22 * scale);\r\n        float y = header.bottom;\r\n        for (const auto& event : m_bigEvents) {\r\n            brush->SetColor(event.color >= 0\r\n                                ? RgbColor(event.color, 0.9f)\r\n                                : D2D1::ColorF(1.0f, 0.27f, 0.23f, 0.9f));\r\n            target->FillRoundedRectangle(\r\n                {{header.left, y + std::round(4 * scale),\r\n                  header.left + std::round(3 * scale),\r\n                  y + line - std::round(4 * scale)},\r\n                 1.5f,\r\n                 1.5f},\r\n                brush);\r\n            const float timeWidth = std::round(58 * scale);\r\n            const std::wstring time = EventTimeText(event.minute);\r\n            brush->SetColor(Fg(0.55f));\r\n            target->DrawText(time.c_str(), (UINT32)time.size(),\r\n                             m_smallFormat.get(),\r\n                             {header.left + std::round(9 * scale), y,\r\n                              header.left + timeWidth, y + line},\r\n                             brush, D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n            const std::wstring name = event.title.empty()\r\n                                          ? std::wstring(Tr(L\"Event\", L\"Evento\"))\r\n                                          : event.title;\r\n            brush->SetColor(Fg(0.95f));\r\n            target->DrawText(name.c_str(), (UINT32)name.size(),\r\n                             m_smallFormat.get(),\r\n                             {header.left + timeWidth, y, header.right,\r\n                              y + line},\r\n                             brush, D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n            y += line;\r\n        }\r\n        if (m_bigEventsMore) {\r\n            const std::wstring more = L\"+\" + std::to_wstring(m_bigEventsMore) +\r\n                                      L\" \" + Tr(L\"more\", L\"mais\");\r\n            brush->SetColor(Fg(0.5f));\r\n            target->DrawText(more.c_str(), (UINT32)more.size(),\r\n                             m_smallFormat.get(),\r\n                             {header.left + std::round(9 * scale), y,\r\n                              header.right, y + line},\r\n                             brush);\r\n        }\r\n    }\r\n    DrawUpcoming(target, brush);\r\n    EndEventsView(target, brush);\r\n}\r\n\r\nvoid CalendarPanel::DrawCalendar(ID2D1RenderTarget* target,\r\n                                 ID2D1SolidColorBrush* brush) {\r\n    if (!m_titleFormat || !m_dayFormat || !m_iconFormat || !m_textFormat ||\r\n        !m_smallFormat) {\r\n        return;\r\n    }\r\n    const float scale = m_scale;\r\n    // (Beside today big, when it's there: see Draw.)\r\n    const float width = (float)m_size.cx - m_side;\r\n    const float padding = std::round(kPanelPadding * scale);\r\n    const float cell = std::round(kCalendarCell * scale);\r\n\r\n    // The time, big, and the date (\"sexta-feira, 3 de outubro\").\r\n    SYSTEMTIME now;\r\n    GetLocalTime(&now);\r\n    const float clockHeight = m_clockHeight;\r\n    if (m_clockFormat && m_dateFormat && clockHeight > 0) {\r\n        std::wstring marker;\r\n        std::wstring time = FormatClockTime(now, true, &marker);\r\n        if (!marker.empty()) {\r\n            time += L\" \" + marker;\r\n        }\r\n        // (Both in the middle, #6609.)\r\n        const D2D1_RECT_F timeRect{padding, padding, width - padding,\r\n                                   padding + clockHeight * 0.62f};\r\n        brush->SetColor(Fg(0.97f));\r\n        winrt::com_ptr<IDWriteTextLayout> layout;\r\n        if (SUCCEEDED(m_dwrite->CreateTextLayout(\r\n                time.c_str(), (UINT32)time.size(), m_clockFormat.get(),\r\n                timeRect.right - timeRect.left,\r\n                timeRect.bottom - timeRect.top, layout.put()))) {\r\n            layout->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_CENTER);\r\n            if (m_tabular) {\r\n                layout->SetTypography(m_tabular.get(),\r\n                                      {0, (UINT32)time.size()});\r\n            }\r\n            SmallClockMarker(layout.get(), time);\r\n            target->DrawTextLayout({timeRect.left, timeRect.top}, layout.get(),\r\n                                   brush);\r\n        }\r\n        WCHAR date[96] = L\"\";\r\n        GetDateFormatEx(DateLocale(), DATE_LONGDATE, &now, nullptr, date,\r\n                        ARRAYSIZE(date), nullptr);\r\n        if (date[0]) {\r\n            date[0] = towupper(date[0]);\r\n        }\r\n        brush->SetColor(Fg(0.6f));\r\n        m_dateFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_CENTER);\r\n        target->DrawText(date, (UINT32)wcslen(date), m_dateFormat.get(),\r\n                         {timeRect.left, timeRect.bottom, width - padding,\r\n                          padding + clockHeight - std::round(8 * scale)},\r\n                         brush);\r\n        m_dateFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_LEADING);\r\n        // A line under it.\r\n        brush->SetColor(Fg(0.1f));\r\n        target->FillRectangle({padding, padding + clockHeight - 1,\r\n                               width - padding, padding + clockHeight},\r\n                              brush);\r\n    }\r\n    const float top = padding + clockHeight;\r\n\r\n    // The agendas' button and the arrows; the title slides with the days.\r\n    const float titleHeight = cell * 1.2f;\r\n    // (In the agendas' view, its button goes back, at the end.)\r\n    const float buttonRight =\r\n        m_agendasView ? width - padding : width - padding - cell * 2;\r\n    m_title = {padding + cell * 0.2f, top, buttonRight - cell,\r\n               top + titleHeight};\r\n    m_agendasButton = {buttonRight - cell, top, buttonRight, top + titleHeight};\r\n    m_previous = m_next = {};\r\n    if (!m_agendasView) {\r\n        m_previous = {width - padding - cell * 2, top, width - padding - cell,\r\n                      top + titleHeight};\r\n        m_next = {width - padding - cell, top, width - padding,\r\n                  top + titleHeight};\r\n    }\r\n    for (Part button : {Part::Agendas, Part::Previous, Part::Next}) {\r\n        const D2D1_RECT_F& rect = button == Part::Agendas    ? m_agendasButton\r\n                                  : button == Part::Previous ? m_previous\r\n                                                             : m_next;\r\n        if (rect.right <= rect.left) {\r\n            continue;\r\n        }\r\n        if (const float lit = Hover(rect, m_hover.part == button);\r\n            lit > 0.01f) {\r\n            const float inset = cell * 0.18f;\r\n            const D2D1_RECT_F back{rect.left + inset, rect.top + inset,\r\n                                   rect.right - inset, rect.bottom - inset};\r\n            brush->SetColor(Fg(0.16f * lit));\r\n            GlassFill(target,\r\n                      {back, (back.bottom - back.top) / 2,\r\n                       (back.bottom - back.top) / 2},\r\n                      brush);\r\n        }\r\n        const WCHAR glyph =\r\n            button == Part::Agendas\r\n                ? (m_agendasView ? kGlyphCalendarBack : kGlyphSettings)\r\n            : button == Part::Previous ? kGlyphPrevious\r\n                                       : kGlyphNext;\r\n        brush->SetColor(Fg(0.9f));\r\n        DrawGlyph(target, &glyph, 1, m_iconFormat.get(), rect, brush);\r\n    }\r\n    if (m_agendasView) {\r\n        PCWSTR title = Tr(L\"Agendas\", L\"Agendas\");\r\n        brush->SetColor(Fg(0.95f));\r\n        target->DrawText(title, (UINT32)wcslen(title), m_titleFormat.get(),\r\n                         m_title, brush);\r\n        DrawAgendas(target, brush);\r\n        return;\r\n    }\r\n\r\n    // Weekday initials, starting on the locale's first day of the week.\r\n    WCHAR firstDayText[4] = L\"6\";\r\n    GetLocaleInfoEx(LOCALE_NAME_USER_DEFAULT, LOCALE_IFIRSTDAYOFWEEK,\r\n                    firstDayText, ARRAYSIZE(firstDayText));\r\n    // LOCALE_IFIRSTDAYOFWEEK: 0 is Monday. Here, 0 is Sunday.\r\n    const int firstDay = (_wtoi(firstDayText) + 1) % 7;\r\n    const float headerTop = top + titleHeight;\r\n    for (int column = 0; column < 7; column++) {\r\n        const int weekday = (firstDay + column) % 7;\r\n        // LOCALE_SSHORTESTDAYNAME1 is Monday.\r\n        WCHAR name[16] = L\"\";\r\n        GetLocaleInfoEx(DateLocale(),\r\n                        LOCALE_SSHORTESTDAYNAME1 + (weekday + 6) % 7, name,\r\n                        ARRAYSIZE(name));\r\n        const D2D1_RECT_F rect{padding + column * cell, headerTop,\r\n                               padding + (column + 1) * cell,\r\n                               headerTop + cell * 0.8f};\r\n        brush->SetColor(Fg(0.5f));\r\n        target->DrawText(name, (UINT32)wcslen(name), m_dayFormat.get(), rect,\r\n                         brush);\r\n    }\r\n\r\n    // The months: the new one slides in, the one before out, both fading,\r\n    // clipped to the calendar.\r\n    const float slide = (float)std::clamp(m_slide, 0.0, 1.0);\r\n    target->PushAxisAlignedClip(\r\n        {padding, top, width - padding, m_eventsHeader.top},\r\n        D2D1_ANTIALIAS_MODE_ALIASED);\r\n    if (slide > 0.001f && m_fromMonth) {\r\n        DrawMonth(target, brush, m_fromYear, m_fromMonth,\r\n                  -m_slideDirection * (1 - slide) * width * 0.6f, slide);\r\n    }\r\n    DrawMonth(target, brush, m_year, m_month,\r\n              m_slideDirection * slide * width * 0.6f, 1 - slide);\r\n    target->PopAxisAlignedClip();\r\n    // (The events area off: the month ends it, see Layout.)\r\n    if (!g_settings.islandCalendarEvents) {\r\n        return;\r\n    }\r\n    BeginEventsView(target);\r\n    DrawEvents(target, brush, width);\r\n    EndEventsView(target, brush);\r\n}\r\n\r\n// Between these two, what's drawn in the events' place scrolls in their view,\r\n// at the panel's own coordinates; without one, it's drawn as it is.\r\nvoid CalendarPanel::BeginEventsView(ID2D1RenderTarget* target) {\r\n    if (m_eventsView.bottom <= m_eventsView.top) {\r\n        return;\r\n    }\r\n    BeginScrollArea(target, m_eventsView, m_eventsScroll);\r\n    D2D1_MATRIX_3X2_F list;\r\n    target->GetTransform(&list);\r\n    target->SetTransform(D2D1::Matrix3x2F::Translation(0, -m_eventsView.top) *\r\n                         *D2D1::Matrix3x2F::ReinterpretBaseType(&list));\r\n}\r\n\r\nvoid CalendarPanel::EndEventsView(ID2D1RenderTarget* target,\r\n                                  ID2D1SolidColorBrush* brush) {\r\n    if (m_eventsView.bottom <= m_eventsView.top) {\r\n        return;\r\n    }\r\n    EndScrollArea(target);\r\n    DrawScrollBar(target, brush, m_eventsView, m_eventsScroll);\r\n}\r\n\r\nvoid CalendarPanel::DrawEvents(ID2D1RenderTarget* target,\r\n                               ID2D1SolidColorBrush* brush,\r\n                               float width) {\r\n    const float scale = m_scale;\r\n    const float padding = std::round(kPanelPadding * scale);\r\n\r\n    // The chosen day's events.\r\n    SYSTEMTIME chosen{(WORD)m_selectedYear, (WORD)m_selectedMonth, 0,\r\n                      (WORD)m_selectedDay};\r\n    WCHAR day[64] = L\"\";\r\n    GetDateFormatEx(DateLocale(), 0, &chosen, MonthDayPicture(false).c_str(),\r\n                    day, ARRAYSIZE(day), nullptr);\r\n    brush->SetColor(Fg(0.1f));\r\n    target->FillRectangle({padding, m_eventsHeader.top, width - padding,\r\n                           m_eventsHeader.top + 1},\r\n                          brush);\r\n    const std::wstring header =\r\n        std::wstring(Tr(L\"Events, \", L\"Eventos, \")) + day;\r\n    brush->SetColor(Fg(0.6f));\r\n    target->DrawText(header.c_str(), (UINT32)header.size(),\r\n                     m_smallFormat.get(), m_eventsHeader, brush);\r\n    // Holidays: a green bar and the name.\r\n    const auto holidays =\r\n        HolidaysOn(m_selectedYear, m_selectedMonth, m_selectedDay);\r\n    for (size_t i = 0; i < m_holidayRows.size() && i < holidays.size(); i++) {\r\n        const D2D1_RECT_F& row = m_holidayRows[i];\r\n        brush->SetColor(D2D1::ColorF(0.2f, 0.78f, 0.35f, 0.9f));\r\n        target->FillRoundedRectangle(\r\n            {{row.left, row.top + std::round(6 * scale),\r\n              row.left + std::round(3 * scale),\r\n              row.bottom - std::round(6 * scale)},\r\n             1.5f,\r\n             1.5f},\r\n            brush);\r\n        brush->SetColor(Fg(0.95f));\r\n        target->DrawText(holidays[i].c_str(), (UINT32)holidays[i].size(),\r\n                         m_textFormat.get(),\r\n                         {row.left + std::round(10 * scale), row.top,\r\n                          row.right, row.bottom},\r\n                         brush, D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n    }\r\n    // The agendas' events: a bar in the agenda's color, the time, the title\r\n    // (read only).\r\n    for (size_t i = 0; i < m_agendaEventRows.size() && i < m_dayAgenda.size();\r\n         i++) {\r\n        const AgendaItem& item = m_dayAgenda[i];\r\n        const D2D1_RECT_F& row = m_agendaEventRows[i];\r\n        brush->SetColor(RgbColor(item.color, 0.9f));\r\n        target->FillRoundedRectangle(\r\n            {{row.left, row.top + std::round(6 * scale),\r\n              row.left + std::round(3 * scale),\r\n              row.bottom - std::round(6 * scale)},\r\n             1.5f,\r\n             1.5f},\r\n            brush);\r\n        const float timeWidth = std::round(64 * scale);\r\n        const std::wstring time = EventTimeText(item.event.minute);\r\n        brush->SetColor(Fg(0.55f));\r\n        target->DrawText(time.c_str(), (UINT32)time.size(), m_smallFormat.get(),\r\n                         {row.left + std::round(10 * scale), row.top,\r\n                          row.left + timeWidth, row.bottom},\r\n                         brush);\r\n        const std::wstring title = item.event.title.empty()\r\n                                       ? std::wstring(Tr(L\"Event\", L\"Evento\"))\r\n                                       : item.event.title;\r\n        brush->SetColor(Fg(0.95f));\r\n        target->DrawText(title.c_str(), (UINT32)title.size(),\r\n                         m_textFormat.get(),\r\n                         {row.left + timeWidth, row.top, row.right, row.bottom},\r\n                         brush, D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n    }\r\n    if (m_agendaMore) {\r\n        const std::wstring more =\r\n            L\"+\" + std::to_wstring(m_agendaMore) + L\" \" + Tr(L\"more\", L\"mais\");\r\n        brush->SetColor(Fg(0.5f));\r\n        target->DrawText(\r\n            more.c_str(), (UINT32)more.size(), m_smallFormat.get(),\r\n            {m_agendaMoreRow.left + std::round(10 * scale), m_agendaMoreRow.top,\r\n             m_agendaMoreRow.right, m_agendaMoreRow.bottom},\r\n            brush);\r\n    }\r\n    const auto events = DayEvents();\r\n    if (m_hiddenRow.bottom > m_hiddenRow.top) {\r\n        WCHAR more[64];\r\n        swprintf_s(more, Tr(L\"Show %zu hidden\", L\"Mostrar %zu ocultos\"),\r\n                   m_hiddenCount);\r\n        brush->SetColor(Fg(0.45f + 0.4f * Hover(m_hiddenRow,\r\n                                                m_hover.part ==\r\n                                                    Part::ShowHidden)));\r\n        target->DrawText(\r\n            more, (UINT32)wcslen(more), m_smallFormat.get(),\r\n            {m_hiddenRow.left + std::round(10 * scale), m_hiddenRow.top,\r\n             m_hiddenRow.right, m_hiddenRow.bottom},\r\n            brush);\r\n    }\r\n    if (events.empty() && m_hiddenCount == 0 && holidays.empty() &&\r\n        m_dayAgenda.empty()) {\r\n        PCWSTR none = Tr(L\"No events\", L\"Nenhum evento\");\r\n        brush->SetColor(Fg(0.4f));\r\n        target->DrawText(none, (UINT32)wcslen(none), m_textFormat.get(),\r\n                         {padding, m_eventsHeader.bottom, width - padding,\r\n                          m_eventsHeader.bottom +\r\n                              std::round(kEventRowHeight * scale)},\r\n                         brush);\r\n    }\r\n    for (size_t i = 0; i < m_eventRows.size() && i < events.size(); i++) {\r\n        const CalendarEvent& event = *events[i];\r\n        const D2D1_RECT_F& row = m_eventRows[i].second;\r\n        const bool hover = (m_hover.part == Part::DeleteEvent) &&\r\n                           m_hover.value == event.id;\r\n        // The row under the mouse (or being edited) lights up: a click edits\r\n        // it.\r\n        const bool editing = m_adding && m_editingId == event.id;\r\n        const float rowLit =\r\n            Hover(row, m_hover.value == event.id &&\r\n                           (m_hover.part == Part::EventRow ||\r\n                            m_hover.part == Part::DeleteEvent));\r\n        if (rowLit > 0.01f || editing) {\r\n            const float rowRadius = std::round(7 * scale);\r\n            brush->SetColor(Fg(editing ? 0.12f : 0.07f * rowLit));\r\n            GlassFill(target, {row, rowRadius, rowRadius}, brush);\r\n        }\r\n        // A colored bar, the time, the title, the bell, the \"x\".\r\n        brush->SetColor(D2D1::ColorF(1.0f, 0.27f, 0.23f, 0.9f));\r\n        target->FillRoundedRectangle(\r\n            {{row.left, row.top + std::round(6 * scale),\r\n              row.left + std::round(3 * scale),\r\n              row.bottom - std::round(6 * scale)},\r\n             1.5f,\r\n             1.5f},\r\n            brush);\r\n        const float timeWidth = std::round(64 * scale);\r\n        const std::wstring time = EventTimeText(event.minute);\r\n        brush->SetColor(Fg(0.55f));\r\n        target->DrawText(time.c_str(), (UINT32)time.size(),\r\n                         m_smallFormat.get(),\r\n                         {row.left + std::round(10 * scale), row.top,\r\n                          row.left + timeWidth, row.bottom},\r\n                         brush);\r\n        brush->SetColor(Fg(0.95f));\r\n        target->DrawText(event.title.c_str(), (UINT32)event.title.size(),\r\n                         m_textFormat.get(),\r\n                         {row.left + timeWidth, row.top,\r\n                          row.right - std::round(48 * scale), row.bottom},\r\n                         brush);\r\n        if (event.remind) {\r\n            brush->SetColor(Fg(event.fired ? 0.3f : 0.6f));\r\n            DrawGlyph(target, &kGlyphBell, 1, m_iconFormat.get(),\r\n                      {row.right - std::round(48 * scale), row.top,\r\n                       row.right - std::round(28 * scale), row.bottom},\r\n                      brush);\r\n        }\r\n        brush->SetColor(Fg(0.4f + 0.55f * Hover(HoverKey(5000, event.id), hover)));\r\n        DrawGlyph(target, &kGlyphEventDelete, 1, m_iconFormat.get(),\r\n                  {row.right - std::round(28 * scale), row.top,\r\n                   row.right, row.bottom},\r\n                  brush);\r\n    }\r\n\r\n    DrawUpcoming(target, brush);\r\n\r\n    // \"+ New event\", or its fields.\r\n    if (!m_adding) {\r\n        const float radius = std::round(8 * scale);\r\n        brush->SetColor(\r\n            Fg(0.09f + 0.07f * Hover(m_addButton, m_hover.part == Part::Add)));\r\n        GlassFill(target, {m_addButton, radius, radius}, brush);\r\n        PCWSTR add = Tr(L\"+  New event\", L\"+  Novo evento\");\r\n        brush->SetColor(Fg(0.85f));\r\n        m_textFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_CENTER);\r\n        target->DrawText(add, (UINT32)wcslen(add), m_textFormat.get(),\r\n                         m_addButton, brush);\r\n        m_textFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_LEADING);\r\n    } else {\r\n        // The fields fade in, sliding down a little.\r\n        const float form = (float)std::clamp(m_form, 0.0, 1.0);\r\n        winrt::com_ptr<ID2D1Layer> formLayer;\r\n        if (form < 0.999f) {\r\n            target->CreateLayer(nullptr, formLayer.put());\r\n        }\r\n        if (formLayer) {\r\n            target->PushLayer(\r\n                D2D1::LayerParameters(D2D1::InfiniteRect(), nullptr,\r\n                                      D2D1_ANTIALIAS_MODE_PER_PRIMITIVE,\r\n                                      D2D1::IdentityMatrix(), form),\r\n                formLayer.get());\r\n        }\r\n        // On top of the panel's own placement.\r\n        D2D1_MATRIX_3X2_F base;\r\n        target->GetTransform(&base);\r\n        target->SetTransform(\r\n            D2D1::Matrix3x2F::Translation(\r\n                0, -std::round(8 * scale) *\r\n                       (1 - (float)std::clamp(m_form, 0.0, 1.2))) *\r\n            *D2D1::Matrix3x2F::ReinterpretBaseType(&base));\r\n        DrawField(target, brush, m_titleField, m_newTitle,\r\n                  Tr(L\"Title\", L\"Título\"), m_focus == Field::Title);\r\n        // \"All day\", blue when chosen.\r\n        const float chipRadius =\r\n            (m_allDayButton.bottom - m_allDayButton.top) / 2;\r\n        brush->SetColor(m_newAllDay ? Accent(1)\r\n                                    : Fg(0.1f + 0.08f * Hover(m_allDayButton,\r\n                                                              m_hover.part ==\r\n                                                                  Part::AllDay)));\r\n        GlassFill(target, {m_allDayButton, chipRadius, chipRadius}, brush);\r\n        PCWSTR allDay = Tr(L\"All day\", L\"Dia todo\");\r\n        brush->SetColor(m_newAllDay ? AccentInk(1) : Fg(0.9f));\r\n        m_textFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_CENTER);\r\n        target->DrawText(allDay, (UINT32)wcslen(allDay), m_textFormat.get(),\r\n                         m_allDayButton, brush);\r\n        // The hour and the minute: click to type them (blue outline), or\r\n        // use the arrows at their right end (or the wheel, or ↑ ↓).\r\n        const float timeOpacity = m_newAllDay ? 0.35f : 1.0f;\r\n        for (Part part : {Part::Hour, Part::Minute}) {\r\n            const D2D1_RECT_F& box = part == Part::Hour ? m_hourBox : m_minuteBox;\r\n            const bool focused =\r\n                !m_newAllDay && m_focus == (part == Part::Hour ? Field::Hour\r\n                                                               : Field::Minute);\r\n            const float radius = std::round(8 * scale);\r\n            brush->SetColor(Fg(\r\n                (0.1f + 0.06f * Hover(box, m_hover.part == part || focused)) *\r\n                timeOpacity));\r\n            GlassFill(target, {box, radius, radius}, brush);\r\n            if (focused) {\r\n                brush->SetColor(Accent(1));\r\n                target->DrawRoundedRectangle(\r\n                    {{box.left + 0.75f, box.top + 0.75f, box.right - 0.75f,\r\n                      box.bottom - 0.75f},\r\n                     radius,\r\n                     radius},\r\n                    brush, 1.5f);\r\n            }\r\n            WCHAR value[8];\r\n            swprintf_s(value, L\"%02d\",\r\n                       part == Part::Hour ? m_newHour : m_newMinute);\r\n            // Half typed: only the figure typed so far.\r\n            if (focused && m_digits == 1) {\r\n                swprintf_s(value, L\"%d_\",\r\n                           part == Part::Hour ? m_newHour : m_newMinute);\r\n            }\r\n            const float arrow = std::round(14 * scale);\r\n            brush->SetColor(Fg(0.95f * timeOpacity));\r\n            target->DrawText(value, (UINT32)wcslen(value), m_dayFormat.get(),\r\n                             {box.left, box.top, box.right - arrow / 2,\r\n                              box.bottom},\r\n                             brush);\r\n            if ((m_hover.part == part || focused) && !m_newAllDay) {\r\n                const float half = (box.bottom - box.top) / 2;\r\n                const bool onArrows = m_hover.part == part;\r\n                brush->SetColor(\r\n                    Fg(onArrows && m_hover.value > 0 ? 0.95f : 0.4f));\r\n                DrawGlyph(target, &kGlyphCollapse, 1, m_iconFormat.get(),\r\n                          {box.right - arrow, box.top + 2,\r\n                           box.right - 2, box.top + half},\r\n                          brush);\r\n                brush->SetColor(\r\n                    Fg(onArrows && m_hover.value < 0 ? 0.95f : 0.4f));\r\n                DrawGlyph(target, &kGlyphChevronDownCalendar, 1,\r\n                          m_iconFormat.get(),\r\n                          {box.right - arrow, box.top + half,\r\n                           box.right - 2, box.bottom - 2},\r\n                          brush);\r\n            }\r\n        }\r\n        brush->SetColor(Fg(0.7f * timeOpacity));\r\n        target->DrawText(L\":\", 1, m_dayFormat.get(),\r\n                         {m_hourBox.right, m_hourBox.top, m_minuteBox.left,\r\n                          m_hourBox.bottom},\r\n                         brush);\r\n        m_textFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_LEADING);\r\n        // The reminder's bell: blue when on.\r\n        const float radius = (m_remindButton.bottom - m_remindButton.top) / 2;\r\n        brush->SetColor(m_newRemind ? Accent(1)\r\n                                    : Fg(0.12f));\r\n        GlassFill(target, {m_remindButton, radius, radius}, brush);\r\n        brush->SetColor(Fg(0.95f));\r\n        DrawGlyph(target, &kGlyphBell, 1, m_iconFormat.get(), m_remindButton,\r\n                  brush);\r\n        const float saveRadius = (m_saveButton.bottom - m_saveButton.top) / 2;\r\n        brush->SetColor(Accent(1.0f - 0.15f * Hover(m_saveButton,\r\n                                                          m_hover.part ==\r\n                                                              Part::Save)));\r\n        target->FillRoundedRectangle({m_saveButton, saveRadius, saveRadius},\r\n                                     brush);\r\n        PCWSTR save = m_editingId ? Tr(L\"Save\", L\"Salvar\")\r\n                                  : Tr(L\"Add\", L\"Adicionar\");\r\n        brush->SetColor(AccentInk(1));\r\n        m_textFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_CENTER);\r\n        target->DrawText(save, (UINT32)wcslen(save), m_textFormat.get(),\r\n                         m_saveButton, brush);\r\n        // \"Cancel\", gray.\r\n        const float cancelRadius =\r\n            (m_cancelButton.bottom - m_cancelButton.top) / 2;\r\n        brush->SetColor(Fg(\r\n            0.1f + 0.08f * Hover(m_cancelButton, m_hover.part == Part::Cancel)));\r\n        GlassFill(target, {m_cancelButton, cancelRadius, cancelRadius}, brush);\r\n        PCWSTR cancel = Tr(L\"Cancel\", L\"Cancelar\");\r\n        brush->SetColor(Fg(0.9f));\r\n        target->DrawText(cancel, (UINT32)wcslen(cancel), m_textFormat.get(),\r\n                         m_cancelButton, brush);\r\n        m_textFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_LEADING);\r\n        if (!m_statusText.empty()) {\r\n            brush->SetColor(D2D1::ColorF(1.0f, 0.55f, 0.5f, 1));\r\n            target->DrawText(m_statusText.c_str(),\r\n                             (UINT32)m_statusText.size(), m_smallFormat.get(),\r\n                             m_status, brush);\r\n        } else {\r\n            PCWSTR bell =\r\n                m_newRemind\r\n                    ? Tr(L\"In the pill with a sound, even in Do not disturb\",\r\n                         L\"Na pílula com som, também no Não incomodar\")\r\n                    : Tr(L\"No reminder (the bell turns it on)\",\r\n                         L\"Sem lembrete (o sino liga)\");\r\n            brush->SetColor(Fg(0.5f));\r\n            target->DrawText(bell, (UINT32)wcslen(bell), m_smallFormat.get(),\r\n                             m_status, brush, D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n        }\r\n        target->SetTransform(base);\r\n        if (formLayer) {\r\n            target->PopLayer();\r\n        }\r\n    }\r\n}\r\n\r\n// The agendas' view: each agenda (its color, a click changes it; its name\r\n// and how it's doing; its \"x\"), the link or path to add, and today's color.\r\nvoid CalendarPanel::LayoutAgendas(float y) {\r\n    const float scale = m_scale;\r\n    const float padding = std::round(kPanelPadding * scale);\r\n    // (Wider than the month, for the agendas' names.)\r\n    const float width = std::round(\r\n        (padding * 2 + std::round(kCalendarCell * scale) * 7) * 1.25f);\r\n    const float row = std::round(40 * scale);\r\n    const float gap = std::round(6 * scale);\r\n    y += gap;\r\n    m_agendaRows.clear();\r\n    m_agendaRemovable.clear();\r\n    AcquireSRWLockShared(&g_agendasLock);\r\n    for (const auto& agenda : g_agendas) {\r\n        m_agendaRows.push_back({padding, y, width - padding, y + row});\r\n        m_agendaRemovable.push_back(!agenda.fromSettings);\r\n        y += row;\r\n    }\r\n    const bool none = g_agendas.empty();\r\n    ReleaseSRWLockShared(&g_agendasLock);\r\n    // Without any: what to paste.\r\n    m_agendaHint = {};\r\n    if (none) {\r\n        m_agendaHint = {padding, y, width - padding,\r\n                        y + std::round(70 * scale)};\r\n        y = m_agendaHint.bottom;\r\n    }\r\n    y += gap;\r\n    const float field = std::round(32 * scale);\r\n    const float add = std::round(84 * scale);\r\n    m_linkField = {padding, y, width - padding - add - gap, y + field};\r\n    m_linkAdd = {width - padding - add, y, width - padding, y + field};\r\n    y += field;\r\n    const float status = std::round(kEventRowHeight * scale * 0.8f);\r\n    m_agendaStatus = {padding, y, width - padding, y + status};\r\n    if (!m_agendaStatusText.empty()) {\r\n        y += status;\r\n    }\r\n    y += std::round(12 * scale);\r\n    m_todayHeader = {padding, y, width - padding,\r\n                     y + std::round(kEventRowHeight * scale)};\r\n    y = m_todayHeader.bottom;\r\n    const float chip = std::round(30 * scale);\r\n    const float chipWidth = std::floor((width - padding * 2 - gap * 2) / 3);\r\n    for (size_t i = 0; i < m_todayChips.size(); i++) {\r\n        const float left = padding + i * (chipWidth + gap);\r\n        m_todayChips[i] = {left, y, left + chipWidth, y + chip};\r\n    }\r\n    y += chip;\r\n    m_deleteHeader = m_countLine = m_deletePastButton = {};\r\n    m_deleteChips = {};\r\n    if (IslandHasMainSettings(m_owner)) {\r\n        y += std::round(12 * scale);\r\n        m_deleteHeader = {padding, y, width - padding,\r\n                          y + std::round(kEventRowHeight * scale)};\r\n        y = m_deleteHeader.bottom;\r\n        const float deleteWidth =\r\n            std::floor((width - padding * 2 - gap * 3) / 4);\r\n        for (size_t i = 0; i < m_deleteChips.size(); i++) {\r\n            const float left = padding + i * (deleteWidth + gap);\r\n            m_deleteChips[i] = {left, y, left + deleteWidth, y + chip};\r\n        }\r\n        y += chip + gap;\r\n        const float button = std::round(170 * scale);\r\n        m_countLine = {padding, y, width - padding - button - gap, y + chip};\r\n        m_deletePastButton = {width - padding - button, y, width - padding,\r\n                              y + chip};\r\n        y += chip;\r\n    }\r\n    y += padding;\r\n    m_size = {(LONG)width, (LONG)std::ceil(y)};\r\n}\r\n\r\nvoid CalendarPanel::DrawAgendas(ID2D1RenderTarget* target,\r\n                                ID2D1SolidColorBrush* brush) {\r\n    const float scale = m_scale;\r\n    AcquireSRWLockShared(&g_agendasLock);\r\n    for (size_t i = 0; i < m_agendaRows.size() && i < g_agendas.size(); i++) {\r\n        const Agenda& agenda = g_agendas[i];\r\n        const D2D1_RECT_F& row = m_agendaRows[i];\r\n        const float middle = (row.top + row.bottom) / 2;\r\n        const float dot = std::round(6 * scale);\r\n        const D2D1_POINT_2F center{row.left + std::round(10 * scale), middle};\r\n        brush->SetColor(RgbColor(agenda.color, 1));\r\n        target->FillEllipse({center, dot, dot}, brush);\r\n        if (const float lit = Hover(HoverKey(5002, (long long)i),\r\n                                    m_hover.part == Part::AgendaColor &&\r\n                                        m_hover.value == (long long)i);\r\n            lit > 0.01f) {\r\n            brush->SetColor(Fg(0.5f * lit));\r\n            target->DrawEllipse({center, dot + std::round(3 * scale),\r\n                                 dot + std::round(3 * scale)},\r\n                                brush, 1.5f);\r\n        }\r\n        const float textLeft = row.left + std::round(28 * scale);\r\n        const float textRight = row.right - std::round(32 * scale);\r\n        const std::wstring name =\r\n            agenda.name.empty() ? AgendaShortName(agenda.source) : agenda.name;\r\n        brush->SetColor(Fg(0.95f));\r\n        target->DrawText(name.c_str(), (UINT32)name.size(), m_textFormat.get(),\r\n                         {textLeft, row.top + std::round(3 * scale), textRight,\r\n                          middle + std::round(2 * scale)},\r\n                         brush, D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n        std::wstring state =\r\n            agenda.reading && !agenda.read\r\n                ? std::wstring(Tr(L\"Reading…\", L\"Lendo…\"))\r\n            : agenda.notIcs\r\n                ? std::wstring(\r\n                      Tr(L\"Not an .ics link (Google: Secret address in iCal \"\r\n                         L\"format)\",\r\n                         L\"Não é um link .ics (Google: Endereço secreto no \"\r\n                         L\"formato iCal)\"))\r\n            : agenda.failed\r\n                ? std::wstring(Tr(L\"Couldn't read it\", L\"Não foi possível ler\"))\r\n            : agenda.read ? std::to_wstring(agenda.events.size()) +\r\n                                Tr(L\" events\", L\" eventos\")\r\n                          : std::wstring();\r\n        if (agenda.fromSettings) {\r\n            state += (state.empty() ? L\"\" : L\" · \") +\r\n                     std::wstring(Tr(L\"from Windhawk\", L\"do Windhawk\"));\r\n        }\r\n        brush->SetColor(agenda.failed ? D2D1::ColorF(1.0f, 0.55f, 0.5f, 1)\r\n                                      : Fg(0.5f));\r\n        target->DrawText(\r\n            state.c_str(), (UINT32)state.size(), m_smallFormat.get(),\r\n            {textLeft, middle, textRight, row.bottom - std::round(3 * scale)},\r\n            brush, D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n        if (i < m_agendaRemovable.size() && m_agendaRemovable[i]) {\r\n            brush->SetColor(\r\n                Fg(0.4f + 0.55f * Hover(HoverKey(5003, (long long)i),\r\n                                        m_hover.part == Part::AgendaRemove &&\r\n                                            m_hover.value == (long long)i)));\r\n            DrawGlyph(target, &kGlyphEventDelete, 1, m_iconFormat.get(),\r\n                      {row.right - std::round(28 * scale), row.top,\r\n                       row.right, row.bottom},\r\n                      brush);\r\n        }\r\n    }\r\n    ReleaseSRWLockShared(&g_agendasLock);\r\n    if (m_agendaHint.bottom > m_agendaHint.top) {\r\n        const std::wstring hint =\r\n            std::wstring(Tr(L\"No agendas yet.\", L\"Nenhuma agenda ainda.\")) +\r\n            L\" \" +\r\n            Tr(L\"Paste an .ics link (Google Calendar: Settings, your calendar, \"\r\n               L\"Secret address in iCal format) or a file's path.\",\r\n               L\"Cole um link .ics (Google Agenda: Configurações, a sua \"\r\n               L\"agenda, Endereço secreto no formato iCal) ou o caminho \"\r\n               L\"de um arquivo.\");\r\n        winrt::com_ptr<IDWriteTextLayout> layout;\r\n        if (SUCCEEDED(m_dwrite->CreateTextLayout(\r\n                hint.c_str(), (UINT32)hint.size(), m_smallFormat.get(),\r\n                m_agendaHint.right - m_agendaHint.left,\r\n                m_agendaHint.bottom - m_agendaHint.top, layout.put()))) {\r\n            layout->SetWordWrapping(DWRITE_WORD_WRAPPING_WRAP);\r\n            layout->SetParagraphAlignment(DWRITE_PARAGRAPH_ALIGNMENT_NEAR);\r\n            brush->SetColor(Fg(0.55f));\r\n            target->DrawTextLayout({m_agendaHint.left, m_agendaHint.top},\r\n                                   layout.get(), brush);\r\n        }\r\n    }\r\n    DrawField(target, brush, m_linkField, m_newLink,\r\n              Tr(L\".ics link or file path\", L\"Link ou caminho do .ics\"), true);\r\n    const float addRadius = (m_linkAdd.bottom - m_linkAdd.top) / 2;\r\n    brush->SetColor(\r\n        Accent(1.0f - 0.15f * Hover(m_linkAdd, m_hover.part == Part::LinkAdd)));\r\n    target->FillRoundedRectangle({m_linkAdd, addRadius, addRadius}, brush);\r\n    PCWSTR add = Tr(L\"Add\", L\"Adicionar\");\r\n    brush->SetColor(AccentInk(1));\r\n    m_textFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_CENTER);\r\n    target->DrawText(add, (UINT32)wcslen(add), m_textFormat.get(), m_linkAdd,\r\n                     brush);\r\n    m_textFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_LEADING);\r\n    if (!m_agendaStatusText.empty()) {\r\n        brush->SetColor(D2D1::ColorF(1.0f, 0.55f, 0.5f, 1));\r\n        target->DrawText(m_agendaStatusText.c_str(),\r\n                         (UINT32)m_agendaStatusText.size(), m_smallFormat.get(),\r\n                         m_agendaStatus, brush);\r\n    }\r\n    // Today's color: red, Windows' accent color, or one chosen (a swatch on\r\n    // each; the one in use outlined).\r\n    brush->SetColor(Fg(0.1f));\r\n    target->FillRectangle({m_todayHeader.left, m_todayHeader.top,\r\n                           m_todayHeader.right, m_todayHeader.top + 1},\r\n                          brush);\r\n    PCWSTR header = Tr(L\"Today's color\", L\"Cor de hoje\");\r\n    brush->SetColor(Fg(0.6f));\r\n    target->DrawText(header, (UINT32)wcslen(header), m_smallFormat.get(),\r\n                     m_todayHeader, brush);\r\n    const int colors[] = {kTodayRed, m_windowsAccent, m_todayColor};\r\n    const PCWSTR names[] = {Tr(L\"Red\", L\"Vermelho\"), Tr(L\"Windows\", L\"Windows\"),\r\n                            Tr(L\"Choose\", L\"Escolher\")};\r\n    for (size_t i = 0; i < m_todayChips.size(); i++) {\r\n        const D2D1_RECT_F& chip = m_todayChips[i];\r\n        const bool chosen = m_todayMode == (int)i;\r\n        const float radius = (chip.bottom - chip.top) / 2;\r\n        brush->SetColor(Fg(\r\n            chosen ? 0.18f\r\n                   : 0.08f + 0.08f * Hover(chip,\r\n                                           m_hover.part == Part::TodayChoice &&\r\n                                               m_hover.value == (long long)i)));\r\n        GlassFill(target, {chip, radius, radius}, brush);\r\n        if (chosen) {\r\n            brush->SetColor(Fg(0.7f));\r\n            target->DrawRoundedRectangle(\r\n                {{chip.left + 0.75f, chip.top + 0.75f, chip.right - 0.75f,\r\n                  chip.bottom - 0.75f},\r\n                 radius,\r\n                 radius},\r\n                brush, 1.5f);\r\n        }\r\n        const float dot = std::round(5 * scale);\r\n        brush->SetColor(RgbColor(colors[i], 1));\r\n        target->FillEllipse(\r\n            {{chip.left + std::round(13 * scale), (chip.top + chip.bottom) / 2},\r\n             dot,\r\n             dot},\r\n            brush);\r\n        brush->SetColor(Fg(0.9f));\r\n        target->DrawText(names[i], (UINT32)wcslen(names[i]),\r\n                         m_smallFormat.get(),\r\n                         {chip.left + std::round(22 * scale), chip.top,\r\n                          chip.right - std::round(4 * scale), chip.bottom},\r\n                         brush, D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n    }\r\n    // Past events hidden after: never, a day, a week or thirty days (the one\r\n    // in use outlined); the events' count, and \"Delete past events\".\r\n    if (m_deleteHeader.bottom <= m_deleteHeader.top) {\r\n        return;\r\n    }\r\n    brush->SetColor(Fg(0.1f));\r\n    target->FillRectangle({m_deleteHeader.left, m_deleteHeader.top,\r\n                           m_deleteHeader.right, m_deleteHeader.top + 1},\r\n                          brush);\r\n    PCWSTR deleteHeader =\r\n        Tr(L\"Hide past events after\", L\"Ocultar eventos passados depois de\");\r\n    brush->SetColor(Fg(0.6f));\r\n    target->DrawText(deleteHeader, (UINT32)wcslen(deleteHeader),\r\n                     m_smallFormat.get(), m_deleteHeader, brush,\r\n                     D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n    const PCWSTR waits[] = {Tr(L\"Never\", L\"Nunca\"), Tr(L\"1 day\", L\"1 dia\"),\r\n                            Tr(L\"7 days\", L\"7 dias\"),\r\n                            Tr(L\"30 days\", L\"30 dias\")};\r\n    m_smallFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_CENTER);\r\n    for (size_t i = 0; i < m_deleteChips.size(); i++) {\r\n        const D2D1_RECT_F& chip = m_deleteChips[i];\r\n        const bool chosen = g_hidePastAfter == (int)i;\r\n        const float radius = (chip.bottom - chip.top) / 2;\r\n        brush->SetColor(Fg(\r\n            chosen ? 0.18f\r\n                   : 0.08f + 0.08f * Hover(chip,\r\n                                           m_hover.part == Part::DeleteChoice &&\r\n                                               m_hover.value == (long long)i)));\r\n        GlassFill(target, {chip, radius, radius}, brush);\r\n        if (chosen) {\r\n            brush->SetColor(Fg(0.7f));\r\n            target->DrawRoundedRectangle(\r\n                {{chip.left + 0.75f, chip.top + 0.75f, chip.right - 0.75f,\r\n                  chip.bottom - 0.75f},\r\n                 radius,\r\n                 radius},\r\n                brush, 1.5f);\r\n        }\r\n        brush->SetColor(Fg(0.9f));\r\n        target->DrawText(waits[i], (UINT32)wcslen(waits[i]),\r\n                         m_smallFormat.get(), chip, brush,\r\n                         D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n    }\r\n    // \"Delete 12 past events?\" while it waits for the second press.\r\n    const size_t past = PastEventCount();\r\n    const bool armed = NowSeconds() - m_deletePastArmedAt < 4 && past > 0;\r\n    {\r\n        const D2D1_RECT_F& button = m_deletePastButton;\r\n        const float radius = (button.bottom - button.top) / 2;\r\n        const float opacity = past > 0 ? 1.0f : 0.4f;\r\n        brush->SetColor(\r\n            armed ? D2D1::ColorF(1.0f, 0.27f, 0.23f, 0.9f)\r\n                  : Fg((0.08f + 0.08f * Hover(button, m_hover.part ==\r\n                                                          Part::DeletePast)) *\r\n                       opacity));\r\n        GlassFill(target, {button, radius, radius}, brush);\r\n        WCHAR label[64];\r\n        if (armed) {\r\n            swprintf_s(label, Tr(L\"Delete %zu past events?\",\r\n                                 L\"Apagar %zu eventos passados?\"),\r\n                       past);\r\n        } else {\r\n            wcscpy_s(label, Tr(L\"Delete past events\", L\"Apagar eventos passados\"));\r\n        }\r\n        brush->SetColor(armed ? D2D1::ColorF(1, 1, 1, 1) : Fg(0.9f * opacity));\r\n        target->DrawText(label, (UINT32)wcslen(label), m_smallFormat.get(),\r\n                         button, brush, D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n    }\r\n    m_smallFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_LEADING);\r\n    // \"180 of 200 events\", in orange once it's almost full.\r\n    WCHAR count[96];\r\n    swprintf_s(count, Tr(L\"%zu of %zu events\", L\"%zu de %zu eventos\"),\r\n               g_events.size(), kMaxEvents);\r\n    std::wstring countText = count;\r\n    const bool almostFull = g_events.size() + 20 >= kMaxEvents;\r\n    if (almostFull) {\r\n        countText += Tr(L\" · almost full\", L\" · quase cheio\");\r\n    }\r\n    brush->SetColor(almostFull ? D2D1::ColorF(1.0f, 0.62f, 0.04f, 1)\r\n                               : Fg(0.5f));\r\n    target->DrawText(countText.c_str(), (UINT32)countText.size(),\r\n                     m_smallFormat.get(), m_countLine, brush,\r\n                     D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n}\r\n\r\n// A link or a path typed (or pasted) added, and read.\r\nvoid CalendarPanel::AddAgenda() {\r\n    const std::wstring source = AgendaSource(m_newLink);\r\n    m_agendaStatusText.clear();\r\n    if (source.empty()) {\r\n        m_agendaStatusText = Tr(L\"Only https links or file paths\",\r\n                                L\"Só links https ou caminhos de arquivos\");\r\n    } else {\r\n        AcquireSRWLockExclusive(&g_agendasLock);\r\n        const bool known = std::any_of(\r\n            g_agendas.begin(), g_agendas.end(),\r\n            [&](const Agenda& agenda) { return agenda.source == source; });\r\n        const bool full = g_agendas.size() >= kMaxAgendas;\r\n        if (!known && !full) {\r\n            Agenda agenda;\r\n            agenda.source = source;\r\n            agenda.color = NextAgendaColor(g_agendas);\r\n            // (Before the settings' ones, as they're read.)\r\n            g_agendas.insert(std::find_if(g_agendas.begin(), g_agendas.end(),\r\n                                          [](const Agenda& one) {\r\n                                              return one.fromSettings;\r\n                                          }),\r\n                             std::move(agenda));\r\n        }\r\n        ReleaseSRWLockExclusive(&g_agendasLock);\r\n        if (known) {\r\n            m_agendaStatusText = Tr(L\"Already added\", L\"Já adicionada\");\r\n        } else if (full) {\r\n            m_agendaStatusText = Tr(L\"Too many agendas\", L\"Agendas demais\");\r\n        } else {\r\n            m_newLink.clear();\r\n            SaveAgendas();\r\n            RequestAgendas(m_hwnd);\r\n        }\r\n    }\r\n    Layout();\r\n    StartIslandAnimation();\r\n}\r\n\r\nvoid CalendarPanel::RemoveAgenda(size_t index) {\r\n    AcquireSRWLockExclusive(&g_agendasLock);\r\n    if (index < g_agendas.size() && !g_agendas[index].fromSettings) {\r\n        g_agendas.erase(g_agendas.begin() + index);\r\n        IndexAgendaDays();\r\n    }\r\n    ReleaseSRWLockExclusive(&g_agendasLock);\r\n    SaveAgendas();\r\n    Layout();\r\n    StartIslandAnimation();\r\n}\r\n\r\nD2D1_COLOR_F CalendarPanel::TodayColor() const {\r\n    return m_todayMode == 1   ? RgbColor(m_windowsAccent, 1)\r\n           : m_todayMode == 2 ? RgbColor(m_todayColor, 1)\r\n                              : D2D1::ColorF(1.0f, 0.27f, 0.23f, 1);\r\n}\r\n\r\nvoid CalendarPanel::SetTodayMode(int mode) {\r\n    m_todayMode = std::clamp(mode, 0, 2);\r\n    if (m_todayMode == 1) {\r\n        m_windowsAccent = WindowsAccentColor();\r\n    }\r\n    Wh_SetIntValue(L\"calendarToday\", m_todayMode);\r\n}\r\n\r\nvoid CalendarPanel::DrawUpcoming(ID2D1RenderTarget* target,\r\n                                 ID2D1SolidColorBrush* brush) {\r\n    const float scale = m_scale;\r\n    const float line = std::round(22 * scale);\r\n    SYSTEMTIME now;\r\n    GetLocalTime(&now);\r\n    // A list: a line over it, its title, then a row each, the date (in the\r\n    // agenda's color, or the holidays' green; with the year when it isn't\r\n    // this one, like a yearly event already past this year) and what it is.\r\n    struct Row {\r\n        SYSTEMTIME date;\r\n        int color;\r\n        std::wstring text;\r\n    };\r\n    auto list = [&](const D2D1_RECT_F& header, PCWSTR title,\r\n                    const std::vector<Row>& rows) {\r\n        if (rows.empty()) {\r\n            return;\r\n        }\r\n        brush->SetColor(Fg(0.1f));\r\n        target->FillRectangle(\r\n            {header.left, header.top, header.right, header.top + 1}, brush);\r\n        brush->SetColor(Fg(0.6f));\r\n        target->DrawText(title, (UINT32)wcslen(title), m_smallFormat.get(),\r\n                         header, brush);\r\n        bool otherYear = false;\r\n        for (const auto& row : rows) {\r\n            otherYear = otherYear || row.date.wYear != now.wYear;\r\n        }\r\n        // The dates, and their column as wide as the widest needs (longer\r\n        // in some languages, like \"11月20日\").\r\n        const std::wstring monthDay = MonthDayPicture(true);\r\n        std::vector<std::wstring> dates;\r\n        float dateWidth = std::round((otherYear ? 80 : 46) * scale);\r\n        for (const auto& row : rows) {\r\n            WCHAR date[32] = L\"\";\r\n            const std::wstring picture =\r\n                monthDay + (row.date.wYear != now.wYear ? L\" yyyy\" : L\"\");\r\n            GetDateFormatEx(DateLocale(), 0, &row.date, picture.c_str(), date,\r\n                            ARRAYSIZE(date), nullptr);\r\n            dates.push_back(date);\r\n            winrt::com_ptr<IDWriteTextLayout> layout;\r\n            if (SUCCEEDED(m_dwrite->CreateTextLayout(date, (UINT32)wcslen(date),\r\n                                                     m_smallFormat.get(), 1000,\r\n                                                     line, layout.put()))) {\r\n                DWRITE_TEXT_METRICS metrics{};\r\n                layout->GetMetrics(&metrics);\r\n                dateWidth =\r\n                    std::max(dateWidth, std::ceil(metrics.width + 8 * scale));\r\n            }\r\n        }\r\n        float y = header.bottom;\r\n        for (size_t i = 0; i < rows.size(); i++) {\r\n            const Row& row = rows[i];\r\n            const std::wstring& date = dates[i];\r\n            // Under the mouse: lit (a click shows its day, see HitTest).\r\n            if (m_hover.part == Part::Upcoming &&\r\n                m_hover.value == row.date.wYear * 10000LL +\r\n                                     row.date.wMonth * 100 + row.date.wDay) {\r\n                const float radius = std::round(6 * scale);\r\n                brush->SetColor(Fg(0.08f));\r\n                GlassFill(target,\r\n                          {{header.left - std::round(4 * scale), y,\r\n                            header.right + std::round(4 * scale), y + line},\r\n                           radius,\r\n                           radius},\r\n                          brush);\r\n            }\r\n            brush->SetColor(RgbColor(row.color, 1));\r\n            target->DrawText(\r\n                date.c_str(), (UINT32)date.size(), m_smallFormat.get(),\r\n                {header.left, y, header.left + dateWidth, y + line}, brush);\r\n            brush->SetColor(Fg(0.85f));\r\n            target->DrawText(\r\n                row.text.c_str(), (UINT32)row.text.size(), m_smallFormat.get(),\r\n                {header.left + dateWidth, y, header.right, y + line}, brush,\r\n                D2D1_DRAW_TEXT_OPTIONS_CLIP);\r\n            y += line;\r\n        }\r\n    };\r\n    std::vector<Row> events;\r\n    for (const auto& item : m_upcomingAgenda) {\r\n        const AgendaEvent& event = item.event;\r\n        const std::wstring title = event.title.empty()\r\n                                       ? std::wstring(Tr(L\"Event\", L\"Evento\"))\r\n                                       : event.title;\r\n        events.push_back(\r\n            {{(WORD)event.year, (WORD)event.month, 0, (WORD)event.day},\r\n             item.color,\r\n             event.minute >= 0 ? EventTimeText(event.minute) + L\" · \" + title\r\n                               : title});\r\n    }\r\n    list(m_upcomingAgendaHeader, Tr(L\"Upcoming events\", L\"Próximos eventos\"),\r\n         events);\r\n    std::vector<Row> holidays;\r\n    for (const auto& holiday : m_upcoming) {\r\n        holidays.push_back(\r\n            {{(WORD)holiday.year, (WORD)holiday.month, 0, (WORD)holiday.day},\r\n             0x33C759,\r\n             holiday.name});\r\n    }\r\n    list(m_upcomingHeader, Tr(L\"Upcoming holidays\", L\"Próximos feriados\"),\r\n         holidays);\r\n}\r\n\r\nvoid CalendarPanel::DrawMonth(ID2D1RenderTarget* target,\r\n                              ID2D1SolidColorBrush* brush,\r\n                              int year,\r\n                              int month,\r\n                              float offset,\r\n                              float opacity) {\r\n    const float scale = m_scale;\r\n    const float padding = std::round(kPanelPadding * scale);\r\n    const float cell = std::round(kCalendarCell * scale);\r\n    const float top = padding + m_clockHeight;\r\n    const float titleHeight = cell * 1.2f;\r\n\r\n    // Title (\"Outubro de 2026\").\r\n    const std::wstring title = YearMonthTitle(year, month);\r\n    brush->SetColor(Fg(0.95f * opacity));\r\n    target->DrawText(title.c_str(), (UINT32)title.size(), m_titleFormat.get(),\r\n                     {m_title.left + offset, m_title.top, m_title.right + offset,\r\n                      m_title.bottom},\r\n                     brush);\r\n\r\n    WCHAR firstDayText[4] = L\"6\";\r\n    GetLocaleInfoEx(LOCALE_NAME_USER_DEFAULT, LOCALE_IFIRSTDAYOFWEEK,\r\n                    firstDayText, ARRAYSIZE(firstDayText));\r\n    const int firstDay = (_wtoi(firstDayText) + 1) % 7;\r\n\r\n    // Six weeks of days: today in a circle (red like on macOS, or the color\r\n    // chosen), the chosen day in a ring, a dot under days with events.\r\n    SYSTEMTIME today;\r\n    GetLocalTime(&today);\r\n    D2D1_COLOR_F todayFill = TodayColor();\r\n    // White on it, or dark on a light color.\r\n    const float todayInk =\r\n        Luminance(todayFill.r, todayFill.g, todayFill.b) > 0.62f ? 0.08f : 1.0f;\r\n    todayFill.a = opacity;\r\n    const int lead = (DayOfWeek(year, month, 1) - firstDay + 7) % 7;\r\n    const int days = DaysInMonth(year, month);\r\n    const int previousMonth = month == 1 ? 12 : month - 1;\r\n    const int previousDays =\r\n        DaysInMonth(month == 1 ? year - 1 : year, previousMonth);\r\n    const float gridTop = top + titleHeight + cell * 0.8f;\r\n    for (int index = 0; index < 42; index++) {\r\n        int day = index - lead + 1;\r\n        bool inMonth = true;\r\n        if (day < 1) {\r\n            day += previousDays;\r\n            inMonth = false;\r\n        } else if (day > days) {\r\n            day -= days;\r\n            inMonth = false;\r\n        }\r\n        const D2D1_RECT_F rect{padding + (index % 7) * cell + offset,\r\n                               gridTop + (index / 7) * m_rowHeight,\r\n                               padding + (index % 7 + 1) * cell + offset,\r\n                               gridTop + (index / 7 + 1) * m_rowHeight};\r\n        const D2D1_POINT_2F center{(rect.left + rect.right) / 2,\r\n                                   (rect.top + rect.bottom) / 2};\r\n        const float circle = std::min(cell, m_rowHeight) * 0.4f;\r\n        const bool isToday = inMonth && day == today.wDay &&\r\n                             month == today.wMonth && year == today.wYear;\r\n        const bool selected = inMonth && day == m_selectedDay &&\r\n                              month == m_selectedMonth &&\r\n                              year == m_selectedYear;\r\n        const bool hover = inMonth && m_hover.part == Part::Day &&\r\n                           m_hover.value == day && year == m_year &&\r\n                           month == m_month;\r\n        if (isToday) {\r\n            brush->SetColor(todayFill);\r\n            target->FillEllipse({center, circle, circle}, brush);\r\n        } else if (const float lit = Hover(\r\n                       HoverKey(5001, year * 10000 + month * 100 + index),\r\n                       hover);\r\n                   lit > 0.01f) {\r\n            brush->SetColor(Fg(0.1f * opacity * lit));\r\n            GlassFillEllipse(target, {center, circle, circle}, brush);\r\n        }\r\n        if (selected && !isToday) {\r\n            brush->SetColor(Fg(0.6f * opacity));\r\n            target->DrawEllipse({center, circle, circle}, brush, 1.5f);\r\n        }\r\n        const std::wstring text = std::to_wstring(day);\r\n        // On today's circle, its ink; a day with agenda events in its\r\n        // agenda's color, a holiday green; the theme's color elsewhere.\r\n        int agendaColor = 0;\r\n        const bool agendaDay = inMonth && !isToday &&\r\n                               AgendaDayColor(year, month, day, &agendaColor);\r\n        const bool holiday = inMonth && !isToday && !agendaDay &&\r\n                             !HolidaysOn(year, month, day).empty();\r\n        brush->SetColor(\r\n            isToday     ? D2D1::ColorF(todayInk, todayInk, todayInk, opacity)\r\n            : agendaDay ? RgbColor(agendaColor, opacity)\r\n            : holiday   ? D2D1::ColorF(0.2f, 0.78f, 0.35f, opacity)\r\n                        : Fg((inMonth ? 0.9f : 0.3f) * opacity));\r\n        target->DrawText(text.c_str(), (UINT32)text.size(), m_dayFormat.get(),\r\n                         rect, brush);\r\n        if (inMonth && HasEvents(year, month, day)) {\r\n            const float dot = 1.8f * scale;\r\n            brush->SetColor(\r\n                isToday ? D2D1::ColorF(todayInk, todayInk, todayInk, opacity)\r\n                        : D2D1::ColorF(1.0f, 0.27f, 0.23f, opacity));\r\n            target->FillEllipse(\r\n                {{center.x, center.y + circle - 3 * scale}, dot, dot}, brush);\r\n        }\r\n    }\r\n}\r\n\r\nbool CalendarPanel::OnMouseMove(POINT pt) {\r\n    const Hit hover = HitTest(pt);\r\n    if (hover == m_hover) {\r\n        return false;\r\n    }\r\n    m_hover = hover;\r\n    return true;\r\n}\r\n\r\nbool CalendarPanel::OnMouseLeave() {\r\n    if (m_hover.part == Part::None) {\r\n        return false;\r\n    }\r\n    m_hover = {};\r\n    return true;\r\n}\r\n\r\nvoid CalendarPanel::SaveNewEvent() {\r\n    const int minute = m_newAllDay ? -1 : m_newHour * 60 + m_newMinute;\r\n    auto edited = std::find_if(\r\n        g_events.begin(), g_events.end(),\r\n        [&](const CalendarEvent& e) { return m_editingId && e.id == m_editingId; });\r\n    if (edited == g_events.end() && g_events.size() >= kMaxEvents) {\r\n        m_statusText = Tr(L\"Calendar full: delete past events in the gear\",\r\n                          L\"Calendário cheio: apague os eventos passados na \"\r\n                          L\"engrenagem\");\r\n        Layout();\r\n        return;\r\n    }\r\n    CalendarEvent event;\r\n    if (edited != g_events.end()) {\r\n        event = *edited;\r\n    } else {\r\n        FILETIME now;\r\n        GetSystemTimeAsFileTime(&now);\r\n        event.id = ((long long)now.dwHighDateTime << 32) | now.dwLowDateTime;\r\n        event.year = m_selectedYear;\r\n        event.month = m_selectedMonth;\r\n        event.day = m_selectedDay;\r\n    }\r\n    event.minute = minute;\r\n    event.title = m_newTitle.empty()\r\n                      ? std::wstring(Tr(L\"Event\", L\"Evento\"))\r\n                      : m_newTitle;\r\n    event.remind = m_newRemind;\r\n    // A reminder for a time already gone isn't due; moved later, it is again.\r\n    SYSTEMTIME local;\r\n    GetLocalTime(&local);\r\n    event.fired =\r\n        LocalMinutes(event.year, event.month, event.day,\r\n                     minute >= 0 ? minute : kAllDayReminderMinute) <=\r\n        LocalMinutes(local.wYear, local.wMonth, local.wDay,\r\n                     local.wHour * 60 + local.wMinute);\r\n    if (edited != g_events.end()) {\r\n        *edited = std::move(event);\r\n    } else {\r\n        g_events.push_back(std::move(event));\r\n    }\r\n    SaveEvents();\r\n    StopEditing();\r\n}\r\n\r\nbool CalendarPanel::OnMouseUp(POINT pt) {\r\n    const Hit hit = HitTest(pt);\r\n    switch (hit.part) {\r\n        case Part::BigAlarms:\r\n        case Part::BigTimer:\r\n            // (3: the alarms' tab, 0: the timer's.)\r\n            OpenTimerTabOf(Owner(), hit.part == Part::BigAlarms ? 3 : 0);\r\n            return false;\r\n\r\n        case Part::Previous:\r\n            ChangeMonth(-1);\r\n            return true;\r\n        case Part::Next:\r\n            ChangeMonth(1);\r\n            return true;\r\n        case Part::Title: {\r\n            // The title goes back to this month (and today).\r\n            SYSTEMTIME today;\r\n            GetLocalTime(&today);\r\n            const int delta =\r\n                (today.wYear - m_year) * 12 + (today.wMonth - m_month);\r\n            if (delta) {\r\n                ChangeMonth(delta);\r\n            }\r\n            m_selectedYear = today.wYear;\r\n            m_selectedMonth = today.wMonth;\r\n            m_selectedDay = today.wDay;\r\n            Layout();\r\n            return true;\r\n        }\r\n        case Part::Day:\r\n            m_selectedYear = m_year;\r\n            m_selectedMonth = m_month;\r\n            m_selectedDay = (int)hit.value;\r\n            m_eventsScroll.Reset();\r\n            Layout();\r\n            return true;\r\n        case Part::Upcoming: {\r\n            // Its month shown, its day chosen (with its events under it).\r\n            const int year = (int)(hit.value / 10000);\r\n            const int month = (int)(hit.value / 100 % 100);\r\n            const int delta = (year - m_year) * 12 + (month - m_month);\r\n            if (delta) {\r\n                ChangeMonth(delta);\r\n            }\r\n            m_selectedYear = year;\r\n            m_selectedMonth = month;\r\n            m_selectedDay = (int)(hit.value % 100);\r\n            Layout();\r\n            return true;\r\n        }\r\n        case Part::DeleteEvent:\r\n            if (m_adding && m_editingId == hit.value) {\r\n                StopEditing();\r\n            }\r\n            std::erase_if(g_events, [&](const CalendarEvent& event) {\r\n                return event.id == hit.value;\r\n            });\r\n            SaveEvents();\r\n            Layout();\r\n            return true;\r\n        case Part::EventRow:\r\n            for (const auto& event : g_events) {\r\n                if (event.id == hit.value) {\r\n                    StartEditing(&event);\r\n                    break;\r\n                }\r\n            }\r\n            return true;\r\n        case Part::Add:\r\n            StartEditing(nullptr);\r\n            return true;\r\n        case Part::TitleField:\r\n            m_focus = Field::Title;\r\n            return true;\r\n        case Part::Hour:\r\n        case Part::Minute:\r\n            if (hit.value) {\r\n                StepTime(hit.part, (int)hit.value);\r\n            } else {\r\n                m_newAllDay = false;\r\n            }\r\n            m_focus = hit.part == Part::Hour ? Field::Hour : Field::Minute;\r\n            m_digits = 0;\r\n            return true;\r\n        case Part::Cancel:\r\n            StopEditing();\r\n            return true;\r\n        case Part::AllDay:\r\n            m_newAllDay = !m_newAllDay;\r\n            return true;\r\n        case Part::Remind:\r\n            m_newRemind = !m_newRemind;\r\n            return true;\r\n        case Part::Save:\r\n            SaveNewEvent();\r\n            return true;\r\n        // (Today big's gear: the same view, back to the card from there.)\r\n        case Part::BigGear:\r\n        case Part::Agendas:\r\n            if (m_adding) {\r\n                StopEditing();\r\n            }\r\n            m_agendasView = !m_agendasView;\r\n            m_agendaStatusText.clear();\r\n            g_lastTyped = NowSeconds();\r\n            Layout();\r\n            StartIslandAnimation();\r\n            return true;\r\n        case Part::AgendaColor: {\r\n            std::wstring source;\r\n            int color = 0;\r\n            AcquireSRWLockShared(&g_agendasLock);\r\n            if ((size_t)hit.value < g_agendas.size()) {\r\n                source = g_agendas[hit.value].source;\r\n                color = g_agendas[hit.value].color;\r\n            }\r\n            ReleaseSRWLockShared(&g_agendasLock);\r\n            if (!source.empty()) {\r\n                StartColorDialog(source, color);\r\n            }\r\n            return true;\r\n        }\r\n        case Part::AgendaRemove:\r\n            RemoveAgenda((size_t)hit.value);\r\n            return true;\r\n        case Part::LinkField:\r\n            g_lastTyped = NowSeconds();\r\n            StartIslandAnimation();\r\n            return true;\r\n        case Part::LinkAdd:\r\n            AddAgenda();\r\n            return true;\r\n        case Part::TodayChoice:\r\n            SetTodayMode((int)hit.value);\r\n            if (hit.value == 2) {\r\n                StartColorDialog(L\"\", m_todayColor);\r\n            }\r\n            return true;\r\n        case Part::DeleteChoice:\r\n            SetHidePastAfter((int)hit.value);\r\n            m_eventsDropped = g_eventsDropped;\r\n            Layout();\r\n            return true;\r\n        case Part::DeletePast:\r\n            // (Pressed again within a few seconds: deleted.)\r\n            if (PastEventCount() == 0) {\r\n                return true;\r\n            }\r\n            if (NowSeconds() - m_deletePastArmedAt >= 4) {\r\n                m_deletePastArmedAt = NowSeconds();\r\n                Render();\r\n                return true;\r\n            }\r\n            m_deletePastArmedAt = -100;\r\n            DeletePastEvents();\r\n            m_eventsDropped = g_eventsDropped;\r\n            Layout();\r\n            return true;\r\n        case Part::ShowHidden:\r\n            m_showHiddenFor = SelectedDayKey();\r\n            Layout();\r\n            return true;\r\n        case Part::None:\r\n            break;\r\n    }\r\n    return false;\r\n}\r\n\r\n// By one, around the clock.\r\nvoid CalendarPanel::StepTime(Part part, int steps) {\r\n    m_digits = 0;\r\n    if (m_newAllDay) {\r\n        m_newAllDay = false;\r\n        return;\r\n    }\r\n    if (part == Part::Hour) {\r\n        m_newHour = ((m_newHour + steps) % 24 + 24) % 24;\r\n    } else {\r\n        m_newMinute = ((m_newMinute + steps) % 60 + 60) % 60;\r\n    }\r\n}\r\n\r\nbool CalendarPanel::OnWheel(int delta) {\r\n    if (m_agendasView) {\r\n        return false;\r\n    }\r\n    // Over the hour or the minute: changes it.\r\n    if (m_adding &&\r\n        (m_hover.part == Part::Hour || m_hover.part == Part::Minute)) {\r\n        StepTime(m_hover.part, delta > 0 ? 1 : -1);\r\n        return true;\r\n    }\r\n    // Over the events, when they don't fit: they scroll (and only they, at\r\n    // their ends the panel's turn comes, see Panel::ShownHeight).\r\n    if (m_eventsView.bottom > m_eventsView.top) {\r\n        POINT pt{};\r\n        GetCursorPos(&pt);\r\n        ScreenToClient(m_hwnd, &pt);\r\n        pt.x -= m_contentOffset.x;\r\n        pt.y -= m_contentOffset.y;\r\n        if (PointInRect(pt, m_eventsView)) {\r\n            m_hover = {};\r\n            return m_eventsScroll.Wheel(\r\n                delta, std::round(kEventRowHeight * m_scale * 2));\r\n        }\r\n    }\r\n    if (PanelCanScroll(delta)) {\r\n        return false;\r\n    }\r\n    ChangeMonth(delta > 0 ? -1 : 1);\r\n    return true;\r\n}\r\n\r\nbool CalendarPanel::OnKey(WPARAM key) {\r\n    // Escape goes back from the agendas to the month.\r\n    if (m_agendasView) {\r\n        if (key != VK_ESCAPE) {\r\n            return false;\r\n        }\r\n        m_agendasView = false;\r\n        m_agendaStatusText.clear();\r\n        Layout();\r\n        StartIslandAnimation();\r\n        return true;\r\n    }\r\n    if (m_adding) {\r\n        // Escape leaves the event; the arrows change the hour or the minute.\r\n        if (key == VK_ESCAPE) {\r\n            StopEditing();\r\n            return true;\r\n        }\r\n        if ((key == VK_UP || key == VK_DOWN) && m_focus != Field::Title) {\r\n            StepTime(m_focus == Field::Hour ? Part::Hour : Part::Minute,\r\n                     key == VK_UP ? 1 : -1);\r\n            return true;\r\n        }\r\n        return false;\r\n    }\r\n    if (key == VK_LEFT || key == VK_PRIOR) {\r\n        ChangeMonth(-1);\r\n        return true;\r\n    }\r\n    if (key == VK_RIGHT || key == VK_NEXT) {\r\n        ChangeMonth(1);\r\n        return true;\r\n    }\r\n    return false;\r\n}\r\n\r\n// Typing the event's title, or its time; Tab goes to the next field, Enter\r\n// adds it. In the agendas' view, a link or a path.\r\nbool CalendarPanel::OnChar(WCHAR c) {\r\n    if (m_agendasView) {\r\n        std::wstring& text = m_newLink;\r\n        if (c == L'\\r') {\r\n            AddAgenda();\r\n            return true;\r\n        }\r\n        if (c == L'\\b') {\r\n            if (!text.empty()) {\r\n                text.pop_back();\r\n            }\r\n        } else if (c == 0x16) {\r\n            PasteText(m_hwnd, &text, kMaxAgendaSource);\r\n        } else if (c >= 0x20 && text.size() < kMaxAgendaSource) {\r\n            text += c;\r\n        } else {\r\n            return false;\r\n        }\r\n        if (!m_agendaStatusText.empty()) {\r\n            m_agendaStatusText.clear();\r\n            Layout();\r\n        }\r\n        return true;\r\n    }\r\n    if (!m_adding) {\r\n        return false;\r\n    }\r\n    if (c == L'\\t') {\r\n        const bool back = GetKeyState(VK_SHIFT) < 0;\r\n        m_focus = m_focus == Field::Title  ? (back ? Field::Minute : Field::Hour)\r\n                  : m_focus == Field::Hour ? (back ? Field::Title : Field::Minute)\r\n                                           : (back ? Field::Hour : Field::Title);\r\n        m_digits = 0;\r\n        return true;\r\n    }\r\n    if (m_focus != Field::Title && c != L'\\r') {\r\n        if (c >= L'0' && c <= L'9') {\r\n            TypeDigit(c - L'0');\r\n        } else if (c == L'\\b') {\r\n            // Back to the hour from an empty minute.\r\n            if (m_focus == Field::Minute && m_digits == 0 && m_newMinute == 0) {\r\n                m_focus = Field::Hour;\r\n            } else if (m_focus == Field::Hour) {\r\n                m_newHour /= 10;\r\n            } else {\r\n                m_newMinute /= 10;\r\n            }\r\n            m_digits = 0;\r\n        } else if (c == L':' || c == L'h' || c == L'H') {\r\n            m_focus = Field::Minute;\r\n            m_digits = 0;\r\n        } else {\r\n            return false;\r\n        }\r\n        return true;\r\n    }\r\n    std::wstring& text = m_newTitle;\r\n    if (c == L'\\r') {\r\n        SaveNewEvent();\r\n    } else if (c == L'\\b') {\r\n        if (!text.empty()) {\r\n            text.pop_back();\r\n        }\r\n    } else if (c == 0x16) {\r\n        PasteText(m_hwnd, &text, 120);\r\n    } else if (c >= 0x20 && text.size() < 120) {\r\n        text += c;\r\n    } else {\r\n        return false;\r\n    }\r\n    m_statusText.clear();\r\n    Layout();\r\n    return true;\r\n}\r\n\r\n////////////////////////////////////////////////////////////////////////////////\r\n// The control center, like on macOS: tiles for the network, Bluetooth, \"Do\r\n// not disturb\" and the settings, the volume as a big slider, and the battery.\r\n// The sound has two more screens, like the Windows quick settings: the output\r\n// device, and the volume of each app.\r\n\r\n// Windows' own interface for the default audio device. It isn't documented,\r\n// but it has been stable since Windows 7, and the volume tools use it.\r\nstruct IPolicyConfig : public IUnknown {\r\n    virtual HRESULT STDMETHODCALLTYPE GetMixFormat(PCWSTR, void**) = 0;\r\n    virtual HRESULT STDMETHODCALLTYPE GetDeviceFormat(PCWSTR, INT, void**) = 0;\r\n    virtual HRESULT STDMETHODCALLTYPE ResetDeviceFormat(PCWSTR) = 0;\r\n    virtual HRESULT STDMETHODCALLTYPE SetDeviceFormat(PCWSTR, void*, void*) = 0;\r\n    virtual HRESULT STDMETHODCALLTYPE GetProcessingPeriod(PCWSTR, INT, PINT64,\r\n                                                          PINT64) = 0;\r\n    virtual HRESULT STDMETHODCALLTYPE SetProcessingPeriod(PCWSTR, PINT64) = 0;\r\n    virtual HRESULT STDMETHODCALLTYPE GetShareMode(PCWSTR, void*) = 0;\r\n    virtual HRESULT STDMETHODCALLTYPE SetShareMode(PCWSTR, void*) = 0;\r\n    virtual HRESULT STDMETHODCALLTYPE GetPropertyValue(PCWSTR,\r\n                                                       const PROPERTYKEY&,\r\n                                                       PROPVARIANT*) = 0;\r\n    virtual HRESULT STDMETHODCALLTYPE SetPropertyValue(PCWSTR,\r\n                                                       const PROPERTYKEY&,\r\n                                                       PROPVARIANT*) = 0;\r\n    virtual HRESULT STDMETHODCALLTYPE SetDefaultEndpoint(PCWSTR deviceId,\r\n                                                         ERole role) = 0;\r\n    virtual HRESULT STDMETHODCALLTYPE SetEndpointVisibility(PCWSTR, INT) = 0;\r\n};\r\n\r\nconstexpr GUID kCLSID_PolicyConfig = {\r\n    0x870af99c,\r\n    0x171d,\r\n    0x4f9e,\r\n    {0xaf, 0x0d, 0xe6, 0x3d, 0xf4, 0x0c, 0x2b, 0xc9}};\r\nconstexpr GUID kIID_IPolicyConfig = {\r\n    0xf8679f50,\r\n    0x850a,\r\n    0x41cf,\r\n    {0x9c, 0x72, 0x43, 0x0f, 0x29, 0x02, 0x90, 0xc8}};\r\nconstexpr GUID kIID_IAudioSessionManager2 = {\r\n    0x77aa99a0,\r\n    0x1bd6,\r\n    0x484f,\r\n    {0x8b, 0xc7, 0x2c, 0x65, 0x4c, 0x9a, 0x9b, 0x6f}};\r\nconstexpr PROPERTYKEY kPKEY_AudioEndpoint_FormFactor = {\r\n    {0x1da5d803,\r\n     0xd492,\r\n     0x4edd,\r\n     {0x8c, 0x23, 0xe0, 0xc0, 0xff, 0xee, 0x7f, 0x0e}},\r\n    0};\r\n\r\nconstexpr WCHAR kGlyphHeadphones = 0xE7F6;\r\nconstexpr WCHAR kGlyphSpeakers = 0xE7F5;\r\nconstexpr WCHAR kGlyphMonitor = 0xE7F4;\r\nconstexpr WCHAR kGlyphCheck = 0xE73E;\r\nconstexpr WCHAR kGlyphBack = 0xE72B;\r\n\r\nconstexpr WCHAR kGlyphLock = 0xE72E;\r\nconstexpr WCHAR kGlyphEdit = 0xE70F;\r\nconstexpr WCHAR kGlyphClose = 0xE711;\r\nconstexpr WCHAR kGlyphBrightness = 0xE706;\r\nconstexpr WCHAR kGlyphNightLight = 0xF08C;\r\nconstexpr WCHAR kGlyphProject = 0xEBC6;\r\nconstexpr WCHAR kGlyphHotspot = 0xE88A;\r\nconstexpr WCHAR kGlyphAirplane = 0xE709;\r\nconstexpr WCHAR kGlyphMagnifier = 0xE71E;\r\nconstexpr WCHAR kGlyphNarrator = 0xEBC5;\r\nconstexpr WCHAR kGlyphColorFilters = 0xE790;\r\nconstexpr WCHAR kGlyphShow = 0xE7B3;\r\nconstexpr WCHAR kGlyphHide = 0xED1A;\r\nconstexpr WCHAR kGlyphKeyboard = 0xE765;\r\nconstexpr WCHAR kGlyphMouse = 0xE962;\r\n\r\n// The controls the control center can show: big tiles (two per row), small\r\n// buttons (four per row) and full-width sections. Which ones, and their\r\n// order, are chosen in it (\"Edit\").\r\nenum class ControlId {\r\n    Network,\r\n    Bluetooth,\r\n    DoNotDisturb,\r\n    NightLight,\r\n    Hotspot,\r\n    Airplane,\r\n    Project,\r\n    Cast,\r\n    Captions,\r\n    Accessibility,\r\n    DarkMode,\r\n    Screenshot,\r\n    Lock,\r\n    Emoji,\r\n    Clipboard,\r\n    TaskManager,\r\n    Calculator,\r\n    Explorer,\r\n    Display,\r\n    Sound,\r\n    Battery,\r\n    PowerMode,\r\n    Microphone,\r\n    Notes,\r\n    Tasks,\r\n    Shortcuts,\r\n    Weather,\r\n    Updates,\r\n    Komorebi,\r\n    ShowDesktop,\r\n    OnScreenKeyboard,\r\n    // (Added in 3.1.)\r\n    TouchKeyboard,\r\n    WindowsSettings,\r\n    StartMenuKeys,\r\n    // The pill's items that open something, as buttons too (added in 2.1,\r\n    // not shown until added; see ControlItem).\r\n    Notifications,\r\n    Calendar,\r\n    Media,\r\n    Power,\r\n    Usage,\r\n    Profiles,\r\n    KeyboardLanguage,\r\n    Privacy,\r\n    Drives,\r\n    Desktops,\r\n    Folders,\r\n    Wallpaper,\r\n    KomorebiLayout,\r\n    WorldClocks,\r\n    NextEvent,\r\n    RecycleBin,\r\n    Timer,\r\n    TrayIcons,\r\n    // The timer panel's other tabs, like the iPhone's Control Center's\r\n    // (added in 2.1 too, not shown until added).\r\n    Stopwatch,\r\n    Pomodoro,\r\n    Alarms,\r\n};\r\n\r\nenum class ControlKind { Tile, Button, Section };\r\n\r\nstruct ControlInfo {\r\n    ControlId id;\r\n    ControlKind kind;\r\n    WCHAR glyph;\r\n    PCWSTR english;\r\n    PCWSTR portuguese;\r\n    // Remembered by this name.\r\n    PCWSTR key;\r\n    bool shownByDefault;\r\n};\r\n\r\nconst ControlInfo kControls[] = {\r\n    {ControlId::Network, ControlKind::Tile, 0xE701, L\"Wi-Fi / network\",\r\n     L\"Wi-Fi / rede\", L\"network\", true},\r\n    {ControlId::Bluetooth, ControlKind::Tile, 0xE702, L\"Bluetooth\",\r\n     L\"Bluetooth\", L\"bluetooth\", true},\r\n    {ControlId::DoNotDisturb, ControlKind::Tile, 0xE708, L\"Do not disturb\",\r\n     L\"Não incomodar\", L\"dnd\", true},\r\n    {ControlId::NightLight, ControlKind::Tile, 0xF08C, L\"Night light\",\r\n     L\"Luz noturna\", L\"nightLight\", true},\r\n    {ControlId::Hotspot, ControlKind::Tile, 0xE88A, L\"Mobile hotspot\",\r\n     L\"Hotspot móvel\", L\"hotspot\", false},\r\n    {ControlId::Airplane, ControlKind::Tile, 0xE709, L\"Airplane mode\",\r\n     L\"Modo avião\", L\"airplane\", false},\r\n    {ControlId::Project, ControlKind::Button, 0xEBC6, L\"Project\", L\"Projetar\",\r\n     L\"project\", true},\r\n    {ControlId::Cast, ControlKind::Button, 0xEC15, L\"Cast\", L\"Transmitir\",\r\n     L\"cast\", true},\r\n    {ControlId::Captions, ControlKind::Button, 0xE7F0, L\"Captions\",\r\n     L\"Legendas\", L\"captions\", true},\r\n    {ControlId::Accessibility, ControlKind::Button, 0xE776, L\"Accessibility\",\r\n     L\"Acessibilidade\", L\"accessibility\", true},\r\n    {ControlId::DarkMode, ControlKind::Button, 0xE793, L\"Dark mode\",\r\n     L\"Modo escuro\", L\"darkMode\", false},\r\n    {ControlId::Screenshot, ControlKind::Button, 0xE722, L\"Screenshot\",\r\n     L\"Captura de tela\", L\"screenshot\", false},\r\n    {ControlId::Lock, ControlKind::Button, 0xE72E, L\"Lock\", L\"Bloquear\",\r\n     L\"lock\", false},\r\n    {ControlId::Emoji, ControlKind::Button, 0xE76E, L\"Emoji\", L\"Emojis\",\r\n     L\"emoji\", false},\r\n    {ControlId::Clipboard, ControlKind::Button, 0xF0E3, L\"Clipboard\",\r\n     L\"Área de transferência\", L\"clipboard\", false},\r\n    {ControlId::TaskManager, ControlKind::Button, 0xE9D9, L\"Task Manager\",\r\n     L\"Gerenciador de Tarefas\", L\"taskManager\", false},\r\n    {ControlId::Calculator, ControlKind::Button, 0xE8EF, L\"Calculator\",\r\n     L\"Calculadora\", L\"calculator\", false},\r\n    {ControlId::Explorer, ControlKind::Button, 0xEC50, L\"File Explorer\",\r\n     L\"Explorador de Arquivos\", L\"explorer\", false},\r\n    {ControlId::ShowDesktop, ControlKind::Button, 0xE7F4, L\"Show desktop\",\r\n     L\"Mostrar área de trabalho\", L\"showDesktop\", false},\r\n    {ControlId::OnScreenKeyboard, ControlKind::Button, 0xE765,\r\n     L\"On-screen keyboard\", L\"Teclado virtual\", L\"onScreenKeyboard\", false},\r\n    {ControlId::TouchKeyboard, ControlKind::Button, 0xEDA4, L\"Touch keyboard\",\r\n     L\"Teclado touch\", L\"touchKeyboard\", false},\r\n    {ControlId::WindowsSettings, ControlKind::Button, 0xE713,\r\n     L\"Windows Settings\", L\"Configurações do Windows\", L\"windowsSettings\",\r\n     false},\r\n    {ControlId::StartMenuKeys, ControlKind::Button, 0xE8FD, L\"Win+X menu\",\r\n     L\"Menu Win+X\", L\"winXMenu\", false},\r\n    {ControlId::Microphone, ControlKind::Button, 0xE720, L\"Microphone\",\r\n     L\"Microfone\", L\"microphone\", false},\r\n    {ControlId::Notes, ControlKind::Button, 0xE70B, L\"Notes\", L\"Anotações\",\r\n     L\"notes\", false},\r\n    {ControlId::Tasks, ControlKind::Button, 0xE9D5, L\"Tasks\", L\"Tarefas\",\r\n     L\"tasks\", false},\r\n    {ControlId::Shortcuts, ControlKind::Button, 0xE765, L\"Shortcuts\",\r\n     L\"Atalhos\", L\"shortcuts\", false},\r\n    {ControlId::Weather, ControlKind::Button, 0xE753, L\"Weather\", L\"Clima\",\r\n     L\"weather\", false},\r\n    {ControlId::Updates, ControlKind::Button, 0xE895, L\"Updates\",\r\n     L\"Atualizações\", L\"updates\", false},\r\n    {ControlId::Notifications, ControlKind::Button, 0xEA8F, L\"Notifications\",\r\n     L\"Notificações\", L\"notifications\", false},\r\n    {ControlId::Calendar, ControlKind::Button, 0xE787, L\"Calendar\",\r\n     L\"Calendário\", L\"calendar\", false},\r\n    {ControlId::Media, ControlKind::Button, 0xE8D6, L\"What's playing\",\r\n     L\"O que está tocando\", L\"media\", false},\r\n    {ControlId::Power, ControlKind::Button, 0xE7E8, L\"Power button\",\r\n     L\"Botão de desligar\", L\"power\", false},\r\n    {ControlId::Usage, ControlKind::Button, 0xE9D9, L\"CPU, RAM and VRAM use\",\r\n     L\"Uso de CPU, RAM e VRAM\", L\"usage\", false},\r\n    {ControlId::Profiles, ControlKind::Button, 0xE748, L\"Profiles\", L\"Perfis\",\r\n     L\"profiles\", false},\r\n    {ControlId::KeyboardLanguage, ControlKind::Button, 0xE774,\r\n     L\"Keyboard language\", L\"Idioma do teclado\", L\"keyboardLanguage\", false},\r\n    {ControlId::Privacy, ControlKind::Button, 0xEA18, L\"Privacy\",\r\n     L\"Privacidade\", L\"privacy\", false},\r\n    {ControlId::Drives, ControlKind::Button, 0xE88E, L\"USB drives\",\r\n     L\"Pendrives\", L\"drives\", false},\r\n    {ControlId::Desktops, ControlKind::Button, 0xE7C4, L\"Virtual desktops\",\r\n     L\"Áreas de trabalho virtuais\", L\"desktops\", false},\r\n    {ControlId::Folders, ControlKind::Button, 0xE8B7, L\"Folders and places\",\r\n     L\"Pastas e locais\", L\"folders\", false},\r\n    {ControlId::Wallpaper, ControlKind::Button, 0xE8B9, L\"Wallpaper\",\r\n     L\"Papel de parede\", L\"wallpaper\", false},\r\n    {ControlId::KomorebiLayout, ControlKind::Button, kGlyphKomorebiLayout,\r\n     L\"komorebi's layout\", L\"Layout do komorebi\", L\"komorebiLayout\", false},\r\n    {ControlId::WorldClocks, ControlKind::Button, 0xE909, L\"World clocks\",\r\n     L\"Relógios mundiais\", L\"worldClocks\", false},\r\n    {ControlId::NextEvent, ControlKind::Button, 0xE916, L\"Next event\",\r\n     L\"Próximo evento\", L\"nextEvent\", false},\r\n    {ControlId::RecycleBin, ControlKind::Button, 0xE74D, L\"Recycle Bin\",\r\n     L\"Lixeira\", L\"recycleBin\", false},\r\n    {ControlId::Timer, ControlKind::Button, 0xE916, L\"Timer\", L\"Timer\",\r\n     L\"timer\", false},\r\n    {ControlId::TrayIcons, ControlKind::Button, 0xE712,\r\n     L\"Other apps' tray icons\", L\"Ícones dos outros apps\", L\"trayIcons\",\r\n     false},\r\n    {ControlId::Stopwatch, ControlKind::Button, 0xE916, L\"Stopwatch\",\r\n     L\"Cronômetro\", L\"stopwatch\", false},\r\n    {ControlId::Pomodoro, ControlKind::Button, 0xE916, L\"Pomodoro\",\r\n     L\"Pomodoro\", L\"pomodoro\", false},\r\n    {ControlId::Alarms, ControlKind::Button, 0xE823, L\"Alarms\", L\"Alarmes\",\r\n     L\"alarms\", false},\r\n    {ControlId::Display, ControlKind::Section, 0xE706, L\"Display brightness\",\r\n     L\"Brilho da tela\", L\"display\", true},\r\n    {ControlId::Sound, ControlKind::Section, 0xE767, L\"Sound\", L\"Som\",\r\n     L\"sound\", true},\r\n    {ControlId::Battery, ControlKind::Section, 0xE83F, L\"Battery\",\r\n     L\"Bateria\", L\"battery\", true},\r\n    {ControlId::PowerMode, ControlKind::Section, 0xEC48, L\"Power\",\r\n     L\"Energia\", L\"powermode\", true},\r\n    {ControlId::Komorebi, ControlKind::Section, kGlyphKomorebi, L\"komorebi\",\r\n     L\"komorebi\", L\"komorebi\", false},\r\n};\r\n\r\n// komorebi (a tiling window manager, when installed): its control center\r\n// section and its button on the pill start, stop or reload it, like yasb's\r\n// control, with its own command line tool, only on a click: without a\r\n// window (like yasb and the Windows 11 Start Menu Buttons mod), and again\r\n// in a terminal on the screen when it fails, to show why. Nothing is\r\n// installed or accepted for the user, and the mod never ends komorebi by\r\n// itself.\r\n\r\n// The user's environment as Windows has it now, not this process's (from\r\n// when it started: its PATH lacks what was installed since, like komorebi\r\n// and whkd installed with Windhawk running). Freed with\r\n// DestroyEnvironmentBlock; null if it can't be made.\r\nvoid* FreshEnvironment() {\r\n    HANDLE token = nullptr;\r\n    void* block = nullptr;\r\n    if (OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY | TOKEN_DUPLICATE,\r\n                         &token)) {\r\n        if (!CreateEnvironmentBlock(&block, token, FALSE)) {\r\n            block = nullptr;\r\n        }\r\n        CloseHandle(token);\r\n    }\r\n    return block;\r\n}\r\n\r\n// That environment's PATH (empty if it can't be read).\r\nstd::wstring FreshPath() {\r\n    std::wstring path;\r\n    if (void* block = FreshEnvironment()) {\r\n        for (auto entry = (PCWSTR)block; *entry; entry += wcslen(entry) + 1) {\r\n            if (_wcsnicmp(entry, L\"Path=\", 5) == 0) {\r\n                path = entry + 5;\r\n                break;\r\n            }\r\n        }\r\n        DestroyEnvironmentBlock(block);\r\n    }\r\n    return path;\r\n}\r\n\r\n// A tool of komorebi's (komorebic.exe, whkd.exe), on PATH or where its\r\n// installer (`folder` under Program Files) or scoop put it; empty if it\r\n// isn't installed.\r\nstd::wstring FindKomorebiTool(PCWSTR file, PCWSTR folder) {\r\n    WCHAR path[MAX_PATH];\r\n    const std::wstring fresh = FreshPath();\r\n    const DWORD found = SearchPath(fresh.empty() ? nullptr : fresh.c_str(),\r\n                                   file, nullptr, MAX_PATH, path, nullptr);\r\n    if (found > 0 && found < MAX_PATH) {\r\n        return path;\r\n    }\r\n    // (%ProgramW6432%: the island's process is 32-bit.)\r\n    for (const std::wstring& place :\r\n         {L\"%ProgramW6432%\\\\\" + std::wstring(folder) + L\"\\\\bin\\\\\" + file,\r\n          L\"%USERPROFILE%\\\\scoop\\\\shims\\\\\" + std::wstring(file)}) {\r\n        if (ExpandEnvironmentStrings(place.c_str(), path, MAX_PATH) &&\r\n            GetFileAttributes(path) != INVALID_FILE_ATTRIBUTES) {\r\n            return path;\r\n        }\r\n    }\r\n    return {};\r\n}\r\n\r\nstd::wstring FindKomorebic() {\r\n    return FindKomorebiTool(L\"komorebic.exe\", L\"komorebi\");\r\n}\r\n\r\n// Whether komorebi and whkd are installed, for the settings (-1 until\r\n// looked for, see LookForKomorebi).\r\nint g_komorebiFound = -1;\r\nint g_whkdFound = -1;\r\n\r\nvoid LookForKomorebi() {\r\n    g_komorebiFound = !FindKomorebic().empty();\r\n    g_whkdFound = !FindKomorebiTool(L\"whkd.exe\", L\"whkd\").empty();\r\n}\r\n\r\n// A program's process in this session (its file's name), or 0 if it doesn't\r\n// run.\r\nDWORD SessionProcessId(PCWSTR exe) {\r\n    DWORD session = 0;\r\n    ProcessIdToSessionId(GetCurrentProcessId(), &session);\r\n    HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);\r\n    if (snapshot == INVALID_HANDLE_VALUE) {\r\n        return 0;\r\n    }\r\n    DWORD found = 0;\r\n    PROCESSENTRY32 entry{};\r\n    entry.dwSize = sizeof(entry);\r\n    for (BOOL more = Process32First(snapshot, &entry); more && !found;\r\n         more = Process32Next(snapshot, &entry)) {\r\n        DWORD its = 0;\r\n        if (_wcsicmp(entry.szExeFile, exe) == 0 &&\r\n            ProcessIdToSessionId(entry.th32ProcessID, &its) &&\r\n            its == session) {\r\n            found = entry.th32ProcessID;\r\n        }\r\n    }\r\n    CloseHandle(snapshot);\r\n    return found;\r\n}\r\n\r\n// komorebi's process in this session, or 0 if it doesn't run.\r\nDWORD KomorebiProcessId() {\r\n    return SessionProcessId(L\"komorebi.exe\");\r\n}\r\n\r\nbool KomorebiRunning() {\r\n    return KomorebiProcessId() != 0;\r\n}\r\n\r\n// Its version: from komorebi.exe beside its tool (scoop's shim says where\r\n// that is), or from its installer's entry in Windows' apps; empty if\r\n// neither says.\r\nstd::wstring KomorebiVersion(std::wstring komorebic) {\r\n    if (komorebic.ends_with(L\"\\\\shims\\\\komorebic.exe\")) {\r\n        const std::wstring shim =\r\n            komorebic.substr(0, komorebic.size() - 3) + L\"shim\";\r\n        if (FILE* file = _wfopen(shim.c_str(), L\"rt, ccs=UTF-8\")) {\r\n            WCHAR line[MAX_PATH + 16];\r\n            while (fgetws(line, ARRAYSIZE(line), file)) {\r\n                std::wstring text = line;\r\n                if (text.starts_with(L\"path = \")) {\r\n                    text = text.substr(7);\r\n                    std::erase(text, L'\"');\r\n                    std::erase(text, L'\\n');\r\n                    komorebic = text;\r\n                    break;\r\n                }\r\n            }\r\n            fclose(file);\r\n        }\r\n    }\r\n    const std::wstring exe =\r\n        komorebic.substr(0, komorebic.find_last_of(L'\\\\') + 1) +\r\n        L\"komorebi.exe\";\r\n    DWORD handle = 0;\r\n    if (const DWORD size = GetFileVersionInfoSize(exe.c_str(), &handle)) {\r\n        std::vector<BYTE> data(size);\r\n        VS_FIXEDFILEINFO* info = nullptr;\r\n        UINT length = 0;\r\n        if (GetFileVersionInfo(exe.c_str(), 0, size, data.data()) &&\r\n            VerQueryValue(data.data(), L\"\\\\\", (void**)&info, &length) &&\r\n            info && length >= sizeof(*info) && info->dwFileVersionMS) {\r\n            return std::to_wstring(HIWORD(info->dwFileVersionMS)) + L\".\" +\r\n                   std::to_wstring(LOWORD(info->dwFileVersionMS)) + L\".\" +\r\n                   std::to_wstring(HIWORD(info->dwFileVersionLS));\r\n        }\r\n    }\r\n    for (HKEY root : {HKEY_LOCAL_MACHINE, HKEY_CURRENT_USER}) {\r\n        HKEY apps = nullptr;\r\n        if (RegOpenKeyEx(root,\r\n                         L\"SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\\"\r\n                         L\"Uninstall\",\r\n                         0, KEY_READ | KEY_WOW64_64KEY,\r\n                         &apps) != ERROR_SUCCESS) {\r\n            continue;\r\n        }\r\n        std::wstring version;\r\n        WCHAR name[256];\r\n        for (DWORD i = 0; version.empty(); i++) {\r\n            DWORD nameLength = ARRAYSIZE(name);\r\n            if (RegEnumKeyEx(apps, i, name, &nameLength, nullptr, nullptr,\r\n                             nullptr, nullptr) != ERROR_SUCCESS) {\r\n                break;\r\n            }\r\n            WCHAR display[64] = L\"\";\r\n            DWORD displaySize = sizeof(display);\r\n            if (RegGetValue(apps, name, L\"DisplayName\", RRF_RT_REG_SZ, nullptr,\r\n                            display, &displaySize) != ERROR_SUCCESS ||\r\n                _wcsicmp(display, L\"komorebi\") != 0) {\r\n                continue;\r\n            }\r\n            WCHAR value[64] = L\"\";\r\n            DWORD valueSize = sizeof(value);\r\n            if (RegGetValue(apps, name, L\"DisplayVersion\", RRF_RT_REG_SZ,\r\n                            nullptr, value, &valueSize) == ERROR_SUCCESS) {\r\n                version = value;\r\n            }\r\n        }\r\n        RegCloseKey(apps);\r\n        if (!version.empty()) {\r\n            return version;\r\n        }\r\n    }\r\n    return {};\r\n}\r\n\r\n// The commands for a button (0 start, 1 stop, 2 reload), with what it\r\n// takes along (whkd, masir).\r\nstd::wstring KomorebiCommands(const std::wstring& komorebic, int button) {\r\n    std::wstring flags;\r\n    if (g_settings.komorebiWhkd) {\r\n        flags += L\" --whkd\";\r\n    }\r\n    if (g_settings.komorebiMasir) {\r\n        flags += L\" --masir\";\r\n    }\r\n    const std::wstring tool = L\"\\\"\" + komorebic + L\"\\\"\";\r\n    const std::wstring start = tool + L\" start\" + flags;\r\n    const std::wstring stop = tool + L\" stop\" + flags;\r\n    return button == 0 ? start : button == 1 ? stop : stop + L\" && \" + start;\r\n}\r\n\r\n// Whether this is the 32-bit Windhawk process on 64-bit Windows: it sees\r\n// SysWOW64 as System32, Program Files (x86) as %ProgramFiles% and the\r\n// registry's 32-bit view.\r\nbool IsWow64() {\r\n    static const bool wow64 = [] {\r\n        BOOL wow64 = FALSE;\r\n        return IsWow64Process(GetCurrentProcess(), &wow64) && wow64;\r\n    }();\r\n    return wow64;\r\n}\r\n\r\n// A path the user gave with its environment variables, as a 64-bit program\r\n// sees it: the 64-bit Program Files, and a file in System32 through\r\n// Sysnative (the 32-bit process's way to the real one; a folder stays as it\r\n// is: the 64-bit Explorer that shows it doesn't know that name). Empty if it\r\n// can't be expanded.\r\nstd::wstring ExpandedAsNative(std::wstring text) {\r\n    WCHAR windows[MAX_PATH];\r\n    const bool wow64 = IsWow64() && GetWindowsDirectory(windows, MAX_PATH);\r\n    if (wow64) {\r\n        for (const auto& [from, to] :\r\n             {std::pair<std::wstring_view, std::wstring_view>{\r\n                  L\"%programfiles%\", L\"%ProgramW6432%\"},\r\n              {L\"%commonprogramfiles%\", L\"%CommonProgramW6432%\"}}) {\r\n            for (size_t at = 0;\r\n                 (at = std::wstring_view(text).find(L'%', at)) !=\r\n                 std::wstring::npos;\r\n                 at++) {\r\n                if (_wcsnicmp(text.c_str() + at, from.data(), from.size()) ==\r\n                    0) {\r\n                    text.replace(at, from.size(), to);\r\n                    at += to.size() - 1;\r\n                }\r\n            }\r\n        }\r\n    }\r\n    const DWORD size = ExpandEnvironmentStrings(text.c_str(), nullptr, 0);\r\n    std::wstring expanded(size, L'\\0');\r\n    if (!size || ExpandEnvironmentStrings(text.c_str(), expanded.data(),\r\n                                          size) != size) {\r\n        return {};\r\n    }\r\n    expanded.resize(size - 1);\r\n    if (wow64) {\r\n        const std::wstring system = std::wstring(windows) + L\"\\\\System32\";\r\n        if (_wcsnicmp(expanded.c_str(), system.c_str(), system.size()) == 0 &&\r\n            (expanded.size() == system.size() ||\r\n             expanded[system.size()] == L'\\\\')) {\r\n            const std::wstring native = std::wstring(windows) +\r\n                                        L\"\\\\Sysnative\" +\r\n                                        expanded.substr(system.size());\r\n            const DWORD attributes = GetFileAttributes(native.c_str());\r\n            if (attributes != INVALID_FILE_ATTRIBUTES &&\r\n                !(attributes & FILE_ATTRIBUTE_DIRECTORY)) {\r\n                expanded = native;\r\n            }\r\n        }\r\n    }\r\n    return expanded;\r\n}\r\n\r\n// Runs a cmd line (what follows \"cmd /c\"), with the user's current\r\n// environment (komorebic looks for whkd and masir on PATH): without a\r\n// window, or in its own console window on the screen. It inherits nothing.\r\n// `process` (if given) gets its handles. The 64-bit cmd.exe, also from the\r\n// 32-bit Windhawk process: the 64-bit System32's tools found (wsl,\r\n// pnputil).\r\nbool StartKomorebiCommand(const std::wstring& line,\r\n                          bool onScreen,\r\n                          PROCESS_INFORMATION* process) {\r\n    WCHAR cmd[MAX_PATH];\r\n    const UINT length = GetWindowsDirectory(cmd, MAX_PATH);\r\n    if (!length || length + 21 > MAX_PATH) {\r\n        return false;\r\n    }\r\n    wcscat_s(cmd,\r\n             IsWow64() ? L\"\\\\Sysnative\\\\cmd.exe\" : L\"\\\\System32\\\\cmd.exe\");\r\n    std::wstring command = L\"cmd.exe /c \\\"\" + line + L\"\\\"\";\r\n    void* environment = FreshEnvironment();\r\n    STARTUPINFO startup{};\r\n    startup.cb = sizeof(startup);\r\n    startup.dwFlags = STARTF_USESHOWWINDOW;\r\n    startup.wShowWindow = onScreen ? SW_SHOWNORMAL : SW_HIDE;\r\n    PROCESS_INFORMATION started{};\r\n    const bool ok =\r\n        CreateProcess(cmd, command.data(), nullptr, nullptr, FALSE,\r\n                      (onScreen ? CREATE_NEW_CONSOLE : CREATE_NO_WINDOW) |\r\n                          (environment ? CREATE_UNICODE_ENVIRONMENT : 0),\r\n                      environment, nullptr, &startup, &started);\r\n    if (environment) {\r\n        DestroyEnvironmentBlock(environment);\r\n    }\r\n    if (!ok) {\r\n        IslandLog(L\"komorebi's command didn't start: %u\", GetLastError());\r\n        return false;\r\n    }\r\n    if (process) {\r\n        *process = started;\r\n    } else {\r\n        CloseHandle(started.hThread);\r\n        CloseHandle(started.hProcess);\r\n    }\r\n    return true;\r\n}\r\n\r\n// A button's commands, on a thread of their own (which owns this, and its\r\n// own copy of the stop event). What they print goes to a file in the mod's\r\n// storage folder (not a pipe: komorebi, started by them, may keep their\r\n// output open, and a pipe closed on it could fail its writes), shown in a\r\n// terminal only if they fail (they're never run a second time: a reload\r\n// would stop komorebi again), and deleted, or at the next run if still open.\r\nstruct KomorebiJob {\r\n    std::wstring commands;\r\n    int button;\r\n    HWND notify;\r\n    HANDLE stop;\r\n};\r\n\r\n// Tells the panel how it went (wParam the button, lParam 1 if it failed).\r\nconstexpr UINT WM_APP_KOMOREBI_DONE = WM_APP + 85;\r\n\r\n// How long a command may take (komorebi starting takes a few seconds).\r\nconstexpr DWORD kKomorebiCommandMs = 60000;\r\n\r\nDWORD WINAPI KomorebiThreadProc(LPVOID parameter) {\r\n    std::unique_ptr<KomorebiJob> job((KomorebiJob*)parameter);\r\n    WCHAR folder[MAX_PATH];\r\n    WCHAR output[MAX_PATH] = L\"\";\r\n    if (Wh_GetModStoragePath(folder, ARRAYSIZE(folder))) {\r\n        CreateDirectory(folder, nullptr);\r\n        // (Ones left by a command still running at an earlier wait's end.)\r\n        WIN32_FIND_DATA data;\r\n        const std::wstring base = std::wstring(folder) + L\"\\\\\";\r\n        HANDLE find = FindFirstFile((base + L\"kmb*.tmp\").c_str(), &data);\r\n        if (find != INVALID_HANDLE_VALUE) {\r\n            do {\r\n                DeleteFile((base + data.cFileName).c_str());\r\n            } while (FindNextFile(find, &data));\r\n            FindClose(find);\r\n        }\r\n        if (!GetTempFileName(folder, L\"kmb\", 0, output)) {\r\n            output[0] = L'\\0';\r\n        }\r\n    }\r\n    PROCESS_INFORMATION process{};\r\n    bool started = false;\r\n    bool ended = false;\r\n    DWORD exitCode = 0;\r\n    if (output[0] &&\r\n        StartKomorebiCommand(L\"(\" + job->commands + L\") > \\\"\" + output +\r\n                                 L\"\\\" 2>&1\",\r\n                             false, &process)) {\r\n        started = true;\r\n        const HANDLE waits[] = {process.hProcess, job->stop};\r\n        ended = WaitForMultipleObjects(ARRAYSIZE(waits), waits, FALSE,\r\n                                       kKomorebiCommandMs) == WAIT_OBJECT_0 &&\r\n                GetExitCodeProcess(process.hProcess, &exitCode);\r\n        CloseHandle(process.hThread);\r\n        CloseHandle(process.hProcess);\r\n    }\r\n    const bool stopping = WaitForSingleObject(job->stop, 0) == WAIT_OBJECT_0;\r\n    const bool failed = !started || !ended || exitCode != 0;\r\n    if (!stopping && !started) {\r\n        // (Nothing ran: it runs once, on the screen, where it waits for a\r\n        // key if it fails.)\r\n        StartKomorebiCommand(job->commands + L\" || pause\", true, nullptr);\r\n    } else if (!stopping && ended && exitCode != 0) {\r\n        // What it printed, in a terminal on the screen (which deletes it).\r\n        const std::wstring file = L\"\\\"\" + std::wstring(output) + L\"\\\"\";\r\n        if (!StartKomorebiCommand(\r\n                L\"type \" + file + L\" & del \" + file + L\" & pause\", true,\r\n                nullptr)) {\r\n            DeleteFile(output);\r\n        }\r\n    } else if (output[0]) {\r\n        // (One still running at the wait's end keeps its file open.)\r\n        DeleteFile(output);\r\n    }\r\n    if (!stopping && job->notify) {\r\n        PostMessage(job->notify, WM_APP_KOMOREBI_DONE, job->button, failed);\r\n    }\r\n    CloseHandle(job->stop);\r\n    return 0;\r\n}\r\n\r\n// A job's commands on a thread of their own, which gets its own copy of the\r\n// stop event (`*stop` is the caller's, `*thread` the thread); false if it\r\n// couldn't start.\r\nbool StartKomorebiJob(const std::wstring& commands,\r\n                      int button,\r\n                      HWND notify,\r\n                      HANDLE* thread,\r\n                      HANDLE* stop) {\r\n    HANDLE event = CreateEvent(nullptr, TRUE, FALSE, nullptr);\r\n    HANDLE copy = nullptr;\r\n    if (!event || !DuplicateHandle(GetCurrentProcess(), event,\r\n                                   GetCurrentProcess(), &copy, 0, FALSE,\r\n                                   DUPLICATE_SAME_ACCESS)) {\r\n        if (event) {\r\n            CloseHandle(event);\r\n        }\r\n        return false;\r\n    }\r\n    auto* job = new KomorebiJob{commands, button, notify, copy};\r\n    *thread = CreateThread(nullptr, 0, KomorebiThreadProc, job, 0, nullptr);\r\n    if (!*thread) {\r\n        CloseHandle(copy);\r\n        CloseHandle(event);\r\n        delete job;\r\n        return false;\r\n    }\r\n    *stop = event;\r\n    return true;\r\n}\r\n\r\n// Its thread told to stop and waited for (a while: it owns its job, so it\r\n// can be left to end by itself). The command itself goes on.\r\nvoid EndKomorebiJob(HANDLE* thread, HANDLE* stop) {\r\n    if (*stop) {\r\n        SetEvent(*stop);\r\n    }\r\n    if (*thread) {\r\n        WaitForSingleObject(*thread, 5000);\r\n        CloseHandle(*thread);\r\n        *thread = nullptr;\r\n    }\r\n    if (*stop) {\r\n        CloseHandle(*stop);\r\n        *stop = nullptr;\r\n    }\r\n}\r\n\r\n// The last app window in front brought back there, when one of the island's\r\n// own windows is (defined further down).\r\nvoid FrontLastApp();\r\n\r\n// One of Windows' 64-bit tools (the magnifier and the on-screen keyboard,\r\n// which run with UI access; Task Manager) started through Explorer: the\r\n// 32-bit Windhawk process sees SysWOW64 as System32, which doesn't have\r\n// them, and Windows can't start them from the Sysnative path (a 64-bit\r\n// service starts them). False if Explorer couldn't be started (whether the\r\n// tool then started isn't known here, see StartMagnifier).\r\nbool StartWithUiAccess(PCWSTR program) {\r\n    WCHAR windows[MAX_PATH];\r\n    if (!GetWindowsDirectory(windows, ARRAYSIZE(windows))) {\r\n        return false;\r\n    }\r\n    const std::wstring explorer = std::wstring(windows) + L\"\\\\explorer.exe\";\r\n    // (Quoted: a Windows folder with a space in its path.)\r\n    const std::wstring path =\r\n        L\"\\\"\" + std::wstring(windows) + L\"\\\\System32\\\\\" + program + L\"\\\"\";\r\n    return (INT_PTR)ShellExecute(nullptr, L\"open\", explorer.c_str(),\r\n                                 path.c_str(), nullptr, SW_SHOWNORMAL) > 32;\r\n}\r\n\r\n// Task Manager, started itself (Ctrl+Shift+Esc pressed for it is dropped\r\n// with an elevated window in front, and mixes with keys held), or with\r\n// those keys.\r\nvoid OpenTaskManager() {\r\n    if (!StartWithUiAccess(L\"Taskmgr.exe\")) {\r\n        PressKeys({VK_CONTROL, VK_SHIFT, VK_ESCAPE});\r\n    }\r\n}\r\n\r\n// Windows' touch keyboard host (the one its taskbar button talks to).\r\nstruct ITipInvocation : public IUnknown {\r\n    virtual HRESULT STDMETHODCALLTYPE Toggle(HWND window) = 0;\r\n};\r\nconstexpr IID kIidTipInvocation = {\r\n    0x37c994e7,\r\n    0x432b,\r\n    0x4834,\r\n    {0xa2, 0xf7, 0xdc, 0xe1, 0xf1, 0x3b, 0x83, 0x4b}};\r\nconstexpr CLSID kClsidUiHostNoLaunch = {\r\n    0x4ce576fa,\r\n    0x83dc,\r\n    0x4f88,\r\n    {0x95, 0x1c, 0x9d, 0x07, 0x82, 0xb4, 0xe3, 0x76}};\r\n\r\nstd::wstring ExpandedPath(PCWSTR path);\r\n\r\n// Shows or hides the touch keyboard, like its taskbar button. When its host\r\n// isn't running, TabTip.exe starts it (and shows the keyboard).\r\nvoid ToggleTouchKeyboard() {\r\n    winrt::com_ptr<ITipInvocation> tip;\r\n    HRESULT hr = CoCreateInstance(kClsidUiHostNoLaunch, nullptr,\r\n                                  CLSCTX_INPROC_HANDLER | CLSCTX_LOCAL_SERVER,\r\n                                  kIidTipInvocation, tip.put_void());\r\n    if (SUCCEEDED(hr)) {\r\n        hr = tip->Toggle(GetDesktopWindow());\r\n    }\r\n    if (FAILED(hr)) {\r\n        IslandLog(L\"Touch keyboard: 0x%08X, starting TabTip.exe\", hr);\r\n        // (%CommonProgramW6432%: the 64-bit folder from the 32-bit build too.)\r\n        std::wstring path = ExpandedPath(\r\n            L\"%CommonProgramW6432%\\\\microsoft shared\\\\ink\\\\TabTip.exe\");\r\n        if (path.empty()) {\r\n            path = ExpandedPath(\r\n                L\"%CommonProgramFiles%\\\\microsoft shared\\\\ink\\\\TabTip.exe\");\r\n        }\r\n        if (!path.empty()) {\r\n            ShellExecute(nullptr, L\"open\", path.c_str(), nullptr, nullptr,\r\n                         SW_SHOWNORMAL);\r\n        }\r\n    }\r\n}\r\n\r\n// The controls that are a shortcut (from the control center or the pill).\r\nvoid RunControlShortcut(ControlId id) {\r\n    switch (id) {\r\n        case ControlId::Cast:\r\n            // Casting looks for wireless displays: the Windows panel.\r\n            PressKeys({VK_LWIN, 'K'});\r\n            break;\r\n        case ControlId::Captions:\r\n            // Live captions switch on and off with their shortcut.\r\n            PressKeys({VK_LWIN, VK_CONTROL, 'L'});\r\n            break;\r\n        case ControlId::Lock:\r\n            LockWorkStation();\r\n            break;\r\n        // Both open for the window in front and close as it loses the focus:\r\n        // from the control center (in front while it goes away), the app\r\n        // that was in front before it, first.\r\n        case ControlId::Emoji:\r\n            FrontLastApp();\r\n            PressKeys({VK_LWIN, VK_OEM_PERIOD});\r\n            break;\r\n        case ControlId::Clipboard:\r\n            FrontLastApp();\r\n            PressKeys({VK_LWIN, 'V'});\r\n            break;\r\n        case ControlId::TaskManager:\r\n            OpenTaskManager();\r\n            break;\r\n        case ControlId::Calculator:\r\n            ShellExecute(nullptr, L\"open\", L\"calc.exe\", nullptr, nullptr,\r\n                         SW_SHOWNORMAL);\r\n            break;\r\n        case ControlId::Explorer:\r\n            ShellExecute(nullptr, L\"open\", L\"explorer.exe\", nullptr, nullptr,\r\n                         SW_SHOWNORMAL);\r\n            break;\r\n        case ControlId::ShowDesktop:\r\n            // Windows' own (Win+D): pressed again, the windows come back.\r\n            PressKeys({VK_LWIN, 'D'});\r\n            break;\r\n        case ControlId::OnScreenKeyboard:\r\n            StartWithUiAccess(L\"osk.exe\");\r\n            break;\r\n        case ControlId::TouchKeyboard:\r\n            ToggleTouchKeyboard();\r\n            break;\r\n        case ControlId::WindowsSettings:\r\n            ShellExecute(nullptr, L\"open\", L\"ms-settings:\", nullptr, nullptr,\r\n                         SW_SHOWNORMAL);\r\n            break;\r\n        case ControlId::StartMenuKeys:\r\n            // (No API opens it: Windows shows it by the Start button.)\r\n            PressKeys({VK_LWIN, 'X'});\r\n            break;\r\n        default:\r\n            break;\r\n    }\r\n}\r\n\r\n// The pill's item a control center button opens like (see\r\n// Island::OpenFromControlCenter), or None for the control center's own.\r\nIslandItem ControlItem(ControlId id) {\r\n    switch (id) {\r\n        case ControlId::Notifications:\r\n            return IslandItem::Bell;\r\n        case ControlId::Calendar:\r\n            return IslandItem::Clock;\r\n        case ControlId::Media:\r\n            return IslandItem::Media;\r\n        case ControlId::Power:\r\n            return IslandItem::Power;\r\n        case ControlId::Usage:\r\n            return IslandItem::UsageCpu;\r\n        case ControlId::Profiles:\r\n            return IslandItem::Profiles;\r\n        case ControlId::KeyboardLanguage:\r\n            return IslandItem::InputMethod;\r\n        case ControlId::Privacy:\r\n            return IslandItem::PrivacyMicrophone;\r\n        case ControlId::Drives:\r\n            return IslandItem::Drives;\r\n        case ControlId::Desktops:\r\n            return IslandItem::Desktops;\r\n        case ControlId::Folders:\r\n            return IslandItem::Folders;\r\n        case ControlId::Wallpaper:\r\n            return IslandItem::Wallpaper;\r\n        case ControlId::KomorebiLayout:\r\n            return IslandItem::KomorebiLayout;\r\n        case ControlId::WorldClocks:\r\n            return IslandItem::WorldClock;\r\n        case ControlId::NextEvent:\r\n            return IslandItem::Countdown;\r\n        case ControlId::RecycleBin:\r\n            return IslandItem::RecycleBin;\r\n        case ControlId::Timer:\r\n        case ControlId::Stopwatch:\r\n        case ControlId::Pomodoro:\r\n        case ControlId::Alarms:\r\n            return IslandItem::Timer;\r\n        case ControlId::TrayIcons:\r\n            return IslandItem::Overflow;\r\n        default:\r\n            return IslandItem::None;\r\n    }\r\n}\r\n\r\nconst ControlInfo& GetControlInfo(ControlId id) {\r\n    for (const auto& info : kControls) {\r\n        if (info.id == id) {\r\n            return info;\r\n        }\r\n    }\r\n    return kControls[0];\r\n}\r\n\r\n// The shortcut that minimizes the islands (islandMinimizeShortcut): its key,\r\n// with its modifiers in the next byte; Win+J unless other keys were recorded\r\n// (see ControlPanel::StartShortcutRecording).\r\nconstexpr int kShortcutWin = 1;\r\nconstexpr int kShortcutCtrl = 2;\r\nconstexpr int kShortcutAlt = 4;\r\nconstexpr int kShortcutShift = 8;\r\nconstexpr int kDefaultMinimizeShortcut = kShortcutWin << 8 | 'J';\r\nstd::atomic<int> g_minimizeShortcut{kDefaultMinimizeShortcut};\r\n// The one that lets clicks through the pill (islandShortcut1,\r\n// islandClickThroughKey): no keys (0) until some are recorded. Letting them\r\n// through now, for all the islands.\r\nstd::atomic<int> g_clickThroughShortcut{0};\r\nbool g_clickThrough = false;\r\n// Of a settings' row (SettingKind::Shortcut's value).\r\nint ShortcutOfSlot(int slot) {\r\n    return slot == 0 ? g_minimizeShortcut.load()\r\n                     : g_clickThroughShortcut.load();\r\n}\r\n// Recording new keys for it: the next key pressed with Win, Ctrl or Alt goes\r\n// to this window (as WM_APP_SHORTCUT_RECORDED, its combination; -1: Escape\r\n// cancelled it; a key without them, its combination too, to say it needs\r\n// one) instead of the app in front (see ShortcutKeyProc).\r\nconstexpr UINT WM_APP_SHORTCUT_RECORDED = WM_APP + 96;\r\nstd::atomic<bool> g_shortcutRecording;\r\nstd::atomic<HWND> g_shortcutRecorder;\r\n// The low-level keyboard hook on while a shortcut is chosen or one is being\r\n// recorded (see Island::UpdateShortcutKeys).\r\nvoid UpdateShortcutHook();\r\nstd::wstring ShortcutText(int combo, bool spaced = true);\r\nstd::wstring SetIslandShortcut(int slot, int combo);\r\n\r\n// The setup assistant, a tab of the settings' window: its steps (see\r\n// ControlPanel::SetupLines), and its buttons under them (see\r\n// ControlPanel::PressSetupButton).\r\nenum SetupStep {\r\n    kSetupWelcome,\r\n    kSetupStyle,\r\n    kSetupPill,\r\n    kSetupHiding,\r\n    kSetupLook,\r\n    kSetupDone,\r\n    kSetupSteps\r\n};\r\nenum SetupButton { kSetupCancel, kSetupBack, kSetupNext, kSetupButtons };\r\n// Where it is: its step, the profile in use and every option's value\r\n// (by IslandPref) as its tab showed, put back by its Cancel (empty while its\r\n// tab isn't shown).\r\nstruct SetupState {\r\n    int step = kSetupWelcome;\r\n    int profile = -1;\r\n    std::vector<int> from;\r\n};\r\n\r\n// The settings' window as it was when the islands started again (another\r\n// style, the notches, a monitor...: they're all made again, the window too,\r\n// with their thread): opened again where it was, on the same tab and place\r\n// in it, by the island of the same monitor (see ReopenSettingsWindow).\r\nstruct SettingsWindowState {\r\n    double at = -100;\r\n    // The island's monitor (empty: the main island).\r\n    std::wstring device;\r\n    WINDOWPLACEMENT placement{sizeof(WINDOWPLACEMENT)};\r\n    // Where it was on the screen (the placement's is against the main\r\n    // monitor's work area, which the island's own strip changes with the\r\n    // style: back a few pixels off).\r\n    RECT rect{};\r\n    int tab = 0;\r\n    std::wstring search;\r\n    double scroll = 0;\r\n    double navScroll = 0;\r\n    SetupState setup;\r\n    // \"Restore what changed\" on an option's card (see ApplyNeeds): its\r\n    // entry, and each change made (the option, from, to).\r\n    int restoreEntry = -1;\r\n    std::vector<std::array<int, 3>> restore;\r\n};\r\n// (One for each monitor's window open when the islands started again.)\r\nstd::vector<SettingsWindowState> g_settingsWindowStates;\r\n\r\n// The island's own options, chosen in it (the control center's settings,\r\n// from the bubble of a right click on the island) rather than in Windhawk, and kept with Wh_SetIntValue.\r\nenum class IslandPref {\r\n    Bar,\r\n    Theme,\r\n    Tray,\r\n    TrayOpen,\r\n    Network,\r\n    Volume,\r\n    Battery,\r\n    Bell,\r\n    Media,\r\n    MediaButtons,\r\n    MediaTitle,\r\n    Banner,\r\n    BannerMinimized,\r\n    HideWindowsBanners,\r\n    WebPictures,\r\n    ClockSeconds,\r\n    ClockWeekday,\r\n    ClockDate,\r\n    ClockYear,\r\n    FreeDrag,\r\n    VerticalSides,\r\n    ClockCenter,\r\n    Power,\r\n    OwnNotifications,\r\n    PanelsFollow,\r\n    ThemeButton,\r\n    UsageCpu,\r\n    UsageRam,\r\n    UsageVram,\r\n    Microphone,\r\n    Holidays,\r\n    Notes,\r\n    Tasks,\r\n    Shortcuts,\r\n    Weather,\r\n    Updates,\r\n    Animations,\r\n    FollowMouse,\r\n    Profiles,\r\n    AutoHide,\r\n    AllMonitors,\r\n    VolumePercent,\r\n    BatteryPercent,\r\n    Brightness,\r\n    Clipboard,\r\n    Frosted,\r\n    DateOrder,\r\n    MonthNumber,\r\n    InputMethod,\r\n    Privacy,\r\n    UsbDrives,\r\n    UsbNotify,\r\n    ClockFormat,\r\n    TrayStyle,\r\n    WindowColor,\r\n    Folders,\r\n    Wallpaper,\r\n    WallpaperTransition,\r\n    Desktops,\r\n    // The control center's buttons on the pill (see kPillActions).\r\n    ActionNetwork,\r\n    ActionBluetooth,\r\n    ActionNightLight,\r\n    ActionHotspot,\r\n    ActionAirplane,\r\n    ActionProject,\r\n    ActionCast,\r\n    ActionCaptions,\r\n    ActionAccessibility,\r\n    ActionScreenshot,\r\n    ActionLock,\r\n    ActionEmoji,\r\n    ActionClipboard,\r\n    ActionTaskManager,\r\n    ActionCalculator,\r\n    ActionExplorer,\r\n    // Win+N and Win+A open the island's notifications and control center.\r\n    ShortcutNotifications,\r\n    ShortcutControl,\r\n    // The Fixed style's notches (see islandNotches).\r\n    Notches,\r\n    NotchEach,\r\n    GroupApps,\r\n    // komorebi's button on the pill (see kPillActions) and what its buttons\r\n    // take along.\r\n    ActionKomorebi,\r\n    KomorebiWhkd,\r\n    KomorebiMasir,\r\n    ScreenshotFolder,\r\n    MediaWheel,\r\n    MediaMarquee,\r\n    // The icons of the apps with notifications on the pill.\r\n    NotificationApps,\r\n    // komorebi's layout on the pill, and the app in focus on the monitor.\r\n    KomorebiLayout,\r\n    FocusedApp,\r\n    KomorebiHideEmpty,\r\n    // Files dragged out of the folders panel: 0 asked, 1 copied, 2 moved\r\n    // (chosen on its own row, see kChoiceFolderDrag).\r\n    FolderDrag,\r\n    LiquidGlass,\r\n    // The names under the icons and buttons (see Island::ShowTrayTip).\r\n    Tips,\r\n    HoverHighlight,\r\n    MinimizeButton,\r\n    BarCorners,\r\n    GlassTranslucent,\r\n    Clock,\r\n    ActionShowDesktop,\r\n    MinimizeKey,\r\n    NetSpeed,\r\n    WorldClocks,\r\n    Countdown,\r\n    RecycleBin,\r\n    ActionOnScreenKeyboard,\r\n    StatusNotices,\r\n    FoldApps,\r\n    Timer,\r\n    Visualizer,\r\n    // What \"Time until the next\" counts down to, and the pill filling like\r\n    // a loading bar (downloads, the battery charging; see Island::Fill).\r\n    CountdownEvents,\r\n    CountdownAlarms,\r\n    CountdownTimer,\r\n    CountdownPomodoro,\r\n    DownloadFill,\r\n    ChargeFill,\r\n    // The fill's colors, chosen on rows of their own (see kChoiceFillColor).\r\n    FillColor,\r\n    FillOwnColor,\r\n    FillCopyColor,\r\n    FillCopyOwnColor,\r\n    FillChargeColor,\r\n    FillChargeOwnColor,\r\n    // Chosen on its own row (see kChoiceFillStyle).\r\n    FillStyle,\r\n    // Song lyrics, their size and color (rows of their own, see\r\n    // kChoiceLyricsSize), and the line in the title's place.\r\n    Lyrics,\r\n    LyricsSize,\r\n    LyricsColor,\r\n    LyricsOwnColor,\r\n    LyricsInTitle,\r\n    // The audio visualizer's color (see kChoiceVisualizerColor).\r\n    VisualizerColor,\r\n    VisualizerOwnColor,\r\n    // From how much in it the Recycle Bin shows (kChoiceRecycleMinSize).\r\n    RecycleMinSize,\r\n    // The longest a song's line gets on the pill (kChoiceLyricsWidth).\r\n    LyricsWidth,\r\n    VisualizerSmooth,\r\n    WhatsNewNotice,\r\n    // 3.0 (new ones go here, at the end, like in kIslandPrefs).\r\n    WeatherUnit,\r\n    NotchOpen,\r\n    IconPack,\r\n    IconColors,\r\n    CapsLock,\r\n    HideWhen,\r\n    LineFade,\r\n    HideClock,\r\n    PillNotches,\r\n    BarClear,\r\n    AiUsage,\r\n    AiClaude,\r\n    AiCodex,\r\n    FocusedTitle,\r\n    WeatherCards,\r\n    CalendarBigDay,\r\n    Commands,\r\n    BarSide,\r\n    BarInnerCorners,\r\n    DndSilent,\r\n    BannerSize,\r\n    BannerWidth,\r\n    BannerCorners,\r\n    BannerPlace,\r\n    DownloadStalled,\r\n    FolderThumbnails,\r\n    Shelf,\r\n    // (Chosen on its own row, see kChoiceShelfLimit.)\r\n    ShelfLimit,\r\n    TimerLine,\r\n    LineClick,\r\n    ExternalBrightness,\r\n    GlassLight,\r\n    // (Added in 3.1: after the others.)\r\n    ActionTouchKeyboard,\r\n    ActionWindowsSettings,\r\n    LyricsIcon,\r\n    ArrowPins,\r\n    ZoneAsPill,\r\n    MediaAlways,\r\n    MediaPlayOnly,\r\n    BarFixedSides,\r\n    PowerSleep,\r\n    PowerHibernate,\r\n    PowerRestart,\r\n    PowerShutDown,\r\n    PowerLock,\r\n    PowerSignOut,\r\n    PowerConfirm,\r\n    ClickThroughKey,\r\n    OverFullscreen,\r\n    CalendarEvents,\r\n    BarAlign,\r\n    HoverOpen,\r\n    NotchHideEmpty,\r\n    BannerMarquee,\r\n    ActionStartMenuKeys,\r\n    BatteryRing,\r\n    BarClearDesktop,\r\n    HideClockEdge,\r\n    OrderDrag,\r\n    Launcher,\r\n    MediaCoverOnly,\r\n    MediaStyle,\r\n    NoticeCharger,\r\n    NoticeLowBattery,\r\n    NoticeBluetooth,\r\n    NoticeDnd,\r\n    NoticeDesktop,\r\n    BellWindows,\r\n    WorldClocksInClock,\r\n    WeatherIcons,\r\n    VlcTitle,\r\n    MusicLine,\r\n};\r\n\r\nstruct IslandPrefInfo {\r\n    IslandPref pref;\r\n    PCWSTR key;\r\n    WCHAR glyph;\r\n    PCWSTR english;\r\n    PCWSTR portuguese;\r\n};\r\n\r\nconst IslandPrefInfo kIslandPrefs[] = {\r\n    {IslandPref::Bar, L\"islandBar\", 0xE7C4, L\"Style\", L\"Estilo\"},\r\n    {IslandPref::Theme, L\"islandTheme\", 0xE790, L\"Colors\", L\"Cores\"},\r\n    {IslandPref::Tray, L\"islandTray\", 0xE712, L\"Other apps' tray icons\",\r\n     L\"Ícones dos outros apps\"},\r\n    {IslandPref::TrayOpen, L\"trayKeepOpen\", 0xE718, L\"Keep their list open\",\r\n     L\"Manter a lista aberta\"},\r\n    {IslandPref::Network, L\"islandNetwork\", kGlyphControlCenter,\r\n     L\"Control center\", L\"Central de controle\"},\r\n    {IslandPref::Volume, L\"islandVolume\", 0xE767, L\"Volume\", L\"Volume\"},\r\n    {IslandPref::Battery, L\"islandBattery\", 0xE83F, L\"Battery\", L\"Bateria\"},\r\n    {IslandPref::Bell, L\"islandBell\", 0xEA8F, L\"Notifications (bell)\",\r\n     L\"Notificações (sino)\"},\r\n    {IslandPref::Media, L\"islandMedia\", 0xE8D6, L\"What's playing\",\r\n     L\"O que está tocando\"},\r\n    {IslandPref::MediaButtons, L\"mediaButtons\", 0xE768,\r\n     L\"Media buttons on the pill\", L\"Botões de mídia na pílula\"},\r\n    {IslandPref::MediaTitle, L\"mediaTitle\", 0xE93C,\r\n     L\"Cover and title on the pill\", L\"Capa e título na pílula\"},\r\n    {IslandPref::Banner, L\"bannerEnabled\", 0xE8BD, L\"Banners in the pill\",\r\n     L\"Avisos na pílula\"},\r\n    {IslandPref::BannerMinimized, L\"bannerMinimized\", 0xE921,\r\n     L\"Banners even with the pill minimized\",\r\n     L\"Avisos mesmo com a pílula minimizada\"},\r\n    {IslandPref::HideWindowsBanners, L\"hideWindowsBanners\", 0xED1A,\r\n     L\"Hide the Windows banners\", L\"Esconder os avisos do Windows\"},\r\n    {IslandPref::WebPictures, L\"bannerWebPictures\", 0xE774,\r\n     L\"Download pictures from the web (goes online)\",\r\n     L\"Baixar fotos da internet (acessa a internet)\"},\r\n    {IslandPref::ClockSeconds, L\"clockSeconds\", 0xE916, L\"Seconds\",\r\n     L\"Segundos\"},\r\n    {IslandPref::ClockWeekday, L\"clockWeekday\", 0xE787, L\"Day of the week\",\r\n     L\"Dia da semana\"},\r\n    {IslandPref::ClockDate, L\"clockDate\", 0xE8BF, L\"Day and month\",\r\n     L\"Dia e mês\"},\r\n    {IslandPref::ClockYear, L\"clockYear\", 0xE787, L\"Year\", L\"Ano\"},\r\n    {IslandPref::FreeDrag, L\"islandFreeDrag\", 0xE7C2,\r\n     L\"Move the pill by dragging it\", L\"Mover a pílula arrastando\"},\r\n    {IslandPref::VerticalSides, L\"islandVerticalSides\", 0xE8B4,\r\n     L\"Upright on the left and right edges\", L\"Em pé nas laterais\"},\r\n    {IslandPref::ClockCenter, L\"islandClockCenter\", 0xE823,\r\n     L\"Clock in the middle (the other items move around it)\",\r\n     L\"Relógio no meio (os outros itens se reorganizam em volta)\"},\r\n    {IslandPref::Power, L\"islandPower\", 0xE7E8,\r\n     L\"Power button (sleep, restart, shut down)\",\r\n     L\"Botão de desligar (suspender, reiniciar, desligar)\"},\r\n    {IslandPref::OwnNotifications, L\"islandOwnsNotifications\", 0xE767,\r\n     L\"The island handles notifications and their sounds (Windows' stay quiet)\",\r\n     L\"A ilha cuida das notificações e dos sons (as do Windows ficam quietas)\"},\r\n    {IslandPref::PanelsFollow, L\"islandPanelsFollow\", 0xE740,\r\n     L\"Panels as wide as the island\", L\"Painéis na largura da ilha\"},\r\n    {IslandPref::ThemeButton, L\"islandThemeButton\", 0xE7A1,\r\n     L\"Light and dark mode button\", L\"Botão de modo claro e escuro\"},\r\n    {IslandPref::UsageCpu, L\"usageCpu\", 0xE950, L\"Processor use (CPU)\",\r\n     L\"Uso do processador (CPU)\"},\r\n    {IslandPref::UsageRam, L\"usageRam\", 0xE964, L\"Memory use (RAM)\",\r\n     L\"Uso da memória (RAM)\"},\r\n    {IslandPref::UsageVram, L\"usageVram\", 0xEEA1, L\"Video memory in use (VRAM)\",\r\n     L\"Memória de vídeo em uso (VRAM)\"},\r\n    {IslandPref::Microphone, L\"islandMicrophone\", 0xE720,\r\n     L\"Microphone button (mute)\", L\"Botão do microfone (silenciar)\"},\r\n    {IslandPref::Holidays, L\"calendarHolidays\", 0xE787,\r\n     L\"Holidays in the calendar (goes online)\",\r\n     L\"Feriados no calendário (acessa a internet)\"},\r\n    {IslandPref::Notes, L\"islandNotes\", 0xE70B, L\"Notes button\",\r\n     L\"Botão de anotações\"},\r\n    {IslandPref::Tasks, L\"islandTasks\", 0xE9D5, L\"Tasks button\",\r\n     L\"Botão de tarefas\"},\r\n    {IslandPref::Shortcuts, L\"islandShortcuts\", 0xE765,\r\n     L\"Keyboard shortcuts button\", L\"Botão de atalhos do teclado\"},\r\n    {IslandPref::Weather, L\"islandWeather\", 0xE753, L\"Weather (goes online)\",\r\n     L\"Clima (acessa a internet)\"},\r\n    {IslandPref::Updates, L\"islandUpdates\", 0xE895,\r\n     L\"Updates (winget and Windows Update)\",\r\n     L\"Atualizações (winget e Windows Update)\"},\r\n    // Kept with the other animation settings (see SetAnimationChoice).\r\n    {IslandPref::Animations, nullptr, 0xE945, L\"Animations\", L\"Animações\"},\r\n    {IslandPref::FollowMouse, L\"islandFollowMouse\", 0xE962,\r\n     L\"On the monitor with the mouse\", L\"No monitor onde está o mouse\"},\r\n    {IslandPref::Profiles, L\"islandProfiles\", 0xE748,\r\n     L\"Profiles button (switch profiles)\",\r\n     L\"Botão de perfis (trocar de perfil)\"},\r\n    {IslandPref::AutoHide, L\"islandAutoHide\", 0xE89F,\r\n     L\"Hide as its line until the mouse reaches it\",\r\n     L\"Esconder na linha até o mouse chegar nela\"},\r\n    {IslandPref::AllMonitors, L\"islandAllMonitors\", 0xE7F4, L\"On every monitor\",\r\n     L\"Em todos os monitores\"},\r\n    {IslandPref::VolumePercent, L\"islandVolumePercent\", 0xE995,\r\n     L\"Volume percentage beside its icon\",\r\n     L\"Porcentagem do volume ao lado do ícone\"},\r\n    {IslandPref::BatteryPercent, L\"islandBatteryPercent\", 0xE83F,\r\n     L\"Battery percentage beside its icon\",\r\n     L\"Porcentagem da bateria ao lado do ícone\"},\r\n    {IslandPref::Brightness, L\"islandBrightness\", 0xE706,\r\n     L\"Screen brightness (the mouse wheel changes it)\",\r\n     L\"Brilho da tela (a roda do mouse muda)\"},\r\n    {IslandPref::Clipboard, L\"islandClipboard\", 0xE77F,\r\n     L\"Show what's copied (a bubble under the pill)\",\r\n     L\"Mostrar o que foi copiado (um balão sob a pílula)\"},\r\n    {IslandPref::Frosted, L\"islandFrosted\", 0xE771,\r\n     L\"Frosted glass on the bar and the Fixed style's strip\",\r\n     L\"Vidro fosco na barra e na faixa do estilo Fixa\"},\r\n    // Chosen on its own row (see kChoiceDateOrder).\r\n    {IslandPref::DateOrder, L\"islandDateOrder\", 0xE787, L\"Date order\",\r\n     L\"Ordem da data\"},\r\n    {IslandPref::MonthNumber, L\"islandMonthNumber\", 0xE8BF,\r\n     L\"Month as a number (9/10)\", L\"Mês em número (9/10)\"},\r\n    {IslandPref::InputMethod, L\"islandInputMethod\", 0xE774,\r\n     L\"Keyboard language (like Windows' input indicator)\",\r\n     L\"Idioma do teclado (como o indicador do Windows)\"},\r\n    {IslandPref::Privacy, L\"islandPrivacy\", 0xEA18,\r\n     L\"Microphone, camera and location in use (and which app)\",\r\n     L\"Microfone, câmera e localização em uso (e qual app)\"},\r\n    {IslandPref::UsbDrives, L\"islandUsbDrives\", 0xE88E,\r\n     L\"USB drives icon on the pill (open or eject them)\",\r\n     L\"Ícone dos pendrives na pílula (abrir ou ejetar)\"},\r\n    {IslandPref::UsbNotify, L\"islandUsbNotify\", 0xE7E7,\r\n     L\"Notify when a USB drive is plugged in\",\r\n     L\"Avisar quando um pendrive for conectado\"},\r\n    // Chosen on its own row (see kChoiceClockFormat).\r\n    {IslandPref::ClockFormat, L\"islandClockFormat\", 0xE823, L\"Time format\",\r\n     L\"Formato da hora\"},\r\n    // Chosen on its own row (see kChoiceTrayStyle).\r\n    {IslandPref::TrayStyle, L\"islandTrayStyle\", 0xE712,\r\n     L\"Icons that aren't pinned\", L\"Ícones não fixados\"},\r\n    {IslandPref::WindowColor, L\"islandWindowColor\", 0xE790,\r\n     L\"Colors following the app in front (its title bar or its icon)\",\r\n     L\"Cores seguindo o app da frente (a barra de título ou o ícone)\"},\r\n    {IslandPref::Folders, L\"islandFolders\", 0xE8B7,\r\n     L\"Folders and places (your shortcuts)\", L\"Pastas e locais (seus atalhos)\"},\r\n    {IslandPref::Wallpaper, L\"islandWallpaper\", 0xE8B9,\r\n     L\"Wallpapers from a folder (with a transition)\",\r\n     L\"Papéis de parede de uma pasta (com transição)\"},\r\n    // Chosen on its own row (see kChoiceWallpaper).\r\n    {IslandPref::WallpaperTransition, L\"islandWallpaperTransition\", 0xE8B9,\r\n     L\"Transition\", L\"Transição\"},\r\n    {IslandPref::Desktops, L\"islandDesktops\", 0xE7C4,\r\n     L\"Virtual desktops (the mouse wheel switches them)\",\r\n     L\"Áreas de trabalho virtuais (a roda do mouse troca)\"},\r\n    {IslandPref::ActionNetwork, L\"pillNetwork\", 0xE701, L\"Wi-Fi / network\",\r\n     L\"Wi-Fi / rede\"},\r\n    {IslandPref::ActionBluetooth, L\"pillBluetooth\", 0xE702, L\"Bluetooth\",\r\n     L\"Bluetooth\"},\r\n    {IslandPref::ActionNightLight, L\"pillNightLight\", 0xF08C, L\"Night light\",\r\n     L\"Luz noturna\"},\r\n    {IslandPref::ActionHotspot, L\"pillHotspot\", 0xE88A, L\"Mobile hotspot\",\r\n     L\"Hotspot móvel\"},\r\n    {IslandPref::ActionAirplane, L\"pillAirplane\", 0xE709, L\"Airplane mode\",\r\n     L\"Modo avião\"},\r\n    {IslandPref::ActionProject, L\"pillProject\", 0xEBC6, L\"Project\",\r\n     L\"Projetar\"},\r\n    {IslandPref::ActionCast, L\"pillCast\", 0xEC15, L\"Cast\", L\"Transmitir\"},\r\n    {IslandPref::ActionCaptions, L\"pillCaptions\", 0xE7F0, L\"Captions\",\r\n     L\"Legendas\"},\r\n    {IslandPref::ActionAccessibility, L\"pillAccessibility\", 0xE776,\r\n     L\"Accessibility\", L\"Acessibilidade\"},\r\n    {IslandPref::ActionScreenshot, L\"pillScreenshot\", 0xE722, L\"Screenshot\",\r\n     L\"Captura de tela\"},\r\n    {IslandPref::ActionLock, L\"pillLock\", 0xE72E, L\"Lock\", L\"Bloquear\"},\r\n    {IslandPref::ActionEmoji, L\"pillEmoji\", 0xE76E, L\"Emoji\", L\"Emojis\"},\r\n    {IslandPref::ActionClipboard, L\"pillClipboard\", 0xF0E3, L\"Clipboard\",\r\n     L\"Área de transferência\"},\r\n    {IslandPref::ActionTaskManager, L\"pillTaskManager\", 0xE9D9, L\"Task Manager\",\r\n     L\"Gerenciador de Tarefas\"},\r\n    {IslandPref::ActionCalculator, L\"pillCalculator\", 0xE8EF, L\"Calculator\",\r\n     L\"Calculadora\"},\r\n    {IslandPref::ActionExplorer, L\"pillExplorer\", 0xEC50, L\"File Explorer\",\r\n     L\"Explorador de Arquivos\"},\r\n    {IslandPref::ShortcutNotifications, L\"islandWinN\", 0xE765,\r\n     L\"Win+N opens the island's notifications\",\r\n     L\"Win+N abre as notificações da ilha\"},\r\n    {IslandPref::ShortcutControl, L\"islandWinA\", 0xE765,\r\n     L\"Win+A opens the island's control center\",\r\n     L\"Win+A abre a central de controle da ilha\"},\r\n    // Chosen on its own row (see kChoiceNotches).\r\n    {IslandPref::Notches, L\"islandNotches\", 0xECA5, L\"Notches\", L\"Entalhes\"},\r\n    {IslandPref::NotchEach, L\"islandNotchEach\", 0xE921,\r\n     L\"Hide each notch on its own (not all together)\",\r\n     L\"Esconder cada entalhe sozinho (não todos juntos)\"},\r\n    {IslandPref::GroupApps, L\"islandGroupApps\", 0xE71D,\r\n     L\"One icon per app (Phone Link's phone apps together)\",\r\n     L\"Um ícone por app (os apps do celular do Vincular ao Celular juntos)\"},\r\n    {IslandPref::ActionKomorebi, L\"pillKomorebi\", kGlyphKomorebi,\r\n     L\"komorebi (start, stop, reload)\",\r\n     L\"komorebi (iniciar, parar, recarregar)\"},\r\n    {IslandPref::KomorebiWhkd, L\"komorebiWhkd\", kGlyphKomorebi,\r\n     L\"komorebi: with whkd (its shortcuts)\",\r\n     L\"komorebi: com o whkd (os atalhos dele)\"},\r\n    {IslandPref::KomorebiMasir, L\"komorebiMasir\", kGlyphKomorebi,\r\n     L\"komorebi: with masir (focus follows the mouse)\",\r\n     L\"komorebi: com o masir (o foco segue o mouse)\"},\r\n    {IslandPref::ScreenshotFolder, L\"islandScreenshotFolder\", 0xE722,\r\n     L\"Screenshot notifications open the picture (in Explorer)\",\r\n     L\"Avisos de captura abrem a imagem (no Explorador)\"},\r\n    {IslandPref::MediaWheel, L\"islandMediaWheel\", 0xE893,\r\n     L\"The wheel on what's playing changes the song (not the volume)\",\r\n     L\"A roda no que está tocando troca a música (não o volume)\"},\r\n    {IslandPref::MediaMarquee, L\"islandMediaMarquee\", 0xE8AB,\r\n     L\"A long title keeps scrolling while it plays\",\r\n     L\"Título longo rolando enquanto toca\"},\r\n    {IslandPref::NotificationApps, L\"islandApps\", 0xE7E7,\r\n     L\"Icons of the apps with notifications\",\r\n     L\"Ícones dos apps com notificações\"},\r\n    {IslandPref::KomorebiLayout, L\"islandKomorebiLayout\", kGlyphKomorebiLayout,\r\n     L\"komorebi: its layout on the pill (a menu changes it)\",\r\n     L\"komorebi: o layout na pílula (um menu troca)\"},\r\n    {IslandPref::FocusedApp, L\"islandFocusedApp\", kGlyphFocusedApp,\r\n     L\"The app in focus on this monitor (its icon and name)\",\r\n     L\"O app em foco neste monitor (ícone e nome)\"},\r\n    {IslandPref::KomorebiHideEmpty, L\"islandKomorebiHideEmpty\",\r\n     kGlyphKomorebiLayout, L\"komorebi: hide the workspaces without windows\",\r\n     L\"komorebi: esconder as áreas de trabalho sem janelas\"},\r\n    // Chosen on its own row (see kChoiceFolderDrag).\r\n    {IslandPref::FolderDrag, L\"islandFolderDrag\", 0xE8C8, L\"Files dragged out\",\r\n     L\"Arquivos arrastados para fora\"},\r\n    {IslandPref::LiquidGlass, L\"islandLiquidGlass\", 0xE771,\r\n     L\"Glass: see-through and blurred, with a bright edge (Windows' blur: \"\r\n     L\"needs its transparency effects)\",\r\n     L\"Vidro: transparente e desfocado, com borda de luz (desfoque do \"\r\n     L\"Windows: precisa dos efeitos de transparência dele)\"},\r\n    {IslandPref::Tips, L\"islandTips\", 0xE946,\r\n     L\"Tips under the icons and buttons (their names, an app's notifications)\",\r\n     L\"Dicas embaixo dos ícones e botões (os nomes, as notificações de um \"\r\n     L\"app)\"},\r\n    {IslandPref::HoverHighlight, L\"islandHoverHighlight\", 0xE7C9,\r\n     L\"Highlight behind the item under the mouse\",\r\n     L\"Destaque atrás do item sob o mouse\"},\r\n    {IslandPref::MinimizeButton, L\"islandMinimizeButton\", 0xE70E,\r\n     L\"Minimize arrow at the end of the pill\",\r\n     L\"Seta de minimizar no fim da pílula\"},\r\n    {IslandPref::BarCorners, L\"islandBarCorners\", 0xE7C4,\r\n     L\"Bar: items at the screen's corners (the clock in the middle)\",\r\n  