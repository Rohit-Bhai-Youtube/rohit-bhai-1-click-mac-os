 {SettingKind::Pref, (int)IslandPref::ActionShowDesktop,\n         L\"Puts a button on the pill that shows the desktop\",\n         L\"PÃµe na pÃ­lula um botÃ£o que mostra a Ã¡rea de trabalho\"},\n        {SettingKind::Pref, (int)IslandPref::ActionOnScreenKeyboard,\n         L\"Puts a button on the pill that opens the on-screen keyboard\",\n         L\"PÃµe na pÃ­lula um botÃ£o que abre o teclado virtual\"},\n        {SettingKind::Pref, (int)IslandPref::ActionTouchKeyboard,\n         L\"Puts a button on the pill that shows or hides the touch keyboard\",\n         L\"PÃµe na pÃ­lula um botÃ£o que mostra ou esconde o teclado touch\"},\n        {SettingKind::Pref, (int)IslandPref::ActionWindowsSettings,\n         L\"Puts a button on the pill that opens Windows\u0027 Settings\",\n         L\"PÃµe na pÃ­lula um botÃ£o que abre as ConfiguraÃ§Ãµes do Windows\"},\n        {SettingKind::Pref, (int)IslandPref::ActionStartMenuKeys,\n         L\"Puts a button on the pill that opens the Start button\u0027s right-click \"\n         L\"menu (the one of Win+X)\",\n         L\"PÃµe na pÃ­lula um botÃ£o que abre o menu do botÃ£o direito do Iniciar \"\n         L\"(o do Win+X)\"},\n        {SettingKind::Pref, (int)IslandPref::ActionKomorebi,\n         L\"Puts a button on the pill to start, stop or reload komorebi\",\n         L\"PÃµe na pÃ­lula um botÃ£o para iniciar, parar ou recarregar o \"\n         L\"komorebi\"},\n        {SettingKind::Pref, (int)IslandPref::KomorebiWhkd,\n         L\"The komorebi buttons also start and stop whkd, its shortcut helper\",\n         L\"Os botÃµes do komorebi tambÃ©m iniciam e param o whkd, o ajudante de \"\n         L\"atalhos\"},\n        {SettingKind::Pref, (int)IslandPref::KomorebiMasir,\n         L\"The komorebi buttons also start and stop masir, so focus follows \"\n         L\"the mouse\",\n         L\"Os botÃµes do komorebi tambÃ©m iniciam e param o masir, e o foco \"\n         L\"segue o mouse\"},\n        {SettingKind::Pref, (int)IslandPref::KomorebiLayout,\n         L\"Shows komorebi\u0027s workspaces and layout on the pill, a menu changes \"\n         L\"it\",\n         L\"Mostra as Ã¡reas e o layout do komorebi na pÃ­lula, um menu o troca\"},\n        {SettingKind::Pref, (int)IslandPref::KomorebiHideEmpty,\n         L\"Leaves out komorebi workspaces that have no windows\",\n         L\"Deixa de fora as Ã¡reas do komorebi sem janelas\"},\n        {SettingKind::Pref, (int)IslandPref::Tray,\n         L\"Adds a way to reach the tray icons of other apps from the pill\",\n         L\"Adiciona um jeito de acessar os Ã­cones da bandeja de outros apps \"\n         L\"pela pÃ­lula\"},\n        {SettingKind::Choice, kChoiceTrayStyle,\n         L\"Opens the unpinned icons as a list in the pill, a grid or a named \"\n         L\"list\",\n         L\"Abre os Ã­cones nÃ£o fixados como lista na pÃ­lula, grade ou lista \"\n         L\"com nomes\"},\n        {SettingKind::Pref, (int)IslandPref::TrayOpen,\n         L\"The list stays open after you click an icon (In the pill style)\",\n         L\"A lista continua aberta depois de clicar em um Ã­cone (estilo Na \"\n         L\"pÃ­lula)\"},\n        {SettingKind::Size, 3,\n         L\"How many icons show before the list starts to scroll\",\n         L\"Quantos Ã­cones aparecem antes de a lista comeÃ§ar a rolar\"},\n        {SettingKind::Size, 20,\n         L\"How tall the bars can grow (as far as the pill allows)\",\n         L\"AtÃ© que altura as barras podem crescer (atÃ© onde a pÃ­lula \"\n         L\"deixa)\"},\n        {SettingKind::Size, 21,\n         L\"How wide each bar is; the item grows with them\",\n         L\"A largura de cada barra; o item cresce com elas\"},\n        {SettingKind::Size, 22,\n         L\"The room between the bars; the item grows with it\",\n         L\"O espaÃ§o entre as barras; o item cresce com ele\"},\n        {SettingKind::Size, kSliderMediaButtons,\n         L\"How big the previous, play and next buttons on the pill are, \"\n         L\"as far as the pill is tall\",\n         L\"O tamanho dos botÃµes de anterior, tocar e prÃ³xima na pÃ­lula, \"\n         L\"atÃ© onde a pÃ­lula Ã© alta\"},\n        {SettingKind::Size, kSliderMediaPanel,\n         L\"Makes the What\u0027s playing panel bigger than the other panels; \"\n         L\"on a short screen it still fits and scrolls\",\n         L\"Deixa o painel do que estÃ¡ tocando maior que os outros \"\n         L\"painÃ©is; numa tela baixa ele continua cabendo e rola\"},\n        {SettingKind::Size, 18,\n         L\"How much the bars move with the sound (they follow the playing \"\n         L\"app\u0027s own sound)\",\n         L\"O quanto as barras se mexem com o som (elas seguem o som do app \"\n         L\"que estÃ¡ tocando)\"},\n        {SettingKind::Size, 17,\n         L\"Number of columns in the icon grid (Grid style only)\",\n         L\"NÃºmero de colunas da grade de Ã­cones (sÃ³ no estilo Grade)\"},\n        {SettingKind::Pref, (int)IslandPref::Media,\n         L\"Shows the playing song or video with its cover and controls\",\n         L\"Mostra a mÃºsica ou o vÃ­deo tocando com capa e controles\"},\n        {SettingKind::Pref, (int)IslandPref::MediaButtons,\n         L\"Puts previous, play and next buttons right on the pill\",\n         L\"PÃµe os botÃµes de anterior, tocar e prÃ³xima direto na pÃ­lula\"},\n        {SettingKind::Pref, (int)IslandPref::MediaTitle,\n         L\"Shows the cover and the song title on the pill\",\n         L\"Mostra a capa e o tÃ­tulo da mÃºsica na pÃ­lula\"},\n        {SettingKind::Size, 11,\n         L\"Longest width the song title may take on the pill\",\n         L\"Maior largura que o tÃ­tulo da mÃºsica pode ocupar na pÃ­lula\"},\n        {SettingKind::Pref, (int)IslandPref::MediaMarquee,\n         L\"A title too long to fit scrolls across while it plays\",\n         L\"Um tÃ­tulo longo demais rola enquanto a mÃºsica toca\"},\n        {SettingKind::Pref, (int)IslandPref::MediaWheel,\n         L\"Scrolling on the player skips songs instead of changing the volume\",\n         L\"Rolar sobre o player troca de mÃºsica em vez de mudar o volume\"},\n        {SettingKind::Pref, (int)IslandPref::Clock,\n         L\"Shows the time on the pill\",\n         L\"Mostra a hora na pÃ­lula\"},\n        {SettingKind::Choice, kChoiceClockFormat,\n         L\"Follows Windows or forces a 24 hour or 12 hour clock\",\n         L\"Segue o Windows ou forÃ§a relÃ³gio de 24 ou de 12 horas\"},\n        {SettingKind::Pref, (int)IslandPref::ClockSeconds,\n         L\"Adds the seconds to the time\",\n         L\"Acrescenta os segundos Ã  hora\"},\n        {SettingKind::Pref, (int)IslandPref::ClockWeekday,\n         L\"Adds the weekday to the clock\",\n         L\"Acrescenta o dia da semana ao relÃ³gio\"},\n        {SettingKind::Pref, (int)IslandPref::ClockDate,\n         L\"Adds the day and the month to the clock\",\n         L\"Acrescenta o dia e o mÃªs ao relÃ³gio\"},\n        {SettingKind::Pref, (int)IslandPref::ClockYear,\n         L\"Adds the year to the clock\",\n         L\"Acrescenta o ano ao relÃ³gio\"},\n        {SettingKind::Choice, kChoiceDateOrder,\n         L\"Sets the order of day, month and year when the date shows\",\n         L\"Define a ordem de dia, mÃªs e ano quando a data aparece\"},\n        {SettingKind::Pref, (int)IslandPref::MonthNumber,\n         L\"Writes the month as a number, like 9/10, not as a name\",\n         L\"Escreve o mÃªs como nÃºmero, como 9/10, e nÃ£o como nome\"},\n        {SettingKind::Pref, (int)IslandPref::Holidays,\n         L\"Marks holidays in the calendar, it needs an internet connection\",\n         L\"Marca os feriados no calendÃ¡rio, precisa de conexÃ£o com a internet\"},\n        {SettingKind::Pref, (int)IslandPref::WorldClocks,\n         L\"Shows the extra clocks you added in Windows\",\n         L\"Mostra os relÃ³gios adicionais que vocÃª incluiu no Windows\"},\n        {SettingKind::Pref, (int)IslandPref::Countdown,\n         L\"Shows how long until the next event, alarm, timer or Pomodoro part\",\n         L\"Mostra quanto falta para o prÃ³ximo evento, alarme, timer ou parte \"\n         L\"do Pomodoro\"},\n        {SettingKind::Pref, (int)IslandPref::AiUsage,\n         L\"How much of the AI agents\u0027 limits is used and when each starts \"\n         L\"over, read on this PC (no login and nothing online)\",\n         L\"Quanto dos limites dos agentes de IA jÃ¡ foi usado e quando cada \"\n         L\"um recomeÃ§a, lido neste PC (sem login e nada online)\"},\n        {SettingKind::Pref, (int)IslandPref::AiClaude,\n         L\"What Claude Code in a terminal gives its status line (a line in \"\n         L\"its script, see the item\u0027s panel). The Claude desktop app doesn\u0027t \"\n         L\"leave its limits on this PC, so it can\u0027t show here\",\n         L\"O que o Claude Code no terminal passa para a linha de status dele \"\n         L\"(uma linha no script dela, veja o painel do item). O app de \"\n         L\"desktop do Claude nÃ£o deixa os limites neste PC, entÃ£o ele nÃ£o \"\n         L\"aparece aqui\"},\n        {SettingKind::Pref, (int)IslandPref::AiCodex,\n         L\"What Codex writes in its logs on this PC\",\n         L\"O que o Codex escreve nos logs dele neste PC\"},\n        {SettingKind::Pref, (int)IslandPref::FocusedTitle,\n         L\"Also shows the title of the window in focus, like the page or the \"\n         L\"file open in it\",\n         L\"Mostra tambÃ©m o tÃ­tulo da janela em foco, como a pÃ¡gina ou o \"\n         L\"arquivo aberto nela\"},\n        {SettingKind::Pref, (int)IslandPref::WeatherCards,\n         L\"The weather panel shows feels like, humidity, wind, UV, rain, \"\n         L\"pressure and clouds as small cards, like a phone\u0027s\",\n         L\"O painel do clima mostra sensaÃ§Ã£o, umidade, vento, UV, chuva, \"\n         L\"pressÃ£o e nuvens em cartÃµes pequenos, como no celular\"},\n        {SettingKind::Pref, (int)IslandPref::CalendarBigDay,\n         L\"The calendar opens as a card: today big at its left, the month \"\n         L\"beside it, buttons for the alarms, the timer and your agendas, and \"\n         L\"the day\u0027s events\",\n         L\"O calendÃ¡rio abre como um cartÃ£o: o dia de hoje grande Ã  esquerda, \"\n         L\"o mÃªs ao lado, botÃµes para os alarmes, o timer e suas agendas, e \"\n         L\"os eventos do dia\"},\n        {SettingKind::Pref, (int)IslandPref::Commands,\n         L\"Shortcuts to programs and files (or command lines) you add, with \"\n         L\"their own icons, a click away in their panel; any of them can be a \"\n         L\"button on the pill or have a keyboard shortcut (set in its editor)\",\n         L\"Atalhos para programas e arquivos (ou linhas de comando) que vocÃª \"\n         L\"adiciona, com os Ã­cones deles, a um clique no painel; qualquer um \"\n         L\"pode virar um botÃ£o na pÃ­lula ou ter um atalho de teclado (no \"\n         L\"editor dele)\"},\n        {SettingKind::Pref, (int)IslandPref::DndSilent,\n         L\"In the island\u0027s Do not disturb, calls, alarms and reminders don\u0027t \"\n         L\"ring either (they still show on the pill)\",\n         L\"No NÃ£o incomodar da ilha, chamadas, alarmes e lembretes tambÃ©m nÃ£o \"\n         L\"tocam (continuam aparecendo na pÃ­lula)\"},\n        {SettingKind::Pref, (int)IslandPref::DownloadStalled,\n         L\"Browsers never tell the taskbar a download is paused or failed: \"\n         L\"one whose bar stands still for 30 s turns yellow\",\n         L\"Os navegadores nunca avisam a barra de tarefas que um download \"\n         L\"pausou ou falhou: um com a barra parada por 30 s fica amarelo\"},\n        {SettingKind::Pref, (int)IslandPref::FolderThumbnails,\n         L\"Pictures, videos and documents show a small preview, as in \"\n         L\"Explorer, in the folders panel and on the shelf\",\n         L\"Fotos, vÃ­deos e documentos mostram uma prÃ©via pequena, como no \"\n         L\"Explorador, no painel de pastas e na prateleira\"},\n        {SettingKind::Pref, (int)IslandPref::Shelf,\n         L\"Drop files on the pill to keep them there, then drag them out into \"\n         L\"another app later (their places are kept, not copies)\",\n         L\"Solte arquivos na pÃ­lula para guardÃ¡-los ali e depois arraste para \"\n         L\"outro app (guarda onde eles estÃ£o, nÃ£o cÃ³pias)\"},\n        {SettingKind::Pref, (int)IslandPref::TimerLine,\n         L\"While a timer, Pomodoro or the stopwatch runs, the line becomes a \"\n         L\"small pill with its ring and its time (with Only the clock, the \"\n         L\"time goes beside the clock)\",\n         L\"Enquanto um timer, o Pomodoro ou o cronÃ´metro corre, a linha vira \"\n         L\"uma pÃ­lula pequena com o anel e o tempo (com SÃ³ o relÃ³gio, o tempo \"\n         L\"fica ao lado da hora)\"},\n        {SettingKind::Pref, (int)IslandPref::ExternalBrightness,\n         L\"Their sliders talk to the monitor over its cable. Turn off if a \"\n         L\"monitor flickers or a dock or MST hub resets when the control \"\n         L\"center opens\",\n         L\"Os controles deles falam com o monitor pelo cabo. Desligue se um \"\n         L\"monitor piscar ou se uma dock ou hub MST reiniciar ao abrir a \"\n         L\"central de controle\"},\n        {SettingKind::Pref, (int)IslandPref::GlassLight,\n         L\"The glass gets a sheen, a beveled edge, light along its bottom and \"\n         L\"a soft shadow around it, and the panels\u0027 cards look like glass too \"\n         L\"(idea by Thiago Silva)\",\n         L\"O vidro ganha brilho, borda chanfrada, luz na parte de baixo e uma \"\n         L\"sombra suave em volta, e os cartÃµes dos painÃ©is tambÃ©m parecem \"\n         L\"vidro (ideia de Thiago Silva)\"},\n        {SettingKind::Pref, (int)IslandPref::LyricsIcon,\n         L\"Only an icon on the pill while the song has lyrics, instead of the \"\n         L\"line sung now; a click opens them\",\n         L\"SÃ³ um Ã­cone na pÃ­lula enquanto a mÃºsica tem letra, no lugar da \"\n         L\"linha cantada; um clique abre a letra\"},\n        {SettingKind::Pref, (int)IslandPref::ArrowPins,\n         L\"With the line on, a click on the arrow keeps this monitor\u0027s island \"\n         L\"open until you click it again\",\n         L\"Com a linha ligada, um clique na seta mantÃ©m aberta a ilha deste \"\n         L\"monitor atÃ© outro clique\"},\n        {SettingKind::Pref, (int)IslandPref::ZoneAsPill,\n         L\"The mouse at the edge, anywhere along the pill\u0027s width, brings it \"\n         L\"back, also with the line invisible\",\n         L\"O mouse na borda, em qualquer ponto da largura da pÃ­lula, traz ela \"\n         L\"de volta, tambÃ©m com a linha invisÃ­vel\"},\n        {SettingKind::Pref, (int)IslandPref::MediaAlways,\n         L\"Keeps the note on the pill when no app has media; a click opens \"\n         L\"the panel\",\n         L\"MantÃ©m a nota na pÃ­lula quando nenhum app tem mÃ­dia; um clique \"\n         L\"abre o painel\"},\n        {SettingKind::Pref, (int)IslandPref::MediaPlayOnly,\n         L\"Leaves only the play and pause button on the pill, without \"\n         L\"previous and next\",\n         L\"Deixa sÃ³ o botÃ£o de tocar e pausar na pÃ­lula, sem anterior e \"\n         L\"prÃ³xima\"},\n        {SettingKind::Pref, (int)IslandPref::BarFixedSides,\n         L\"The items before the clock in the order stay at one corner and the \"\n         L\"others at the other, without changing sides as items come and go\",\n         L\"Os itens antes do relÃ³gio na ordem ficam num canto e os outros no \"\n         L\"outro, sem trocar de lado quando itens entram e saem\"},\n        {SettingKind::Pref, (int)IslandPref::PowerSleep,\n         L\"Shows this action in the power button\u0027s menu; if only one is on, a \"\n         L\"click on the button runs it\",\n         L\"Mostra esta aÃ§Ã£o no menu do botÃ£o de energia; se sÃ³ uma estiver \"\n         L\"ligada, um clique no botÃ£o a executa\"},\n        {SettingKind::Pref, (int)IslandPref::PowerHibernate,\n         L\"Shows this action in the power button\u0027s menu; if only one is on, a \"\n         L\"click on the button runs it\",\n         L\"Mostra esta aÃ§Ã£o no menu do botÃ£o de energia; se sÃ³ uma estiver \"\n         L\"ligada, um clique no botÃ£o a executa\"},\n        {SettingKind::Pref, (int)IslandPref::PowerRestart,\n         L\"Shows this action in the power button\u0027s menu; if only one is on, a \"\n         L\"click on the button runs it\",\n         L\"Mostra esta aÃ§Ã£o no menu do botÃ£o de energia; se sÃ³ uma estiver \"\n         L\"ligada, um clique no botÃ£o a executa\"},\n        {SettingKind::Pref, (int)IslandPref::PowerShutDown,\n         L\"Shows this action in the power button\u0027s menu; if only one is on, a \"\n         L\"click on the button runs it\",\n         L\"Mostra esta aÃ§Ã£o no menu do botÃ£o de energia; se sÃ³ uma estiver \"\n         L\"ligada, um clique no botÃ£o a executa\"},\n        {SettingKind::Pref, (int)IslandPref::PowerLock,\n         L\"Shows this action in the power button\u0027s menu; if only one is on, a \"\n         L\"click on the button runs it\",\n         L\"Mostra esta aÃ§Ã£o no menu do botÃ£o de energia; se sÃ³ uma estiver \"\n         L\"ligada, um clique no botÃ£o a executa\"},\n        {SettingKind::Pref, (int)IslandPref::PowerSignOut,\n         L\"Shows this action in the power button\u0027s menu; if only one is on, a \"\n         L\"click on the button runs it\",\n         L\"Mostra esta aÃ§Ã£o no menu do botÃ£o de energia; se sÃ³ uma estiver \"\n         L\"ligada, um clique no botÃ£o a executa\"},\n        {SettingKind::Pref, (int)IslandPref::PowerConfirm,\n         L\"Off, these actions run at the first click, with no question\",\n         L\"Desligado, essas aÃ§Ãµes rodam no primeiro clique, sem perguntar\"},\n        {SettingKind::Pref, (int)IslandPref::ClickThroughKey,\n         L\"The keys below make the pill let clicks through to what\u0027s under \"\n         L\"it, and again take them back; it stays shown\",\n         L\"As teclas abaixo fazem os cliques passarem pela pÃ­lula para o que \"\n         L\"estÃ¡ embaixo dela, e de novo voltam ao normal; ela continua visÃ­vel\"},\n        {SettingKind::Pref, (int)IslandPref::OverFullscreen,\n         L\"Games in exclusive full screen still draw over it. In some games \"\n         L\"it can cost some performance, or bother anti-cheat systems\",\n         L\"Jogos em tela cheia exclusiva continuam por cima dela. Em alguns \"\n         L\"jogos pode custar desempenho ou incomodar sistemas anti-cheat\"},\n        {SettingKind::Pref, (int)IslandPref::CalendarEvents,\n         L\"The day\u0027s events and holidays under the month, the next ones and \"\n         L\"the button to add one. Off, the calendar shows only the clock and \"\n         L\"the month; reminders and the countdown keep working\",\n         L\"Os eventos e feriados do dia sob o mÃªs, os prÃ³ximos e o botÃ£o para \"\n         L\"adicionar um. Desligado, o calendÃ¡rio mostra sÃ³ o relÃ³gio e o mÃªs; \"\n         L\"lembretes e a contagem continuam funcionando\"},\n        {SettingKind::Pref, (int)IslandPref::HoverOpen,\n         L\"Resting the mouse on an item opens its panel, and it closes a \"\n         L\"moment after the mouse leaves. Buttons that do something still \"\n         L\"need a click; a click keeps the panel open\",\n         L\"Parar o mouse num item abre o painel dele, que fecha logo depois \"\n         L\"que o mouse sai. BotÃµes que fazem algo continuam pedindo um \"\n         L\"clique; um clique deixa o painel aberto\"},\n        {SettingKind::Pref, (int)IslandPref::NotchHideEmpty,\n         L\"A notch with no items disappears, the one with the bell too. It \"\n         L\"comes back when an item or a notification comes to it, and while \"\n         L\"you drag items between the notches here. The strip kept on the \"\n         L\"screen stays the same\",\n         L\"Um entalhe sem itens desaparece, inclusive o do sino. Ele volta \"\n         L\"quando chega um item ou uma notificaÃ§Ã£o, e enquanto vocÃª arrasta \"\n         L\"itens entre os entalhes aqui. A faixa reservada na tela continua \"\n         L\"igual\"},\n        {SettingKind::Pref, (int)IslandPref::BannerMarquee,\n         L\"A notification\u0027s text stays on one line, and under the mouse it \"\n         L\"scrolls to its end and back instead of opening on up to three \"\n         L\"lines. With animations reduced or off, it opens on three lines as \"\n         L\"usual\",\n         L\"O texto do aviso fica em uma linha e, sob o mouse, rola atÃ© o fim \"\n         L\"e volta, em vez de abrir em atÃ© trÃªs linhas. Com as animaÃ§Ãµes \"\n         L\"reduzidas ou desligadas, abre em trÃªs linhas como sempre\"},\n        {SettingKind::Pref, (int)IslandPref::BarClearDesktop,\n         L\"While an app\u0027s window is maximized on this monitor, the bar goes \"\n         L\"back to its usual look (frosted, with the frosted glass on), so \"\n         L\"the window doesn\u0027t show behind it\",\n         L\"Enquanto a janela de um app estiver maximizada neste monitor, a \"\n         L\"barra volta ao visual normal (fosca, com o vidro fosco ligado), \"\n         L\"para a janela nÃ£o aparecer atrÃ¡s dela\"},\n        {SettingKind::Pref, (int)IslandPref::HideClockEdge,\n         L\"The small pill with the time touches the screen\u0027s edge, straight \"\n         L\"on that side and as thin as its text, covering less of what\u0027s \"\n         L\"under it. The mouse on it opens the island as usual\",\n         L\"A pequena pÃ­lula com a hora encosta na borda da tela, reta desse \"\n         L\"lado e fina como o texto, cobrindo menos do que estÃ¡ embaixo. O \"\n         L\"mouse sobre ela abre a ilha como sempre\"},\n        {SettingKind::Pref, (int)IslandPref::OrderDrag,\n         L\"Hold Ctrl and drag an item on the island (in any style) to another \"\n         L\"place, or to another notch. Its items jiggle while Ctrl is held \"\n         L\"with the mouse on it\",\n         L\"Segure Ctrl e arraste um item na ilha (em qualquer estilo) para \"\n         L\"outro lugar, ou para outro entalhe. Os itens tremem enquanto o \"\n         L\"Ctrl fica segurado com o mouse sobre ela\"},\n        {SettingKind::Pref, (int)IslandPref::Launcher,\n         L\"A grid on the pill that opens all your apps, Store apps too, like \"\n         L\"macOS: search them by typing, your favorites first (the star), \"\n         L\"then all of them in alphabetical order\",\n         L\"Uma grade na pÃ­lula que abre todos os seus apps, os da Store \"\n         L\"tambÃ©m, como no macOS: busque digitando, seus favoritos primeiro \"\n         L\"(a estrela), depois todos em ordem alfabÃ©tica\"},\n        {SettingKind::Pref, (int)IslandPref::MediaCoverOnly,\n         L\"The pill shows the song\u0027s cover without its title. Hover it to \"\n         L\"read the title\",\n         L\"A pÃ­lula mostra a capa da mÃºsica sem o tÃ­tulo. Passe o mouse para \"\n         L\"ler o tÃ­tulo\"},\n        {SettingKind::Pref, (int)IslandPref::NoticeCharger,\n         L\"Shows a notice when the charger is plugged in\",\n         L\"Mostra um aviso quando o carregador Ã© ligado\"},\n        {SettingKind::Pref, (int)IslandPref::NoticeLowBattery,\n         L\"Shows a notice when the battery goes under 20% and under 10%\",\n         L\"Mostra um aviso quando a bateria cai abaixo de 20% e de 10%\"},\n        {SettingKind::Pref, (int)IslandPref::NoticeBluetooth,\n         L\"Shows a notice with the device\u0027s name when Bluetooth audio connects\",\n         L\"Mostra um aviso com o nome do dispositivo quando um Ã¡udio \"\n         L\"Bluetooth conecta\"},\n        {SettingKind::Pref, (int)IslandPref::NoticeDnd,\n         L\"Shows a notice when you turn Do not disturb on or off\",\n         L\"Mostra um aviso quando vocÃª liga ou desliga o NÃ£o incomodar\"},\n        {SettingKind::Pref, (int)IslandPref::NoticeDesktop,\n         L\"Shows the number and name of the virtual desktop for a moment when \"\n         L\"you switch to it, also when the island is minimized\",\n         L\"Mostra o nÃºmero e o nome da Ã¡rea de trabalho virtual por um \"\n         L\"instante quando vocÃª troca para ela, tambÃ©m com a ilha minimizada\"},\n        {SettingKind::Pref, (int)IslandPref::BellWindows,\n         L\"A click on the bell opens Windows\u0027 own notification center instead \"\n         L\"of the island\u0027s list\",\n         L\"Um clique no sino abre a central de notificaÃ§Ãµes do prÃ³prio \"\n         L\"Windows em vez da lista da ilha\"},\n        {SettingKind::Pref, (int)IslandPref::WorldClocksInClock,\n         L\"Only the main clock shows on the pill; the other clocks list when \"\n         L\"the mouse rests on it\",\n         L\"SÃ³ o relÃ³gio principal aparece na pÃ­lula; os outros ficam numa \"\n         L\"lista quando o mouse para sobre ele\"},\n        {SettingKind::Pref, (int)IslandPref::VlcTitle,\n         L\"VLC 3 doesn\u0027t tell Windows\u0027 media controls what it plays, so the \"\n         L\"island can\u0027t see it. With this on, while VLC makes sound, the \"\n         L\"island reads the song\u0027s name from VLC\u0027s window title, shows it \"\n         L\"with VLC\u0027s icon, and its buttons press play/pause, previous and \"\n         L\"next in VLC. No cover or time, and VLC must show the name in its \"\n         L\"window title (its default)\",\n         L\"O VLC 3 nÃ£o conta aos controles de mÃ­dia do Windows o que estÃ¡ \"\n         L\"tocando, entÃ£o a ilha nÃ£o o vÃª. Com isto ligado, enquanto o VLC \"\n         L\"faz som, a ilha lÃª o nome da mÃºsica no tÃ­tulo da janela do VLC, \"\n         L\"mostra com o Ã­cone do VLC, e os botÃµes dela apertam tocar/pausar, \"\n         L\"anterior e prÃ³ximo no VLC. Sem capa nem tempo, e o VLC precisa \"\n         L\"mostrar o nome no tÃ­tulo da janela (o padrÃ£o dele)\"},\n        {SettingKind::Pref, (int)IslandPref::MusicLine,\n         L\"While something plays, the line becomes a thin pill with the \"\n         L\"song\u0027s cover and moving bars; the mouse on it opens the island, as \"\n         L\"on the line (with Only the clock, they go beside the clock)\",\n         L\"Enquanto algo toca, a linha vira uma pÃ­lula fina com a capa da \"\n         L\"mÃºsica e barras que se mexem; o mouse nela abre a ilha, como na \"\n         L\"linha (com SÃ³ o relÃ³gio, elas ficam ao lado da hora)\"},\n        {SettingKind::Pref, (int)IslandPref::CountdownEvents,\n         L\"Your events and your agendas\u0027 events\",\n         L\"Seus eventos e os das suas agendas\"},\n        {SettingKind::Pref, (int)IslandPref::CountdownAlarms,\n         L\"The next alarm that\u0027s on\",\n         L\"O prÃ³ximo alarme ligado\"},\n        {SettingKind::Pref, (int)IslandPref::CountdownTimer,\n         L\"While the timer runs\",\n         L\"Enquanto o timer estÃ¡ rodando\"},\n        {SettingKind::Pref, (int)IslandPref::CountdownPomodoro,\n         L\"Its focus or break ending, while it runs\",\n         L\"O fim do foco ou da pausa, enquanto ele roda\"},\n        {SettingKind::Pref, (int)IslandPref::DownloadFill,\n         L\"The progress apps show on their taskbar button (downloads, copies, installs)\",\n         L\"O progresso que os apps mostram no botÃ£o da barra de tarefas (downloads, cÃ³pias, instalaÃ§Ãµes)\"},\n        {SettingKind::Pref, (int)IslandPref::ChargeFill,\n         L\"On a laptop, the battery\u0027s percentage as it charges\",\n         L\"Num notebook, a porcentagem da bateria enquanto carrega\"},\n        {SettingKind::Choice, kChoiceFillColor,\n         L\"Downloads, installs and other apps\u0027 progress; red for an error, \"\n         L\"yellow paused\",\n         L\"Downloads, instalaÃ§Ãµes e o progresso dos outros apps; vermelho \"\n         L\"com erro, amarelo pausado\"},\n        {SettingKind::Choice, kChoiceFillCopyColor,\n         L\"Files copied or moved by Windows (its copy window)\",\n         L\"Arquivos copiados ou movidos pelo Windows (a janela de cÃ³pia)\"},\n        {SettingKind::Choice, kChoiceFillChargeColor,\n         L\"The battery\u0027s charge while a laptop charges\",\n         L\"A carga da bateria enquanto o notebook carrega\"},\n        {SettingKind::Pref, (int)IslandPref::Lyrics,\n         L\"The line sung now on the pill (place it in the order above), all \"\n         L\"of them in its panel. Each song\u0027s title and artist are sent to \"\n         L\"lrclib.net (songs only: not videos, voice messages or the apps \"\n         L\"turned off below)\",\n         L\"A linha cantada agora na pÃ­lula (posicione na ordem acima), todas \"\n         L\"no painel dela. O tÃ­tulo e o artista de cada mÃºsica sÃ£o enviados \"\n         L\"ao lrclib.net (sÃ³ mÃºsicas: nÃ£o vÃ­deos, Ã¡udios de voz nem os apps \"\n         L\"desligados abaixo)\"},\n        {SettingKind::Choice, kChoiceLyricsSize,\n         L\"How big the line is on the pill\",\n         L\"O tamanho da linha na pÃ­lula\"},\n        {SettingKind::Choice, kChoiceLyricsWidth,\n         L\"\\\"Follows the line\\\": as wide as each line; the others keep the \"\n         L\"widest line\u0027s width. A longer line ends with \\u2026\",\n         L\"\\\"Segue a linha\\\": da largura de cada linha; as outras mantÃªm a \"\n         L\"largura da linha mais larga. Uma linha maior termina em \\u2026\"},\n        {SettingKind::Choice, kChoiceLyricsColor,\n         L\"The line\u0027s color, on the pill and lit in the panel\",\n         L\"A cor da linha, na pÃ­lula e destacada no painel\"},\n        {SettingKind::Pref, (int)IslandPref::LyricsInTitle,\n         L\"While a line is sung, it takes the title and artist\u0027s place; \"\n         L\"between lines they come back\",\n         L\"Enquanto uma linha Ã© cantada, ela fica no lugar do nome e do \"\n         L\"artista; entre as linhas eles voltam\"},\n        {SettingKind::Choice, kChoiceFillStyle,\n         L\"How it moves; paused it breathes, an error shakes, done flashes \"\n         L\"with a check, canceled drains back\",\n         L\"Como ele se mexe; pausado respira, erro treme, concluÃ­do brilha \"\n         L\"com um visto, cancelado escorre de volta\"},\n        {SettingKind::Pref, (int)IslandPref::OwnNotifications,\n         L\"The island shows the notifications and plays their sounds, Windows \"\n         L\"stays quiet\",\n         L\"A ilha mostra as notificaÃ§Ãµes e toca os sons, o Windows fica \"\n         L\"quieto\"},\n        {SettingKind::Pref, (int)IslandPref::ShortcutNotifications,\n         L\"Pressing Win+N opens the island\u0027s notifications instead of \"\n         L\"Windows\u0027\",\n         L\"Apertar Win+N abre as notificaÃ§Ãµes da ilha em vez das do Windows\"},\n        {SettingKind::Pref, (int)IslandPref::ShortcutControl,\n         L\"Pressing Win+A opens the island\u0027s control center instead of \"\n         L\"Windows\u0027\",\n         L\"Apertar Win+A abre a central de controle da ilha em vez da do \"\n         L\"Windows\"},\n        {SettingKind::Pref, (int)IslandPref::MinimizeKey,\n         L\"The keys below send the island to its line, and again bring it \"\n         L\"back\",\n         L\"As teclas abaixo levam a ilha para a linha, e de novo a trazem de \"\n         L\"volta\"},\n        {SettingKind::Shortcut, 0,\n         L\"Shows the minimize keys, click them to record a new combination\",\n         L\"Mostra as teclas de minimizar, clique nelas para gravar outra \"\n         L\"combinaÃ§Ã£o\"},\n        {SettingKind::Shortcut, 1,\n         L\"Shows the keys that let clicks through, click them to record a \"\n         L\"combination\",\n         L\"Mostra as teclas que deixam os cliques passarem, clique nelas para \"\n         L\"gravar uma combinaÃ§Ã£o\"},\n        {SettingKind::Pref, (int)IslandPref::CapsLock,\n         L\"A bubble on the island says when Caps Lock is turned on or off\",\n         L\"Um balÃ£o na ilha avisa quando o Caps Lock Ã© ligado ou desligado\"},\n        {SettingKind::Pref, (int)IslandPref::StatusNotices,\n         L\"Shows notices for the charger, low battery, Bluetooth audio and Do \"\n         L\"not disturb\",\n         L\"Mostra avisos do carregador, bateria fraca, Ã¡udio Bluetooth e NÃ£o \"\n         L\"incomodar\"},\n        {SettingKind::Pref, (int)IslandPref::FoldApps,\n         L\"Folds the app icons into an arrow, they come out for new ones or \"\n         L\"on hover\",\n         L\"Recolhe os Ã­cones dos apps numa seta, que saem com novidades ou ao \"\n         L\"passar o mouse\"},\n        {SettingKind::Pref, (int)IslandPref::Banner,\n         L\"Shows a banner on the pill when a notification arrives\",\n         L\"Mostra um aviso na pÃ­lula quando chega uma notificaÃ§Ã£o\"},\n        {SettingKind::Pref, (int)IslandPref::BannerMinimized,\n         L\"Banners still appear while the pill is minimized to its line\",\n         L\"Os avisos continuam aparecendo com a pÃ­lula minimizada na linha\"},\n        {SettingKind::Choice, kChoiceBannerSize,\n         L\"How big the banner is, its texts and buttons with it\",\n         L\"O tamanho do aviso, com os textos e botÃµes dele\"},\n        {SettingKind::Choice, kChoiceShelfLimit,\n         L\"How many files it keeps: the oldest goes when a new one comes\",\n         L\"Quantos arquivos ela guarda: o mais antigo sai quando chega um \"\n         L\"novo\"},\n        {SettingKind::Choice, kChoiceBannerWidth,\n         L\"How wide the banner is (a longer text fits on its lines)\",\n         L\"A largura do aviso (um texto maior cabe nas linhas dele)\"},\n        {SettingKind::Choice, kChoiceBannerCorners,\n         L\"How round the banner\u0027s corners are\",\n         L\"O quanto os cantos do aviso sÃ£o arredondados\"},\n        {SettingKind::Choice, kChoiceBannerPlace,\n         L\"\\\"Following the bell\\\": out of the pill, as now; or at a point of \"\n         L\"the screen, sliding in from its nearest edge\",\n         L\"\\\"Seguindo o sino\\\": saindo da pÃ­lula, como hoje; ou num ponto da \"\n         L\"tela, entrando pela borda mais perto\"},\n        {SettingKind::Pref, (int)IslandPref::HideWindowsBanners,\n         L\"Stops Windows\u0027 own banners so you only see the island\u0027s\",\n         L\"Impede os avisos do prÃ³prio Windows para vocÃª ver sÃ³ os da ilha\"},\n        {SettingKind::Pref, (int)IslandPref::WebPictures,\n         L\"Fetches pictures for banners from the web, it needs an internet \"\n         L\"connection\",\n         L\"Busca imagens dos avisos na web, precisa de conexÃ£o com a internet\"},\n        {SettingKind::Pref, (int)IslandPref::NotificationApps,\n         L\"Shows an icon on the pill for each app with notifications\",\n         L\"Mostra na pÃ­lula um Ã­cone para cada app com notificaÃ§Ãµes\"},\n        {SettingKind::Pref, (int)IslandPref::GroupApps,\n         L\"Merges an app\u0027s notifications into one icon, Phone Link\u0027s phone \"\n         L\"apps included\",\n         L\"ReÃºne as notificaÃ§Ãµes de um app em um Ã­cone, inclusive os apps do \"\n         L\"celular do Vincular ao Celular\"},\n        {SettingKind::Pref, (int)IslandPref::Clipboard,\n         L\"Shows a bubble under the pill with what you just copied\",\n         L\"Mostra um balÃ£o sob a pÃ­lula com o que vocÃª acabou de copiar\"},\n        {SettingKind::Pref, (int)IslandPref::ScreenshotFolder,\n         L\"Clicking a screenshot notice opens the picture in Explorer\",\n         L\"Clicar no aviso de captura abre a imagem no Explorador\"},\n        {SettingKind::Dock, 0,\n         L\"Its style, size, hiding and animations are in Windhawk\u0027s settings \"\n         L\"for this mod\",\n         L\"Estilo, tamanho, esconder e animaÃ§Ãµes ficam nas configuraÃ§Ãµes do \"\n         L\"mod no Windhawk\"},\n        {SettingKind::About, 0,\n         L\"Made in Brazil, new versions bring fixes and what users ask for\",\n         L\"Feito no Brasil, as versÃµes novas trazem correÃ§Ãµes e o que os \"\n         L\"usuÃ¡rios pedem\"},\n        {SettingKind::About, 4,\n         L\"Every option explained step by step, the roadmap and your votes\",\n         L\"Cada opÃ§Ã£o explicada passo a passo, o roadmap e os seus votos\"},\n        {SettingKind::About, 1,\n         L\"My site, with my other projects and a Discord link\",\n         L\"Meu site, com meus outros projetos e um link do Discord\"},\n        {SettingKind::About, 2,\n         L\"Report a bug or suggest an idea, GitHub tells you when it comes out\",\n         L\"Relate um bug ou sugira uma ideia, o GitHub avisa quando sair\"},\n        {SettingKind::About, 3, L\"To talk to me and follow my projects\",\n         L\"Para falar comigo e acompanhar meus projetos\"},\n        {SettingKind::Pref, (int)IslandPref::WhatsNewNotice,\n         L\"Once per version, a notice from the pill opens this page\",\n         L\"Uma vez por versÃ£o, um aviso da pÃ­lula abre esta pÃ¡gina\"},\n        {SettingKind::Choice, kChoiceNotesLanguage,\n         L\"Only for the notes below; the island keeps its language\",\n         L\"SÃ³ para as notas abaixo; a ilha mantÃ©m o idioma dela\"},\n        {SettingKind::Logs, 0,\n         L\"A summary of the PC, the island\u0027s settings and its last 300 log \"\n         L\"lines (the dock\u0027s are in Windhawk\u0027s log)\",\n         L\"Um resumo do PC, as configuraÃ§Ãµes da ilha e as Ãºltimas 300 linhas \"\n         L\"de log dela (as da dock ficam no log do Windhawk)\"},\n        {SettingKind::Monitors, 0,\n         L\"Chooses which monitors show the island, with a map of your screens\",\n         L\"Escolhe quais monitores mostram a ilha, com um mapa das suas telas\"},\n    };\n    for (const auto\u0026 description : kDescriptions) {\n        if (description.kind == entry.kind \u0026\u0026 description.value == entry.value) {\n            return Tr(description.english, description.portuguese);\n        }\n    }\n    return {};\n}\n\nfloat ControlPanel::DescriptionHeight(const SettingEntry\u0026 entry,\n                                      float width) const {\n    float height = 0;\n    for (const std::wstring\u0026 text :\n         {SettingDescription(entry), SettingReason(entry)}) {\n        if (!text.empty()) {\n            height += std::round(2 * m_scale) +\n                      WrappedHeight(text, m_smallFormat.get(), width);\n        }\n    }\n    return height;\n}\n\nstd::vector\u003cControlPanel::NoteLine\u003e ControlPanel::NotesLines(int index) {\n    std::vector\u003cNoteLine\u003e lines;\n    if (index \u003c 0 || index \u003e= kReleaseNotesCount) {\n        return lines;\n    }\n    const int language =\n        std::clamp(g_notesLanguage \u003e= 0 ? g_notesLanguage\n                                        : (int)IslandTextLanguage(),\n                   0, kTextLanguages - 1);\n    std::wstring_view text = kReleaseNotes[index].text[language];\n    while (!text.empty()) {\n        const size_t end = std::min(text.find(L\u0027\\n\u0027), text.size());\n        std::wstring_view line = text.substr(0, end);\n        const bool heading = !line.empty() \u0026\u0026 line[0] == L\u0027#\u0027;\n        if (heading) {\n            line.remove_prefix(1);\n        }\n        SettingTarget link{SettingKind::Label, -1};\n        if (const size_t close = line.find(L\u0027}\u0027);\n            !line.empty() \u0026\u0026 line[0] == L\u0027{\u0027 \u0026\u0026 close != line.npos) {\n            link = NoteTarget(line.substr(1, close - 1));\n            line.remove_prefix(close + 1);\n        }\n        // (An item with its option is a button, see kNoteArrow.)\n        if (!line.empty()) {\n            lines.push_back({std::wstring(line), heading, link});\n        }\n        text.remove_prefix(std::min(end + 1, text.size()));\n    }\n    return lines;\n}\n\n// The option a \"What\u0027s new\" item tells about, by the key in braces at its\n// start (the same in every language).\nControlPanel::SettingTarget ControlPanel::NoteTarget(std::wstring_view key) {\n    auto pref = [](IslandPref option) {\n        return SettingTarget{SettingKind::Pref, (int)option};\n    };\n    auto choice = [](int id) { return SettingTarget{SettingKind::Choice, id}; };\n    static const std::pair\u003cstd::wstring_view, SettingTarget\u003e kKeys[] = {\n        {L\"IconPack\", choice(kChoiceIconPack)},\n        {L\"HideWhen\", choice(kChoiceHideWhen)},\n        {L\"HideClock\", pref(IslandPref::HideClock)},\n        {L\"AppPlaces\", {SettingKind::AppPlaces, 0}},\n        {L\"MusicLine\", pref(IslandPref::MusicLine)},\n        {L\"Dock\", {SettingKind::Dock, 0}},\n        {L\"Setup\", {SettingKind::Setup, 0}},\n        {L\"LineFade\", choice(kChoiceLineFade)},\n        {L\"LineClick\", choice(kChoiceLineClick)},\n        {L\"BarAlign\", choice(kChoiceBarAlign)},\n        {L\"MediaStyle\", choice(kChoiceMediaStyle)},\n        {L\"MediaCoverOnly\", pref(IslandPref::MediaCoverOnly)},\n        {L\"MediaButtonsSize\", {SettingKind::Size, kSliderMediaButtons}},\n        {L\"BatteryRing\", choice(kChoiceBatteryRing)},\n        {L\"TextFont\", choice(kChoiceTextFont)},\n        {L\"ClockFont\", choice(kChoiceClockFont)},\n        {L\"BarSide\", choice(kChoiceBarSide)},\n        {L\"DndSilent\", pref(IslandPref::DndSilent)},\n        {L\"BannerSize\", choice(kChoiceBannerSize)},\n        {L\"BannerPlace\", choice(kChoiceBannerPlace)},\n        {L\"Shelf\", pref(IslandPref::Shelf)},\n        {L\"Style\", {SettingKind::Style, 0}},\n        {L\"FolderDrag\", choice(kChoiceFolderDrag)},\n        {L\"Lyrics\", pref(IslandPref::Lyrics)},\n        {L\"LyricsIcon\", pref(IslandPref::LyricsIcon)},\n        {L\"OverFullscreen\", pref(IslandPref::OverFullscreen)},\n        {L\"ClickThroughKey\", pref(IslandPref::ClickThroughKey)},\n        {L\"BarFixedSides\", pref(IslandPref::BarFixedSides)},\n        {L\"CalendarEvents\", pref(IslandPref::CalendarEvents)},\n        {L\"PowerActions\", pref(IslandPref::PowerSleep)},\n        {L\"ArrowPins\", pref(IslandPref::ArrowPins)},\n        {L\"HoverOpen\", pref(IslandPref::HoverOpen)},\n        {L\"ZoneAsPill\", pref(IslandPref::ZoneAsPill)},\n        {L\"MediaAlways\", pref(IslandPref::MediaAlways)},\n        {L\"MediaPlayOnly\", pref(IslandPref::MediaPlayOnly)},\n        {L\"VlcTitle\", pref(IslandPref::VlcTitle)},\n        {L\"Timer\", pref(IslandPref::Timer)},\n        {L\"Visualizer\", pref(IslandPref::Visualizer)},\n        {L\"NetSpeed\", pref(IslandPref::NetSpeed)},\n        {L\"BannerMarquee\", pref(IslandPref::BannerMarquee)},\n        {L\"BarClearDesktop\", pref(IslandPref::BarClearDesktop)},\n        {L\"HideClockEdge\", pref(IslandPref::HideClockEdge)},\n        {L\"NotchHideEmpty\", pref(IslandPref::NotchHideEmpty)},\n        {L\"WorldClocks\", pref(IslandPref::WorldClocks)},\n        {L\"Countdown\", pref(IslandPref::Countdown)},\n        {L\"RecycleBin\", pref(IslandPref::RecycleBin)},\n        {L\"DownloadFill\", pref(IslandPref::DownloadFill)},\n        {L\"StatusNotices\", pref(IslandPref::StatusNotices)},\n        {L\"Language\", choice(kChoiceLanguage)},\n        {L\"Folders\", pref(IslandPref::Folders)},\n        {L\"Glass\", pref(IslandPref::LiquidGlass)},\n        {L\"PillShape\", {SettingKind::Size, 12}},\n        {L\"BarCorners\", pref(IslandPref::BarCorners)},\n        {L\"Updates\", pref(IslandPref::Updates)},\n        {L\"IconSize\", {SettingKind::Size, 7}},\n        {L\"OwnNotifications\", pref(IslandPref::OwnNotifications)},\n        {L\"FolderThumbnails\", pref(IslandPref::FolderThumbnails)},\n        {L\"TimerLine\", pref(IslandPref::TimerLine)},\n        {L\"GlassLight\", pref(IslandPref::GlassLight)},\n        {L\"OrderDrag\", pref(IslandPref::OrderDrag)},\n        {L\"Order\", {SettingKind::Order, 0}},\n        {L\"ExternalBrightness\", pref(IslandPref::ExternalBrightness)},\n        {L\"DownloadStalled\", pref(IslandPref::DownloadStalled)},\n        {L\"NotchOpen\", choice(kChoiceNotchOpen)},\n        {L\"Notches\", choice(kChoiceNotches)},\n        {L\"TextSize\", {SettingKind::Size, 19}},\n        {L\"BarClear\", pref(IslandPref::BarClear)},\n        {L\"WeatherUnit\", choice(kChoiceWeatherUnit)},\n        {L\"WeatherIcons\", choice(kChoiceWeatherIcons)},\n        {L\"CapsLock\", pref(IslandPref::CapsLock)},\n        {L\"MinimizeKey\", pref(IslandPref::MinimizeKey)},\n        {L\"AiUsage\", pref(IslandPref::AiUsage)},\n        {L\"FocusedTitle\", pref(IslandPref::FocusedTitle)},\n        {L\"Commands\", pref(IslandPref::Commands)},\n        {L\"WeatherCards\", pref(IslandPref::WeatherCards)},\n        {L\"CalendarBigDay\", pref(IslandPref::CalendarBigDay)},\n        {L\"Launcher\", pref(IslandPref::Launcher)},\n        {L\"BellWindows\", pref(IslandPref::BellWindows)},\n        {L\"WorldClocksInClock\", pref(IslandPref::WorldClocksInClock)},\n        {L\"NoticeDesktop\", pref(IslandPref::NoticeDesktop)},\n        {L\"Desktops\", pref(IslandPref::Desktops)},\n        {L\"Colors\", choice(kChoiceColors)},\n        {L\"Profiles\", {SettingKind::Profiles, 0}},\n        {L\"Reset\", choice(kChoiceBackup)},\n    };\n    for (const auto\u0026 [name, target] : kKeys) {\n        if (name == key) {\n            return target;\n        }\n    }\n    return {SettingKind::Label, -1};\n}\n\n// The app last in front, to add to profile `id` (none: empty), from the\n// island whose settings are open.\nstd::wstring AutoProfileAppToAdd(int id) {\n    const HWND app = g_island ? g_island-\u003eLastAppWindow() : nullptr;\n    if (!app || !IsWindow(app)) {\n        return {};\n    }\n    const std::wstring appId = WindowAppKey(app);\n    return appId.empty() || AutoProfileHas(id, L\u0027a\u0027, appId) ? std::wstring()\n                                                            : appId;\n}\n\nint ControlPanel::ProfileAppRows() const {\n    const size_t count = AutoProfileApps(m_profileEdit).size() +\n                         (AutoProfileAppToAdd(m_profileEdit).empty() ? 0 : 1);\n    return (int)((count + 2) / 3);\n}\n\nPCWSTR ControlPanel::ProfilesHint(int hint) {\n    switch (hint) {\n        case 0:\n            return Tr(\n                L\"This monitor\u0027s profile: changes here apply to every \"\n                L\"monitor using it\",\n                L\"Perfil deste monitor: as mudanÃ§as aqui valem para todo \"\n                L\"monitor que usa ele\");\n        case 1:\n            return Tr(\n                L\"Same as main: changes here apply to it too Â· + creates \"\n                L\"this monitor\u0027s profile\",\n                L\"Igual Ã  principal: as mudanÃ§as aqui valem para ela \"\n                L\"tambÃ©m Â· + cria o perfil deste monitor\");\n        case 2:\n            return Tr(\n                L\"+ saves the current settings as a profile, to switch \"\n                L\"back to them later.\",\n                L\"+ salva as configuraÃ§Ãµes atuais como um perfil, para \"\n                L\"voltar a elas depois.\");\n        case 3:\n            return Tr(L\"Saved \\u2713\", L\"Salvo \\u2713\");\n        case 4:\n            return Tr(L\"No profile in use: click one to apply it\",\n                      L\"Nenhum perfil em uso: clique num para aplicar\");\n        default:\n            return Tr(\n                L\"Changes are saved in the one in use Â· the pencil \"\n                L\"renames, saves or deletes\",\n                L\"As mudanÃ§as ficam salvas no perfil em uso Â· o lÃ¡pis \"\n                L\"renomeia, salva ou exclui\");\n    }\n}\n\nPCWSTR SettingSectionTitle(int section, bool english) {\n    static const PCWSTR kTitles[kSectionCount][2] = {\n        {L\"Profiles\", L\"Perfis\"},\n        {L\"Backup (notes, tasks, profiles and settings)\",\n         L\"Backup (notas, tarefas, perfis e configuraÃ§Ãµes)\"},\n        {L\"Language\", L\"Idioma\"},\n        {L\"Style (the options of the style chosen under it)\",\n         L\"Estilo (as opÃ§Ãµes do estilo escolhido embaixo dele)\"},\n        {L\"Place\", L\"PosiÃ§Ã£o\"},\n        {L\"Hiding: when and how it becomes the line\",\n         L\"Esconder: quando e como ela vira a linha\"},\n        {L\"Colors\", L\"Cores\"},\n        {L\"Glass\", L\"Vidro\"},\n        {L\"The pill\u0027s shape\", L\"Forma da pÃ­lula\"},\n        {L\"Sizes\", L\"Tamanhos\"},\n        {L\"The Bar style\", L\"O estilo Barra\"},\n        {L\"Details\", L\"Detalhes\"},\n        {L\"Icons\", L\"Ãcones\"},\n        {L\"Animations\", L\"AnimaÃ§Ãµes\"},\n        {L\"System\", L\"Sistema\"},\n        {L\"The pill as a loading bar\", L\"A pÃ­lula como barra de carregamento\"},\n        {L\"Desktop\", L\"Ãrea de trabalho\"},\n        {L\"Apps and tools\", L\"Apps e ferramentas\"},\n        {L\"Control center buttons on the pill\", L\"BotÃµes da central na pÃ­lula\"},\n        {L\"Other apps\u0027 tray icons\", L\"Ãcones dos outros apps\"},\n        {L\"What\u0027s playing\", L\"O que estÃ¡ tocando\"},\n        {L\"Clock and calendar (agendas: the calendar\u0027s gear)\",\n         L\"RelÃ³gio e calendÃ¡rio (agendas: engrenagem do calendÃ¡rio)\"},\n        {L\"Notifications\", L\"NotificaÃ§Ãµes\"},\n        {L\"Banners (notifications on the pill)\",\n         L\"Avisos (as notificaÃ§Ãµes na pÃ­lula)\"},\n        {L\"Monitors\", L\"Monitores\"},\n        {L\"Dock\", L\"Dock\"},\n        {L\"About\", L\"Sobre\"},\n        {L\"Setup assistant\", L\"Assistente de configuraÃ§Ã£o\"},\n        {L\"What\u0027s new\", L\"Novidades\"},\n        {L\"Logs\", L\"Logs\"},\n    };\n    return kTitles[std::clamp(section, 0, kSectionCount - 1)][english ? 0 : 1];\n}\n\nPCWSTR SettingTabTitle(int tab) {\n    static const PCWSTR kTitles[kTabCount][2] = {\n        {L\"General\", L\"Geral\"},\n        {L\"Style\", L\"Estilo\"},\n        {L\"Place\", L\"PosiÃ§Ã£o\"},\n        {L\"Hiding\", L\"Esconder\"},\n        {L\"Look\", L\"AparÃªncia\"},\n        {L\"Icons\", L\"Ãcones\"},\n        {L\"Animations\", L\"AnimaÃ§Ãµes\"},\n        {L\"System\", L\"Sistema\"},\n        {L\"Desktop\", L\"Ãrea de trabalho\"},\n        {L\"Apps and tools\", L\"Apps e ferramentas\"},\n        {L\"Control center\", L\"Central de controle\"},\n        {L\"Tray icons\", L\"Ãcones da bandeja\"},\n        {L\"What\u0027s playing\", L\"O que estÃ¡ tocando\"},\n        {L\"Clock and calendar\", L\"RelÃ³gio e calendÃ¡rio\"},\n        {L\"Notifications\", L\"NotificaÃ§Ãµes\"},\n        {L\"Banners\", L\"Avisos\"},\n        {L\"Monitors\", L\"Monitores\"},\n        {L\"Dock\", L\"Dock\"},\n        {L\"About\", L\"Sobre\"},\n        {L\"Setup assistant\", L\"Assistente de configuraÃ§Ã£o\"},\n        {L\"What\u0027s new\", L\"Novidades\"},\n        {L\"Logs\", L\"Logs\"},\n    };\n    const int i = std::clamp(tab, 0, kTabCount - 1);\n    return Tr(kTitles[i][0], kTitles[i][1]);\n}\n\n// What finds the pill\u0027s separator lines (the order strip\u0027s \"+ Line\" chip), in\n// every language of the island.\nstd::wstring SeparatorSearchWords() {\n    return L\" separator separators line lines divider Separador \"\n           L\"separadores linha linhas divisor åˆ†éš”çº¿ åˆ†å‰²çº¿ åˆ†éš” \"\n           L\"Trennlinie Trenner Linie lÃ­nea lÃ­neas Ð Ð°Ð·Ð´ÐµÐ»Ð¸Ñ‚ÐµÐ»ÑŒ \"\n           L\"Ñ€Ð°Ð·Ð´ÐµÐ»Ð¸Ñ‚ÐµÐ»ÑŒÐ½Ð°Ñ Ð»Ð¸Ð½Ð¸Ñ åŒºåˆ‡ã‚Šç·š åŒºåˆ‡ã‚Š ç·š Ä‘Æ°á»ng káº» phÃ¢n cÃ¡ch \"\n           L\"váº¡ch ngÄƒn\";\n}\n\n// A search that is about them: long enough not to find them with any\n// letter (two Chinese or Japanese characters are enough).\nbool SeparatorSearch(const std::wstring\u0026 query) {\n    size_t letters = 0;\n    bool wide = false;\n    for (const WCHAR c : query) {\n        if (c != L\u0027 \u0027) {\n            letters++;\n            wide = wide || c \u003e= 0x2E80;\n        }\n    }\n    return letters \u003e= (wide ? 2u : 3u) \u0026\u0026\n           MatchesSearch(SeparatorSearchWords(), query);\n}\n\n// What finds an entry: its names in both languages, a few words for what it\n// does, and its section\u0027s title.\nstd::wstring ControlPanel::SettingText(const SettingEntry\u0026 entry) const {\n    // (In Chinese too, when the island\u0027s texts are: see Tr.)\n    std::wstring text = std::wstring(SettingSectionTitle(entry.section, true)) +\n                        L\" \" + SettingSectionTitle(entry.section, false) +\n                        L\" \" +\n                        Tr(SettingSectionTitle(entry.section, true),\n                           SettingSectionTitle(entry.section, false));\n    switch (entry.kind) {\n        case SettingKind::Label:\n        case SettingKind::Setup:\n            break;\n        case SettingKind::Style:\n            text += L\" Style pill fixed keep room reserve maximized bar Estilo \"\n                    L\"pÃ­lula fixa reservar espaÃ§o maximizadas barra\";\n            break;\n        case SettingKind::Theme:\n            text +=\n                L\" Colors theme black graphite light accent glass auto dark \"\n                L\"mode inverted own custom Cores tema preto grafite claro \"\n                L\"destaque vidro automÃ¡tico escuro modo invertido prÃ³prias \"\n                L\"personalizadas\";\n            break;\n        case SettingKind::Size:\n            text += entry.value == 18\n                        ? L\" Visualizer sensitivity bars sound audio level \"\n                          L\"Sensibilidade do visualizador barras som Ã¡udio\"\n                    : entry.value == kSliderMediaButtons ||\n                            entry.value == kSliderMediaPanel\n                        ? L\" Media buttons panel size bigger larger \"\n                          L\"What\u0027s playing Tamanho dos botÃµes painel de \"\n                          L\"mÃ­dia maior O que estÃ¡ tocando\"\n                    : entry.value \u003e= 20\n                        ? L\" Visualizer bars height width spacing room size \"\n                          L\"Visualizador barras altura largura espaÃ§o \"\n                          L\"tamanho\"\n                    : entry.value == 16\n                        ? L\" Glass blur blurred frosted strength Liquid \"\n                          L\"Desfoque do vidro desfocado fosco forÃ§a\"\n                    : entry.value == 15\n                        ? L\" Edge around border outline line glow rim \"\n                          L\"Borda em volta contorno linha brilho\"\n                    : entry.value == 14\n                        ? L\" Room at the pill\u0027s ends width wide narrow \"\n                          L\"EspaÃ§o nas pontas da pÃ­lula largura larga \"\n                          L\"estreita\"\n                    : entry.value == 13\n                        ? L\" Pill corners round square radius Cantos da \"\n                          L\"pÃ­lula redondos quadrados\"\n                    : entry.value == 12\n                        ? L\" Pill height thin fat tall Altura da pÃ­lula \"\n                          L\"fina gorda alta\"\n                    : entry.value == 11\n                        ? L\" Title width length song scroll What\u0027s playing \"\n                          L\"Largura do tÃ­tulo comprimento mÃºsica rolar\"\n                    : entry.value == 10\n                        ? L\" Panels size settings text zoom bigger 4K \"\n                          L\"Tamanho dos painÃ©is configuraÃ§Ãµes texto maior\"\n                    : entry.value == 9\n                        ? L\" Area that brings it back activation hot corner \"\n                          L\"line auto-hide Ãrea que traz de volta ativaÃ§Ã£o \"\n                          L\"canto linha\"\n                    : entry.value == 8\n                        ? L\" Line opacity transparent invisible auto-hide \"\n                          L\"Opacidade da linha transparente invisÃ­vel\"\n                    : entry.value == 19\n                        ? L\" Text size texts font clock date percentage \"\n                          L\"small big Tamanho dos textos fonte relÃ³gio data \"\n                          L\"percentual pequenos grandes\"\n                    : entry.value == 7\n                        ? L\" Icon size icons symbols buttons small big \"\n                          L\"Tamanho dos Ã­cones sÃ­mbolos botÃµes pequenos \"\n                          L\"grandes\"\n                    : entry.value == 6\n                        ? L\" Notch curves round corners MacBook Curvas dos \"\n                          L\"entalhes cantos redondos\"\n                    : entry.value == 5\n                        ? L\" Hide after seconds delay auto-hide line Esconder \"\n                          L\"depois segundos linha\"\n                    : entry.value == 4\n                        ? L\" Opacity transparency transparent see-through \"\n                          L\"Opacidade transparÃªncia transparente\"\n                    : entry.value == 3\n                        ? L\" Tray icons list scroll how many Ãcones da \"\n                          L\"bandeja lista rolar quantos\"\n                    : entry.value == 2\n                        ? L\" Animation speed faster slower Velocidade das \"\n                          L\"animaÃ§Ãµes mais rÃ¡pido devagar\"\n                    : entry.value\n                        ? L\" Distance from the edges gap margin room space \"\n                          L\"DistÃ¢ncia das bordas espaÃ§o margem\"\n                        : L\" Size bigger smaller Tamanho maior menor\";\n            break;\n        case SettingKind::Place:\n            text += L\" Place where position PosiÃ§Ã£o onde lugar\";\n            break;\n        case SettingKind::Choice:\n            text += entry.value == kChoiceAnimationLevel\n                        ? L\" Level how many all partial none slower computer \"\n                          L\"NÃ­vel quantas todas parciais nenhuma computador \"\n                          L\"lento\"\n                    : entry.value == kChoiceFrameRate\n                        ? L\" Frame rate limit FPS Limite de quadros por \"\n                          L\"segundo\"\n                    : entry.value == kChoiceBackup\n                        ? L\" Export import backup file save restore Exportar \"\n                          L\"importar arquivo salvar restaurar cÃ³pia\"\n                    : entry.value == kChoiceColors\n                        ? L\" Your own colors custom background text icons \"\n                          L\"Cores prÃ³prias personalizadas fundo texto Ã­cones\"\n                    : entry.value == kChoiceDateOrder\n                        ? L\" Date order day month year Ordem da data dia mÃªs \"\n                          L\"ano\"\n                    : entry.value == kChoiceClockFormat\n                        ? L\" Time format 24 12 hours AM PM Formato da hora \"\n                          L\"horas\"\n                    : entry.value == kChoiceWeatherUnit\n                        ? L\" Temperature unit Celsius Fahrenheit weather \"\n                          L\"Unidade de temperatura clima\"\n                    : entry.value == kChoiceWeatherIcons\n                        ? L\" Weather icons emoji Meteocons Weather Icons \"\n                          L\"pictures sky Ãcones do clima cÃ©u imagens\"\n                    : entry.value == kChoiceIconPack\n                        ? L\" Icon pack icons theme emoji Ionicons Lucide \"\n                          L\"iPhone Mac online download folder Pacote de \"\n                          L\"Ã­cones tema baixar pasta\"\n                    : entry.value == kChoiceIconColors\n                        ? L\" Icon colors tint original monochrome Cores dos \"\n                          L\"Ã­cones originais\"\n                    : entry.value == kChoiceIconFolder\n                        ? L\" Icon folder own pictures custom SVG PNG save \"\n                          L\"Pasta de Ã­cones imagens prÃ³prias salvar\"\n                    : entry.value == kChoiceTrayStyle\n                        ? L\" Tray icons hidden list grid names Ãcones \"\n                          L\"bandeja ocultos lista grade nomes\"\n                    : entry.value == kChoiceWallpaper\n                        ? L\" Wallpaper transition fade circle slide zoom \"\n                          L\"Papel de parede transiÃ§Ã£o esmaecer cÃ­rculo \"\n                          L\"deslizar\"\n                    : entry.value == kChoiceNotchOpen\n                        ? L\" Line opens island notch left middle right \"\n                          L\"Linha abre ilha entalhe esquerda meio direita\"\n                    : entry.value == kChoiceLineClick\n                        ? L\" Line click open mouse hover pill Linha clique \"\n                          L\"abrir mouse pÃ­lula\"\n                    : entry.value == kChoiceLineFade\n                        ? L\" Fade line OLED burn-in screen minimized Apagar \"\n                          L\"linha tela queimar minimizada\"\n                    : entry.value == kChoiceBarSide\n                        ? L\" Bar vertical side left right upright Barra \"\n                          L\"vertical lado esquerda direita em pÃ©\"\n                    : entry.value == kChoiceTextFont ||\n                            entry.value == kChoiceClockFont\n                        ? L\" Font typeface text clock Fonte letra texto \"\n                          L\"relÃ³gio\"\n                    : entry.value == kChoiceBatteryRing\n                        ? L\" Battery ring charge edge notch \"\n                          L\"Bateria anel carga borda entalhe\"\n                    : entry.value == kChoiceMediaStyle\n                        ? L\" Media panel style Pixel Android One UI \"\n                          L\"Samsung Windows 11 cover compact What\u0027s \"\n                          L\"playing Estilo do painel de mÃ­dia capa \"\n                          L\"compacto O que estÃ¡ tocando\"\n                    : entry.value == kChoiceBarAlign\n                        ? L\" Bar items position left center right align \"\n                          L\"Barra itens posiÃ§Ã£o esquerda centro direita\"\n                    : entry.value == kChoiceBarInnerCorners\n                        ? L\" Bar corners round radius Barra cantos \"\n                          L\"arredondados raio\"\n                    : entry.value == kChoiceShelfLimit\n                        ? L\" Shelf files how many limit Prateleira arquivos \"\n                          L\"quantos limite\"\n                    : entry.value == kChoiceBannerSize ||\n                            entry.value == kChoiceBannerWidth ||\n                            entry.value == kChoiceBannerCorners ||\n                            entry.value == kChoiceBannerPlace\n                        ? L\" Banner notification size width corners place \"\n                          L\"position screen Aviso notificaÃ§Ã£o tamanho \"\n                          L\"largura cantos lugar posiÃ§Ã£o tela\"\n                    : entry.value == kChoiceHideWhen\n                        ? L\" When hides smart auto-hide maximized window over \"\n                          L\"covering Quando esconder automÃ¡tico maximizada \"\n                          L\"janela por cima cobrindo\"\n                    : entry.value == kChoiceNotches\n                        ? L\" Notches notch MacBook corners middle three Fixed \"\n                          L\"Entalhes entalhe cantos meio trÃªs Fixa\"\n                    : entry.value == kChoiceFolderDrag\n                        ? L\" Folders drag files copy move ask Pastas arrastar \"\n                          L\"arquivos copiar mover perguntar\"\n                    : entry.value == kChoiceLanguage\n                        ? L\" Language English Portuguese Chinese German \"\n                          L\"Spanish Russian Japanese Vietnamese translation \"\n                          L\"Idioma inglÃªs portuguÃªs chinÃªs alemÃ£o espanhol \"\n                          L\"russo japonÃªs vietnamita traduÃ§Ã£o è¯­è¨€ Sprache \"\n                          L\"Ð¯Ð·Ñ‹Ðº è¨€èªž Tiáº¿ng Viá»‡t ngÃ´n ngá»¯\"\n                    : FillChoiceKind(entry.value) \u003e= 0\n                        ? L\" Fill color progress download copy charge green \"\n                          L\"blue accent customize Cor preenchimento progresso \"\n                          L\"cÃ³pia carga verde azul destaque personalizar\"\n                    : entry.value == kChoiceFillStyle\n                        ? L\" Fill animation liquid wave glow particles simple \"\n                          L\"AnimaÃ§Ã£o preenchimento onda lÃ­quida brilho \"\n                          L\"partÃ­culas simples\"\n                    : entry.value == kChoiceLyricsSize ||\n                            entry.value == kChoiceLyricsColor ||\n                            entry.value == kChoiceLyricsWidth\n                        ? L\" Lyrics song words size color karaoke Letra \"\n                          L\"mÃºsica tamanho cor karaokÃª\"\n                    : entry.value == kChoiceVisualizerColor\n                        ? L\" Visualizer audio bars color rainbow accent \"\n                          L\"customize Visualizador Ã¡udio barras cor arco-Ã­ris \"\n                          L\"destaque personalizar\"\n                    : entry.value == kChoiceRecycleMinSize\n                        ? L\" Recycle Bin size MB GB always Lixeira tamanho \"\n                          L\"peso sempre\"\n                        : L\"\";\n            break;\n        case SettingKind::AppPlaces:\n            text += L\" Place and icons per app PosiÃ§Ã£o e Ã­cones por app\";\n            break;\n        case SettingKind::Icons:\n            text += L\" Icons pictures own Ãcones imagens prÃ³prias\";\n            for (const auto\u0026 icon : kIcons) {\n                if ((int)icon.group == entry.value) {\n                    text += L\" \" + std::wstring(icon.name);\n                }\n            }\n            break;\n        case SettingKind::LyricsApps:\n            text += entry.value == 1\n                        ? L\" Visualizer apps players bars sound Visualizador \"\n                          L\"apps barras som\"\n                        : L\" Lyrics apps songs lrclib Letras apps mÃºsicas\";\n            for (const auto\u0026 app : AppSwitchesOf(entry.value)) {\n                text += L\" \" + AppDisplayName(app.appId);\n            }\n            break;\n        case SettingKind::Monitors:\n            text +=\n                L\" Monitors screens follow mouse all profile notifications \"\n                L\"Monitor telas segue mouse todos perfil notificaÃ§Ãµes\";\n            break;\n        case SettingKind::Profiles:\n            text += L\" Profiles save apply rename delete Perfis salvar aplicar \"\n                    L\"renomear excluir app style estilo automatic \"\n                    L\"automÃ¡tico\";\n            for (const auto\u0026 profile : g_profiles) {\n                text += L\" \" + profile.name;\n            }\n            break;\n        case SettingKind::Order:\n            text += L\" Order of the items move Ordem dos itens mover\" +\n                    SeparatorSearchWords();\n            for (const auto\u0026 info : kPillGroupInfo) {\n                text += std::wstring(L\" \") + info.english + L\" \" +\n                        info.portuguese + L\" \" +\n                        Tr(info.english, info.portuguese);\n            }\n            break;\n        case SettingKind::Pref: {\n            const IslandPrefInfo\u0026 info = kIslandPrefs[entry.value];\n            text += std::wstring(L\" \") + info.english + L\" \" + info.portuguese +\n                    L\" \" + Tr(info.english, info.portuguese);\n            break;\n        }\n        case SettingKind::Dock:\n            text += L\" Dock Windhawk taskbar barra de tarefas\";\n            break;\n        case SettingKind::About:\n            text += L\" About version author Instagram GitHub site bugs ideas \"\n                    L\"Sobre versÃ£o autor ideias \" +\n                    SettingName(entry);\n            break;\n        case SettingKind::Logs:\n            text += L\" Logs log diagnostic copy save registro diagnÃ³stico \"\n                    L\"copiar salvar\";\n            break;\n        case SettingKind::WhatsNew:\n            text += L\" What\u0027s new changelog version notes Novidades versÃ£o \"\n                    L\"notas \" +\n                    SettingName(entry);\n            for (const auto\u0026 note : NotesLines(entry.value)) {\n                text += L\" \" + note.text;\n            }\n            break;\n        case SettingKind::Shortcut:\n            text += L\" Keys shortcut minimize record Win+J Teclas atalho \"\n                    L\"minimizar gravar \" +\n                    (ShortcutOfSlot(entry.value)\n                         ? ShortcutText(ShortcutOfSlot(entry.value))\n                         : std::wstring()) +\n                    L\" \" + Tr(L\"Keys\", L\"Teclas\");\n            break;\n    }\n    return text;\n}\n\n// How wide a chip of the order strip is (at 100%): the clock\u0027s time, a\n// separator\u0027s line narrower, the \"+ Line\" label wider, the icons.\nfloat OrderChipWidth(PillGroup group) {\n    return group == PillGroup::Clock       ? 50.0f\n           : IsPillSeparator(group)        ? 14.0f\n           : group == kAddSeparatorChip    ? 64.0f\n                                           : 30.0f;\n}\n\nControlPanel::OrderChip* ControlPanel::FindOrderChip(PillGroup group,\n                                                    int strip) {\n    for (auto\u0026 chip : m_orderChips) {\n        if (chip.group == group \u0026\u0026 chip.strip == strip) {\n            return \u0026chip;\n        }\n    }\n    return nullptr;\n}\n\nstd::vector\u003cPillGroup\u003e ControlPanel::StripOrder(int strip) const {\n    return strip \u003e= 0 \u0026\u0026 strip \u003c (int)AppPlaces().size()\n               ? PlaceOrder(AppPlaces()[strip])\n               : g_pillOrder;\n}\n\nbool ControlPanel::StripShows(int strip, PillGroup group) const {\n    // (A separator is always there.)\n    if ((int)group \u003e= kPillGroups) {\n        return true;\n    }\n    if (strip \u003c 0 || strip \u003e= (int)AppPlaces().size()) {\n        return PillGroupOn(group);\n    }\n    const IslandPlace\u0026 place = AppPlaces()[strip];\n    return !((place.own ? place.hidden\n                        : place.hidden | GloballyHiddenGroups()) \u0026\n             (1ull \u003c\u003c (int)group)) \u0026\u0026\n           OnlineGroupAllowed(group);\n}\n\nvoid ControlPanel::SetStripOrder(int strip,\n                                 const std::vector\u003cPillGroup\u003e\u0026 order) {\n    if (strip \u003c 0 || strip \u003e= (int)AppPlaces().size()) {\n        SetPillOrder(order);\n        return;\n    }\n    AppPlaces()[strip].order = order;\n    if (g_island) {\n        ForEachIsland([\u0026](Island\u0026 island) { island.Relayout(); });\n    }\n}\n\nvoid ControlPanel::ToggleAppGroup(size_t entry, int group) {\n    if (entry \u003e= AppPlaces().size()) {\n        return;\n    }\n    IslandPlace\u0026 place = AppPlaces()[entry];\n    if (!place.own) {\n        place.hidden |= GloballyHiddenGroups();\n        place.own = true;\n    }\n    place.hidden ^= 1ull \u003c\u003c group;\n    SavePlaces();\n    if (g_island) {\n        ForEachIsland([\u0026](Island\u0026 island) { island.OnPlacesChanged(); });\n        ForEachIsland([\u0026](Island\u0026 island) { island.Relayout(); });\n    }\n}\n\n// The order strip\u0027s items, side by side in the chosen order, centered.\nvoid ControlPanel::LayoutOrderChips(int strip) {\n    const D2D1_RECT_F\u0026 stripRect = StripRect(strip);\n    // (The settings\u0027 strip with notches: a part for each.)\n    const int notches = strip \u003c 0 ? NotchCountWanted() : 0;\n    // Only the items on the pill (the others are turned on in the list), and\n    // the notch each is in (a separator\u0027s, its group before\u0027s).\n    const std::vector\u003cPillGroup\u003e full = StripOrder(strip);\n    std::vector\u003cPillGroup\u003e shown;\n    std::vector\u003cint\u003e shownNotch;\n    for (size_t i = 0; i \u003c full.size(); i++) {\n        const PillGroup group = full[i];\n        // (Not the clock while it\u0027s kept in the middle: it goes there; with\n        // notches, it\u0027s moved to one like the others.)\n        if (StripShows(strip, group) \u0026\u0026\n            !(group == PillGroup::Clock \u0026\u0026 notches == 0 \u0026\u0026\n              PlaceClockCenter(strip \u003e= 0 \u0026\u0026 strip \u003c (int)AppPlaces().size()\n                                   ? \u0026AppPlaces()[strip]\n                                   : nullptr))) {\n            shown.push_back(group);\n            shownNotch.push_back(notches \u003e 0 ? PillEntryNotch(full, i, notches)\n                                             : 1);\n        }\n    }\n    // The \"+\" that adds a separator, after the others (in the last notch).\n    if (std::count_if(full.begin(), full.end(), IsPillSeparator) \u003c\n        kMaxPillSeparators) {\n        shown.push_back(kAddSeparatorChip);\n        shownNotch.push_back(-1);\n    }\n    std::erase_if(m_orderChips, [\u0026](const OrderChip\u0026 chip) {\n        return chip.strip == strip \u0026\u0026\n               std::find(shown.begin(), shown.end(), chip.group) == shown.end();\n    });\n    if (strip \u003c 0) {\n        m_notchParts.clear();\n    }\n    if (notches == 0) {\n        PlaceOrderChips(shown, stripRect, strip);\n        return;\n    }\n    // The notches side by side (one: in the middle), each with its items;\n    // a notch with many takes more of the strip (they\u0027re alike otherwise).\n    const float s = m_scale;\n    const std::vector\u003cint\u003e places = NotchPlaces(notches);\n    const float between = std::round(12 * s);\n    const float room = stripRect.right - stripRect.left;\n    // (Their curves inside their part.)\n    const float curve = NotchShoulder(stripRect.bottom - stripRect.top);\n    std::vector\u003cstd::vector\u003cPillGroup\u003e\u003e groups(places.size());\n    std::vector\u003cfloat\u003e wanted(places.size());\n    float available = room - between * (places.size() - 1);\n    float total = 0;\n    for (size_t i = 0; i \u003c places.size(); i++) {\n        float need = std::round(6 * s) + curve * 2;\n        for (size_t k = 0; k \u003c shown.size(); k++) {\n            if (shownNotch[k] == places[i] ||\n                (shownNotch[k] \u003c 0 \u0026\u0026 i + 1 == places.size())) {\n                groups[i].push_back(shown[k]);\n                need += std::round(OrderChipWidth(shown[k]) * s) +\n                        std::round(2 * s);\n            }\n        }\n        wanted[i] = std::max(need, available / places.size() * 0.6f);\n        total += wanted[i];\n    }\n    float left = stripRect.left;\n    if (places.size() == 1) {\n        const float width = std::round(room * 0.85f);\n        left = std::round(stripRect.left + (room - width) / 2);\n        wanted[0] = total = available = width;\n    }\n    for (size_t i = 0; i \u003c places.size(); i++) {\n        const float width = std::floor(available * wanted[i] / total);\n        const D2D1_RECT_F part{left + curve, stripRect.top,\n                               left + width - curve, stripRect.bottom};\n        m_notchParts.push_back({places[i], part});\n        PlaceOrderChips(groups[i], part, strip);\n        left += width + between;\n    }\n}\n\nvoid ControlPanel::PlaceOrderChips(const std::vector\u003cPillGroup\u003e\u0026 groups,\n                                   const D2D1_RECT_F\u0026 rect,\n                                   int strip) {\n    const float s = m_scale;\n    const float gap = std::round(2 * s);\n    const float inset = std::round(3 * s);\n    // Narrower when they don\u0027t all fit.\n    float full = -gap;\n    for (PillGroup group : groups) {\n        full += std::round(OrderChipWidth(group) * s) + gap;\n    }\n    const float room = rect.right - rect.left - inset * 2;\n    const float squeeze =\n        full \u003e room \u0026\u0026 groups.size() \u003e 1\n            ? (room - gap * (groups.size() - 1)) /\n                  (full - gap * (groups.size() - 1))\n            : 1.0f;\n    auto widthOf = [s, squeeze](PillGroup group) {\n        return std::floor(OrderChipWidth(group) * s * squeeze);\n    };\n    float total = -gap;\n    for (PillGroup group : groups) {\n        total += widthOf(group) + gap;\n    }\n    float x = std::round((rect.left + rect.right - total) / 2);\n    for (PillGroup group : groups) {\n        const float width = widthOf(group);\n        const D2D1_RECT_F chipRect{x, rect.top + inset, x + width,\n                                   rect.bottom - inset};\n        if (OrderChip* chip = FindOrderChip(group, strip)) {\n            chip-\u003erect = chipRect;\n        } else {\n            m_orderChips.push_back({group, chipRect, chipRect.left, 0, strip});\n        }\n        x += width + gap;\n    }\n}\n\n// The pictures\u0027 places: a card for each choice, side by side in the\n// middle; for the banners\u0027 place, \"Following the bell\" beside a little\n// screen with its nine points (the chosen one\u0027s name under it).\nvoid ControlPanel::PlaceChoicePictures(int id,\n                                       const D2D1_RECT_F\u0026 rect,\n                                       float top,\n                                       float bottom) {\n    const float s = m_scale;\n    auto\u0026 segments = m_choiceSegments[id];\n    if (id == kChoiceBannerPlace) {\n        const float gap = std::round(16 * s);\n        const float bell = std::round(150 * s);\n        const float screenHeight = std::round(96 * s);\n        const float screenWidth = std::min(\n            std::round(168 * s),\n            std::max(std::round(90 * s),\n                     rect.right - rect.left - bell - gap - std::round(8 * s)));\n        const float left = std::round((rect.left + rect.right) / 2 -\n                                      (bell + gap + screenWidth) / 2);\n        const float screenTop = top + std::round(4 * s);\n        const float middle = screenTop + screenHeight / 2;\n        const float button = std::round(34 * s);\n        segments.push_back(\n            {left, middle - button / 2, left + bell, middle + button / 2});\n        const D2D1_RECT_F screen{left + bell + gap, screenTop,\n                                 left + bell + gap + screenWidth,\n                                 screenTop + screenHeight};\n        const float inset = std::round(5 * s);\n        const float cellWidth = (screen.right - screen.left - inset * 2) / 3;\n        const float cellHeight = (screen.bottom - screen.top - inset * 2) / 3;\n        for (int i = 0; i \u003c 9; i++) {\n            const float x = screen.left + inset + cellWidth * (float)(i % 3);\n            const float y = screen.top + inset + cellHeight * (float)(i / 3);\n            segments.push_back({x, y, x + cellWidth, y + cellHeight});\n        }\n        return;\n    }\n    const int count = ChoiceCount(id);\n    const float gap = std::round(8 * s);\n    const float card = std::min(\n        std::round(112 * s),\n        std::floor((rect.right - rect.left - gap * (float)(count - 1)) /\n                   (float)count));\n    const float left = std::round((rect.left + rect.right) / 2 -\n                                  (card * count + gap * (count - 1)) / 2);\n    for (int i = 0; i \u003c count; i++) {\n        const float x = left + (card + gap) * (float)i;\n        segments.push_back({x, top, x + card, bottom});\n    }\n}\n\n// The pictures (see PlaceChoicePictures): the chosen one ringed in the\n// accent, the one under the mouse lighter.\nvoid ControlPanel::DrawChoicePictures(ID2D1RenderTarget* target,\n                                      ID2D1SolidColorBrush* brush,\n                                      int id,\n                                      float opacity) {\n    const float s = m_scale;\n    const auto\u0026 segments = m_choiceSegments[id];\n    const int value = ChoiceValue(id);\n    auto lit = [\u0026](int i) {\n        return Hover(segments[i], m_hover.part == Part::ChoiceSegment \u0026\u0026\n                                      m_hover.index == id * 16 + i);\n    };\n    auto card = [\u0026](const D2D1_RECT_F\u0026 rect, bool chosen, float hover) {\n        const float radius = std::round(10 * s);\n        brush-\u003eSetColor(Fg((chosen ? 0.14f : 0.06f + 0.06f * hover) * opacity));\n        GlassFill(target, {rect, radius, radius}, brush);\n        if (chosen) {\n            brush-\u003eSetColor(Accent(opacity));\n            target-\u003eDrawRoundedRectangle(\n                {{rect.left + 1, rect.top + 1, rect.right - 1, rect.bottom - 1},\n                 radius - 1,\n                 radius - 1},\n                brush, std::max(1.5f, std::round(2 * s)));\n        }\n    };\n    if (id == kChoiceBannerPlace \u0026\u0026 segments.size() == 10) {\n        // \"Following the bell\": a button with the bell.\n        const D2D1_RECT_F\u0026 bell = segments[0];\n        card(bell, value == 0, lit(0));\n        const WCHAR glyph = 0xEA8F;\n        const float icon = bell.bottom - bell.top;\n        brush-\u003eSetColor(Fg((value == 0 ? 0.95f : 0.7f) * opacity));\n        DrawGlyph(target, \u0026glyph, 1, m_smallIconFormat.get(),\n                  {bell.left + std::round(4 * s), bell.top,\n                   bell.left + std::round(4 * s) + icon, bell.bottom},\n                  brush);\n        DrawMarquee(target, brush, ChoiceOption(id, 0), m_linkFormat.get(),\n                    {bell.left + icon, bell.top,\n                     bell.right - std::round(8 * s), bell.bottom},\n                    false);\n        // The little screen, a banner at each of its nine points.\n        const D2D1_RECT_F screen{segments[1].left - std::round(5 * s),\n                                 segments[1].top - std::round(5 * s),\n                                 segments[9].right + std::round(5 * s),\n                                 segments[9].bottom + std::round(5 * s)};\n        const float corner = std::round(8 * s);\n        brush-\u003eSetColor(Fg(0.05f * opacity));\n        GlassFill(target, {screen, corner, corner}, brush);\n        brush-\u003eSetColor(Fg(0.3f * opacity));\n        target-\u003eDrawRoundedRectangle({screen, corner, corner}, brush,\n                                     std::max(1.0f, s));\n        for (int i = 1; i \u003c= 9; i++) {\n            const D2D1_RECT_F\u0026 cell = segments[i];\n            const float width = (cell.right - cell.left) * 0.62f;\n            const float height = (cell.bottom - cell.top) * 0.5f;\n            const int column = (i - 1) % 3;\n            const int row = (i - 1) / 3;\n            const float pad = std::round(2 * s);\n            const float x = column == 0 ? cell.left + pad\n                            : column == 2\n                                ? cell.right - pad - width\n                                : (cell.left + cell.right - width) / 2;\n            const float y = row == 0 ? cell.top + pad\n                            : row == 2 ? cell.bottom - pad - height\n                                       : (cell.top + cell.bottom - height) / 2;\n            const D2D1_RECT_F banner{x, y, x + width, y + height};\n            const float round = height / 2;\n            const float hover = lit(i);\n            brush-\u003eSetColor(value == i ? Accent(opacity)\n                                       : Fg((0.2f + 0.3f * hover) * opacity));\n            target-\u003eFillRoundedRectangle({banner, round, round}, brush);\n        }\n        // The chosen point\u0027s name under the screen.\n        if (value \u003e= 1 \u0026\u0026 value \u003c= 9) {\n            const std::wstring name = ChoiceOption(id, value);\n            brush-\u003eSetColor(Fg(0.75f * opacity));\n            target-\u003eDrawText(name.c_str(), (UINT32)name.size(),\n                             m_linkFormat.get(),\n                             {screen.left - std::round(20 * s), screen.bottom,\n                              screen.right + std::round(20 * s),\n                              screen.bottom + std::round(26 * s)},\n                             brush);\n        }\n        return;\n    }\n    for (size_t i = 0; i \u003c segments.size(); i++) {\n        const D2D1_RECT_F\u0026 rect = segments[i];\n        const bool chosen = value == (int)i;\n        card(rect, chosen, lit((int)i));\n        // The drawing over the name: a little screen.\n        const float label = std::round(24 * s);\n        const float pictureBottom = rect.bottom - label;\n        const float w = std::round(56 * s);\n        const float h = std::round(36 * s);\n        const float cx = (rect.left + rect.right) / 2;\n        const float cy = (rect.top + pictureBottom) / 2 + std::round(3 * s);\n        const D2D1_RECT_F screen{cx - w / 2, cy - h / 2, cx + w / 2,\n                                 cy + h / 2};\n        const D2D1_COLOR_F ink = chosen ? Accent(opacity) : Fg(0.7f * opacity);\n        const float thick = std::round(6 * s);\n        if (id == kChoiceBannerCorners) {\n            // A banner with those corners.\n            const float radius = i == 0   ? std::round(10 * s)\n                                 : i == 1 ? std::round(5 * s)\n                                          : 0.0f;\n            const D2D1_RECT_F banner{screen.left, cy - std::round(12 * s),\n                                     screen.right, cy + std::round(12 * s)};\n            brush-\u003eSetColor(ink);\n            target-\u003eFillRoundedRectangle({banner, radius, radius}, brush);\n        } else {\n            brush-\u003eSetColor(Fg(0.3f * opacity));\n            target-\u003eDrawRectangle(screen, brush, std::max(1.0f, s));\n            if (id == kChoiceBarSide) {\n                // The bar along its edge.\n                const D2D1_RECT_F bar =\n                    i == 0   ? D2D1_RECT_F{screen.left, screen.top,\n                                         screen.right, screen.top + thick}\n                    : i == 1 ? D2D1_RECT_F{screen.left, screen.top,\n                                           screen.left + thick, screen.bottom}\n                             : D2D1_RECT_F{screen.right - thick, screen.top,\n                                           screen.right, screen.bottom};\n                brush-\u003eSetColor(ink);\n                target-\u003eFillRectangle(bar, brush);\n            } else if (id == kChoiceSetupStyle) {\n                // The pill floating under the top edge, the pill joined to\n                // it, or the bar along it.\n                const float pill = std::round(9 * s);\n                const float half = std::round(w * 0.3f);\n                const D2D1_RECT_F shape =\n                    i == 0   ? D2D1_RECT_F{cx - half, screen.top + thick,\n                                         cx + half, screen.top + thick + pill}\n                    : i == 1 ? D2D1_RECT_F{cx - half, screen.top - pill,\n                                           cx + half, screen.top + pill}\n                             : D2D1_RECT_F{screen.left, screen.top,\n                                           screen.right, screen.top + thick};\n                const float radius = i == 2 ? 0.0f : pill / 2;\n                target-\u003ePushAxisAlignedClip(screen,\n                                            D2D1_ANTIALIAS_MODE_PER_PRIMITIVE);\n                brush-\u003eSetColor(ink);\n                target-\u003eFillRoundedRectangle({shape, radius, radius}, brush);\n                target-\u003ePopAxisAlignedClip();\n            } else {\n                // The bar at the top, and the screen under it with the\n                // corners rounded where they meet (the bar\u0027s color in them).\n                brush-\u003eSetColor(ink);\n                target-\u003eFillRectangle(screen, brush);\n                const float radius = std::round(4 * s) * (float)i;\n                brush-\u003eSetColor(Bg(1));\n                target-\u003eFillRoundedRectangle(\n                    {{screen.left, screen.top + thick, screen.right,\n                      screen.bottom + radius},\n                     radius,\n                     radius},\n                    brush);\n                brush-\u003eSetColor(Fg(0.3f * opacity));\n                target-\u003eDrawRectangle(screen, brush, std::max(1.0f, s));\n            }\n        }\n        const std::wstring name = ChoiceOption(id, (int)i);\n        brush-\u003eSetColor(Fg((chosen ? 0.95f : 0.7f) * opacity));\n        DrawMarquee(target, brush, name, m_linkFormat.get(),\n                    {rect.left + std::round(6 * s), pictureBottom,\n                     rect.right - std::round(6 * s),\n                     rect.bottom - std::round(2 * s)},\n                    false);\n    }\n}\n\nvoid ControlPanel::LayoutSettings() {\n    if (!m_toolsLooked) {\n        m_toolsLooked = true;\n        LookForKomorebi();\n    }\n    if (m_settings.empty()) {\n        static const SettingSpec kSpecs[] = {\n            // The setup assistant\u0027s page: its text, then its own choices\n            // (the other tabs\u0027 options it shows come after them, see\n            // SetupShows).\n            {(int)SettingKind::Setup, 0, kSectionSetup},\n            {(int)SettingKind::Choice, kChoiceSetupStyle, kSectionSetup},\n            {(int)SettingKind::Choice, kChoiceSetupItems, kSectionSetup},\n            {(int)SettingKind::Choice, kChoiceSetupHide, kSectionSetup},\n            {(int)SettingKind::Choice, kChoiceSetupTheme, kSectionSetup},\n            {(int)SettingKind::Label, 0, kSectionProfiles},\n            {(int)SettingKind::Profiles, 0, kSectionProfiles},\n            {(int)SettingKind::Label, 0, kSe